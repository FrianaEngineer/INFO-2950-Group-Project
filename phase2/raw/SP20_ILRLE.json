sion": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 369372, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3445", "titleShort": "Inequality in US Higher Ed", "titleLong": "Inequality in U.S. Higher Education", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14259, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "er488", "firstName": "Evan", "middleName": "", "lastName": "Riehl"}], "pattern": "MW", "facilityDescr": "Ives Hall 217", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS217", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3770", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Is the U.S. college system a great equalizer or a cause of growing inequality? Improved access to higher education has brought millions of Americans into the middle class, and yet rising selectivity has meant that a disproportionate share of the economic elite come from a few top colleges. This course will explore the three big parts of the college experience --- (1) admissions and the college-going decision; (2) education while in college; and (3) college completion and labor market entry --- and ask how each part contributes to inequality in economic outcomes. Lectures and readings will focus on simple economic theories of higher education as well as the empirical methods used to test these theories.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400, ECON 3030\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 370825, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3450", "titleShort": "Race and American Labor Market", "titleLong": "Race and the American Labor Market in Historical Perspective", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18256, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "ss3977", "firstName": "Seth", "middleName": "", "lastName": "Sanders"}], "pattern": "TR", "facilityDescr": "Ives Hall 219", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS219", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3480", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This class investigates race and class in the American labor market from Colonial America to the present day. We investigate the circumstances and labor institutions that brought labor to the U.S. and how laborers of various classes were received. A primary goal of the class is to understand the degree to which social mobility was historically possible in different time periods in American history. Social mobility is intimately tied to labor market institutions and the ability for workers to get ahead within those institutions. Some of the institutions we study are Indentured Servitude, Slavery, tenant farming, the Great Migration and labor organization in the industrial north. Ultimately we hope to build an understanding of the historical roots of the role of race and class today.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ECON 3030\u00a0or ILRLE 2400.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 360370, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "4430", "titleShort": "Compensation, Incentives&Prod", "titleLong": "Compensation, Incentives, and Productivity", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14207, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 2, "netid": "srt82", "firstName": "Stephanie", "middleName": "R", "lastName": "Thomas"}], "pattern": "TR", "facilityDescr": "Ives Hall 115", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS115", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3430", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Examines topics in labor economics of particular relevance to individual managers and firms. Representative topics include recruitment, screening, and hiring strategies; compensation (including retirement pensions and other benefits); training, turnover, and the theory of human capital; incentive schemes and promotions; layoffs, downsizing, and buyouts; teamwork; and internal labor markets. Focuses on labor-related business problems using the analytic tools of economic theory and should appeal to students with strong quantitative skills who are contemplating careers in general business, consulting, and human resource management as well as in economics.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 360369, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "4440", "titleShort": "Evolution of Social Policy in", "titleLong": "The Evolution of Social Policy in Britain and America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17712, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "grb3", "firstName": "George", "middleName": "R.", "lastName": "Boyer"}], "pattern": "TR", "facilityDescr": "Ives Hall 115", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS115", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3340", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Surveys the history of social policy in Great Britain and the United States from 1800 to the adoption of the British welfare state after World War II. Topics include the role of poor relief in the early 19th century; the changing relationship between public relief and private charity; the adoption of social insurance programs and protective labor legislation for children and women; government intervention in the Great Depression; and the beginnings of the welfare state.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 360379, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "5400", "titleShort": "Labor Economics", "titleLong": "Labor Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14316, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 3, "netid": "djc397", "firstName": "Darius", "middleName": "J.", "lastName": "Conger"}], "pattern": "MW", "facilityDescr": "Ives Hall 219", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS219", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This is a course in labor market economics for prospective managers in the corporate, union, not-for-profit, and public sectors. The course begins with demand and supply in labor markets, presenting the tools of decision analysis for workers and firms. It then goes on to consider various topics in workplace management including deciding on the optimal mix of capital and labor to employ, attracting and retaining talent, pay and productivity, hiring and training investments, and using strategic budget constraints. The final section of the course covers other important labor market issues i