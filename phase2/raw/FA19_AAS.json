{"status": "success", "data": {"classes": [{"strm": 2741, "crseId": 351002, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "2100", "titleShort": "South Asian Diaspora", "titleLong": "South Asian Diaspora", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8436, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "vpm1", "firstName": "Viranjini", "middleName": "P.", "lastName": "Munasinghe"}], "pattern": "TR", "facilityDescr": "McGraw Hall 215", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG215", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "2410", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This interdisciplinary course (with an emphasis in anthropology) will introduce students to the multiple routes/roots, lived experiences, and imagined worlds of South Asians who have traveled to various lands at different historical moments spanning Fiji, South Africa, Mauritius, Britain, Malaysia, United States, Trinidad, and even within South Asia itself such as the Tamil-speaking population of Sri Lanka. The course will begin with the labor migrations of the 1830s and continue up to the present period. The primary exercise will be to compare and contrast the varied expressions of the South Asian Diaspora globally in order to critically evaluate this transnational identity. Thus, we will ask what, if any, are the ties that bind a fifth-generation Indo-Trinidadian whose ancestor came to the New World as an indentured laborer or \"coolie\" in the mid-19th century to labor in the cane fields, to a Pakistani medical doctor who migrated to the United States in the late 1980s. If Diaspora violates a sense of identity based on territorial integrity, then could \"culture\" serve as the basis for a shared identity?", "catalogBreadth": "(GHB)", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 352628, "crseOfferNbr": 2, "subject": "AAS", "catalogNbr": "2130", "titleShort": "Intro To Asian American Hist", "titleLong": "Introduction to Asian American History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8989, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "dsc37", "firstName": "Derek", "middleName": "S.", "lastName": "Chang"}], "pattern": "TR", "facilityDescr": "Mcgraw Hall 165", "