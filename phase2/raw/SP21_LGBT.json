: "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Individual study program intended for juniors and seniors working on special topics with selected reading or research projects not covered in regularly scheduled courses. Students select a topic in consultation with an LGBT Studies faculty member who has agreed to supervise independent study.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "To apply for independent study, please complete the on-line form.", "catalogPrereqCoreq": "Prerequisite: LGBT 2290\u00a0and one additional LGBT Studies course at the 3000-level.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 371309, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "4505", "titleShort": "Queer Proximities", "titleLong": "Queer Proximities", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17898, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "02:20PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "mpb23", "firstName": "Mary Pat", "middleName": "P.", "lastName": "Brady"}], "pattern": "M", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4502", "type": "B"}, {"subject": "AMST", "catalogNbr": "6502", "type": "B"}, {"subject": "ASRC", "catalogNbr": "4555", "type": "B"}, {"subject": "ASRC", "catalogNbr": "6555", "type": "B"}, {"subject": "ENGL", "catalogNbr": "4505", "type": "B"}, {"subject": "ENGL", "catalogNbr": "6505", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4505", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6505", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6505", "type": "B"}, {"subject": "LSP", "catalogNbr": "4505", "type": "B"}, {"subject": "LSP", "catalogNbr": "6505", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "How has the fiction and art of queers of color transformed the worlds we know? How have their theoretical interventions created new queer freedoms and new understandings of race and sexualities?\u00a0 In this course we will focus on the struggles against subjugation led by Black and Latinx artists and writers including Audre Lorde, Gabby Rivera, Marlon Riggs, F\u00e9lix, Gonz\u00e1lez-Torres, Essex Hemphill, Gloria Anzald\u00faa, James Baldwin, Cherr\u00ede Moraga. Building on their work, will turn to queer of color theory, a conceptual field that interrogates the ways race, gender, sexuality, regimes of embodiment, and class reinforce racializing technologies, in order to learn what queer of color thinkers can teach us about globalization, incarceration, immigration as well as joy, pleasure, intoxication, the unruly and the opaque.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 368795, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "4701", "titleShort": "Nightlife", "titleLong": "Nightlife", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 7884, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "kj12", "firstName": "Karen", "middleName": "", "lastName": "Jaime"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4705", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "6701", "type": "B"}, {"subject": "PMA", "catalogNbr": "4701", "type": "B"}, {"subject": "PMA", "catalogNbr": "6701", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4701", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course explores nightlife as a temporality that fosters countercultural performances of the self and that serves as a site for the emergence of alternative kinship networks.\u00a0 Focusing on queer communities of color, course participants will be asked to interrogate the ways in which nightlife demonstrates the queer world-making potential that exists beyond the normative 9-5 capitalist model of production. Performances of the everyday,\u00a0alongside films, texts, and performance art, will be analyzed through a performance studies methodological lens.\u00a0 Through close readings and sustained cultural analysis, students will acquire a critical understanding of the potentiality of spaces, places, and geographies codified as \"after hours\" in the development of subcultures, alternative sexualities, and emerging performance practices.", "catalogBreadth": "", "catalogDistr": "(CA-AS, ALC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 366528, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "4876", "titleShort": "Humanitarian Affects", "titleLong": "Humanitarian Affects", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17644, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "02:20PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "sh888", "firstName": "Saida", "middleName": "", "lastName": "Hodzic"}], "pattern": "F", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "4176", "type": "B"}, {"subject": "ANTHR", "catalogNbr": "7176", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4876", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6876", "type": "B"}, {"subject": "GOVT", "catalogNbr": "4745", "type": "B"}, {"subject": "GOVT", "catalogNbr": "6745", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Liberal feminists and political theorists argue that sentiments such as compassion and empathy have the capacity to alert us to suffering, injustice, and oppression, and thus incite transformative political action. This interdisciplinary seminar explores the challenges to this theory by staging a conversation between postcolonial, feminist, and queer theories of affect, and anthropological critiques of humanitarian projects. Sentiments are mobilized to defend borders, wage wars, grant asylum to refugees, provide medical care and disaster relief, and inspire feminist activism. We will analyze how these gendered and racialized ethical projects and political regimes are co-constituted, and how they mediate access to resources and survival, as well as political agency, subjectivity, citizenship, and national belonging.", "catalogBreadth": "(GB)", "catalogDistr": "(CA-AS, GLC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 371311, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "6505", "titleShort": "Queer Proximities", "titleLong": "Queer Proximities", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17905, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "02:20PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "mpb23", "firstName": "Mary Pat", "middleName": "P.", "lastName": "Brady"}], "pattern": "M", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "loca