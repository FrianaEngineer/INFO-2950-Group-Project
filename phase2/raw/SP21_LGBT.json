: "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "By posing seemingly simple questions such as what is love and who has the right to love, this introductory-level lecture course surveys how love has been experienced and expressed from the pre-modern period to the present. Through case studies of familial and conjugal love in Africa, Asia, the US, Europe, and South and Latin America, the course will examine the debates about and enactment's of what constitutes the appropriate way to show love and affection in different cultures and historical contexts. Among the themes we will explore are questions of sexuality, marriage, kinship, and gender rights. A final unit will examine these themes through modern technologies such as the Internet, scientific advances in medicine, and a growing awareness that who and how we love is anything but simple or universal.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SAP)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 363820, "crseOfferNbr": 2, "subject": "LGBT", "catalogNbr": "2290", "titleShort": "Intro to LGBT studies", "titleLong": "Introduction to Lesbian, Gay, Bisexual, and Transgender Studies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 7147, "meetings": [{"classMtgNbr": 1, "timeStart": "11:25AM", "timeEnd": "12:40PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 4, "netid": "mkm23", "firstName": "Kate", "middleName": "", "lastName": "McCullough"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "FGSS", "catalogNbr": "2290", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course offers an introduction to central issues, debates, and theories that characterize the field of Lesbian, Gay, Bisexual, and Transgender (LGBT) Studies. Starting from the assumption that neither \"sex\" nor \"sexuality\" is a private experience or category, we will explore some of the ways that these powerfully public and political terms have circulated in social, legal, economic, and cultural spheres. We will also examine how these categories are situated in relation to other formative categories including race, ethnicity, religion, family, marriage, reproduction, the economy, and the state. Using a comparative and intersectional approach, we will read from various disciplines to assess the tools that LGBT studies offers for understanding power and culture in our contemporary world.", "catalogBreadth":