ype": "C"}, {"subject": "FGSS", "catalogNbr": "2350", "type": "C"}, {"subject": "SHUM", "catalogNbr": "2350", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "How does literary language depict the experience of physical suffering? Can a poem or a novel palliate pain, illness, even the possibility of death? From darkly comic narratives of black plague to the rise and fall of hysteria to depictions of the AIDS crisis, this course examines literature centered on medical practices from the early modern period through the twentieth century. Why have medical practices changed, and how do writers address their political, social, and ideological implications? Readings will include a broad range of genres, including poetry (Dickinson, Whitman, Keats), fiction (McEwan, Chekhov, Gilman, Kafka, Camus), theater (Kushner), nonfiction prose (Woolf, Freud), and critical theory (Foucault, Scarry, Canguilhem, Sontag).", "catalogBreadth": "", "catalogDistr": "(LA-AS, ALC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 352755, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "2760", "titleShort": "Desire", "titleLong": "Desire", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 7395, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "02/08/2021", "endDt": "05/