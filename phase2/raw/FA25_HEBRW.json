 "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/25/2025", "endDt": "12/20/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "JWST", "catalogNbr": "1103", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/25/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Intermediate Modern Hebrew is designed to strengthen students' proficiency in Modern Hebrew by advancing their reading, writing, listening, and conversation skills. The curriculum incorporates Hebrew literature, news articles, Israeli TV series, and cinema, offering a deeper understanding of language, society, and culture. Students will engage with Hebrew literary works, poetry, and media, developing an appreciation for Israeli and Jewish cultural expression. The course also explores the role of language in shaping cultural identity, focusing on historical and social influences. By the end of the course, students will be able to engage in extended conversations in Hebrew, improve reading comprehension and textual analysis, enhance listening skills through authentic Hebrew media, read and understand 500-word passages with minimal assistance, and discuss topics in class while writing a 200-word paragraph with improved grammar. Emphasizing fluency and confidence in communication over rigid grammatical accuracy, the course develops all four language skills while reinforcing grammar and pronunciation through structured materials on diverse topics. The course is designed for students who have completed Hebrew 1102 or have received instructor approval.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "one year of Hebrew or permission of instructor.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 353532, "crseOfferNbr": 1, "subject": "HEBRW", "catalogNbr": "3101", "titleShort": "Advanced Modern Hebrew I", "titleLong": "Advanced Modern Hebrew I", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "EUAREA", "descr": "European Studies Area", "descrformal": "European Studies Area", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "LA-AG", "descr": "AG-Literature & the Arts", "descrformal": "AG-Literature and the Arts", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "ALC-AS", "descr": "AS-Arts, Literat, and Culture", "descrformal": "AS-Arts, Literature, and Culture", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "FLOPI-AS", "descr": "AS-Foreign Language Op