"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This class teaches advanced leadership and coaching skills to Johnson Leadership Fellows as they, in their role as JLFs, guide first-year Core teams. \u00a0Through this course, JLFs will develop skills for team coaching as well as hone personal leadership skills, influencing, effective feedback, listening, conflict resolution, and individual and team resilience skills. \u00a0In addition the course serves as a confidential forum in which to process specific challenges that arise in the Core teams that the JLFs are coaching.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 362020, "crseOfferNbr": 1, "subject": "NMI", "catalogNbr": "5080", "titleShort": "BR Consulting", "titleLong": "BR Consulting", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 13954, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 11, "netid": "rla9", "firstName": "Randy", "middleName": "Lee", "lastName": "Allen"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "By Permission Only.  Please contact Professor Randy Allen at rla9@cornell.edu with questions regarding the application process.\n***GM and Grad Students Only***\nThis course is a Management Science Elective."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 0.5, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "BR Consulting educates students on consulting through work on a project with a local company, non-profit or alumni run small company.\u00a0 The six directors act as the partners of a consulting firm.\u00a0 Through this process they learn the aspects of running a consulting business and how to be a manager or above on a project.\u00a0 There are weekly meetings with the faculty for education, managing the business and reviewing consulting students projects.\u00a0 The student consultants apply in the fall to be a consultant.\u00a0 They take responsibility for finalizing the consulting project, conducting the work and delivering a final recommendation in the spring before graduation.\u00a0 There are six just in time education sessions timed to the specific point in their project.\u00a0 In addition, there a regular meetings with the directors and faculty.\u00a0 The students present their interim findings before winter break. Before they deliver the final presentation, there are multiple reviews and a case competition.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 372049, "crseOfferNbr": 1, "subject": "NMI", "catalogNbr": "5101", "titleShort": "Work Experience", "titleLong": "Work Experience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 19885, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/26/2021", "endDt": "09/25/2021", "instructors": [{"instrAssignSeq": 1, "netid": "sk2922", "firstName": "Sofia", "middleName": "", "lastName": "Kalantzi"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Required graduation requirement"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "09/26/2021", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["IND"], "grading