catalogNbr": "7312", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "7312", "type": "C"}, {"subject": "PMA", "catalogNbr": "7312", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "The voice occupies a peculiar phenomenological position, on one hand emanating from material bodies and conveying that materiality with register, mannerism, grain, and break; on the other hand existing as disembodied sound waves, and an internalized sonorous Other. This course will explore the many cultural and conceptual approaches to the voice and its role in the production of music, language, desire, subjectivity, embodiment, and the human.\u00a0 Students will workshop projects developed within the course or already underway as part of a dissertation, article, performance, or recording.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-01-31T19:14:21-0500", "catalogDttm": "2019-01-31T19:15:35-0500"}}