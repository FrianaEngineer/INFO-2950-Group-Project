n period to the present. Through case studies of familial and conjugal love in Africa, Asia, the US, Europe, and South and Latin America, the course will examine the debates about and enactment's of what constitutes the appropriate way to show love and affection in different cultures and historical contexts. Among the themes we will explore are questions of sexuality, marriage, kinship, and gender rights. A final unit will examine these themes through modern technologies such as the Internet, scientific advances in medicine, and a growing awareness that who and how we love is anything but simple or universal.", "catalogBreadth": "", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 350754, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "2421", "titleShort": "Sex and Gender", "titleLong": "Sex and Gender in Cross-Cultural Perspective", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8483, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 10, "netid": "ler35", "firstName": "Lucinda", "middleName": "E.G.", "lastName": "Ramberg"}], "pattern": "TR", "facilityDescr": "Mcgraw Hall 165", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG165", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "s