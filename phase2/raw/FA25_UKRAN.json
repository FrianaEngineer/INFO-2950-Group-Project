exploreCriteriaIds": []}], "description": "The course starts with a review and subsequent reinforcement of grammar fundamentals and core vocabulary pertaining to the most common aspects of daily life. Principal emphasis is placed on further development of students' communicative skills (oral and written) on such topics as the self, family, studies and leisure, travel, meals and others.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 373805, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "2200", "titleShort": "Understanding Ukraine", "titleLong": "Understanding Ukraine: History, Culture, Language, and the Road to Independence", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 7955, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:00AM", "startDt": "08/25/2025", "endDt": "12/08/2025", "instructors": [{"instrAssignSeq": 1, "netid": "kg463", "firstName": "Krystyna", "middleName": "", "lastName": "Golovakova"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "An organizational meeting will be held during the first week of the semester to schedule the meeting times for this cla