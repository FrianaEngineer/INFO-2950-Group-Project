35", "titleShort": "Chinese Buddhist Texts", "titleLong": "Chinese Buddhist Texts", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16157, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "djb38", "firstName": "Daniel", "middleName": "Joseph", "lastName": "Boucher"}], "pattern": "T", "facilityDescr": "Rockefeller Hall 382", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK382", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: at least one semester of classical Chinese."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This seminar is designed to introduce students to the idiom of Buddhist Chinese.\u00a0 We will start by reading selections from the early translations to gain a grounding in the vocabulary and syntax that came to characterize literary Buddhism in China.\u00a0 From there we will survey\u00a0 some of the so-called apocryphal texts (Buddhist \"sutras\" produced in China) and look at sam