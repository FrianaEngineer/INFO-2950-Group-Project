", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Honors students conduct research to prepare a thesis on a topic of their own choosing under the direction of a faculty member.\u00a0The application must be successfully submitted and an Honors Committee formed by the end of applicant's junior year in order for the student to be an honors candidate. Permission to enroll in CAPS 4020 is contingent upon the advisor's judgement of the viability of the student's honors thesis by the end of the semester.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-UGR)", "catalogWhenOffered": "Fall.", "catalogComments": "Honors applicants must consult with the CAPS Director to select an honors thesis advisor.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: CAPS majors.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 363486, "crseOfferNbr": 2, "subject": "CAPS", "catalogNbr": "4406", "titleShort": "Rdgs in Chin Hst & Bus Culture", "titleLong": "Readings in Chinese History and Business Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8239, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "zc46", "firstName": "Zhihong", "middleName": "", "lastName": "Chen"}], "pattern": "TR", "facilityDescr": "McGraw Hall 365", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG365", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: Two years (on heritage track) or three years of Chinese or equivalent. Permission of instructor required."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "CHIN", "catalogNbr": "4406", "type": "B"}, {"subject": "CHIN", "catalogNbr": "6606", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course is designed for those who have studied Mandarin to the advanced level (or equivalent). The course aims to continuously improve students' Chinese proficiency while, at the same time, preparing them for studying or working in a Chinese native environment. Along with the growth of Chinese economy, issues on Chinese business and economy become a hot topic. Following this trend, authentic Chinese materials selected from a variety of sources will be introduced in class to enhance students' Chinese professional skills and promote their understanding of the macro and micro business environment as well as the economic history, present, and future of China and its partners in the global economy.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComm