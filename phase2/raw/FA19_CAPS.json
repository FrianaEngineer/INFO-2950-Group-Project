": "B"}, {"subject": "GOVT", "catalogNbr": "4827", "type": "B"}, {"subject": "GOVT", "catalogNbr": "6827", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Seminar intended to examine the increasingly complex relationship that has evolved between China and the rest of the international system,\u00a0with particular focus on the rise of Chinese nationalism and the extent to which those in Tibet, Xinjiang, and, to a lesser extent, Taiwan, are contesting such a trend. In so doing, the course emphasizes the interrelated, yet often contradictory, challenges facing Beijing in regards to the task of furthering the cause of national unity while promoting policies of integration with international society and interdependence with the global economy.", "catalogBreadth": "(GB)", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 364033, "crseOfferNbr": 1, "subject": "CAPS", "catalogNbr": "4888", "titleShort": "Directed Study - Beijing", "titleLong": "Directed Study - Beijing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "670", "classNbr": 7213, "meetings": [{"classMtgNbr": 1, "timeStart": "05:10PM", "timeEnd": "08:30PM", "startDt": "08/30/2019", "endDt": "12/19/2019", "instructors": [], "pattern": "W", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDesc