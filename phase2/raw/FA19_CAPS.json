ington, DC. This is part of the Cornell in Washington program."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "DC", "locationDescr": "Washington, DC", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This required course forms the core of the Cornell in Washington academic program. The foundational skill of both politics and policy is taking knowledge, analyzing it, figuring out how to convert it into action. This course aims to give students the experience and understanding of how this process of knowledge into action works. Students will undertake a substantial research project in a topic related to or affected by politics and/or policy (broadly defined), and examine it through a variety of approaches and disciplines. The main goal is to understand the issue, analyze what is going on, and evaluate what options are available to respond.\u00a0 The idea is to not only define and examine the issue, but also think how to create and implement a solution. To do this, students will examine their issue using multiple different forms of inquiry (normative, empirical, and policy analysis) to see what each of those reveal as well as to see how the choice of how they investigate it shapes their results. CAPS students must do a topic that is related to\u00a0Asia. GPHS students must do a topic that is related to public health.", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 362734, "crseOfferNbr": 1, "subject": "CAPS", "catalogNbr": "4999", "titleShort": "CAPS Independent Study", "titleLong": "CAPS Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 6446, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 4, "netid": "xx12", "firstName": "Xu", "middleName": "", "lastName": "Xin"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/201