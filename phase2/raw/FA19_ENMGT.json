jects were focused on Puerto Rico post Hurricane Maria. As part of this course, you will work closely with local stakeholders to hear their perspective on prior challenges and future needs. Each subsequent year will then build upon the prior year's activity to tackle large, complex issues over multiple years. During the course, you will contribute to developing a library of monitoring tools and algorithms which will persist over time and then be applied to solve new challenges with each course iteration.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: MEng students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 350653, "crseOfferNbr": 2, "subject": "ENMGT", "catalogNbr": "5900", "titleShort": "Project Management", "titleLong": "Project Management", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 12821, "meetings": [{"classMtgNbr": 1, "timeStart": "08:00AM", "timeEnd": "09:55AM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 3, "netid": "rtn24", "firstName": "Robert", "middleName": "Todd", "lastName": "Newman"}], "pattern": "MW", "facilityDescr": "Bill and Melinda Gates Hll G01", "bldgDescr": "Bill and Melinda Gates Hall", "facilityDescrshort": "GTSG01", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addCon