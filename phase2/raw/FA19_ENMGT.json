": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Evaluate the client's conceptual design providing broad, yet accurate cost appraisals.", "Have a thorough understanding of the interactions and relationships among the participants within the construction process.", "Prepare a comprehensive construction cost estimate for a complex building, including general construction, and specialty contractors.  Develop an understanding of how this estimate is developed and carried forward into the bidding and cost control processes.", "Develop a project schedule from this cost estimate to determine the overall project duration and critical path.", "Confidentially advise a project owner of project delivery options in an ethical and effective manner."], "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 358728, "crseOfferNbr": 2, "subject": "ENMGT", "catalogNbr": "5980", "titleShort": "Intro to Decision Analysis", "titleLong": "Introduction to Decision Analysis", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 12819, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "pmr82", "firstName": "Patrick", "middleName": "Michael", "lastName": "Reed"}], "pattern": "TR", "facilityDescr": "Hollister Hall 110", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Cam