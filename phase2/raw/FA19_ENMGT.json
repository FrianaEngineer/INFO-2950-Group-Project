sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course is focused on learning how high-technology ideas are converted into world-class businesses in venture-backed startup companies as well as in new business development in existing companies. Work is focused on a single project: students form a startup team and follow a technical business idea of their own choosing through the process of developing and founding a business. Tutorial sessions with professors apply lessons to the team business model. Traditionally, this course is composed of STEM graduate students, such as Master of Engineering students.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate students or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 370444, "crseOfferNbr": 1, "subject": "ENMGT", "catalogNbr": "6020", "titleShort": "Managing Culture of Innovation", "titleLong": "Managing a Culture of Innovation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17722, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}], "pattern": "TR", "facilityDescr": "Hollister Hall 202", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS202", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Innovation is not just ideas, but getting ideas to measurable impact for your customers or employees. While the word \"innovation\" is pervasive throughout engineering and business, developing and managing a culture of innovation has only been mastered by few organizations. In fact, no company has remained on the Dow Jones Industrial Average since its inception. Why? Because implementing a culture of innovation is very difficult and is mired by a lack of understanding of proven innovation strategies, competencies, and tools. In this course, you will learn a systematic approach for developing and managing a culture of innovation. You will learn how to develop an innovation strategy to better meet your organizations goals and customer needs. In addition, we will take time to dive into innovation competencies, such as design thinking, lean start-up, and making, along with learn several innovation tools including hackathons, open innovation challenges and competitions, and corporate venture arms. Lastly, we will discuss how to implement and scale your innovation strategies to deliver impact for your customers and organization.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate standing with engineering undergraduate degree. Seniors with permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 369939, "crseOfferNbr": 1, "subject": "ENMGT", "catalogNbr": "6090", "titleShort": "Professional Leadership Sem", "titleLong": "Professional and Leadership Development Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 12890, "meetings": [{"classMtgNbr": 1, "timeStart": "04:30PM", "timeEnd": "05:30PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}, {"instrAssignSeq": 2, "netid": "rtn24", "firstName": "Robert", "middleName": "Todd", "lastName": "Newman"}], "pattern": "M", "facilityDescr": "Upson Hall 216", "bldgDescr": "Upson Hall", "facilityDescrshort": "UPS216", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "explore