iption": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4575", "type": "B"}, {"subject": "COML", "catalogNbr": "6375", "type": "B"}, {"subject": "DSOC", "catalogNbr": "4312", "type": "B"}, {"subject": "DSOC", "catalogNbr": "6312", "type": "B"}, {"subject": "ILRIC", "catalogNbr": "6312", "type": "B"}, {"subject": "LSP", "catalogNbr": "4312", "type": "B"}, {"subject": "LSP", "catalogNbr": "6312", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course will introduce students to basic concepts and developments related to\u00a0migrants and\u00a0migration in Central America, Mexico, and the United States via engaged learning and research. The course will be organized around core themes such as the challenges and ethics of working with vulnerable populations, workplaces and working conditions, oral histories/testimonios, and immigration policy and enforcement practices. Students will learn qualitative methodologies for field research.\u00a0 All students will practice their skills through collaboration with the Cornell Farmworker Program on priority projects identified by immigrant farmworkers.\u00a0 This can be taken as a stand-alone course, but it is also a prerequisite for an optional winter intersession practicum, and for ILRIC 6311/LSP 6110 in the Spring.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "Co-meets with COML 6375/DSOC 6312/ILRIC 6312/LSP 6312.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: juniors, seniors, and graduate students.\u00a0 Permission of instructor required.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 367320, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4325", "titleShort": "The European Social Model", "titleLong": "The European Social Model", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14552, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "vld7", "firstName": "Virginia", "middleName": "L", "lastName": "Doellgast"}], "pattern": "TR", "facilityDescr": "Ives Hall 108", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS108", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ILRIC", "catalogNbr": "6325", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course examines the past and future of the \"European Social Model.\"\u00a0\u00a0Europe has long been known for its strong labor unions and social regulation of labor markets. We will ask to what extent these traditions have been maintained or transformed in the face of market liberalization and integration within the European Union. \u00a0The class is organized in three parts. In part one, we will discuss the history of, and recent changes in, different national models within Europe, including Germany, the Nordic countries, and France. In part two, we will compare major areas of labor market policy across European countries, including pay, parental leave, gender quotas, employment protection, and working time flexibility. In part three, we will examine the process and politics of European integration in the European Union (EU), including extension into Central and Eastern European countries and migration within Europe. The class will conclude with a discussion of present challenges facing the EU: crisis and austerity in Greece; the UK's pending 'Brexit' from the EU; and growing popular support for Far Right political parties.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Co-meets with ILRIC 6325.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 364423, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4340", "titleShort": "Special Topics in ICL", "titleLong": "Special Topics in International and Comparative Labor", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 15089, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/23/2018", "endDt": "10/12/2018", "instructors": [{"instrAssignSeq": 1, "netid": "rb655", "firstName": "Balu", "middleName": "", "lastName": "Balasubramaniam"}], "pattern": "TR", "facilityDescr": "Ives Hall 112", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS112", "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "The predominant and narrow view that development equates to growth in income, expansion of infrastructure and rise in the standard of living is no longer seen as comprehensive or adequate. The World is also coming to terms with the inadequacy of mere economic growth and is struggling to find a development paradigm that is pragmatic to implement while ensuring sustainability at the same time. This course is about exploring an alternate development paradigm that draws lessons and inspiration from success stories across the world.   It is built on the capability approach that many development economists are increasingly subscribing to and will help the student understand how building human and social capital will result in economic consequences."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "10/12/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "An Alternate Paradigm of Sustainable Development", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "7W1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "10/12/2018", "sessionLong": "Seven Week - First", "exploreCriteriaIds": null}], "description": "Devoted to new topics in the field. The specific content and emphasis vary depending upon the interests of the faculty member teaching the course.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 364526, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4344", "titleShort": "International Labor Law", "titleLong": "International Labor Law", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14681, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "lac24", "firstName": "Lance", "middleName": "", "lastName": "Compa"}], "pattern": "TR", "facilityDescr": "Ives Hall 217", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS217", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ILRIC", "catalogNbr": "6344", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Examines labor rights and labor standards in a world economy regulated by bilateral and multilateral trade agreements, in a context of sharp competition among countries and firms. Readings and discussions focus on the intersections of labor, human rights, and international trade law and policy in this new global economic context. A prior course in a related topic may be helpful but is not required-the first classes are meant to establish a foundation in each area. While the role of law is a unifying theme, the course is more policy-oriented than legalistic. After the introductory classes on labor rights, human rights, and trade, the focus turns to a series of topics that reflect the links between labor rights and trade, followed by thematic treatment of migrant workers, women workers, and child labor.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "Co-meets with ILRIC 6344.", "catalogPrereqCoreq": "Prerequisite: ILRLR 2010.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 364426, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4360", "titleShort": "Global Comparative Disability", "titleLong": "Global Comparative Disability Policy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14496, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "10:00PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 2, "netid": "tpg3", "firstName": "Thomas", "middleName": "P.", "lastName": "Golden"}, {"instrAssignSeq": 6, "netid": "mcs378", "firstName": "Matthew", "middleName": "C", "lastName": "Saleh"}], "pattern": "M", "facilityDescr": "Ives Hall 305", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS305", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Globalization is having a significant impact on international disability policy, as well as on the empowerment of grassroots disability movements in countries around the world. This course will provide an overview of international public policies on disability; focusing on the employment and human rights of people with disabilities. Students will be introduced to the United Nations Convention on the Rights of Persons with Disabilities, and provided an in-depth comparative policy analysis of current and emerging disability and employment policy from around the world. The instructor will provide an initial framework for comparative analysis of public policy, which will be used to guide student analyses throughout the course. Class lectures will be supplemented with presentations by experts from each country that will outline the evolution of country-specific disability policies and discuss how these policies have translated to practice.\u00a0 Students will also learn how various countries evaluate the impact of these policies in achieving specific outcomes. Experientially based methods will be used to maximize learning outcomes, including identification and discussion of current events shaping international disability policy; and weighing the merits of specific policies in different parts of the world/countries, designed to directly address disability discrimination and enhance labor market participation of individuals with disabilities.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 362572, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "6010", "titleShort": "Crossing Borders:Migrations in", "titleLong": "Crossing Borders: Migrations in Comparative Perspective", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16561, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "mlc13", "firstName": "Maria", "middleName": "Lorena", "lastName": "Cook"}], "pattern": "TR", "facilityDescr": "Ives Hall 103", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS103", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "LATA", "catalogNbr": "6210", "type": "C"}, {"subject": "LSP", "catalogNbr": "6010", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This seminar will examine the links between globalization and migration and explore the character and dimensions of \"unauthorized\" migration in several regions of the world. Drawing on cases from Europe, Africa, Asia, North America, Latin America, and Australia, we will consider some of the recent theories, debates, and empirical developments relating to such issues as border controls, migration and human rights, development and migration, the role of states, asylum and refugee protection, and politics and citizenship.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 368930, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "6312", "titleShort": "Migration in the Americas", "titleLong": "Migration in the Americas: Engaged Research Methods and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14686, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 5, "netid": "dac9", "firstName": "Debra", "middleName": "Ann", "lastName": "Castillo"}, {"instrAssignSeq": 1, "netid": "mlc13", "firstName": "Maria", "middleName": "Lorena", "lastName": "Cook"}], "pattern": "TR", "facilityDescr": "Ives Hall 103", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS103", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4575", "type": "B"}, {"subject": "COML", "catalogNbr": "6375", "type": "B"}, {"subject": "DSOC", "catalogNbr": "4312", "type": "B"}, {"subject": "DSOC", "catalogNbr": "6312", "type": "B"}, {"subject": "ILRIC", "catalogNbr": "4312", "type": "B"}, {"subject": "LSP", "catalogNbr": "4312", "type": "B"}, {"subject": "LSP", "catalogNbr": "6312", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course will introduce students to basic concepts and developments related to\u00a0migrants and\u00a0migration in Central America, Mexico, and the United States via engaged learning and research. The course will be organized around core themes such as the challenges and ethics of working with vulnerable populations, workplaces and working conditions, oral histories/testimonios, and immigration policy and enforcement practices. Students will learn qualitative methodologies for field research. All students will practice their skills through collaboration with the Cornell Farmworker Program on priority projects identified by immigrant farmworkers.\u00a0 This can be taken as a stand-alone course, but it is also a prerequisite for an optional winter intersession practicum and for ILRIC 6311/LSP6110 in the Spring.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "Co-meets with COML 4575/DSOC 4312/ILRIC 4312/LSP 4312.\u00a0", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: juniors, seniors, and graduate students.\u00a0 Permission of instructor required.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 367321, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "6325", "titleShort": "The European Social Model", "titleLong": "The European Social Model", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14553, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "vld7", "firstName": "Virginia", "middleName": "L", "lastName": "Doellgast"}], "pattern": "TR", "facilityDescr": "Ives Hall 108", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS108", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Please see http://www.ilr.cornell.edu/academics/ilr-class-enrollment-and-course-information for an updated course description."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ILRIC", "catalogNbr": "4325", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course examines the past and future of the \"European Social Model\". \u00a0Europe has long been known for its strong labor unions and social regulation of labor markets. We will ask to what extent these traditions have been maintained or transformed in the face of market liberalization and integration within the European Union. \u00a0The class is organized in three parts. In part one, we will discuss the history of, and recent changes in, different national models within Europe, including Germany, the Nordic countries, and France. In part two, we will compare major areas of labor market policy across European countries, including pay, parental leave, gender quotas, employment protection, and working time flexibility. In part three, we will examine the process and politics of European integration in the European Union (EU), including extension into Central and Eastern European countries and migration within Europe. The class will conclude with a discussion of present challenges facing the EU: crisis and austerity in Greece; the UK's pending 'Brexit' from the EU; and growing popular support for Far Right political parties.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Co-meets with ILRIC 4325.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 361125, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "6344", "titleShort": "International Labor Law", "titleLong": "International Labor Law", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14682, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "lac24", "firstName": "Lance", "middleName": "", "lastName": "Compa"}], "pattern": "TR", "facilityDescr": "Ives Hall 217", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS217", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ILRIC", "catalogNbr": "4344", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Examines labor rights and labor standards in a world economy regulated by bilateral and multilateral trade agreements, in a context of sharp competition among countries and firms. Readings and discussions focus on the intersections of labor, human rights, and international trade law and policy in this new global economic context. A prior course in a related topic may be helpful but is not required-the first classes are meant to establish a foundation in each area. While the role of law is a unifying theme, the course is more policy-oriented than legalistic. After the introductory classes on labor rights, human rights, and trade, the focus turns to a series of topics that reflect the links between labor rights and trade, followed by thematic treatment of migrant workers, women workers, and child labor.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "Co-meets with\u00a0ILRIC 4344.", "catalogPrereqCoreq": "Prerequisite: ILRLR 5010.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 368218, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "9800", "titleShort": "Workshop in ICL", "titleLong": "Workshop in International and Comparative Labor", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 14634, "meetings": [{"classMtgNbr": 1, "timeStart": "12:15PM", "timeEnd": "01:45PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "rka45", "firstName": "Rachel", "middleName": "K", "lastName": "Aleks"}], "pattern": "W", "facilityDescr": "Ives Hall 381", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS381", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [{"subject": "ILRLR", "catalogNbr": "9800", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Provides a forum for the presentation of current research being undertaken by faculty members and graduate students in the Department of International and Comparative Labor, and by invited guests. All M.S. and Ph.D. candidates in the department who are at work on their theses are strongly urged to enroll. Students are encouraged to make presentations focusing on the formulation, design, execution, and results of their thesis research.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "Co-meets with ILRLR 9800.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-01-31T19:14:21-0500", "catalogDttm": "2019-01-31T19:15:35-0500"}}