ionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 20832, "meetings": [{"classMtgNbr": 1, "timeStart": "08:00AM", "timeEnd": "09:15AM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "ksk28", "firstName": "Karim-Aly", "middleName": "Saleh", "lastName": "Kassam"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3330", "type": "B"}, {"subject": "NTRES", "catalogNbr": "3330", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Based on indigenous and place-based \"ways of knowing,\" this course (1) presents a theoretical and humanistic framework from which to understand generation of ecological knowledge; (2) examines processes by which to engage indigenous and place-based knowledge of natural resources, the nonhuman environment, and human-environment interactions; and (3) reflects upon the relevance of this knowledge to climatic change, resource extraction, food sovereignty, medicinal plant biodiversity, and issues of sustainability and conservation.\u00a0 The fundamental premise of this course is that human beings are embedded in their ecological systems.", "catalogBreadth": "", "catalogDistr": "(CA-AG, D-AG, KCM-AG, SBA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL, CU-SBY)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: juniors, seniors, or graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": ["To appreciate natural resource development from a human ecological perspective;", "To apply the interdisciplinary lens of human ecology to understand human and environmental relations;", "To appreciate the complex interconnectivity between the ecological and the cultural;", "To comprehend that individual actions informed by cultural systems manifest themselves in social structures that rely on ecological foundations;", "To extend the notion of transdisciplinary to include indigenous and place-based knowledge;", "To situate indigenous and local knowledge within a humanistic framework of knowledge generation;", "To illustrate the participatory and experiential basis of indigenous and place-based knowledge;", "To propose a method best suited for researching such knowledge processes; and", "To value the contributions of indigenous and place-based knowledge in the context of socio-cultural and environmental change and natural resource utilization."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 369574, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "4300", "titleShort": "Indigeneity and Decolonization", "titleLong": "Indigenous Peoples and Decolonial Philosophies", "crseAttrs": [], "crseAttrVal