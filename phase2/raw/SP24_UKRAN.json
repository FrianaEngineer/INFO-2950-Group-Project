ar culture, and its current place in Europe and the world.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Students with no previous study of Ukrainian language or culture are welcome, as are those who learned something about Ukraine in their family or community. The credit hour of this course does not count towards the Arts College language requirement.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 370789, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "1122", "titleShort": "Elementary Ukrainian II", "titleLong": "Elementary Ukrainian II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5985, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:00AM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 7, "netid": "kg463", "firstName": "Krystyna", "middleName": "", "lastName": "Golovakova"}], "pattern": "M", "facilityDescr": "Klarman Hall K213", "bldgDescr": "Klarman Hall", "facilityDescrshort": "KLRK213", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 7, "netid": "kg463", "firstName": "Krystyna", "middleName": "", "lastName": "Golovakova"}], "pattern": "T", "facilityDescr": "Klarman Hall K213", "bldgDescr": "Klarman Hall", "facilityDescrshort": "KLRK213", "meetingTopicDescription": ""}, {"classMtgNbr": 3, "timeStart": "04:40PM", "timeEnd": "05:30