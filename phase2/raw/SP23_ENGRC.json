023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "As students develop mobile video games in large teams, they will concurrently be writing documentation to a variety of audiences for a myriad of technical, business, and design needs. Together, students in their teams will write workflow documents, specifications, planning, marketing, video scripting, and project management pieces that have the specific task of always moving the team's work forward. The communication tasks are not extras; rather, they are integral to the game dev process. Iterations and deep revising will be part of this process, with inputs from both the CS instructor and the communication instructor. As well, students will hone their skills for team stand-up presentations.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Corequisite: CS 4152\u00a0or INFO 4152.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Satisfies the College of Engineering's engineering communication requirement.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 372382, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "5152", "titleShort": "Comm Strategies for Games", "titleLong": "Communication Strategies for Games Management and Creation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 20058, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [], "pattern": "", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ENGRC", "catalogNbr": "4152", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "As students develop mobile video games in large teams, graduate level students will concurrently be spearheading project management and communication efforts, often with a co-leader. These tasks will be accompanied by specialized training. As active parts of their team, participants will be writing documentation to a variety of audiences for a myriad of technical, business, and design needs. Together, students in their teams will write workflow documents, specifications, planning, marketing, video scripting, and project management pieces that have the specific task of always moving the team's work forward. The communication tasks are not extras; rather, they are integral to the game dev process. Iterations and deep revising will be part of this process, with inputs from both the CS instructor and the communication instructor. As well, students will hone their skills for team stand-up presentations.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Corequisite: CS 5152\u00a0or INFO 5152.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to plan, write, revise, and hone written documentation that forwards the team's identified goals for coordinated coding, design, and implementation of a working game.", "Students will be able to demonstrate prowess with project management and the communication strategies for equitable, distributed, and iterative development of a finalized project.", "Students will be able to exhibit qualities of team leadership including conflict resolution, coordinated planning with a co-leader, communication to sub-teams and instructors/TAs, timely execution of planning elements, and--at times--quality control of assignments."], "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2023-06-07T20:54:13-0400", "catalogDttm": "2023-06-07T19:14:05-0400"}}