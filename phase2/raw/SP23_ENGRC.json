: "Prerequisite: two First-Year Writing Seminars and major affiliation.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Satisfies the College of Engineering's engineering communication requirement. This course also fulfills a liberal studies requirement.", "catalogPermission": "Enrollment limited to: EN and BEE seniors or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 370116, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3610", "titleShort": "Comm for Transportation Eng", "titleLong": "Communication for Transportation Engineering", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9661, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "01:15PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 5, "netid": "abh98", "firstName": "Allison", "middleName": "", "lastName": "Hutchison"}], "pattern": "W", "facilityDescr": "Hollister Hall 314", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS314", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Permission Note: Enrollment is limited to: CE Undergraduates during pre-enroll."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "