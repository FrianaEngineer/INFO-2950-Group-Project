/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The goal of this course is to give students the foundational skills necessary to conduct scientific research in the field of organizational behavior. Topics covered will include generating research ideas, ethical considerations, common experimental and non-experimental designs, creating surveys and other measures, interpreting results, and writing research papers. Students will be asked to conduct their own research projects as part of the class. This course focuses on methods from psychology and related disciplines and is recommended for students considering doing honors thesis research.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0ILRST 2100\u00a0or comparable statistics.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 355591, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "7220", "titleShort": "Macro Organizational Behavior", "titleLong": "Macro Organizational Behavior Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17099, "meetings": [{"classMtgNbr": 1, "timeStart": "11:20AM", "timeEnd": "01:50PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "bb686", "firstName": "Brittany", "middleName": "M.", "lastName": "Bond"}], "pattern": "M", "facilityDescr": "Ives Hall 103", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS103", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This doctoral seminar is designed to provide you with an overview of major theoretical traditions in the field of macro-Organizational Behavior. We will examine the historical development of sociological theories of organizations and contemporary issues in macro organizational research. The readings are organized in a semi-chronological fashion \u2013 we start with older, established classics and move into more contemporary lines of work.  This course heavily emphasizes reading and analysis of primary source material. Students will be expected to lead a discussion class as well as submit a final written research proposal due at the end of the semester. The goal will be to convert our consumption of scholarship into production of robust research."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This doctoral seminar is designed to provide you with an overview of major theoretical traditions in the field of macro-Organizational Behavior. We will examine the historical development of sociological theories of organizations and contemporary issues in macro organizational research. The readings are organized in a semi-chronological fashion \u2013 we start with older, established classics and move into more contemporary lines of work.\u00a0 This course heavily emphasizes reading and analysis of primary source material. Students will be expected to lead a discussion class as well as submit a final written research proposal due at the end of the semester. The goal will be to convert our consumption of scholarship into production of robust research.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate students pursuing a MS or PhD degree. All others by permission of the\u00a0Instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 365303, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "7235", "titleShort": "Data Analysis in Practice", "titleLong": "Data Analysis in Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17830, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "04:30PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "emz34", "firstName": "Emily", "middleName": "M.", "lastName": "Zitek"}], "pattern": "W", "facilityDescr": "Ives Hall 109", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS109", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The goal of this course is to expose students to common data analysis methods used in social science research. Topics covered will include t-tests, one-way ANOVA, factorial ANOVA, regression, mediation, repeated-measures ANOVA, mixed models analysis, non-parametric tests, reliability theory, factor analysis, power, and meta-analysis. Students will learn how to conduct these analyses on statistical computing packages, how to choose the right analysis to answer a practical research question, and how to report the results of the analyses. This course is designed for doctoral students.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRST 5100\u00a0or comparable statistics.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 355616, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "9200", "titleShort": "Organizl Behavr Workshop", "titleLong": "Organizational Behavior Workshop", "c