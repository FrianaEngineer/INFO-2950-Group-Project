{"status": "success", "data": {"classes": [{"strm": 2769, "crseId": 351002, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "2100", "titleShort": "South Asian Diaspora", "titleLong": "South Asian Diaspora", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 7065, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "04:15PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "vpm1", "firstName": "Viranjini", "middleName": "P.", "lastName": "Munasinghe"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "2410", "type": "C"}, {"subject": "SHUM", "catalogNbr": "2101", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This interdisciplinary course (with an emphasis in anthropology) will introduce students to the multiple routes/roots, lived experiences, and imagined worlds of South Asians who have traveled to various lands at different historical moments spanning Fiji, South Africa, Mauritius, Britain, Malaysia, United States, Trinidad, and even within South Asia itself such as the Tamil-speaking population of Sri Lanka. The course will begin with the labor migrations of the 1830s and continue up to the present period. The primary exercise will be to compare and contrast the varied expressions of the South Asian Diaspora globally in order to critically evaluate this transnational identity. Thus, we will ask what, if any, are the ties that bind a fifth-generation Indo-Trinidadian whose ancestor came to the New World as an indentured laborer or \"coolie\" in the mid-19th century to labor in the cane fields, to a Pakistani medical doctor who migrated to the United States in the late 1980s. If Diaspora violates a sense of identity based on territorial integrity, then could \"culture\" serve as the basis for a shared identity?", "catalogBreadth": "(GHB)", "catalogDistr": "(CA-AS, ALC-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL, EC-SAP)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 352628, "crseOfferNbr": 2, "subject": "AAS", "catalogNbr": "2130", "titleShort": "Intro To Asian American Hist", "titleLong": "Introduction to Asian American History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 7434, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "12:45PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "dsc37", "firstName": "Derek", "middleName": "S.", "lastName": "Chang"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2640", "type": "C"}, {"subject": "HIST", "catalogNbr": "2640", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "An introductory history of Chinese, Japanese, Asian Indians, Filipinos, and Koreans in the United States from the mid-nineteenth century to the 1990s. Major themes include racism and resistance, labor migration, community formation, imperialism, and struggles for equality.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 370293, "crseOfferNbr": 4, "subject": "AAS", "catalogNbr": "3312", "titleShort": "Afro-Asia: Futurism & Feminism", "titleLong": "Afro-Asia: Futurism and Feminism", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8574, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "04:15PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 6, "netid": "tlg92", "firstName": "Tao", "middleName": "Leigh", "lastName": "Goffe"}], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "3310", "type": "B"}, {"subject": "ASRC", "catalogNbr": "6610", "type": "B"}, {"subject": "COML", "catalogNbr": "3310", "type": "B"}, {"subject": "FGSS", "catalogNbr": "3310", "type": "B"}, {"subject": "LGBT", "catalogNbr": "3310", "type": "B"}, {"subject": "SHUM", "catalogNbr": "3310", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course explores cultural representations of Afro-Asian intimacies and coalition in novels, songs, films, paintings, and poems. What affinities, loves and thefts, and tensions are present in cultural forms such as anime, jazz, kung fu, and K-pop? Students will consider the intersections and overlap between African and Asian diasporic cultures in global cities such as New York, Chicago, Havana, Lahore, Kingston, and Hong Kong to ask the question: when did Africa and Asia first encounter each other? This will be contextualized through a political and historical lens of the formation of a proto-Global South in the early twentieth, Afro-futurism, women of color feminisms, and Third World solidarity and internationalism. Tackling issues of race, gender, sexuality, and resistance, this seminar also reckons with the intertwined legacies of the institutions of African enslavement and Asian indenture by reading the novels of Patricia Powell and the paintings of Kehinde Wiley, for instance. Students will work in groups to produce Afro-Asia DJ visual soundtracks as part of the final project.", "catalogBreadth": "(GB)", "catalogDistr": "(LA-AS, GLC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 371102, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "4040", "titleShort": "Fictions of Dictatorship", "titleLong": "Fictions of Dictatorship", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18474, "meetings": [{"classMtgNbr": 1, "timeStart": "03:15PM", "timeEnd": "05:40PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "cbb84", "firstName": "Christine", "middleName": "Bacareza", "lastName": "Balance"}], "pattern": "R", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4040", "type": "C"}, {"subject": "COML", "catalogNbr": "4040", "type": "C"}, {"subject": "PMA", "catalogNbr": "4740", "type": "C"}, {"subject": "SHUM", "catalogNbr": "4040", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Fictions of dictatorship, as termed by scholar Lucy Burns, denote both the narratives and spectacles produced by authoritarian governments and the performances, events, and cultural objects that work against these states of exception. This course will critically examine histories of dictatorships, through both documentary &amp; creative forms (i.e. novels, memoirs, and performance) and with a geographic focus on Asia and Latin America, in order to understand authoritarian returns in our present historical moment.", "catalogBreadth": "(GB)", "catalogDistr": "(LA-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 370667, "crseOfferNbr": 4, "subject": "AAS", "catalogNbr": "4123", "titleShort": "Archipelagoes", "titleLong": "Archipelagoes: Cartographies of Race, Sound, and Sexuality", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17960, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "01:55PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "tlg92", "firstName": "Tao", "middleName": "Leigh", "lastName": "Goffe"}], "pattern": "M", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4123", "type": "B"}, {"subject": "ASRC", "catalogNbr": "4123", "type": "B"}, {"subject": "ENGL", "catalogNbr": "4923", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4123", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6123", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4123", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Considering the archipelagic turn, this course takes a transnational approach to geographies, ecologies, literatures, and cultures of island chains. How are archipelagoes understood in relations of power to the mainland? Taking up Michelle Stephens and Brian Roberts \"Archipelagic American Studies\" students will depart from the conventional and continental definition of the United States and center a hemispheric approach to the Americas. Students will also consider the soundscapes of island cartographies and how gender and sexuality is mapped onto the land. How do island formations provide a framework for understanding militarization, Indigenous sovereignty, creolization, extractive capitalism, and imperialism? Archival analysis as well as experimentation with digital cartography and DJ'ing tools to produce original research theorizing islands will be part of the final project.", "catalogBreadth": "", "catalogDistr": "(CA-AS, ALC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 365712, "crseOfferNbr": 2, "subject": "AAS", "catalogNbr": "4555", "titleShort": "Race and Time", "titleLong": "Race and Time", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16709, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "01:55PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "ssw6", "firstName": "Sunn", "middleName": "Shelley", "lastName": "Wong"}], "pattern": "W", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGL", "catalogNbr": "4550", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Race, comparison, and time\u2014what do these terms have to do with each other? What does it mean to be in time, or out of time? What are some other ways of inhabiting time, or of being inhabited by time? What is the time of the racialized subject? How is time and temporality figured in literature? Some of the writers we'll be reading in the course include Carolivia Herron, Carlos Bulosan, Jamaica Kincaid, Theresa Hak Kyung Cha, and Joy Kogawa. Other readings will be drawn from a range of disciplines, including selections from the work of Johannes Fabian, Frantz Fanon, Dipesh Chakrabarty, Walter Benjamin, Ernst Bloch, Cathy Caruth, Thomas Bender and David Wellbery.", "catalogBreadth": "", "catalogDistr": "(LA-AS, ALC-AS, SCD, AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 351007, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "4950", "titleShort": "Independent Study", "titleLong": "Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 4186, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 3, "netid": "dsc37", "firstName": "Derek", "middleName": "S.", "lastName": "Chang"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}, {