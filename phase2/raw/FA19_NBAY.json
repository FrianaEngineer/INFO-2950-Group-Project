 gap by educating students with the basic data skills that are needed in order to guide an organization to become data-centric and potentially create data products. This course will be held over seven class sessions of double-period length. These classes will be a combination of lectures, discussions, and hands on training with data. The students will build their own predictive model, without the need to directly write code.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: TECH 5310.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Johnson Ithaca &amp; JCT students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 369843, "crseOfferNbr": 1, "subject": "NBAY", "catalogNbr": "6210", "titleShort": "Tech Management", "titleLong": "Technology Management: Cloud Computing & Big Data", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16049, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "05:40PM", "startDt": "09/13/2019", "endDt": "09/13/2019", "instructors": [{"instrAssignSeq": 1, "netid": "jrb553", "firstName": "John (J.B.)", "middleName": "", "lastName": "Blevins"}], "pattern": "F", "facilityDescr": "Bloomberg Center 61", "bldgDescr": "Bloomberg Center", "facilityDescrshort": "BLM61", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "02:30PM", "timeEnd": "05:40PM", "startDt": "10/18/2019", "endDt": "10/18/2019", "instructors": [], "pattern": "F", "facilityDescr": "Bloomberg Center 61", "bldgDescr": "Bloomberg Center", "f