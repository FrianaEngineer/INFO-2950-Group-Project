{"status": "success", "data": {"classes": [{"strm": 2923, "crseId": 361478, "crseOfferNbr": 1, "subject": "VTBMS", "catalogNbr": "7020", "titleShort": "Practice Lab Anim Med", "titleLong": "The Practice of Laboratory Animal Medicine", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2452, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "03:00PM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "jla323", "firstName": "Jenn", "middleName": "", "lastName": "Asher"}], "pattern": "W", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid-Online and In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "A laboratory animal veterinarian must be trained in the regulatory aspects of research and teaching utilizing animals; in addition they must understand the principles of facility management and design. Also, to work with researchers, a lab animal veterinarian must have knowledge of basic research methodologies and animal welfare issues. This course may also be of interest to other veterinarians, veterinary students, and researchers who wish to understand the workings of the specialized field that oversees and enables the use of animals in research and teaching. The topics covered include: Laboratory Animal Medicine: Laws, Regulations, and Policies; Design and Management of Animal Facilities; Anesthesia, Analgesia, and Euthanasia; Techniques of Experimentation; Control of Biohazards used in animal research; Selected zoonoses/xenozoonoses; Genetic monitoring; Transgenic and knock-out mice; Factors influencing animal research; Animal models in biomedical research; Research in Lab Animal and Comparative Medicine; Lab Animal Behavior. The course will meet for 1 hour weekly and will extend over the course of two years, though each term is independent and can be taken separately.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "basic knowledge of anatomy and pathology in comparative animal species.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025FA, 2025SP, 2024FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 361484, "crseOfferNbr": 1, "subject": "VTBMS", "catalogNbr": "7030", "titleShort": "Bio and Disease of Lab Animals", "titleLong": "The Biology and Diseases of Laboratory Animals", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2453, "meetings": [{"classMtgNbr": 1, "timeStart": "03: