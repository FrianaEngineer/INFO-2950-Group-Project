only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Operations Management is the design and management of processes that transform inputs into finished goods or services. All organizations have operations that directly affect their ability to execute on their specified strategies. This course prepares students to think analytically and managerially about operations processes, and to use the tools and intuition they acquire to ensure that the operations in production and service systems support the business strategies for these systems. A process view of operations will be used to analyze different key operational dimensions such as capacity analysis, service operations management, quality management, inventory management and supply chain management.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Similar in content to M.B.A. core course NCC 5080.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: undergraduate seniors and graduate non-Johnson students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-05-19T19:32:44-0400", "catalogDttm": "2024-05-19T19:07:08-0400"}}