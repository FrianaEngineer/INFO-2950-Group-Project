 Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "NCC", "catalogNbr": "4530", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course introduces students to the basic principles of marketing management. The course will familiarize students with all the key concepts in the field, including marketing strategy, marketing analysis (i.e., customer analysis, competitor analysis, and company analysis), and marketing mix (product/ pricing/ advertising and promotion, and distribution). The course will employ a mix of lectures and field-based reading materials to introduce these principles.\u00a0 A major component of the course will focus on case discussions that will provide students an opportunity to apply the marketing principles by critically analyzing real-world marketing scenarios.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "Similar in content to M.B.A. core course NCC 5030. This course can be used to fulfill a core course in the Undergraduate Business Minor.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: non-Johnson Sch