t": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Designed to give insight into how to formulate projects, conduct research, and publish one's work, the colloquium offers a venue for faculty-graduate student dialogue in a collegial, intellectual setting.\u00a0 Meetings are biweekly, 2-3 hours, and are open to all students and faculty in Romance Studies, but required for first year students in the program.\u00a0 Each meeting, two faculty members will be invited to discuss their scholarship and also a short text of their choice, to be distributed beforehand.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 366672, "crseOfferNbr": 2, "subject": "ROMS", "catalogNbr": "6310", "titleShort": "Design Justice Workshop", "titleLong": "Design Justice Workshop", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19242, "meetings": [{"classMtgNbr": 1, "timeStart": "11:20AM", "timeEnd": "01:15PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "kep44", "firstName": "Karen", "middleName": "Elyse", "lastName": "Pinkus"}], "pattern": "R", "facilityDescr": "Sibley Hall 157", "bldgDescr": "Sibley Hall", "facilityDescrshort": "SBL157", "meetingTopicDescription": null}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "Community/Engagement: Methods for Critical Theory", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ARCH", "catalogNbr": "6318", "type": "B"}, {"subject": "ARCH", "catalogNbr": "6418", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6308", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Design Justice Workshops bring students and faculty in the humanities and the design disciplines together around a common and pressing urban issue related to race, social justice, and the urban environment. The intent of the Design Justice Workshop is to study complex urban conditions using theoretical and analytic tools derived in equal part from the design disciplines and humanist studies. The course emphasizes the social reciprocity of learning through faculty and students might advance understanding of race and social justice while also being impacted by both external visitors and the communities with which they interact. The Design Justice Workshop, organized annually around a specific theme and co-taught faculty in A&amp;S and AAP, includes a one-week site visit to experience the conditions under study and meet with local experts, designers, and authorities. Design Justice Workshops are offered under the auspices of Cornell University's Andrew W. Mellon Foundation Collaborative Studies in Architecture, Urbanism, and the Humanities grant. Visit our website for current special topic seminar description and application instructions.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: fellowship recipients who receive a $1500 stipend and a funded, week-long travel program during the semester.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 368458, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "6650", "titleShort": "Revolution:Intellectual Histor", "titleLong": "Revolution: An Intellectual History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19270, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "vt225", "firstName": "Enzo", "middleName": "", "lastName": "Traverso"}], "pattern": "W", "facilityDescr": "Rockefeller Hall 105", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK105", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "HIST", "catalogNbr": "6655", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "For more than two centuries, revolutions have marked the rhythm of modernity. In 1780, the original meaning of revolution - an astronomical rotation - was transformed in order to apprehend a social and political overthrow. This course will investigate the multiple uses of this crucial concept of political theory, from the revolutionary canon (Blanqui, Marx, Fanon...) to the classics of conservatism (Maistre, Cort\u00e9s, Schmitt...), which depict contemporary history as a conflict between revolutions and counter-revolutions, socialist and fascist revolutions. We will explore the connections between history and theory, and stress the global dimension of revolutions, forged by a permanent transfer of ideas and people from one continent to another.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Conducted in English.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2023-04-13T14:00:07-0400", "catalogDttm": "2023-04-12T19:14:04-0400"}}