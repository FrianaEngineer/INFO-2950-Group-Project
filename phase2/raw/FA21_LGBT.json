iteriaIds": []}], "description": "In this course we will examine LGBTQ+ history in the United States with a focus on its recovery and public representation\u2014what are the stakes of researching, preserving, and commemorating the LGBTQ+ past? We will investigate how archival, scholarly, curatorial, and creative practices shape popular conceptions of LGBTQ+ life, politics, and culture, and how those practices and conceptions have changed with evolving understandings of race, gender, sexuality, and oppression. Students will build skills in archival research and historical interpretation and explore possibilities and challenges in building archives and presenting LGBTQ+ history in a variety of public contexts\u2014museums, libraries, monuments, movies and television, and community-based oral history projects. For their final project, students will locate and research a selection of archival materials (periodicals, letters, pamphlets, songs, advertisements, etc.) either online or at Cornell Library's Rare and Manuscript Collections, producing a final research paper and a proposal for a public history project.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 367227, "crseOfferNbr": 6, "subject": "LGBT", "catalogNbr": "3754", "titleShort": "Spoken Word, Hip-Hop Theater", "titleLong": "Spoken Word, Hip-Hop Theater, and the Politics of Performance", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "secti