", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: one semester of Introductory Animal Physiology (BIOAP 1100, BIOG 1440, BIOG 1445\u00a0or equivalent), or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Characterize various physiological systems that fish use to live in an aquatic environment.", "Describe how these systems adjust to environmental changes in the short and long term Explain physiological differences between groups of fishes.", "Explain how physiological systems in fish may be similar to, differ from, or have evolved into those in terrestrial vertebrates.", "Discuss how unsustainable resource management and human perturbations in the environment affect fish at the physiological level."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 352533, "crseOfferNbr": 1, "subject": "BIOAP", "catalogNbr": "4130", "titleShort": "Histology", "titleLong": "Histology: The Biology of the Tissues", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1922, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "02:20PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 5, "netid": "kvs9", "firstName": "Keila", "middleName": "V.", "lastName": "Dhondt"}], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: BIOMG 1350. Recommended prerequisite: BIOMG 3300 or BIOMG 3310, or equivalent."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/202