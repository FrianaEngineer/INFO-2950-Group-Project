ells and tissues.", "catalogBreadth": "", "catalogDistr": "(PBS-AS, BIO-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIOMG 1350. Recommended prerequisite: BIOMG 3300\u00a0and BIOMG 3310, or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will understand cellular organization and the functions of vertebrate organ and tissues.", "Students will understand the correlation between cellular composition and tissue function."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 366718, "crseOfferNbr": 1, "subject": "BIOAP", "catalogNbr": "4140", "titleShort": "Pharmacology", "titleLong": "Principles of Pharmacology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2331, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "02:20PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 3, "netid": "mel237", "firstName": "Maurine", "middleName": "E.", "lastName": "Linder"}, {"instrAssignSeq": 1, "netid": "gaw2", "firstName": "Gregory", "middleName": "A.", "lastName": "Weiland"}], "pattern": "MWF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisites: Animal Physiology (BIOAP 3110) or Human Anatomy and Physiology (NS 3410)."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Speci