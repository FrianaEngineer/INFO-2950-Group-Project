": 2783, "crseId": 371461, "crseOfferNbr": 1, "subject": "ILRID", "catalogNbr": "4431", "titleShort": "Fundrasng/Grantmaking&Lobbying", "titleLong": "Fundraising, Grantmaking, and Lobbying", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19349, "meetings": [{"classMtgNbr": 1, "timeStart": "08:05AM", "timeEnd": "09:20AM", "startDt": "02/08/2021", "endDt": "03/26/2021", "instructors": [{"instrAssignSeq": 1, "netid": "jeg68", "firstName": "Joe", "middleName": "", "lastName": "Grasso"}], "pattern": "MW", "facilityDescr": "Ives Hall 217", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS217", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 2, "descrlong": "This course is designed for students considering a career in the non-profit sector.  It will provide an overview of philanthropy, specific giving vehicles (annual fund, major gifts, capital gifts, deferred gifts, etc.), capital campaigns, grant writing, working with private foundations and community foundations, and crowdfunding techniques.  At the completion of the course students will have a strong working knowledge of key principles and techniques of fundraising and a familiarity with gift vehicles and instruments."}, {"classNotesSeq": 1, "descrlong": "Enrollment limited to students who are able to attend in-person classes in the Ithaca area."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "03/26/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid-Online and In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ILRID", "catalogNbr": "6431", "type": "B"}, {"subject": "PADM", "catalogNbr": "5431", "type": "B"}], "sessionCode": "7W1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "03/26/2021", "sessionLong": "Seven Week - First", "exploreCriteriaIds": null}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 20686, "meetings": [{"classMtgNbr": 1, "timeStart": "08:05AM", "timeEnd": "09:20AM", "startDt": "02/08/2021", "endDt": "03/26/2021", "instructors": [{"instrAssignSeq": 1, "netid": "jeg68", "firstName": "Joe", "middleName": "", "lastName": "Grasso"}], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 2, "descrlong": "This course is designed for students considering a career in the non-profit sector.  It will provide an overview of philanthropy, specific giving vehicles (annual fund, major gifts, capital gifts, deferred gifts, etc.), capital campaigns, grant writing, working with private foundations and community foundations, and crowdfunding techniques.  At the completion of the course students will have a strong working knowledge of key principles and techniques of fundraising and a familiarity with gift vehicles and instruments."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "03/26/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ILRID", "catalogNbr": "6431", "type": "B"}, {"subject": "PADM", "catalogNbr": "5431", "type": "B"}], "sessionCode": "7W1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "03/26/2021", "sessionLong": "Seven Week - First", "exploreCriteriaIds": null}], "description": null, "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 371519, "crseOfferNbr": 1, "subject": "ILRID", "catalogNbr": "4675", "titleShort": "Inclusive Leadership", "titleLong": "Inclusive Leadership", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20726, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "03/29/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "skk86", "firstName": "Stephen", "middleName": "", "lastName": "Kim"}], "pattern": "W", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Please email the instructor to be added to the waitlist.\n\nWhat can we learn about leadership from pathbreakers such as Grace Lee Boggs, Angela Davis, Toni Morrison, and Sylvia Rivera? While traditional scholarship on leadership has focused on corporations, politics, and higher education, leaders exist in many other spaces. Activists, for example, demonstrate many of the proven hallmarks of effective leadership: listening to others, taking risks, and forging communities. This course seeks to galvanize leadership education by putting traditional leadership scholarship in conversation with the writings of activists and humanistic scholars. Through this juxtaposition, we will explore and examine our preconceived notions of \u201cleadership,\u201d \u201cdiversity,\u201d and \u201cinclusion.\u201d We will challenge ourselves to develop dialogue skills for collaboration across difference, analyze identity-based power dynamics, and propose policies and measures to alleviate inequity in organizations. In seminar and in writing assignments, we will also reflect substantially from our own personal experiences as leaders, noting the challenges of leading in the context of structural inequities and the opportunities for creating more inclusive environments. Ultimately, this course seeks to articulate a more critical and informed vision for inclusive leadership and to equip students to lead across difference with empathy and awareness of identity-based power.\nStudents will need a quiet, private space, a webcam and microphone, and a reliable internet connection to participate in this course. Contact the instructor with questions."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/29/2021", "endDt": "05/25/2021", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades on