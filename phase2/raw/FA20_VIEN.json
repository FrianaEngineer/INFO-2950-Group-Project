: "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Identify the different microbes present during wine production, and describe the positive or negative roles that they play during wine production.", "Evaluate potential microbial issues with stuck/sluggish/spoiled fermentations.", "Describe classic and modern approaches used to understand the microbiology of wines.", "Explain and apply routine microbiological techniques useful in a winery.", "Develop independent research projects related to the roles of microbes in the winery, including designing and executing experiments to rigorously test hypotheses."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 362518, "crseOfferNbr": 1, "subject": "VIEN", "catalogNbr": "4960", "titleShort": "Wine Industry Internship", "titleLong": "Viticulture and Enology Internship", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 15480, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Students from all colleges must submit an Independent Study Form (Available online: https://cals.cornell.edu/undergraduate-students/student-services/academic-resources). Do not sign into section 601. You will be put in the course after submitting form online."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrMo