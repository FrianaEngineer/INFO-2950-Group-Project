t": "10/11/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This course examines the legal aspects of information privacy, data protection and data security, including the privacy of electronic communications. It will review the major federal privacy statutes, the role of the federal government and designated administrative agencies in the regulation of corporate consumer privacy conduct and data protection. Attention will be given to the large gaps that exist in the protection of individual privacy rights, and to ongoing efforts to regulate emerging technologies, in light of significant international, federal, and state regulatory developments.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Offered online.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: MSLS students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 371212, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "6100", "titleShort": "Mastering Negotiations", "titleLong": "Mastering Negotiations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 12522, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "10/23/2023", "endDt": "12/07/2023", "instructors": [{"instrAssignSeq": 2, "netid": "amf247", "firstName": "Allan", "middleName": "M.", "lastName": "Filipowicz"}, {"instrAssignSeq": 1, "netid": "tls11", "firstName": "Tony", "middleName": "L.", "lastName": "Simons"}], "pattern": "", "facilityDescr": null, "bl