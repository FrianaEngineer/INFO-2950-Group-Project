istering securities for public sale, certain exemptions that permit sales without registration, aspects of the federal proxy rules, and certain of the antifraud provisions under the Securities Act and the Exchange Act, including Rule 10b-5, and insider trading.\u00a0The course is designed for a student interested in gaining a general familiarity of the basics of the federal securities laws.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Offered online.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: MSLS students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 371225, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "7100", "titleShort": "Capstone Project I", "titleLong": "Capstone Project I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 20751, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/28/2023", "endDt": "12/17/2023", "instructors": [{"instrAssignSeq": 1, "netid": "rcp227", "firstName": "Roger", "middleName": "Chung-Ming", "lastName": "Pao"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/28/2023", "endDt": "12/17/2023", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "