aIds": null, "materials": []}, {"ssrComponent": "LAB", "ssrComponentLong": "Laboratory", "section": "431", "classNbr": 12298, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 5, "netid": "na346", "firstName": "Nandini", "middleName": "", "lastName": "Ananth"}, {"instrAssignSeq": 1, "netid": "pp427", "firstName": "Perrine", "middleName": "", "lastName": "Pepiot"}], "pattern": "W", "facilityDescr": "Upson Hall 152", "bldgDescr": "Upson Hall", "facilityDescrshort": "UPS152", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC", "LAB"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "CHEM", "catalogNbr": "1350", "type": "C"}, {"subject": "CHEME", "catalogNbr": "1510", "type": "C"}, {"subject": "MAE", "catalogNbr": "1510", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Hands-on introduction to scientific modeling and numerical simulations relevant to computational science and engineering. Students will learn how real-world problems can be solved using models, algorithms, and statistical tools. The course is organized around a set of team-based scientific computing projects drawn from various engineering and life science fields, using actual research and/or industrial computational codes. Leveraging simplified and user-friendly software interfaces and tutorials, the course focuses on the inductive learning of key concepts and topics such as physical and computational model formulation, verification and validation, uncertainty analysis, post-processing and data mining, and a high-level introduction to high performance computing. The course culminates with a community-engaged project, in which students are introduced to the basics of engineering design and team management to develop and animate a scientific computing activity in collaboration with, and tailored for, the Sciencenter. \u00a0Future Science Leaders program for middle- and high-schoolers. No prior programming experience is necessary, and a high-school math level is assumed. Enthusiasm for computer-based activities and interest in community outreach is strongly recommended.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Fulfills introduction to engineering requirement.", "catalogPermission": "Open to: all Cornell students regardless of major,\u00a0with interest in science, computer-based activities, and community outreach.\u00a0", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will understand \"corner stone\" skills of CSE, including modeling, code verification and validation, error analysis.", "Use and manipulate software packages to learn how science problems can be represented in computational programs.", "Be confident in their ability to use computers to solve scientific and engineering problems.", "Learn practical skills to improve their ability to lead a team, be a good teammate and communicate effectively."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2020-06-25T19:14:22-0400", "catalogDttm": "2020-06-25T19:15:19-0400"}}