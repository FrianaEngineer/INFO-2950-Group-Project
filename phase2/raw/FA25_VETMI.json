/20/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This seminar series provides students an opportunity to learn about and apply previously learned parasitology knowledge to new hosts and parasites. All students will participate in the seminars for three semesters. The first two semesters will be ungraded, and the final semester will be graded. During the final semester, each student will lead asynchronous discussions for two weeks on a parasite and host not discussed in core classes. During the first week, the student leader will provide a handout with the life cycle, a 10-to-15-minute recorded lecture on the parasite/host and kickoff discussion with one or two questions. During the next week, the student leader will provide a case report involving the parasite/host, a summary of the report and two to three questions for discussion.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: students in the veterinary MPS program.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 374719, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7456", "titleShort": "Vet Pharma Antiparasitic Agent", "titleLong": "Veterinary Pharmacology and Antiparasitic Agents", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19295, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/25/2025", "endDt": "12/08/2025", "instructors": [{"instrAssignSeq": 2, "netid": "al33", "firstName": "Araceli", "middleName": "", "lastName": "Lucio-Forster"}, {"instrAssignSeq": 1, "netid": "rcl233", "firstName": "Randy", "middleName": "C.", "lastName": "Lynn"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/25/2025", "endDt": "12/20/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/25/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The first half of the course will familiarize students with the fundamental principles of veterinary pharmacology, provide a basic understanding of the major definitions and terms used in veterinary pharmacology, and provide the basics on the history and scope of veterinary pharmacology. The second half of the course will take an in-depth look at drugs and agents for the prevention and control of parasitic arthropods, protozoa, and helminths of domestic animals. Emphasis will be on products commercially available in North America and Europe. Presents details on known (or postulated) modes of action for classes of compounds, important differences between drugs within the same class, targeted parasitic life stages, approved drug use and extra label drug use. Established or suspected resistance of parasites to specific drugs or drug classes will be highlighted. This course is intended as a core course for students enrolled in the Master of Professional Studies (MPS) in Veterinary Parasitology program.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: students in the Master of Professional Studies (MPS) in Veterinary Parasitology program.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 374720, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7457", "titleShort": "Vet Ectoparasites and Vectors", "titleLong": "Veterinary Ectoparasites and Vectors", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19296, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/25/2025", "endDt": "12/08/2025", "instructors": [{"instrAssignSeq": 1, "netid": "jkk5", "firstName": "Jennifer", "middleName": "K.", "lastName": "Ketzis"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/25/2025", "endDt": "12/20/2025", "addConsent"