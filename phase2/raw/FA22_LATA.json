"catalogNbr": "1975", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course is the first in a two-course sequence that studies the role of migration in the historical configuration of the Caribbean. This first part focuses on migrations to the Caribbean from the fifteenth century to the present. The course uses the arrival of numerous populations to the Caribbean as analytical lens to explore the role of new populations in shaping the social, political, racial, cultural, and economic landscape of the Caribbean. Through an analysis of the interactions among the many groups that peopled the Caribbean, the course offers students analytical tools to understand and develop their own interpretations of the historical development of the Caribbean, emphasizing processes of dispossession, racialization, colonialism, and resistance.", "catalogBreadth": "", "catalogDistr": "(GLC-AS, HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 359848, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "2170", "titleShort": "Early Modern Iberian Survey", "titleLong": "Early Modern Iberian Survey", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4656, "meetings": [{"classMtgNbr": 1, "timeStart": "09:40AM", "timeEnd": "10:55AM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 4, "netid": "sp349", "firstName": "Simone", "middleName": "", "lastName": "Pinet"}], "pattern": "TR", "facilityDescr": "Uris Hall G22", "bldgDescr": "Uris Hall", "facilityDescrshort": "URHG22", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: SPAN 2070 or SPAN 2090, or CASE Q+, or permission of instructor."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "MEDVL", "catalogNbr": "2170", "type": "C"}, {"subject": "SPAN", "catalogNbr": "2170", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores major texts and themes of the Hispanic tradition from the 11th to the 17th centuries. We will examine general questions on literary analysis and the relationship between literature and history around certain events, such as medieval multicultural Iberia, the creation of the Spanish Inquisition in the 15th century and the expulsion of the Jews in 1492; the encounter between the Old and the New Worlds; the 'opposition' of high and low in popular culture, and of the secular and the sacred in poetry and prose. Readings may be drawn from medieval short stories and miracle collections; chivalric romances, Columbus, Lazarillo de Tormes, Cervantes, Lope de Vega, Calder\u00f3n, and Sor Juana In\u00e9s de la Cruz, among others.", "catalogBreadth": "(HB)", "catalogDistr": "(ALC-AS, HST-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0SPAN 2095\u00a0, or CASE Q++.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 369005, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3100", "titleShort": "Advanced Portuguese I", "titleLong": "Advanced Portuguese I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19121, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "01:15PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "dmo67", "firstName": "Denise", "middleName": "Maria", "lastName": "Osborne"}], "pattern": "MWF", "facilityDescr": "Uris Hall 302", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH302", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "PORT", "catalogNbr": "3100", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course provides intermediate level students with the opportunity to advance their oral and written fluency, proficiency, and understanding of the grammar of Portuguese. In addition, students will be introduced to several cultural aspects of the Lusophone world, including regionalisms of Portuguese language. This goal will be achieved with the aid of literary and journalistic texts. Students will be expected to give individual and group presentations, as well as to write short pieces in the target language. The course is tailored to bridge language learning and content-based courses and research in Portuguese.\n\u00a0", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 351428, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3290", "titleShort": "Com Pol Of Latin Amer", "titleLong": "Comparative Politics of Latin America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16704, "meetings": [{"classMtgNbr": 1, "timeStart": "11:25AM", "timeEnd": "12:40PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "kr99", "firstN