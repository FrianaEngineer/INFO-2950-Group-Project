nces.\u00a0 The course focuses on oral and written skills, with emphasis on tasks based on familiar contexts of use.\u00a0 It also introduces learners to the history, culture and geography of the Andes through exposure to cultural practices, proverbs, folklore, and artefacts of the region (e.g. textiles).\u00a0 Students will reflect on Quechua as an endangered language and on the significance of keeping this very popular indigenous language of Latin America alive.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372551, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "1975", "titleShort": "Caribbean Migrations I", "titleLong": "Caribbean Migrations I: Caribbean Arrivals", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17636, "meetings": [{"classMtgNbr": 1, "timeStart": "11:25AM", "timeEnd": "12:40PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 2, "netid": "gla23", "firstName": "Gerard", "middleName": "Laurence", "lastName": "Aching"}, {"instrAssignSeq": 1, "netid": "eb577", "firstName": "Ernesto", "middleName": "E.", "lastName": "Bassi Arevalo"}], "pattern": "TR", "facilityDescr": "Morrill Hall 106", "bldgDescr": "Morrill Hall", "facilityDescrshort": "MRL106", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "