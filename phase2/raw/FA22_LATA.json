 "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "DIS", "ssrComponentLong": "Discussion", "section": "204", "classNbr": 16953, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:00AM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "kr99", "firstName": "Kenneth", "middleName": "", "lastName": "Roberts"}], "pattern": "W", "facilityDescr": "McGraw Hall 145", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG145", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "GDEV", "catalogNbr": "3290", "type": "C"}, {"subject": "GOVT", "catalogNbr": "3293", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course is designed as an introduction to political, economic, and social issues in 20th century Latin America. Topics are organized chronologically, beginning with the crisis of agro-export economies and oligarchic rule in the 1930s, the onset of state-led development and mass politics in the 1930s and 40s, the military takeovers and revolutionary struggles of the 1960s and 70s, patterns of democratization and market liberalization in the 1980s and 90s, and the recent experience with populist and leftist governments in much of the region. Among the main issues covered are populism and corporatism, dependency theory and import-substitution industrialization, different patterns of authoritarian rule, social movements and revolution, democratic breakdowns and transitions, the debt crisis and market reforms, and U.S.-Latin American relations. Throughout the semester, we will draw on examples from the entire region, but focus on paradigmatic national cases. Knowledge of Spanish or Portuguese is not required.\n\u00a0", "catalogBreadth": "(GB)", "catalogDistr": "(GLC-AS, SBA-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 365499, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3565", "titleShort": "Art & Arch of Colonial Latin A", "titleLong": "Art and Architecture of Colonial Latin America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17251, "meetings": [{"classMtgNbr": 1, "timeStart": "09:40AM", "timeEnd": "10:55AM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "aic42", "firstName": "Ananda", "middleName": "", "lastName": "Cohen-Aponte"}], "pattern": "TR", "facilityDescr": "Goldwin Smith Hall G22", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSHG22", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "ARTH", "catalogNbr": "3565", "type": "B"}, {"subject": "ARTH", "catalogNbr": "6563", "type": "B"}, {"subject": "VISST", "catalogNbr": "3565", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course surveys the artistic and architectural traditions of Latin America during the period of Spanish colonial rule (ca. 1520s-1820s). It will center primarily on visual cultures of the viceroyalties of New Spain (Mexico) and Peru, but will also cover works of art and architecture from the Caribbean and the northern Andes. The course explores the legacy of pre-Columbian visual traditions in the colonial era as well as the lasting impact of colonial artistic practices in modern and contemporary Latin America. It will also examine colonial Latin America as the crossroads of dynamic artistic and cultural interaction between Indigenous, European, and Afrodescendant groups. Topics to be explored include issues of visual translation and transmission, art and agency, and the creation of new colonial artistic practices and idioms.\u00a0\u00a0", "catalogBreadth": "(GHB)", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 364093, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3609", "titleShort": "Deixa Sambar", "titleLong": "Brazilian Ensemble - Deixa Sambar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 7962, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "09:25PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "sfp8", "firstName": "Steven", "middleName": "F.", "lastName": "Pond"}], "pattern": "R", "facilityDescr": "Lincoln Hall B20", "bldgDescr": "Lincoln Hall", "facilityDescrshort": "LNCB20", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["STU"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "MUSIC", "catalogNbr": "3609", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Deixa Sambar performs several styles of samba, Brazil's national music. Members need not have prior background in music-making, but a good sense of rhythm is desirable. Members include students as well as Ithaca community members, brasileiros as well as newcomers to Brazilian culture. Rehearsals develop playing skills, with a deep emphasis on cultural understanding of this vital, community-based music.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372671, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3612", "titleShort": "Pol of Sustain Dev in Lat Am I", "titleLong": "Politics of Sustainable Development in Latin America I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19011, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "09:30PM", "startDt": "10/12/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "kr99", "firstName": "Kenneth", "middleName": "", "lastName": "Roberts"}], "pattern": "M", "facilityDescr": "Rockefeller Hall 110", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK110", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This course is first part of a multi-term sequence."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/12/2022", "endDt": "12/17/2022", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "BMT", "gradingBasisShort": "Multi-Term", "gradingBasisLong": "Multi-Term Course: Not Graded", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "3613", "type": "C"}], "sessionCode": "7W2", "sessionBeginDt": "10/12/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "In recent decades the Andean region of Latin America has become a focal point of international debate over alternative models of economic development and their environmental consequences. Windfall revenues from oil, gas, and mineral extraction have stimulated economic growth in the region, but they have also sparked opposition from environmental organizations and indigenous communities concerned about the effects on land and water resources and community livelihoods. This engaged learning course explores the political ecology of development in Ecuador, focusing on the tensions between extractive models of development and more environmentally-sustainable alternatives. The course will count for four credit hours spread across three modules in the fall, January, and spring semesters. The fall module provides an introduction to Ecuador's political and economic development as well as its racial and ethnic cultural diversity. It will also include background material on theoretical debates over sustainable development and the methods and purpose of community-based engaged learning. This will be followed by an intensive, two-week field trip to Ecuador in January to work on group projects with community partners, and a wrap-up module in the spring semester to complete and present final group projects.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-SBY)", "catalogWhenOffered": "Multi-semester course: (Fall).", "catalogComments": "Students must complete LATA 3612, LATA 3614\u00a0(Winter), and LATA 3623\u00a0(Spring) for a final grade and Arts and Sciences distribution.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 353084, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3613", "titleShort": "Steel Band", "titleLong": "Cornell Steel Band", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 5578, "meetings": [{"classMtgNbr": 1, "timeStart": "04:30PM", "timeEnd": "06:30PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 9, "netid": "cjm299", "firstName": "Christopher", "middleName": "J.", "lastName": "Miller"}], "pattern": "W", "facilityDescr": "Bailey Hall 101", "bldgDescr": "Bailey Hall", "facilityDescrshort": "BLY101", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["STU"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "MUSIC", "catalogNbr": "3613", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The Cornell Steel Band explores the wide variety of music for an orchestra of instruments fashioned from 55-gallon oil drums, and an \"engine room\" of non-pitched percussion. Interwoven into the focus on hands-on practice is reflection on the meanings of steel band, historically and in the present, in its native Trinidad and Tobago and here in the United States. Formal musical training is not necessary, though a sense of rhythm and a good ear are helpful.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Priority given to: music majors and minors and continuing members.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 364958, "crseOfferNbr": 1, "subject": "LATA", "catalogNbr": "4000", "titleShort": "Issues in Latin/Latino America", "titleLong": "Contemporary Issues in Latin - Latino America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 6722, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "ti