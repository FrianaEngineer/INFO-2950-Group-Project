, to introduce students to some of the crucial moments in the history of Italian figurative arts, architecture and fashion design, but also to a range of social issues relevant for understanding the more recent tendencies in art and design in modern Italy; second, to help students refine the way they speak and write about art, architecture and design through a review of the grammatical and lexical structures of Italian and a reinforcement of idiomatic expressions that will increase their ability to discuss, evaluate, analyze and compare issues of relevance to the field of art, architecture and desgn.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ITAL 1201 or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 366922, "crseOfferNbr": 1, "subject": "ITAL", "catalogNbr": "1401", "titleShort": "Intensive Elementary Italian", "titleLong": "Intensive Elementary Italian", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5063, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "keb11", "firstName": "K.E.", "middleName": "", "lastName": "von Wittelsbach"}], "pattern": "MWF", "facilityDescr": "Goldwin Smith Hall 156", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH156", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/22/2024"