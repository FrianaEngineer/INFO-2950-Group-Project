aded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This is an intensive introductory course for those who are native/near native speakers of Spanish.\u00a0 Emphasis will be given in the development of the four skills (speaking, listening, reading, and writing), as well as the appreciation and awareness of Portuguese-speaking cultures.\u00a0 Students will engage with a broad range of topics related to Afro-Luso-Brazilian culture through art (e.g., painting, theater, cinema, literature, photography, dance sculpture, etc).", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: PORT 1220.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372583, "crseOfferNbr": 1, "subject": "PORT", "catalogNbr": "2500", "titleShort": "Intro to Lusophone Cultures", "titleLong": "Intro to Lusophone Cultures", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17406, "meetings": [{"classMtgNbr": 1, "timeStart": "09:05AM", "timeEnd": "09:55AM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [], "pattern": "MWF", "facilityDescr": "Goldwin Smith Hall 122", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH122", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This course will be taught by Leonardo Velloso-Lyons a Mellon Fellow in the Romance Studies department."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Spanning six centuries, this course offers students an introduction to the Portuguese-speaking world. Students will practice analytical skills and gain familiarity with the culture and history of Brazil, Angola, Portugal and Mozambique by engaging with literature, art, music and cinema.\u00a0 Historical moments that we will cover in this course include Portugal's colonialist expansion (1450-1700), the Kingdom of Kongo's response to it (1500-1700), the independence movements in Brazil, Angola and Mozambique (1820-1970), and the most recent cultural movements in music and cinema (1970-2000s).\u00a0 Students will examine different forms of colonialism, and how the legacy of colonialism has shaped today's Lusophone world.\u00a0 Moreover, students will contemplate topics of broader humanistic interest, such as national\u00a0 identities, colonialism, transcontinental cultural exchanges, and forms of resistance to colonial oppression.", "catalogBreadth": "", "catalogDistr": "(CA-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 369005, "crseOfferNbr": 1, "subject": "PORT", "catalogNbr": "3100", "titleShort": "Advanced Portuguese I", "titleLong": "Advanced Portuguese I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19120, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "01:15PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "dmo67", "firstName": "Denise", "middleName": "Maria", "lastName": "Osborne"}], "pattern": "MWF", "facilityDescr": "Uris Hall 302", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH302", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LATA", "catalogNbr": "3100", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course provides intermediate level students with the opportunity to advance their oral and written fluency, proficiency, and understanding of the grammar of Portuguese. In addition, students will be introduced to several cultural aspects of the Lusophone world, including regionalisms of Portuguese language. This goal will be achieved with the aid of literary and journalistic texts. Students will be expected to give individual and group presentations, as well as to write short pieces in the target language. The course is tailored to bridge language learning and content-based courses and research in Portuguese.\n\u00a0", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2023-04-13T14:00:07-0400", "catalogDttm": "2023-04-12T19:14:04-0400"}}