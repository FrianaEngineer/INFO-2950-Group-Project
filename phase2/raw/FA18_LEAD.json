msOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 367167, "crseOfferNbr": 1, "subject": "LEAD", "catalogNbr": "2020", "titleShort": "Greek Leadership Academy", "titleLong": "Greek Leadership Academy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17389, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "09:55PM", "startDt": "10/15/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "mjb554", "firstName": "Marcus", "middleName": "J", "lastName": "Brooks"}, {"instrAssignSeq": 6, "netid": "me14", "firstName": "Marcia", "middleName": "", "lastName": "Eames-Sheavly"}, {"instrAssignSeq": 5, "netid": "kh662", "firstName": "Karel", "middleName": "", "lastName": "Hilversum"}, {"instrAssignSeq": 4, "netid": "aek44", "firstName": "Amy", "middleName": "E.", "lastName": "Kohut"}], "pattern": "M", "facilityDescr": "Uris Hall G26", "bldgDescr": "Uris Hall", "facilityDescrshort": "URHG26", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Course is intended for current and aspiring officers in fraternities and sororities. To enroll, contact Marcus Brooks (mjb554)."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/15/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "10/15/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": null}], "description": "Cornell's Fraternity and Sorority system is in a dynamic period in its lifespan, and it will continue to undergo shifts and adjust to changes over the next few years. It is critical that leaders of these organizations have the skills necessary to lead in ways that will help chapters continue to thrive. This course is specifically designed to meet the needs of existing and incoming leaders in Cornell's Fraternity and Sorority system. You will look critically at your own leadership skills and conclude the course with an action plan that will prepare you for January's recruitment and new member period. In this unique one-credit course, you will build your leadership skills while building connections and relationships with officers in other chapters.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL)", "catalogWhenOffered": "Fall, Spring (weeks 8-14).", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: aspiring officers in fraternities and sororities. To enroll, contact Marcus Brooks (mjb554).", "catalogCourseSubfield": "", "catalogOutcomes": ["Know and demonstrate practices of exemplary leadership, group development, and team building.", "Be able to articulate how leadership impacts organizational culture, change, power and belonging.", "Cultivate an awareness of your leadership strengths, and take steps toward opportunities for growth and improvement.", "Create a plan for positive chapter leadership and collaboration, based on your chapter's mission.", "Experience a sense of community and support from other members that you may come to personally value."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 364483, "crseOfferNbr": 1, "subject": "LEAD", "catalogNbr": "3100", "titleShort": "Foundations in Leadership", "titleLong": "Foundations in Leadership: Skills for Professional Success and Life", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17363, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "04:25PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "ljv4", "firstName": "Larry", "middleName": "", "lastName": "Van De Valk"}], "pattern": "R", "facilityDescr": "Warren Hall B73", "bldgDescr": "Warren Hall", "facilityDescrshort": "WRNB73", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course frames leadership as a particular way of approaching life, one that is essential to both personal fulfillment and career effectiveness. The course begins with the inner work of a leader's personal development and then explores how leaders work through others to enhance their influence.", "catalogBreadth": "", "catalogDistr": "(KCM-AG, SBA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 30 students. Preference given to Leadership Minor students.", "catalogCourseSubfield": "", "catalogOutcomes": ["Develop a critical understanding of contemporary leadership theories, styles, approaches and roles.", "Examine and clarify personal inspirations, values, and purposes in careers and life.", "Learn to align those inner motivations with personal actions, decisions, and communications in order to become more authentic, effective, and influential.", "Build skills for communicating effectively, especially in difficult conversations such as delivering feedback, resolving conflict, and influencing others.", "Practice skills for building effective teams and leading group planning, decision making and problem solving processes.", "Create a personal learning plan and leadership portfolio for supporting personal development.", "Establish a habit of reflection to promote continuous learning and effective leadership."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 369495, "crseOfferNbr": 1, "subject": "LEAD", "catalogNbr": "4925", "titleShort": "Leadership Minor ePortfolio", "titleLong": "Leadership Minor ePortfolio", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 17362, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrsh