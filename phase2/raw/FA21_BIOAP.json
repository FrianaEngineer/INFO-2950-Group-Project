"catalogOutcomes": ["Students will be able to formulate a properly controlled scientific study.", "Students will be able to present scientific data in public forums.", "Students will be able to critically assess scientific literature.", "Students will be able to develop a grant proposal.", "Students will be able to write a scientific abstract."], "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 371753, "crseOfferNbr": 2, "subject": "BIOAP", "catalogNbr": "6270", "titleShort": "Fundamentals of Endocrinology", "titleLong": "Fundamentals of Endocrinology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18709, "meetings": [{"classMtgNbr": 1, "timeStart": "11:20AM", "timeEnd": "12:10PM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 3, "netid": "smq1", "firstName": "Susan", "middleName": "Mary", "lastName": "Quirk"}, {"instrAssignSeq": 7, "netid": "yar9", "firstName": "Yi", "middleName": "Athena", "lastName": "Ren"}], "pattern": "MWF", "facilityDescr": "Morrison Hall B82", "bldgDescr": "Morrison Hall", "facilityDescrshort": "MRSB82", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ANSC", "catalogNbr": "4270", "type": "B"}, {"subject": "ANSC", "catalogNbr": "6270", "type": "B"}, {"subject": "BIOAP", "catalogNbr": "4270", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Physiology and regulation of endocrine secretions. Emphasizes neuroendocrine, reproductive, growth, and metabolic aspects of endocrinology. Examples are selected from many animals, including humans.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: animal or human physiology course or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to define the organization of the endocrine system with a focus on mammals.", "Students will be able to explain the physiological function of major hormones and interactions among components of the endocrine system to control homeostasis.", "Student will, for each major hormone, describe its cellular source, biosynthesis, chemical nature, storage, factors controlling its secretion, cellular mechanisms of action on target cells, and physiological functions.", "Students will be able to discuss how the roles of hormones change during developmental processes.", "Students will be able to predict the consequences of disturbances in components of the endocrine system.", "Students will be able to illustrate how basic scientific research as well as clinical studies of endocrine disorders contribute to the advancement of basic knowledge and development of therapeutic strategies for endocrine disorders.", "Students will be able to appraise how the acquisition of knowledge about the endocrine system is ongoing and how key advances in technology from multiple fields (physiology, cell biology, biochemistry, and genetics) have promoted advancements in knowledge of the endocrine system."], "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-02-07T19:27:30-0500", "catalogDttm": "2022-02-07T19:14:23-0500"}}