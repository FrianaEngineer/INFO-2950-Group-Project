"", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to define the organization of the endocrine system with a focus on mammals.", "Students will be able to explain the physiological function of major hormones and interactions among components of the endocrine system to control homeostasis.", "Student will, for each major hormone, describe its cellular source, biosynthesis, chemical nature, storage, factors controlling its secretion, cellular mechanisms of action on target cells, and physiological functions.", "Students will be able to discuss how the roles of hormones change during developmental processes.", "Students will be able to predict the consequences of disturbances in components of the endocrine system.", "Students will be able to illustrate how basic scientific research as well as clinical studies of endocrine disorders contribute to the advancement of basic knowledge and development of therapeutic strategies for endocrine disorders.", "Students will be able to appraise how the acquisition of knowledge about the endocrine system is ongoing and how key advances in technology from multiple fields (physiology, cell biology, biochemistry, and genetics) have promoted advancements in knowledge of the endocrine system."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 361196, "crseOfferNbr": 1, "subject": "BIOAP", "catalogNbr": "4980", "titleShort": "Teaching Experience", "titleLong": "Teaching Experience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 15097, "meetings": [], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: previous enrollment in course to be taught or equivalent. Arts students may not count this course toward graduation but may, upon petition (one time only) to their