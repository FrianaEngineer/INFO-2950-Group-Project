ng": "Letter or S/U grades", "simpleCombinations": [{"subject": "LATA", "catalogNbr": "2800", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course provides an introduction and overview of Brazilian culture. It will study different periods of Brazilian history, through the analysis of films, literature, essays, visual arts, and music. Students will explore different definitions of Brazilian identity and \"Brazilianness\" focusing on key topics including the formation of the colonial Brazil\u00a0 and the emergence of the nation of Brazil as a tropical paradise; slavery and abolition; the particularities century; and the contradictions of the modernization process throughout the 20th century. We will consider elements of Brazilian popular culture such as Carnival, Samba, and \"telenovels,\" and some of the most important cultural movements of the 20th century, such as \"Modernismo,\" \"Cinema Novo,\" and \"Tropicalia.\" The primary objective of the course is to provide students with the relevant background to understand Brazilian cultural history.", "catalogBreadth": "(GB)", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Conducted in English.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 369005, "crseOfferNbr": 1, "subject": "PORT", "catalogNbr": "3100", "titleShort": "Advanced Portuguese", "titleLong": "Advanced Portuguese", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": 