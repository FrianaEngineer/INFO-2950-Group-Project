orea: Current issues in Korean society, Korean people's thoughts and mind, tradition, history and culture. This course follows the Learner-Centered methodology encouraging students to be active participants in their language learning process. The Learner-Centered methodology is applied by asking students to lead a discussion on the topic of their assigned TV documentary and the contemporary novel. Through discussion and analysis, students will understand the different styles of texts and genres.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0KOREA 4401\u00a0or online placement test (collt.lrc.cornell.edu/).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 14 students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-06-02T19:14:21-0400", "catalogDttm": "2019-06-02T19:15:24-0400"}}