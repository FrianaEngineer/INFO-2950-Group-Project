 heritage students who can understand and speak Korean, but specially need to refine their reading and writing skills. Students will acquire concrete knowledge of grammar to use in everyday conversation, will be able to read the passages faster, and will minimize their spelling errors in writing, through frequent discussion and composition about Korean culture, society and history. They will become confident in reading multi-paragraph-length readings in Korean, be able to write their reflections on the passages that they have read, and speak with ease when participating in classroom discussions.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: KOREA 2209, or online placement test required (collt.lrc.cornell.edu).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 14 students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 351245, "crseOfferNbr": 1, "subject": "KOREA", "catalogNbr": "3302", "titleShort": "High Intermediate Korean II", "titleLong": "High Intermediate Korean II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5715, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 3, "netid": "sj684", "firstName": "Seunggon", "middleName": "", "lastName": "Jeong"}], "pattern": "MWF", "facilityDescr": "Uris Hall 303", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH303", "meetingTopicDescription": ""}], "notes": [{