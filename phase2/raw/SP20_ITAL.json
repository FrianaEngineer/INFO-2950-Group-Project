talogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ITAL 2201.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 357443, "crseOfferNbr": 1, "subject": "ITAL", "catalogNbr": "2204", "titleShort": "The Cinematic Eye of Italy", "titleLong": "The Cinematic Eye of Italy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16380, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 2, "netid": "tcc9", "firstName": "Timothy", "middleName": "C.", "lastName": "Campbell"}], "pattern": "TR", "facilityDescr": "Uris Hall 262", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH262", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisites: ITAL 2202 or permission of instructor."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course, which is at the core of the major and minor in Italian, is designed to give students a basic grounding in some of the most important facets of Italian culture, including cinema, literature, art, and food.\u00a0 Students will trace the development of Italian national identity in literary and cinematic texts as well as across Italian photography and cuisine.\u00a0 Readings will include selections from the works of Primo Levi, Roberto Saviano, and Leonardo Sciascia.\u00a0 Students will also view films by directors such as Rossellini, de Sica, Antonioni, Bertolucci, and Sergio Leone, becoming familiar along the way with genres in Italian national cinema.\u00a0 By the end of the semester, students will have a working knowledge of the effects of geographic and national fragmentation on political life in post-Risorgimento Italy, understand the so-called Southern Question and the fraught relationship between the Italian South and wealthier Northern regions, and gain different perspectives on political life today in Italy.", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: 2 years of Italian language.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 357442, "crseOfferNbr": 1, "subject": "ITAL", "catalogNbr": "2900", "titleShort": "Perspectives In Italian Cultur", "titleLong": "Perspectives in Italian Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8385, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "tcc9", "firstName": "Timothy", "middleName": "C.", "lastName": "Campbell"}], "pattern": "TR", "facilityDescr": "Uris Hall 262", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH262", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Conducted in English."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course serves as an introduction to the close reading of, and critical engagement with, a range of sources from various periods of Italian literary and cultural history.\u00a0 In fact, since Italy doesn't really cohere as a political entity until late in the nineteenth century, this course could just as easily be called Perspectives in Pre-Italian Culture.\u00a0 The questions of perspective-of who's looking, what's being looked at, and what we're\u00a0 looking through-will haunt our readings from sources as varied as Dante's Commedia, the reception history of St. Francis of Assisi, medieval visionary women, Michelangelo's love lyrics, the novel (e.g. Moravia), the short story (e.g. Celati), film, and political philosophy.\u00a0 We'll pay special attention to the way in which desire, pleasure, excess, and resistance structure the articulation of Italian-or more local, frequently urban-identities, and we'll attempt too grapple with how, even as we get a kind of perspective on Italy, Italy always looks back at us with questions, desires, and a gaze of its own.", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "\"Core course\" for the Italian major and the Italian minor, offered every year.\u00a0 Conducted in English with discussion section in Italian.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 353265, "crseOfferNbr": 1, "subject": "ITAL", "catalogNbr": "3020", "titleShort": "Italian Practicum", "titleLong": "Italian Practicum", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19333, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "tcc9", "firstName": "Timothy", "middleName": "C.", "lastName": "Campbell"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special