re weekly meetings with the faculty for education, managing the business and reviewing consulting students projects.\u00a0 The student consultants apply in the fall to be a consultant.\u00a0 They take responsibility for finalizing the consulting project, conducting the work and delivering a final recommendation in the spring before graduation.\u00a0 There are six just in time education sessions timed to the specific point in their project.\u00a0 In addition, there a regular meetings with the directors and faculty.\u00a0 The students present their interim findings before winter break. Before they deliver the final presentation, there are multiple reviews and a case competition.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 364299, "crseOfferNbr": 1, "subject": "NMI", "catalogNbr": "5090", "titleShort": "Big Red MicroEnterprise", "titleLong": "Big Red MicroEnterprise", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "001", "classNbr": 14282, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "mm462", "firstName": "Mark", "middleName": "B.", "lastName": "Milstein"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Students with permission.\n\nTher