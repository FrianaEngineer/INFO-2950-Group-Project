catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369224, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "6710", "titleShort": "Late Theory", "titleLong": "Late Theory", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17815, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 1, "netid": "ngs9", "firstName": "Nick", "middleName": "", "lastName": "Salvato"}], "pattern": "W", "facilityDescr": "Schwartz Ctr-Perform Arts 124", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ124", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2018", "endDt": "05/09/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "FGSS", "catalogNbr": "4711", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6711", "type": "B"}, {"subject": "LGBT", "catalogNbr": "4710", "type": "B"}, {"subject": "PMA", "catalogNbr": "4710", "type": "B"}, {"subject": "PMA", "catalogNbr": "6710", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This seminar explores theoretical work in which lateness figures as the signal condition, gesture, problem, or method. We begin with two topics prominent in twentieth-century criticism: late style and late capitalism. We then pivot to contemporary theory \"after\" theory\u2014or what Amy Holzapfel calls \"subprime critique\": works marked variously by senses or intimations of belatedness, loss, exhaustion, and decay. Throughout, theoretical readings are paired with an eclectic set of art objects, ranging from literary fictions (James, Baldwin) to more and less popular television series (The Sopranos, Roseanne's Nuts) to avant-garde performances (The Lily's Revenge, Discotropic). Authors may include Adorno, Agamben, Berlant, Jameson, Mbembe, Moten, Said, and Sedgwick. Issues of ability, age, class, gender, race, and sexuality are foregrounded.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2018-06-18T19:14:21-0400", "catalogDttm": "2018-06-14T19:15:33-0400"}}