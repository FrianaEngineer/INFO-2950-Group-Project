"endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM", "LAB"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "4260", "type": "C"}, {"subject": "ARKEO", "catalogNbr": "4260", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course provides a hands-on introduction to analytical methods in archaeology, focusing on the circa 1688-1715 On\u00f6ndowa'ga:' (Seneca) White Springs site, located near Geneva, New York. White Springs was a densely-occupied Haudenosaunee (Iroquois) town of about 8 acres that held as many as 100 longhouses and was home to 1700-2000 people; its residents interacted with European colonists and many other indigenous groups. Students will generate new archaeological interpretations by analyzing artifact assemblages recovered by Cornell excavations undertaken in 2007-2015. Readings provide essential background on the history and material culture of the White Springs era. Students will prepare 15-page analytical papers which can draw on field data, museum collections, historical texts, or a combination of these sources.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSat