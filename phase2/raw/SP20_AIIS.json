id": "jwp35", "firstName": "Jon", "middleName": "W.", "lastName": "Parmenter"}], "pattern": "F", "facilityDescr": "Goldwin Smith Hall 350", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH350", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2660", "type": "C"}, {"subject": "HIST", "catalogNbr": "2660", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "One thing many Americans think they know is their Indians: Pocahontas, the First Thanksgiving, fighting cowboys, reservation poverty, and casino riches. Under our very noses, however, Native American history has evolved into one of the most exciting, dynamic, and contentious fields of inquiry into America's past. It is now safer to assume, as Comanche historian Paul Chaat Smith has pointed out, that everything you know about Indians is in fact wrong. Most people have much to \"unlearn\" about Native American history before true learning can take place. This course aims to achieve that end by (re)introducing students to key themes and trends in the history of North America's indigenous nations. Employing an issues-oriented approach, the course stresses the ongoing complexity of Native American societies' engagements with varieties of settler colonialism since 1492 and dedicates itself to a concerted program of myth-busting. As such, the course will provide numerous opportunities for students to develop their critical thinking and reading skills.", "catalogBreadth": "", "catalogDistr": "(D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 365706, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "3560", "titleShort": "Indigenous Philosophies", "titleLong": "Thinking from a Different Place: Indigenous Philosophies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18512, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "etc7", "firstName": "Eric", "middleName": "T.", "lastName": "Cheyfitz"}], "pattern": "TR", "facilityDescr": "Caldwell Hall 400", "bldgDescr": "Caldwell Hall", "facilityDescrshort": "CLD400", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3562", "type": "C"}, {"subject": "ENGL", "catalogNbr": "3560", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "The Western nation-state has failed to solve the two most pressing, indeed catastrophic, global problems: poverty and climate change. This failure is due to the inability of national policy to imagine a world beyond a boundary drawn by the formative capitalist ideas of property, production, and profit. The course will begin by discussing the historical origin and continuing force of these ideas while raising questions about their limits. Then it will look at a range of alternative ideas about how the world should work if we want to keep it socially, economically, and ecologically in balance. The alternatives we will query come from a range of Indigenous writers of fiction, poetry, and theory, who locate themselves in Native American (north and south), Aboriginal, and Maori communities.", "catalogBreadth": "", "catalogDistr": "(D-AG, LA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Explain Indigenous theory and practice in dealing with social, economic, and environmental issues.", "Contrast Indigenous theory and practice with Western approaches to these issues at a time of gross income inequality and environmental collapse worldwide.", "Think critically about the most effective ways to deal with these global issues after having considered both approaches to these issues."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 360397, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "4000", "titleShort": "Critical Approaches to AIIS", "titleLong": "Critical Approaches to American Indian and Indigenous Studies: Intellectual History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 3677, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "04:25PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 3, "netid": "csu3", "firstName": "Chad", "middleName": "S.", "lastName": "Uran"}], "pattern": "W", "facilityDescr": "Caldwell Hall 400", "bldgDescr": "Caldwell Hall", "facilityDescrshort": "CLD400", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment is limited to: advanced undergraduates or graduate students. Course requirements differ at 4000 and 6000 levels."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AIIS", "catalogNbr": "6000", "type": "W"}], "sessionCode": "1", "se