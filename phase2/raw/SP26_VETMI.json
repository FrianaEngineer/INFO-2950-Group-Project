teriaIds": []}], "description": "In-depth look at canine and feline parasites of major veterinary medical importance or of special interest (relative to zoonosis, etc.). Emphasis on parasites common in North America and Europe, with some discussion of other geographic regions. Presents details of taxonomy, biology, epidemiology, pathology, host immunity, clinical presentation, and preventative and curative treatment. Also, as relevant, consideration and discussion of parasitic susceptibility and resistance to available parasiticides. Information from studies reported in primary literature will be reviewed where applicable. This course is intended as an elective course for students enrolled in the Master of Professional Studies (MPS) in Veterinary Parasitology.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: students in the Master of Professional Studies (MPS) in Veterinary Parasitology program.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 374828, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7460", "titleShort": "Clnl/Appl Parasit Cattle Sheep", "titleLong": "Clinical and Applied Parasitology: Cattle and Sheep", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11076, "meetings": [{"c