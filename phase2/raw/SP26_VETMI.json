s will participate in the seminars for three semesters. The first two semesters will be ungraded, and the final semester will be graded. During the final semester, each student will lead asynchronous discussions for two weeks on a parasite and host not discussed in core classes. During the first week, the student leader will provide a handout with the life cycle, a 10-to-15-minute recorded lecture on the parasite/host and kickoff discussion with one or two questions. During the next week, the student leader will provide a case report involving the parasite/host, a summary of the report and two to three questions for discussion.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: students in the veterinary MPS program.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 374823, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7458", "titleShort": "Drug Disc Vaccine Process", "titleLong": "Drug Discovery and Vaccines: The Process and Parasiticides", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11074, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "che29", "firstName": "Christia