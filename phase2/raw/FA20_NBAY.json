g funding options and acquiring financial resources, managing risk and uncertainty, growth and scaling up, and finally, realizing the (financial as well as personal) value of the venture through exit options. The course will help students learn and apply the lean startup methodology, popular among new digital ventures. We will primarily use case studies of a variety of digital entrepreneurial ventures and case-based exercises to illustrate these concepts and practice real world applications. BEV will equip students with the lean startup toolkit and is primarily designed for students interested in starting, working at, advising, or financing new ventures, but can also be of use to someone interested in leading entrepreneurial innovation in established firms. The final deliverable will be student choice: a take-home case analysis, or a business plan.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 366603, "crseOfferNbr": 1, "subject": "NBAY", "catalogNbr": "6090", "titleShort": "Digital Marketing", "titleLong": "Digital Marketing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14305, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "12:50PM", "startDt": "10/21/2020", "endDt": "12/08/2020", "instructors": [{"instrAssignSeq": 6, "netid": "tb558", "firstName": "Tommaso", "middleName": "", "lastName": "Bondi"}], "pattern": "R", "facilityDescr": "Online Meeting", "bldgDescr