0", "firstName": "Edwin", "middleName": "", "lastName": "Cowen"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This class section is reserved for Ed. Equity students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Our current students are the first generation that will feel the impacts of climate change, and the last generation that can do anything about it. The dual objectives of this course are to inform young pre-professional engineers of the factual science in the nexus of climate change/fossil fuels/renewable energy, and to inspire them to dive into that nexus now, and to begin to do something about untangling it as engineers in practice. In this nexus are key issues for civil engineers: water quality/quantity, emissions, renewable energy supply and structures, civil infrastructure systems engineering, energy economics, sustainability in megacities.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 372046, "crseOfferNbr": 2, "subject": "ENGRI", "catalogNbr": "1180", "titleShort": "Building a Habitable Planet", "titleLong": "How to Build a Habitable Planet", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 20357, "meetings": [{"classMtgNbr": 1, "timeStart": "09:05AM", "timeEnd": "09:55AM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "keo52", "firstName": "Karin", "middleName": "Elizabeth", "lastName": "Olson Hoal"}], "pattern": "MWF", "facilityDescr": "Hollister Hall B14", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLSB14", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "EAS", "catalogNbr": "1180", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Our first human ancestors appeared only six million years ago--4.55 billion years into Earth's history. How did our planet develop the critical ingredients for human life\u2014what are the characteristics that make our Pale Blue Dot suited to host complex life? Should we expect to find life elsewhere on other planets? How has human activity altered the story of the Earth, and what global challenges will\u00a0Homo sapiens\u00a0encounter in the coming years to decades? Can we devise and implement solutions to present and future environmental crises? In this course, we will investigate these questions through study of the formation and evolution of our universe, investigate the mechanisms that have led to intelligent life on Earth and quantify the impact of both natural and anthropogenic processes on Earth's changing surface. Students in this course will learn how to analyze and interpret scientific data and apply concepts like mass balance and convection to evaluate Earth as series of complex chemical and physical systems interacting over a breadth of scales.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Describe how the elements formed in stars and the evolution of our solar system.", "Characterize Earth's internal structure and how it has changed over time.", "Quantify the relationship between plate tectonics and hazards like earthquakes and volcanoes.", "Discriminate between long-term, short-term, natural and/or anthropogenic drivers of Earth's climate.", "Place the appearance of life and the role of humanity within the context of Earth's geologic history."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-05-19T19:32:44-0400", "catalogDttm": "2024-05-19T19:07:08-0400"}}