ited States Navy and Marine Corps to prepare them for the roles and responsibilities of Naval leadership.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "OT", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 352152, "crseOfferNbr": 1, "subject": "NAVS", "catalogNbr": "4442", "titleShort": "Naval Professional Lab", "titleLong": "Naval Professional Laboratory", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LAB", "ssrComponentLong": "Laboratory", "section": "401", "classNbr": 13561, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 3, "netid": "tst45", "firstName": "Tyler", "middleName": "Stephen", "lastName": "Trainor"}], "pattern": "W", "facilityDescr": "Barton Hall 246", "bldgDescr": "Barton Hall", "facilityDescrshort": "BTN246", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to students who are able to attend in-person classes in the Ithaca area."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid-Online and In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "components