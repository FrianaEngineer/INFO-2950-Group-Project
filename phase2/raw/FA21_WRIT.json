damental to interdisciplinary reading, research, and writing by collaborating with peers to pose questions, examine ideas, and share drafts. With smaller class sizes, two 50-minute class sessions and weekly student/teacher conferences, Writing 1370 provides an individualized setting for students to learn flexible and sustainable strategies for studying the essential elements of academic writing and for producing clear, precise academic prose that can address a variety of audiences and meet diverse rhetorical aims.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 353946, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "1390", "titleShort": "Special Topics in Writing", "titleLong": "Special Topics in Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4787, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 1, "netid": "thc33", "firstName": "Tracy", "middleName": "Hamler", "lastName": "Carrick"}], "pattern": "", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "i