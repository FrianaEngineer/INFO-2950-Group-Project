ntic reading materials. The course provides students with reading materials from writings in various genres and styles such as newspaper editorials, columns, essays, short stories, and other literary writings. Students will discuss and write an essay on topics regarding living in Korea, popular Korean food, dating culture in Korea, tour sites and regional products, Korean wave, address terms and interpersonal relations, and famous Korean people.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: grade of B- or higher in KOREA 2202\u00a0or KOREA 2210, or online placement test (collt.lrc.cornell.edu/).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 371566, "crseOfferNbr": 1, "subject": "KOREA", "catalogNbr": "3316", "titleShort": "Korean (LAC)", "titleLong": "Korean Language Across the Curriculum (LAC)", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20404, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "hy524", "firstName": "Hyein", "middleName": "", "lastName": "Yang"}], "pattern": "", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "KOREA 2201/ KOREA 2202 or equivalent. Permission of instructor required. Must concurrently enrolled in GOVT 1111."}], "campus": "MAIN", "campusDescr