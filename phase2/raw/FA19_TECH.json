tudio is the foundational studio\u00a0course for product development at Cornell Tech. Students form semester-long teams and select a \"How Might We\" question posed by a company.\u00a0During the semester students learn the basics of product development so they can apply the knowledge and skills\u00a0from their degree program: identifying impactful problems to solve, product ideation and\u00a0design, development process, and constructing\u00a0a meaningful\u00a0product narrative and complete\u00a0product loop.\u00a0Students present their working\u00a0product, narrative, and\u00a0thought\u00a0process four times during the semester, after completing each of\u00a0three 24-hour \"studio sprints\" where they will focus on developing their product and a final product presentation at the end of the semester.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Cornell Tech students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "CT", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 369809, "crseOfferNbr": 1, "subject": "TECH", "catalogNbr": "5999", "titleShort": "Independent Study", "titleLong": "Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 17165, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "sa933", "firstName": "Shiri", "middleName": "", "lastName": "Azenkot"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDesc