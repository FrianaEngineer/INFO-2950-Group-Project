or S/U grades (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Continuation of KOREA 2209.  Designed for Korean heritage students who can understand and speak Korean, but especially need to refine their reading and writing skills. Students will acquire concrete knowledge of grammar to use in everyday conversation, and will minimize their spelling errors in writing, through frequent discussion and composition about Korean culture, society and history. The survey group project on the cultural differences, and the individual project on one's life will enhance students' overall linguistic skills.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: grade of B- or higher in KOREA 2209, or online placement test required (collt.lrc.cornell.edu).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 14 students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 351245, "crseOfferNbr": 1, "subject": "KOREA", "catalogNbr": "3302", "titleShort": "High Intermediate Korean II", "titleLong": "High Intermediate Korean II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5642, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 3, "netid": "hk783", "firstName": "Hankyul", "middleName":