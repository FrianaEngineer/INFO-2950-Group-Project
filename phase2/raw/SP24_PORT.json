": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This is a course designed to intermediate students to enhance their oral and written communication skills in Portuguese while engaging a broad range of topics related to Afro-Luso-Brazilian culture. Along with the textbook, students will read a short-essay book, be exposed to a number of films and critically reflect and discuss the films and readings. Students will continue to build their knowledge on grammar and vocabulary as well as Global Portuguese culture and language diversity.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Although most of the materials are geared to speakers of Spanish, speakers of other romance languages, such as French, Italian, or Catalan, etc. will also find this course effective as an introduction to Portuguese.", "catalogPrereqCoreq": "Prerequisite:\u00a0PORT 2010.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 367690, "crseOfferNbr": 3, "subject": "PORT", "catalogNbr": "3480", "titleShort": "Brazilian Music & Culture", "titleLong": "Brazilian Culture through its Music", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19859, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/22/2024", "endDt": "