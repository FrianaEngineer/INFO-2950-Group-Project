tName": "Navickas"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "For more information about First-Year Writing Seminars, see the Knight Institute website at http://knight.as.cornell.edu/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "FWS: Bridging Differences", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "FWS", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "FWS Session", "exploreCriteriaIds": null}], "description": "Drawing upon personal or academic experiences and interests, students select their own topics and design research portfolios that highlight significant analytic research. To do this, you will step through the Cornell Library gateway and receive a semester-long guided tour through one of the world's most amazing research libraries\u2013\u2013its vast search engines, its abundant print and electronic collections, its precious special collections and archives. This introduction to college research explores using data bases, evaluating information, and engaging both to produce effective academic writing. Study techniques of analysis for converting scholarly information into thesis, synthesizing and acknowledging sources, developing voice and style, crafting technically and rhetorically sophisticated prose.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 371480, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "2101", "titleShort": "Rspnding to Wtg:Theory&Pedagog", "titleLong": "Responding to Writing: Theory & Pedagogy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19481, "meetings": [{"classMtgNbr": 1, "timeStart": "04:30PM", "timeEnd": "06:00PM", "startDt": "03/29/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "ken43", "firstName": "Kate", "middleName": "", "lastName": "Navickas"}], "pattern": "T", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Students interested in this course should apply to be a Cornell Writing Centers tutor at the beginning of the spring semester. All successful tutor applicants will be enrolled automatically. To apply, go here: https://knight.as.cornell.edu/become-wc-tutor To enroll without becoming a tutor, please contact Dr. Kate Navickas, ken43@cornell.edu. Special consideration may be granted based on space, interest, and major. Day/time for this class may change depending on availability of hired tutors."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/29/2021", "endDt": "05/25/2021", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/29/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": null}], "description": "This course introduces students to scholarship on writing pedagogy, requiring them to think critically about collaborative learning strategies, multilingual writing challenges, ethical considerations in peer tutoring, and the ways in which race and other facets of identity inform teaching and learning. The learning objectives include: develop an understanding of different theories of writing and the history of writing centers; practice reading and responding to a variety of different writing genres and student situations in ways that connect theory to practice; learn to question assumptions in specific pieces of writing, frameworks for writing, and in pedagogical interactions; self-reflect on individual writing processes, writing, and previous educational experiences; analyze the ways in which writer and tutor identities affect pedagogical interactions and learn strategies for equitable and ethical tutoring; develop confidence in suggesting interventions for other writers at various stages of their writing processes; and, gain flexibility in utilizing a variety of strategies for fostering writer agency and growth.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "cata