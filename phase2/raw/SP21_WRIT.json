nd share drafts. With smaller class sizes, two 50-minute class sessions and weekly student / teacher conferences, Writing 1380 provides an individualized setting for students to learn flexible and sustainable strategies for studying the essential elements of academic writing and for producing clear, precise academic prose that can address a variety of audiences and meet diverse rhetorical aims.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 353946, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "1390", "titleShort": "Special Topics in Writing", "titleLong": "Special Topics in Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5012, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "thc33", "firstName": "Tracy", "middleName": "Hamler", "lastName": "Carrick"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDesc