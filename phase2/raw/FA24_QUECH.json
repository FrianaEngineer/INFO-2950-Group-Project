{"status": "success", "data": {"classes": [{"strm": 2881, "crseId": 353315, "crseOfferNbr": 1, "subject": "QUECH", "catalogNbr": "1210", "titleShort": "Elem Quechua I", "titleLong": "Elementary Quechua I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20025, "meetings": [{"classMtgNbr": 2, "timeStart": "04:45PM", "timeEnd": "06:00PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 4, "netid": "em889", "firstName": "Edwin Eddy Johan", "middleName": "", "lastName": "Machaca Condori"}], "pattern": "MW", "facilityDescr": "Klarman Hall K155", "bldgDescr": "Klarman Hall", "facilityDescrshort": "KLRK155", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LATA", "catalogNbr": "1210", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "1210-1220 is an introductory sequence that allows students to develop basic fluency in Quechua, the most widely spoken indigenous language in the Americas. Students learn elements of Quechua's phonetics, vocabulary, morphology and syntax through an interactive approach and gain awareness of regional and dialectal differences. The course focuses on oral and written skills, with emphasis on tasks based on familiar contexts of use. It also introduces learners to the history, culture and geography of the Andes through exposure to cultural practices, proverbs, folklore, and artefacts of the region (e.g. textiles). Students will reflect on Quechua as an endangered language and on the significance of keeping this very popular indigenous language of Latin America alive.", "catalogBreadth": null, "catalogDistr": "(FL-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-12-22T19:33:00-0500", "catalogDttm": "2024-12-22T19:07:15-0500"}}