is course seeks to answer that question by exploring the components of service learning as a discipline and to strengthen the intellectual foundation of students who wish to incorporate civic engagement into their curriculum. Students will become familiar with the history of service learning, explore competing theories of social justice and social inequality, and develop a framework for social action that exists at the juncture of theory and practice. Readings will include texts by Dewey, Freire, bell hooks, Franklin, Jefferson, Thoreau, Addams, Baldwin, King, Dorothy Day, and Fanon. Weekly seminar papers as well as a term paper through which students develop their own philosophy of civic engagement.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 353948, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "7101", "titleShort": "Writing In The Majors Seminar", "titleLong": "Writing in the Majors Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 6124, "meetings": [{"classMtgNbr": 1, "timeStart": "07:00PM", "timeEnd": "09:30PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "ehs9", "firstName": "Elliot", "middleName": "Hart", "lastName": "Shapiro"}], "pattern": "R", "facilityDescr": "White Hall B02", "bldgDescr": "White Hall", "facilityDescrshort": "WHTB02", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "