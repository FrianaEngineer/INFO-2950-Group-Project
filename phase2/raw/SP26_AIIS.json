t history remains cloaked behind various Western legal-religious justifications for the dispossession of lndigenous American populations by Europeans (i.e., terra nullius, the Doctrine of Discovery, the right of conquest, and Manifest Destiny). Through analysis of primary texts and up-to-date historical and legal scholarship, students in this course will unpack these still-thriving tropes of settler-colonial justification for dispossession, assess the true impact of the taking of Indigenous lands, and explore prospects for meaningful reconciliation in the present.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2024SP, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 354481, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "4970", "titleShort": "Independent Study", "titleLong": "Independent Study", "crseAttrs": [{"crseAttr": "0013", "crseAttrValue": "CU-UGR", "descr": "Undergraduate Research", "descrformal": "Undergraduate Research", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}], "crseAttrValueGroups": [{"attrDescr": "Exploratory Studies", "crseAttrValues": "(CU-UGR)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "602", "classNbr": 13048, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/20/2026", "end