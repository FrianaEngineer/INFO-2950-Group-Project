"", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 367770, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "5300", "titleShort": "HR and Outsourcing in the Netw", "titleLong": "Human Resources and Outsourcing in the Networked Firm", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14175, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "vld7", "firstName": "Virginia", "middleName": "L", "lastName": "Doellgast"}], "pattern": "TR", "facilityDescr": "Ives Hall 107", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS107", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course examines outsourcing decisions from a human resources perspective, and the human resource implications of managing workers in increasingly networked organizations. Outsourcing, offshoring, spin-offs, and the use of temporary staffing agencies all create challenges for human resource management. Firms face issues of retaining employee knowledge and skills, coordinating HR policies across multiple subcontractors, and motivating workers on different employment contracts \u2013 who in some cases work together within a workplace or virtually. In addition, organizations face increasingly complex decisions concerning the mix of sourcing strategies to use for their own HR functions and processes. The quality and content of these decisions have implications for performance outcomes, as well as for job quality and employee careers. We will analyze these challenges and evaluate strategies to address them from a comparative and international perspective, using industry- and firm-based case studies from North America, Europe, and Asia. The course will end with a discussion of current and future trends, including crowdsourcing, managing the human cloud, and the sharing economy. Some sample company case studies include Boeing, P&amp;G, Toyota, and IKEA.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 370275, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "5310", "titleShort": "Labor Solidarity and Union Cam", "titleLong": "Labor Solidarity and Union Campaigns", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "S