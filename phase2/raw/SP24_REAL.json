"instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AEM", "catalogNbr": "7005", "type": "C"}, {"subject": "ECON", "catalogNbr": "7010", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores links between urbanization and real estate markets. High downtown rents reflect the benefits of proximity to other companies and natural features like port facilities. High housing costs reflect proximity to jobs and the lure of urban amenities. At the same time, segregation and congestion are often exacerbated by urbanization, the costs of which are seen in inequality, crime, pollution, and traffic jams. Urban real estate markets are also affected by local government policy, including enforcement of property rights, zoning, tax and subsidy programs. Shrinking rust belt cities and work from home threaten to undermine urban real estate markets, while volatility and uncertainty contributes to mispricing. These and related ideas will be explored drawing on context from countries around the world.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Elective.\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00