nover, and the theory of human capital; incentive schemes and promotions; layoffs, downsizing, and buyouts; teamwork; and internal labor markets. Focuses on labor-related business problems using the analytic tools of economic theory and should appeal to students with strong quantitative skills who are contemplating careers in general business, consulting, and human resource management as well as in economics.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 360379, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "5400", "titleShort": "Labor Economics", "titleLong": "Labor Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10920, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 3, "netid": "gsf2", "firstName": "Gary", "middleName": "", "lastName": "Fields"}], "pattern": "MW", "facilityDescr": "Ives Hall 219", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS219", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: students in the Master of Industrial and Labor Relations (MILR) degree program."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": 