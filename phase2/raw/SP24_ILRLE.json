", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19867, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "mnd43", "firstName": "Milena", "middleName": "Nikolaeva", "lastName": "Djourelova"}], "pattern": "MW", "facilityDescr": "Goldwin Smith Hall G64-Kau Aud", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSHG64", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3280", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course will provide an overview of recent empirical research in political economy, which applies the toolbox of economic and econometric analysis to the study of politics. The focus will be on the politics of the policymaking process.\u00a0 It will cover the following topics: (1) Voters' behavior; (2) Politicians' behavior; (3) Information and mass media; (4) Political distortions and capture; (5) Political institutions. The course will be based on the reading of research papers and the in-depth discussion of their implications for public policy.", "catalogBreadth": "", "catalogDistr"