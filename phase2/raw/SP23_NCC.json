", "startDt": "02/17/2023", "endDt": "02/17/2023", "instructors": [{"instrAssignSeq": 1, "netid": "amd365", "firstName": "Andrew", "middleName": "M.", "lastName": "Davis"}], "pattern": "F", "facilityDescr": "Sage Graduate Hall B09", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGHB09", "meetingTopicDescription": ""}, {"classMtgNbr": 3, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "03/03/2023", "endDt": "03/03/2023", "instructors": [{"instrAssignSeq": 1, "netid": "amd365", "firstName": "Andrew", "middleName": "M.", "lastName": "Davis"}], "pattern": "F", "facilityDescr": "Sage Graduate Hall B09", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGHB09", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "**Open to first-year MBA students only** Non-MBA students will not be allowed to take to this course. No exceptions will be made.\nThis course counts as a Management Science Course."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "03/31/2023", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 2.5, "unitsMaximum": 2.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Focuses on managing processes: actions that convert inputs into outputs. Almost any business function can be modeled as a network of processes. The first part of the course examines processes, both individually and as part of a larger system. It also covers queuing theory and Monte Carlo simulation, both of which are particularly helpful for analyzing process capabilities. The second part of the course analyzes how goods and services are produced. In particular, it examines quality and lean operations, inventory and forecasting, and supply chain management. The second part also covers constrained optimization models, which provides information about handling finite resources. An overall common course theme is the deleterious effect of variability (in demand, supply, quality, or capacity) in complex systems.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "Johnson School core course. Non-Johnson students, see NCC 5580.", "catalogPrereqCoreq": "Prerequisite: NCC 5010\u00a0or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Johnson MBA first-year students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 350805, "crseOfferNbr": 1, "subject": "NCC", "catalogNbr": "5500", "titleShort": "Financial Accounting", "titleLong": "Financial Accounting", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8447, "meetings": [{"classMtgNbr": 1, "timeStart": "10:05AM", "timeEnd": "11:20AM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 27, "netid": "jl4262", "firstName": "Jin Hee", "middleName": "", "lastName": "Lee"}, {"instrAssignSeq": 23, "netid": "jy937", "firstName": "Jiawen", "middleName": "", "lastName": "Yan"}], "pattern": "TR", "facilit