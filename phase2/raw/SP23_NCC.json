Dt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course provides an introduction to business finance through lectures and assignments. The content of the course varies with the section and instructor. Topics may include basic financial accounting, time value of money, stock and bond valuation, capital budgeting, portfolio theory, asset-pricing models, cost of capital, dealing with risk, capital structure, acquisitions, and options. Application of theory to practical applications will be stressed in the lectures.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will not receive credit for both\u00a0HADM 2220\u00a0and NCC 5560.\n\u00a0", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "This course is similar in content to MBA\u00a0core course NCC 5060. Please note: undergraduate students\u00a0are\u00a0limited to which section they can enroll in, no exceptions. Graduate students have first priority in the event the course is oversubscribed.", "catalogPrereqCoreq": "Prerequisite: instructors of some sections may require a previous course in financial accounting.\u00a0", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: non-Johnson School graduate students for the Fall semester. Undergraduate seniors and juniors may only enroll in the Spring semester.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 350815, "crseOfferNbr": 1, "subject": "NCC", "catalogNbr": "5580", "titleShort": "Managing Operations", "titleLong": "Managing Operations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8361, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/23/2023", "endDt": "04/09/2023", "instructors": [{"instrAssignSeq": 19, "netid": "nst43", "firstName": "Natalia", "middleName": "", "lastName": "Santamaria"}], "pattern": "MW", "facilityDescr": "Sage Graduate Hall B01", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGHB01", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "04/10/2023", "endDt": "04/10/2023", "instructors": [{"instrAssignSeq": 19, "netid": "nst43", "firstName": "Natalia", "middleName": "", "lastName": "Santamaria"}], "pattern": "M", "facilityDescr": "Sage Graduate Hall B05", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGHB05", "meetingTopicDescription": ""}, {"classMtgNbr": 3, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "04/11/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 19, "netid": "nst43", "firstName": "Natalia", "middleName": "", "lastName": "Santamaria"}], "pattern": "MW", "facilityDescr": "Sage Graduate Hall B01", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGHB01", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to non-MBA Graduate and UG Seniors Only.\nNon-MBA Students ONLY: Add/drop: January 17th at 9:00am to February 6th at 11:59pm.  You may add or drop a full semester class after February 6th with permission of the faculty. A late fee of $100.00 will be charged for each add or drop transaction. If you are dropping after March 20th at 11:59pm you will also receive a \"W\" on your transcript in addition to the late fees."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Operations Management is the design and management of processes that transform inputs into finished goods or services. All organizations have operations that directly affect their ability to execute on their specified strategies. This course prepares students to think analytically and managerially about operations processes, and to use the tools and intuition they acquire to ensure that the operations in production and service systems support the business strategies for these systems. A process view of operations will be used to analyze different key operational dimensions such as capacity analysis, service operations management, quality management, inventory management and supply chain management.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Similar in content to M.B.A. core course NCC 5080.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: undergraduate seniors and graduate non-Johnson students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the Univ