ment for people who will manage technical or engineering projects. Focuses both on the \"technical\" tools of project management (e.g., methods for planning, scheduling, and control) and the \"human\" side (e.g., forming a project team, managing performance, resolving conflicts), with somewhat greater emphasis on the latter.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 358721, "crseOfferNbr": 2, "subject": "ENMGT", "catalogNbr": "5910", "titleShort": "Engineering Management Project", "titleLong": "Engineering Management Project", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17430, "meetings": [{"classMtgNbr": 1, "timeStart": "05:30PM", "timeEnd": "06:30PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}], "pattern": "M", "facilityDescr": "Hollister Hall 366", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS366", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "op