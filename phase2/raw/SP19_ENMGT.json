ile staying on top of the current pace of technological change. In this Engineering Management project course, we are bridging from your coursework to your role as an engineering manager. To get there, you will practice the tools, themes, and techniques learned in your Engineering Management coursework through the scaffolding of a large project. In CEE 5910, you will work in teams to lead and execute a project in collaboration with an industry partner. You will perform an intensive evaluation of some mixture of the technological and management aspects of a major engineering project or system, conducted with a team of students.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 370144, "crseOfferNbr": 1, "subject": "ENMGT", "catalogNbr": "5920", "titleShort": "Product Management", "titleLong": "Product Management", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17976, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}], "pattern": "TR", "facilityDescr": "Upson Hall 216", "bldgDescr": "Upson Hall", "facilityDescrshort": "UPS216", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "s