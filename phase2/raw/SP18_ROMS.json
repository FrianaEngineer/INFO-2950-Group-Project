logCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369081, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "3750", "titleShort": "Bohemians", "titleLong": "Bohemians:Between Aesthetics and Politics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 15870, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 1, "netid": "vt225", "firstName": "Enzo", "middleName": "", "lastName": "Traverso"}], "pattern": "TR", "facilityDescr": "Uris Hall 254", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH254", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2018", "endDt": "05/09/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "HIST", "catalogNbr": "2075", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "In 1849, Th\u00e9ophile Gautier described Bohemianism as \"love of art and hatred of the bourgeois.\"\u00a0 For almost two centuries, between Montmartre in Paris and Greenwich Village in New York, passing through Munich, Vienna, Milan, and Buenos Aires, Bohemianism expressed an aesthetic and political revolt against the capitalist ethics of work, sexual conformism, repressive order, and the conventions of academic art.\u00a0 Its representatives were young people whose precarious life took place in the margins of these great cities.\u00a0 Artists, writers, and political conspirators were the heroes of this fragmented and highly unstable avant-garde.\u00a0 This course will retrace the main steps of Bohemianism, from Murger and Courbet to Dada and surrealism, from The Masses to the Beatniks and the Punk movement of the 1970s.\u00a0 Karl Marx,\u00a0 Andr\u00e9 Breton, Walter Benjamin, John Reed, Claude Cahun, Hannah Arendt, Allen Ginsberg and other thinkers will help us to explore this vast intellectual and aesthetic landscape.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369082, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "4370", "titleShort": "Holocaust & History Writing", "titleLong": "The Holocaust and History Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 15871, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 1, "netid": "vt225", "firstName": "Enzo", "middleName": "", "lastName": "Traverso"}], "pattern": "W", "facilityDescr": "McGraw Hall 365", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG365", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2018", "endDt": "05/09/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "FREN", "catalogNbr": "4375", "type": "B"}, {"subject": "FREN", "catalogNbr": "6375", "type": "B"}, {"subject": "GERST", "catalogNbr": "4375", "type": "B"}, {"subject": "GERST", "catalogNbr": "6375", "type": "B"}, {"subject": "HIST", "catalogNbr": "4237", "type": "B"}, {"subject": "HIST", "catalogNbr": "6237", "type": "B"}, {"subject": "ROMS", "catalogNbr": "6370", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "In the last decades, \"Holocaust Studies\" witnessed an extraordinary expansion, covering different fields of scholarship, from history to literature, from philosophy to aesthetics.\u00a0 This seminar will retrace the major steps of Holocaust history writing.\u00a0 It will analyze the classical debates between \"intentionalism\" and \"functionalism,\" the discrepancies between the analytical approaches focused on the perpetrators and those focused on the victims, the inscription of the Holocaust into the broader context of war violence, and its comparison with the genocidal violence of colonialism.\u00a0 Finally, it will investigate some methodological problems concerning the place of testimony in history writing and the permanent connections, both fruitful and problematic, between history and memory.\u00a0 This means taking into account the entanglement of the most productive areas of Holocaust scholarship (Germany, France and the United States) as well as the relationship between the historiography of the Holocaust and other disciplines (memory studies, postcolonial studies, etc.).", "catalogBreadth": "", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369285, "crseOfferNbr": 7, "subject": "ROMS", "catalogNbr": "4625", "titleShort": "Undocumentation", "titleLong": "Undocumentation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16495, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 1, "netid": "asc10", "firstName": "Amy", "middleName": "Sara", "lastName": "Carroll"}], "pattern": "R", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2018", "endDt": "05/09/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4620", "type": "C"}, {"subject": "COML", "catalogNbr": "4616", "type": "C"}, {"subject": "FGSS", "catalogNbr": "4620", "type": "C"}, {"subject": "LATA", "catalogNbr": "4620", "type": "C"}, {"subject": "LSP", "catalogNbr": "4621", "type": "C"}, {"subject": "SHUM", "catalogNbr": "4620", "type": "C"}, {"subject": "VISST", "catalogNbr": "4620", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "In this seminar we will sustain a particular reading of post-1984 Mexico-US border cultural production as \"undocumentation.\" Specifically, we will focus on performance, conceptual, and cinematic practices that corrupt the spreadsheet and the expos\u00e9; that reflect their makers' commitments to portraying extreme labor situations in a period of greater Mexican neoliberal transition now synonymous with NAFTA, culture and drug wars, and border militarization and maquilization. Assigned texts will include artwork by the Border Art Workshop and Elizabeth Sisco, Louis Hock, and David Avalos; writing by Gloria Anzald\u00faa, Guillermo G\u00f3mez-Pe\u00f1a, Sara Uribe, and Sergio Gonz\u00e1lez Rodr\u00edguez; contributions to the Tijuana-San Diego installation festival inSITE; and \"undocumentaries\" like Alex Rivera's Borders Trilogy, Sergio De La Torre and Vicki Funari's Maquilapolis, and Natalia Almada's El Velador.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 359117, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "5070", "titleShort": "Romance Lang Learn &Teach", "titleLong": "Methodology of Romance Language Learning and Teaching", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5619, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "12:05PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 4, "netid": "mkr4", "firstName": "Mary", "middleName": "Kathryn", "lastName": "Redmond"}], "pattern": "M", "facilityDescr": "Klarman Hall KG42", "bldgDescr": "Klarman Hall", "facilityDescrshort": "KLRKG42", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This is the mandatory course for graduate students wishing to TA in Romance Studies."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2018", "endDt": "05/09/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Focuses on language teaching as facilitation of learning, thus on the learner's processing of language acquisition and the promotion of reflective teaching. Pedagogical approaches will be addressed from a learner-centered perspective involving effective language learning strategies and analysis.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Required for all graduate TAs who will be teaching Romance languages for the first time at Cornell.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369083, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "6370", "titleShort": "Holocaust & History Writing", "titleLong": "The Holocaust and History Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 15874, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 1, "netid": "vt225", "firstName": "Enzo", "middleName": "", "lastName": "Traverso"}], "pattern": "W", "facilityDescr": "McGraw Hall 365", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG365", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2018", "end