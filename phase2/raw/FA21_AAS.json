"strm": 2797, "crseId": 370959, "crseOfferNbr": 4, "subject": "AAS", "catalogNbr": "6611", "titleShort": "Minoritarian Aesthetics", "titleLong": "Minoritarian Aesthetics In-And Performance", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19411, "meetings": [{"classMtgNbr": 1, "timeStart": "11:25AM", "timeEnd": "12:40PM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 1, "netid": "kj12", "firstName": "Karen", "middleName": "", "lastName": "Jaime"}], "pattern": "TR", "facilityDescr": "Schwartz Ctr-Perform Arts 124", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ124", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "6612", "type": "C"}, {"subject": "LSP", "catalogNbr": "6611", "type": "C"}, {"subject": "PMA", "catalogNbr": "6611", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "What are minoritarian aesthetics? How do these inform the production and reception of performance, broadly defined? How does attending to the aesthetics involved in the production of artistic and cultural productions open up new ways of critically understanding the world around us? In seeking to answer these questions, and others, this seminar will introduce graduate students to theories and critiques that attend to the aesthetic dimensions of visual culture, scripted staged performances, performance art, and contemporary media created by Black, queer, Asian, Caribbean, and Latinx/Latin people. Drawing on the work of theorists Fred Moten, Jos\u00e9 Esteban Mu\u00f1oz, Leticia Alvarado, and Sandra Ruiz amongst others, students will interrogate the dialectical relationship between the artist's subject position and their resultant creative and critical work.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-02-07T19:27:30-0500", "catalogDttm": "2022-02-07T19:14:23-0500"}}