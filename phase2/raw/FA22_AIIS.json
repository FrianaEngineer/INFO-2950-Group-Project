/2022", "instructors": [], "pattern": "W", "facilityDescr": "Kennedy Hall 101", "bldgDescr": "Kennedy Hall", "facilityDescrshort": "KND101", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "1600", "type": "C"}, {"subject": "ANTHR", "catalogNbr": "1700", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course provides an interdisciplinary introduction to the diverse cultures, histories and contemporary situations of the Indigenous peoples of North America. Students will also be introduced to important themes in the post-1492 engagement between Indigenous and settler populations in North America and will consider the various and complex ways in which that history affected - and continues to affect - American Indian peoples and societies. Course materials draw on the humanities, social sciences, and expressive arts.", "catalogBreadth": "", "catalogDistr": "(D-AG, HA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesRe