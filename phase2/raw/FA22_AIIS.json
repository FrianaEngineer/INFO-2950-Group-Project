": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 368690, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "6200", "titleShort": "Philosophies of Dispossession", "titleLong": "Locke and the Philosophies of Dispossession: Indigenous America's Interruptions and Resistances", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19006, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "04:30PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "tar37", "firstName": "Troy", "middleName": "A.", "lastName": "Richardson"}], "pattern": "M", "facilityDescr": "Caldwell Hall 400", "bldgDescr": "Caldwell Hall", "facilityDescrshort": "CLD400", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AIIS", "catalogNbr": "4200", "type": "B"}, {"subject": "AMST", "catalogNbr": "4220", "type": "B"}, {"subject": "AMST", "catalogNbr": "6220", "type": "B"}, {"subject": "PHIL", "catalogNbr": "4941", "type": "B"}, {"subject": "PHIL", "catalogNbr": "6941", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course looks at the philosopher John Locke as a philosopher of dispossession. There is a uniquely Lockean mode of missionization, conception of mind and re-formulations of the 'soul' applied to dispossess Indigenous peoples of the social institutions, intellectual traditions and the material bases and practices which sustain(ed) them. While colonization is typically used as a kind of shorthand for this process, we will be attempting to stay focused on the specific dimensions of Lockean dispossession and its mutually informing relationship with English colonialism.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Recommended prerequisite: AIIS 1110\u00a0and AIIS 4000/AIIS 6000.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Demonstrate a fluency in the philosophical formulations for settler colonialism and the historical and ongoing dispossessing of Native Americans\u2014specifically, a fluency in Locke's philosophies of 1) the workmanship theory of property, 2) of consciousness and the modern \"self,\" 3) theories of mind, 4) metaphysics and theology.", "Develop enhanced interpretive abilities through formal presentations and writing assignments.", "Apply pedagogical skills in teaching course content where they lead seminar topics.", "Employ sharpened interpretation and critical analysis skills through course writing assignments and structured editorial assistance to 1) concisely convey central argument(s) of texts, 2) make warrantable claims using relevant historical, philosophical, legal and material/empirical evidence, 3) clearly indicate one's positionality in developing arguments."], "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 351907, "crseOfferNbr": 2, "subject": "AIIS", "catalogNbr": "6451", "titleShort": "Federal Indian Law", "titleLong": "Federal Indian Law", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 20684, "meetings": [{"classMtgNbr": 1, "timeStart": "02:15PM", "timeEnd": "03:55PM", "startDt": "08/22/2022", "endDt": "12/01/2022", "instructors": [{"instrAssignSeq": 1, "netid": "rop28", "firstName": "Robert", "middleName": "Odawi", "lastName": "Porter"}], "pattern": "R", "facilityDescr": "Myron Taylor Hall G85", "bldgDescr": "Myron Taylor Hall", "facilityDescrshort": "MTHG85", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "10:10AM", "timeEnd": "11:35AM", "startDt": "08/22/2022", "endDt": "12/16/2022", "instructors": [{"instrAssignSeq": 1, "netid": "rop28", "firstName": "Robert", "middleName": "Odawi", "lastName": "Porter"}], "pattern": "F", "facilityDescr": "Myron Taylor Hall G85", "bldgDescr": "Myron Taylor Hall", "facilityDescrshort": "MTHG85", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "LAW", "catalogNbr": "6451", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The course will focus on the basics of Federal Indian Law, the ever-changing body of case and statutory law and treaties that define the limits and extent of Indian tribal sovereignty in the United States in the late twentieth century. The course will explore the nature and extent of tribal sovereignty at the time of European contact, the changing strategies of the United States in relating to tribes, and the lasting impact of those strategies on current-day tribal communities and their rights of self-government. The course will also explore the role of the United States in protecting tribal sovereignty and tribal resources. It will also examine the powers and jurisdiction of tribal governments with regard to both members and non-members of the tribe, as well as the lack or extent, as the case may be, of state jurisdiction over activities on Indian lands. Students will be encouraged to continually identify and question the legal, political and moral basis of the laws and policies that constitute Federal Indian Law in the United States today. We will also examine the current ALI restatement project for Federal Indian Law.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 360403, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "6970", "titleShort": "Independent Study in AIS", 