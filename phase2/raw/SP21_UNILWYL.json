: "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "This is a Learning Where You Live Course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: West Campus sophomores and juniors.", "catalogCourseSubfield": "", "catalogOutcomes": ["Develop a deep understanding of the career fields covered in the course.", "Identify career paths in these same fields.", "Develop interviewing skills.", "Develop resume writing skills.", "Develop cover letter writing skills.", "Develop interpersonal communication and networking skills."], "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 371199, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1450", "titleShort": "Toxic Inequality", "titleLong": "Toxic Inequality: Environmental Justice in America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16873, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "03/29/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "srb237", "firstName": "Shorna", "middleName": "Broussard", "lastName": "Allred"}], "pattern": "M", "facilityDescr": "Malott Hall 253", "bldgDescr": "Malott Hall", "facilityDescrshort": "MLT253", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This is a Learning Where You Live course."}, {"classNotesSeq": 2, "descrlong": "Enrollment limited to students who are able to attend in-person classes in the Ithaca area."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/29/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/29/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": null}], "description": "This course explores social justice in the environmental context and will engage students in the theory and practice of environmental justice with a particular focus on inequality. Students should have a strong interest in learning about the history and challenges of environmentally overburdened communities \u2014 often communities of color and low-income communities\u2014while also exploring strategies for addressing inequalities as they relate to the environment. Students will learn and practice critical reflection as an essential component of this course and we will employ visual, oral, and narrative forms of reflection to appeal to a variety of learning styles.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Off