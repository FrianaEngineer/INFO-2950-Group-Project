mus, Newton, and many others, students will be able to talk about their favorite sports team, television show, musician, or video game, as well as the Heisenberg Uncertainty Principle and baking cookies (all presentations students have given in the past!). Students should come to this course with a solid grounding in Latin grammar, although no previous spoken Latin is presumed.", "catalogBreadth": "(GHB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: LATIN 2201 or placement above LATIN 2201 on departmental exam.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 369777, "crseOfferNbr": 1, "subject": "LATIN", "catalogNbr": "2209", "titleShort": "Latin Poetry", "titleLong": "Latin Poetry", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 9603, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "dbg223", "firstName": "Daniel", "middleName": "B.", "lastName": "Gallagher"}], "pattern": "MWF", "facilityDescr": "Goldwin Smith Hall 124", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH124", "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: LATIN 2201 or placement above LATIN 2201 on departmental exam."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "