 null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, EC-LASP)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 369433, "crseOfferNbr": 3, "subject": "LATA", "catalogNbr": "7250", "titleShort": "Time & History Ancient Mexico", "titleLong": "Time and History in Ancient Mexico", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19526, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "01:45PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "jsh6", "firstName": "John", "middleName": "S.", "lastName": "Henderson"}], "pattern": "M", "facilityDescr": "McGraw Hall 215", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG215", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "4256", "type": "B"}, {"subject": "ANTHR", "catalogNbr": "7250", "type": "B"}, {"subject": "ARKEO", "catalogNbr": "4256", "type": "B"}, {"subject": "ARKEO", "catalogNbr": "7250", "type": "B"}, {"subject": "LATA", "catalogNbr": "4250", "type": "B"}, {"subject": "RELST", "catalogNbr": "4256", "type": "B"}, {"subject": "RELST", "catalogNbr": "7250", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Explores the ways Mesoamericans understood the world and their place in it, and the ways they constructed history as these are reflected in the few books that have survived from the period before the European invasion. Examines the structure of writing and systems of notation, especially calendars, and considers their potential for illuminating Mesoamerican world views and approaches to history. Primary focus is detailed analysis of five precolumbian books: Codex Borgia, a central Mexican manual of divinatory ritual; Codex Boturini, a history of migration in central Mexico; Codex Nuttall, a Mixtec dynastic history; and two Maya books of astrology and divination, Codex Dresden and Codex Madrid.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-12-22T19:33:00-0500", "catalogDttm": "2024-12-22T19:07:15-0500"}}