": []}], "description": "This course explores major texts and themes of the Hispanic tradition from the 11th to the 17th centuries. We will examine general questions on literary analysis and the relationship between literature and history around certain events, such as medieval multicultural Iberia, the creation of the Spanish Inquisition in the 15th century and the expulsion of the Jews in 1492; the encounter between the Old and the New Worlds; the 'opposition' of high and low in popular culture, and of the secular and the sacred in poetry and prose. Readings may be drawn from medieval short stories and miracle collections; chivalric romances, Columbus, Lazarillo de Tormes, Cervantes, Lope de Vega, Calder\u00f3n, and Sor Juana In\u00e9s de la Cruz, among others.", "catalogBreadth": null, "catalogDistr": "(ALC-AS, HST-AS) (FL-AG)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0SPAN 2095\u00a0, or CASE Q++.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 372801, "crseOfferNbr": 4, "subject": "LATA", "catalogNbr": "2252", "titleShort": "Diasporas Spanish Caribbean", "titleLong": "Diasporas from the Spanish Caribbean", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18189, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "mcg20", "firstName": "Maria Cristina", "middleName": "", "lastName": "Garcia"}], "pa