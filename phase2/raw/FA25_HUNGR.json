EULANG", "descr": "European Studies Lang", "descrformal": "European Studies Language", "attrDescr": "Area Studies", "attrDescrShort": "Area Std"}], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/25/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "In Elementary Hungarian I you will learn four communicative skills of comprehension, speaking, and writing.  During the first semester you will learn to communicate through dialogues about hobbies, where you live, what languages you speak and study, telling time, shopping, what you have, your family.  You will learn to make hotel and restaurant arrangements, describe your friends, family, and environment, discuss interests and more. You will learn at least 13 cases, two verb conjugations for the present tense, verbal prefixes, how to form plurals, adverbs, adjectives, and to express possession and the future. You will learn a lot of grammar and learn to use it frequently and creatively through a variety of conversational environments. You will read dialogues and short texts at every class and will write dialogues and descriptive texts of your own.  You will also learn about Hungarian culture so that you become both grammatically and social correct.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalog