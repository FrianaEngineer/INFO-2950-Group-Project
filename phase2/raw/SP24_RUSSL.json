{"status": "success", "data": {"classes": [{"strm": 2867, "crseId": 371491, "crseOfferNbr": 1, "subject": "RUSSL", "catalogNbr": "3351", "titleShort": "Pushkin's Fictions", "titleLong": "Pushkin's Fictions", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17615, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:15PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "np27", "firstName": "Nancy", "middleName": "", "lastName": "Pollak"}], "pattern": "MWF", "facilityDescr": "Rockefeller Hall 189", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK189", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Alexander Pushkin (1799-1837) is among the greatest of Russian writers and a central figure in Russian culture. In a short life \u2013 he was killed in a duel at 37 \u2013 he wrote in a wide variety of forms. He is best known as a poet, but his fiction marks the beginning of the Russian novel; to understand Tolstoy and Dostoevsky, we need to read Pushkin. Among the fictions we will read are stories, including the Tales of Belkin and \"The Queen of Spades,\" the short novel The Captain's Daughter, the novel in verse Eugene Onegin, and the historical novel about the author's African ancestor, The Moor of Peter the Great. We will also read selected short poems.", "catalogBreadth": "(HB)", "catalogDistr": "(ALC-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "All reading is in English.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "This course satisfies one of the literature requirements for the Russian minor.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373573, "crseOfferNbr": 1, "subject": "RUSSL", "catalogNbr": "3389", "titleShort": "The Revolutionary as Author", "titleLong": "The Revolutionary as Author: Autobiography and Political Myth", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17616, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "sp2357", "firstName": "Sophie", "middleName": "", "lastName": "Pinkham"}], "pattern": "MW", "facilityDescr": "Uris Hall 494", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH494", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "3389", "type": "C"}, {"subject": "ENGL", "catalogNbr": "3989", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "In this course, we will read some of the most influential examples of a genre at the intersection of literature and history: the memoir of the revolutionary. As we study the autobiographies of Russian, American, Spanish, and German leftist political figures like Leon Trotsky, Emma Goldman, Dolores Ibarrui, and Angela Davis, we will consider the literary methods these writers use to intertwine their own life stories with political history. How is life-writing a form of revolutionary self-fashioning? What is the political utility of autobiographies like these? With special attention to the question of gender, ethnicity, religion, and race.", "catalogBreadth": "(HB)", "catalogDistr": "(ALC-AS, HST-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 370330, "crseOfferNbr": 2, "subject": "RUSSL", "catalogNbr": "4172", "titleShort": "Tolstoy:History&CounterCulture", "titleLong": "Tolstoy: History and Counter-Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17695, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ol76", "firstName": "Olga", "middleName": "", "lastName": "Litvak"}], "pattern": "M", "facilityDescr": "Uris Hall 498", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH498", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "DIS", "ssrComponentLong": "Discussion", "section": "201", "classNbr": 17696, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "03:20PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ol76", "firstName": "Olga", "middleName": "", "lastName": "Litvak"}], "pattern": "W", "facilityDescr": "Uris Hall 369", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH369", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM", "DIS"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "HIST", "catalogNbr": "4172", "type": "C"}, {"subject": "SHUM", "catalogNbr": "4172", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Tolstoy is impossible. An aristocrat who renounced the privileges of wealth and rank. A man of titanic appetites who repudiated meat, alcohol and sex. A Christian who did not believe in God and tried to rewrite the Gospels. An anarchist who ruled his estate like an ancient patriarch. A writer of genius who thought literature was evil and a waste of time and referred to his greatest novel as \"garbage.\" A pacifist who described the frontline experience of soldiers in the most careful, loving detail. In Tolstoy's imaginative universe, we may find the origin of contemporary conflicts and anxieties about money, about love and about power. But Tolstoy's modern consciousness was not made in Paris or New York - Tolstoy was made in late imperial Russia, notoriously the least modern country in nineteenth century Europe. How, then, did Tolstoy happen? How can we account historically for the contradictions that informed his epic project of self-fashioning? In this seminar, we will see Tolstoy at work in his single-handed creation of a counter-culture at war with the social and political currents of his time - and of ours.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSub