Group": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 364858, "crseOfferNbr": 1, "subject": "NRE", "catalogNbr": "5220", "titleShort": "Doc Seminar Quant Models", "titleLong": "Doctoral Seminar in Quantitative Models", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10739, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "11:40AM", "startDt": "10/15/2025", "endDt": "12/05/2025", "instructors": [{"instrAssignSeq": 1, "netid": "or83", "firstName": "Omid", "middleName": "", "lastName": "Rafieian"}], "pattern": "M", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Doctor of Philosophy (PhD) students."}, {"classNotesSeq": 2, "descrlong": "Add/Drop Dates: 9:00 am, August 18, 2025 - 11:59 pm, September 8, 2025 with an additional add/drop period 8:00 am, October 15, 2025 - 11:59 pm, October 22, 2025. Students will be required to obtain faculty permission to add/drop after October 22, 2025. If you drop after November 12, 2025, a \"W\" will be posted on your transcript."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/15/2025", "endDt": "12/20/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "10/15/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This sequence of two half-semester courses is designed to introduce students to the key questions and quantitative models and estimation methods commonly used in marketing. During the fall semester, the course is focused on reduced-form estimation approaches. It has two main objectives: (1) to acquaint students with the state-of-the-art reduced-form approaches, and (2) to enable students to build such models to address original research questions. Class will be a combination of lectures, discussion of assigned articles, data analysis, and presentations of research proposals.The spring section of this course is focused on structural models. It will introduce students to a number of classic and emerging structural econometric models that have become prevalent in quantitative marketing research. The course will include dynamic demand-side models, learning models, models with social effects and interactions, dynamic supply-side models, platform and network models, and structural behavioral models.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2025SP, 2024FA, 2024SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogC