of this field is one of the biggest conceptual developments in financial economics over the past 40 years. The course is aimed at doctoral students who would like to learn more about research in the field of behavioral finance. Over the course of the term, we will study dozens of academic papers.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2013FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 365214, "crseOfferNbr": 1, "subject": "NRE", "catalogNbr": "5360", "titleShort": "PhD Sem: Intr to Asset Pricing", "titleLong": "Doctoral Seminar - Introduction to Asset Pricing Theory", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18484, "meetings": [{"classMtgNbr": 1, "timeStart": "11:55AM", "timeEnd": "01:10PM", "startDt": "08/26/2025", "endDt": "08/28/2025", "instructors": [{"instrAssignSeq": 1, "netid": "raj15", "firstName": "Robert", "middleName": "A.", "lastName": "Jarrow"}], "pattern": "MW", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:55AM", "timeEnd": "01:10PM", "startDt": "09/03/2025", "endDt": "10/01/2025", "instructors": [{"instrAssignSeq": 1, "netid": "raj15", "firstName": "Robert", "middleName": "A.", "lastName": "Jarrow"}], "pattern": "MW", "meetingTopicDescription": ""}, {"class