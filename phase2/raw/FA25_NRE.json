is course, we will discuss a number of articles. Some articles will be chosen by the instructor. Others will be selected by the students. Students will be assigned to lead the discussion of specific papers.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2025SP, 2024FA, 2024SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 362109, "crseOfferNbr": 1, "subject": "NRE", "catalogNbr": "5170", "titleShort": "IntraPer Founds of Org Behav", "titleLong": "Intrapersonal Foundations of Organizational Behavior: Cognition, Motivation, and Emotion", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10395, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "11:40AM", "startDt": "08/25/2025", "endDt": "10/10/2025", "instructors": [{"instrAssignSeq": 1, "netid": "st933", "firstName": "Simone", "middleName": "", "lastName": "Tang"}], "pattern": "W", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Doctor of Philosophy (PhD) students."}, {"classNotesSeq": 2, "descrlong": "Add/Drop Dates: 9:00am, August 18, 2025 \u2013 11:59pm September 2, 2025. Students are required to obtain faculty permission to add/drop after September 2, 2025. If you drop after September 22, 202