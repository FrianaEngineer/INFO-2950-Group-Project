 acerbic. This course focuses on the Odes, with particular attention to the Third Book, and the Ars Poetica, a hexameter epistle in which Horace offers advice on composing poetry and drama. The influence of both works on poets, dramatists, and theorists continues to this day. While mastering his intricate and often daunting Latin, we will ask ourselves why.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: undergraduates must have had two semesters of 3000-level Latin.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 354485, "crseOfferNbr": 1, "subject": "LATIN", "catalogNbr": "7271", "titleShort": "Grad Seminar In Latin", "titleLong": "Graduate Seminar in Latin", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16715, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "04:30PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "cfb9", "firstName": "Charles", "middleName": "Francis", "lastName": "Brittain"}], "pattern": "F", "facilityDescr": "Goldwin Smith Hall 122", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH122", "meetingTopicDescription": null}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "De Officiis and De Beneficiis", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Cicero's De Officiis gives a theoretical justification for the \"duties\" or general action-types that are appropriate for Roman citizens (or at least elite male citizens). The duties are derived from a theory of human nature:\u00a0 they are supposed to be the the sorts of actions that will produce an excellent or virtuous person, and accordingly they range from appropriate posture to the selection of fitting professions. Among the duties leading to the virtue of justice is beneficence: how to treat and especially benefit one's fellow-citizens \u2013\u2013 the topic that is explored in detail in Seneca's De Beneficiis.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 354488, "crseOfferNbr": 1, "subject": "LATIN", "catalogNbr": "7920", "titleShort": "Independ Study In Latin", "titleLong": "Independent Study in Latin", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Inde