Long": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "As students develop desktop video games in large teams, they will concurrently be writing documentation to a variety of audiences for a myriad of technical, business, and design needs. Together, students in their teams will write entry-level workflow documents, specifications, planning, marketing, and project management pieces that have the specific task of always moving the team's work forward. The communication tasks are not extras; rather, they are integral to the game dev process. Iterations and deep revising will be part of this process, with inputs from both the CS instructor and the communication instructor.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Corequisite: CS 3152, INFO 3152.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Satisfies the College of Engineering's engineering communication requirement.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 355624, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3350", "titleShort": "Organizational Comm for Eng", "titleLong": "Organizational Communications for Engineers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 9824, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "01/24/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 1, "netid": "rae27", "firstName": "Rick", "middleName": "", "lastName": "Evans"}], "pattern": "TR", "facilityDescr": "Upson Hall 102", "bldgDescr": "Upson Hall",