 10008, "meetings": [{"classMtgNbr": 1, "timeStart": "03:25PM", "timeEnd": "05:20PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "rop28", "firstName": "Robert", "middleName": "Odawi", "lastName": "Porter"}], "pattern": "R", "facilityDescr": "Myron Taylor Hall 276", "bldgDescr": "Myron Taylor Hall", "facilityDescrshort": "MTH276", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "LAW", "catalogNbr": "6451", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The course will focus on the basics of Federal Indian Law, the ever-changing body of case and statutory law and treaties that define the limits and extent of Indian tribal sovereignty in the United States in the late twentieth century. The course will explore the nature and extent of tribal sovereignty at the time of European contact, the changing strategies of the United States in relating to tribes, and the lasting impact of those strategies on current-day tribal communities and their rights of self-government. The course will also explore the role of the United States in protecting tribal sovereignty and tribal resources. It will also examine the powers and jurisdiction of tribal governments with regard to both members and non-members of the tribe, as well as the lack or extent, as the case may be, of state jurisdiction over activities on Indian lands. Students will be encouraged to continually identify and question the legal, political and moral basis of the laws and policies that constitute Federal Indian Law in the United States today. We will also examine the current ALI restatement project for Federal Indian Law.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 360403, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "6970", "titleShort": "Independent Study in AIIS", "titleLong": "Independent Study in American Indian and Indigenous Studies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 1174, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 4, "netid": "pn79", "firstName": "Paul", "middleName": "", "lastName": "Nadasdy"}, {"instrAssignSeq": 3, "netid": "tar37", "firstName": "Troy", "middleName": "A.", "lastName": "Richardson"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "I", "add