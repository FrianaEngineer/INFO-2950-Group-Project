H", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "ALC-AS", "descr": "AS-Arts, Literat, and Culture", "descrformal": "AS-Arts, Literature, and Culture", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "D-AG", "descr": "AG-Human Diversity", "descrformal": "AG-Human Diversity", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "LA-AG", "descr": "AG-Literature & the Arts", "descrformal": "AG-Literature and the Arts", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "SCD-AS", "descr": "AS-Social Difference", "descrformal": "AS-Social Difference", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4705", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "6701", "type": "B"}, {"subject": "PMA", "catalogNbr": "4701", "type": "B"}, {"subject": "PMA", "catalogNbr": "6701", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4701", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores nightlife as a temporality that fosters countercultural performances of the self and that serves as a site for the emergence of alternative kinship networks. Focusing on queer communities of color, course participants will be asked to interrogate the ways in which nightlife demonstrates the queer world-making potential that exists beyond the normative 9-5 capitalist model of production. Performances of the everyday, alongside films, texts, and performance art, will be analyzed through a performance studies methodological lens. Through close readings and sustained cultural analysis, students will acquire a critical understanding of the potentiality of spaces, places, and geographies codified as after hours in the development of subcultures, alternative sexualities, and emerging performance practices. (HTC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2023SP, 2022SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 366995, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "4944", "titleShort": "Digital Biopolitics", "titleLong": "Digital Biopolitics", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "ALC-AS", "descr": "AS-Arts, Literat, and Culture", "descr