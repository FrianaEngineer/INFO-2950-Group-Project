imum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "FGSS", "catalogNbr": "2310", "type": "C"}, {"subject": "SOC", "catalogNbr": "2310", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course introduces the field of sexuality studies to advanced undergraduates by examining the social, cultural, political, and historical dimensions of sexuality. We will read theoretical and empirical research with an emphasis on sociological perspectives and methods. We will develop an understanding of sexuality as a socially constructed system of stratification that is shaped by race, gender, class, and ability. Topics include sexual identity, behavior, and desire (such as heterosexuality and homosexuality), queer theory, the body, healthism, reproductive justice, and human rights.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 367858, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "3210", "titleShort": "Gender and the Brain", "titleLong": "Gender and the Brain", "crseAttrs": [{"crseAt