escrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "1601", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course attends to the contemporary issues, contexts and experiences of Indigenous peoples. Students will develop a substantive understanding of colonialism and engage in the parallels and differences of its histories, forms, and effects on Indigenous peoples globally. Contemporary Indigenous theorists, novelists, visual artists and historians have a prominent place in the course, highlighting sociocultural and environmental philosophies, critical responses to and forms of resistance toward neocolonial political and economic agendas and the fundamental concern for Indigenous self-determination, among other topics. We will not only examine the history of victimization of indigenous peoples through colonial oppression, but we will also study their response as agents of change in providing alternative paradigms and insights to humanity in the third millennium.", "catalogBreadth": "", "catalogDistr": "(CA-AG, D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["To gain perspective of contemporary issues in Indigenous Studies with a historical sense that not only conveys the \"pastness of the past\" but its presence and relevance for the future.", "To examine current issues in Indigenous Studies that are important to communities.", "To apply an interdisciplinary lens in understanding indigenous sociocultural and ecological issues.", "To appreciate the complex interconnectivity between the ecological and the sociocultural.", "To comprehend that policy actions informed by cultural systems manifest themselves in social structures that rely on ecological foundations.", "To situate Indigenous Studies within a humanistic framework of knowledge generation.", "To illustrate the relevance and contribution of Indigenous Studies to broader issues of humanity in the 21st Century.", "To discern a methodology of hope based on indigenous experience."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 359320, "crseOfferNbr": 4, "subject": "AIIS", "catalogNbr": "3248", "titleShort": "Northeast Native Archaeology", "titleLong": "Finger Lakes and Beyond: Archaeology of the Native Northeast", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17249, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [], "pattern": "TR", "facilityDescr": "White Hall 106", "bldgDescr": "White Hall", "facilityDescrshort": "WHT106", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": 