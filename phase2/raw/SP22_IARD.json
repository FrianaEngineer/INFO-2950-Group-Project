cademic Session", "exploreCriteriaIds": []}], "description": "This course focuses on issues of conflict, peace, and reconciliation in Israel and the Palestinian Territories as well as Sub-Saharan Africa. Both regions exemplify how issues ranging from nationalism and ethnocentrism to land, water and resource management, climate change and migration, as well as socio-psychological dynamics, can exacerbate conflicts. At the same time, these regions also exemplify how trans-border collaboration and regional integration, civilian peace building efforts, strategies for achieving historical justice, as well as science education and science diplomacy can become crucial tools for long-term peace-building, reconciliation and development. In this course we will work with and discuss issues of peace and conflict with policy-makers and local stakeholders involved in peace-building efforts.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL, CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 354140, "crseOfferNbr": 1, "subject": "IARD", "catalogNbr": "4970", "titleShort": "Independent Study in IARD", "titleLong": "Independent Study in IARD", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "604", "classNbr": 15559, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/24/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 4, "netid": "twt2", "firstName": "Terry", "middleName": "W.", "lastName": "Tucker"