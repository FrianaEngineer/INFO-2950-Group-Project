2/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "All materials used in the course are authentic Burmese stories, current event reports, radio plays, etc. The particular materials used in any given year may vary depending on the proficiency level of the students. For students who are involved in Burma/Myanmar related research, their projects may also become part of the course. ", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0BURM 3301\u00a0or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 370851, "crseOfferNbr": 1, "subject": "BURM", "catalogNbr": "3310", "titleShort": "Adv Rdg  Burmese(Myanmar) II", "titleLong": "Advanced Readings in Burmese (Myanmar) II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 7448, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "yk696", "firstName": "Yu Yu", "middleName": "", "lastName": "Khaing"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "BURM 3309 or permission of instructor. This course is part of the Shared Course Initiative and at times may include students from other universities using videoconferencing technology. Questions rel