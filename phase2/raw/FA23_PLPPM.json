Required": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Fungi play a vital role in our ecosystem and are responsible for devastating crop infestations that threaten global food supplies and diseases that result in the death of hundreds of thousands of individuals each year. This course explores fungal biology through the lens of molecular genetics and genomics, including epigenetics, genome defense mechanisms, metabolism, and signaling pathways. We will cover the use of genetic tools in fungi ranging from classical genetics to CRISPR to high-throughput sequencing. This course will also teach skills necessary to analyze genetic and genomic data using Python and publicly available sequencing analysis software. No prior coding experience is necessary. The course will emphasize the development of professional skills, such as critically reading and reviewing scientific literature, experimental design, scientific communication, and data analysis. Students will write and peer review manuscripts based on the analysis of transcriptional profiling of fungi. Classes will include lectures, student-led discussion of the primary literature, presentations, and computer labs. A laptop is necessary for this course.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIOMG 2800\u00a0or PLBRG 2250.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Articulate the beneficial and harmful biological roles fungi play in the ecosystem.", "Explain the genetic and genomic principles governing fungi.", "Evaluate research papers from the current and historical literature on fungal genetics and genomics.", "Use Python and publicly available sequencing analysis programs to analyze transcriptomic data."], "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 354257, "crseOfferNbr": 1, "subject": "PLPPM", "catalogNbr": "6610", "titleShort": "Diagnostic Lab Experience", "titleLong": "Diagnostic Lab Experience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LAB", "ssrComponentLong": "Laboratory", "section": "401", "classNbr": 1982, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "kls13", "firstName": "Karen", "middleName": "Lynn", "lastName": "Snover-Clift"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Recommended prerequisite: course work or experience in diagnostic techniques. Enrollment preference given to: graduate students in plant pathology and plant protection. Students will work with instructor prior to enrollment to discuss course credit options and the associated time commitments per credit hour policy."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LAB"], "gradingBasis": "SU