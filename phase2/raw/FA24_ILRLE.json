gBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3465", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Should policy interventions target inequality between workers or disparities between places? Inequality has risen in most developed countries in recent decades. While top incomes have grown significantly, incomes at the bottom of the distribution have increased much less. In light of these trends, this course examines the role of labor market and place-based policies in reducing inequality, and discusses the trade-offs that arise between reducing inequality and promoting economic activity.", "catalogBreadth": null, "catalogDistr": "(SBA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ECON 1110, ECON 1120, and ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 373978, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3486", "titleShort": "Field Expriments in Econ & Bus", "titleLong": "Field Experiments in Economics and Business", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18680, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bkd34", "firstName": "Bart", "middleName": "K", "lastName": "de Koning"}], "p