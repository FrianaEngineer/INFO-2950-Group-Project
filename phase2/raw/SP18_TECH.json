", "ssrComponentLong": "Seminar", "section": "030", "classNbr": 18458, "meetings": [{"classMtgNbr": 1, "timeStart": "09:30AM", "timeEnd": "10:45AM", "startDt": "02/28/2018", "endDt": "03/29/2018", "instructors": [{"instrAssignSeq": 1, "netid": "hn288", "firstName": "Helen", "middleName": "", "lastName": "Nissenbaum"}], "pattern": "T", "facilityDescr": "Tata Innovation Center 131", "bldgDescr": "Tata Innovation Center", "facilityDescrshort": "TIC131", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. Enrollment limited to Cornell Tech students as part of the studio curriculum. Class sessions will meet during Module II. Student teams are required to schedule additional intensive meetings with the instructor during Module III."}], "campus": "NYT", "campusDescr": "New York Tech Campus", "location": "NYCTECH", "locationDescr": "Cornell Tech", "startDt": "02/28/2018", "endDt": "03/29/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Digital technologies have raised important ethical questions. Although often the focus is how ethical issues arise from ways people have used these technologies, there is growing interest in ethical values associated with the design and development of digital systems and devices. The study of values in, or values embodied in technology, has grown in importance as engineers and computer and data scientists have acknowledged that sound ethical practice is a responsibility alongside technical. This course introduces students to the latter. After providing a background to this way of thinking -- about ethics as a dimension of technology design and development \u2013 it introduces students to Values at Play, one particular approach to putting these ideas into practice.\u00a0Students are encouraged to apply this learning to their own projects.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "CT", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369441, "crseOfferNbr": 1, "subject": "TECH", "catalogNbr": "5110", "titleShort": "Early Adopters", "titleLong": "Early Adopters", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "030", "classNbr": 18341, "meetings": [{"classMtgNbr": 1, "timeStart": "09:30AM", "timeEnd": "10:45AM", "startDt": "04/09/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 4, "netid": "fg277", "firstName": "Fernando", "middleName": "", "lastName": "Gomez-Baquero"}, {"instrAssignSeq": 2, "netid": "ah643", "firstName": "Aaron", "middleName": "", "lastName": "Holiday"}], "pattern": "TR", "facilityDescr": "Tata Innovation Center 141", "bldgDescr": "Tata Innovation Center", "facilityDescrshort": "TIC141", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. Enrollment limited to Cornell Tech students as part of the Studio curriculum."}], "campus": "NYT", "campusDescr": "New York Tech Campus", "location": "NYCTECH", "locationDescr": "Cornell Tech", "startDt": "04/09/2018", "endDt": "05/09/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Students will learn a set of methodologies that support identifying and onboarding early adopters as customers. Upon completion of the course, students will have a set of tools and examples of real contracts, frameworks, and system and process designs that can be used to help support them in acquiring their first customer. In addition to the tools to support customer acquisition, students will make an attempt at acquiring their first customer for a real or hypothetical startup that is being built in the Studio at Cornell Tech.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: TECH 5900.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Cornell Tech students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "CT", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 369420, "crseOfferNbr": 1, "subj