", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 10277, "meetings": [{"classMtgNbr": 1, "timeStart": "04:10PM", "timeEnd": "06:00PM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: TIBET 1121 or equivalent."}, {"classNotesSeq": 2, "descrlong": "This course is part of the Shared Course Initiative (SCI). For more information about SCI courses, please see http://sharedcourseinitiative.org/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "EALANG", "descr": "East Asia Studies Lang", "descrformal": "East Asia Studies Language", "attrDescr": "Area Studies", "attrDescrShort": "Area Std"}, {"crseAttr": "0012", "crseAttrValue": "FL-AG", "descr": "AG-Foreign Language", "descrformal": "AG-Foreign Language", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Introduces students to the grammar of Classical Literary Tibetan as found in Indian treatises translated from Sanskrit into Tibetan, as well as indigenous Tibetan philosophical works. The course progresses through a sequence of the basic rudiments of the language, including an introduction to the script and its romanization, pronunciation (central Lhasan dialect), normative dictionary order, and the basic categories of grammar. Following these preliminaries, students proceed to guided readings in Tibetan literature designed to introduce them to the formal approach of Tibetan lexical semantics with an emphasis on the role of verbs in determining argument realization options. Over the duration of the course, students encounter new vocabulary (and associated Buddhist concept hierarchies) and increasingly complex sentence structures. This course thus provides a solid foundation for the later exploration of other genres of literature and styles of composition.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "TIBET 1121 or equivalent.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 367741, "crseOfferNbr": 1, "subject": "TIBET", "catalogNbr": "2202", "titleShort": "Interm Classical Tibetan II", "titleLong": "Intermediate Classical Tibetan II", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "SAAREA", "descr": "South Asia Studies Area", "descrformal": "South Asia Studies Area", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0012", "crseAttrValue": "FL-AG", "descr": "AG-Foreign Language", "descr