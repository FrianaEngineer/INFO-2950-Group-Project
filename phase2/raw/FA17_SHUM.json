{"status": "success", "data": {"classes": [{"strm": 2678, "crseId": 368946, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "4613", "titleShort": "The Indian Novel in English", "titleLong": "Theorizing the Local and the Global: Corruption and the Indian Novel in English", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16832, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "02:15PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 5, "netid": "ab2834", "firstName": "Ayelet", "middleName": "", "lastName": "Ben-Yishai"}], "pattern": "R", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASIAN", "catalogNbr": "4463", "type": "C"}, {"subject": "ENGL", "catalogNbr": "4996", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course will survey the history of the novel in India in English over the past hundred years, from colonial rule, through the consolidation of the Indian nation, to the growing pressures of globalization. Focusing on realist fiction, we will address the ways that generic conventions change over time, and discuss the local and the global as formal concerns, modulating in relation to the world beyond India as well as in negotiation with its multiple locales, identities, languages, and cultures. Through this prism, we will focus our attention on the theme of corruption \u2013 of politics, of the nation, of language and literary form \u2013 that has been a constant (though often figured as crisis) in this literary tradition which simultaneously is and is not a national tradition.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 368934, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "4614", "titleShort": "Polluted Senses", "titleLong": "Polluted Senses", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16814, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 4, "netid": "ccc278", "firstName": "Conerly", "middleName": "Carole", "lastName": "Casey"}], "pattern": "M", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "4014", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Nothing is more essential to humans than everyday sensory experiencing. We feel the rain on our skin, or smell the stench of garbage, and decide what to do. Our senses clue us into possibilities and potential dangers. But are our sensory experiences universal? No. We have ample evidence that what people consider as their senses varies widely across societies, cultures, and national borders. Sensory experiencing also changes over time, with new technologies. This seminar engages the global diversity of sensory apprehension, honing in on multiple sensory forms of 'pollution' (aesthetic, political, ecological, religious, legal and cultural), and emerging conceptual and experiential approaches to \"polluted senses.\" Concepts and enactments of pollution affect what is communally sacred, social, and environmental, but also what is degenerative, contaminated, or corrupt such as health or moral crises and social, political conflicts.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 368935, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "4615", "titleShort": "Electronic Civil Disobedience", "titleLong": "Artivism: Electronic Civil Disobedience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16817, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "12:05PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 4, "netid": "rrd54", "firstName": "Ricardo", "middleName": "Rene", "lastName": "Dominguez"}], "pattern": "T", "facilityDescr": "A D White House 109", "bldgDescr": "A D White House", "facilityDescrshort": "ADW109", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "VISST", "catalogNbr": "4615", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "The seminar will investigate the critical theories and practices by post-contemporary artivist and activist networks to corrupt the protocols of networks across the arcs of the planet by focusing on the history and manifestation of a single formation: Electronic Civil Disobedience (ECD). By focusing on ECD as a specific practice the seminar will be able to open a politics of the question into the multiple trajectories and layers that are happening now under the sign of hacktivism.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 368936, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "4616", "titleShort": "Corrupting Environmental Media", "titleLong": "Corrupting Environmental Media", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16812, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "02:15PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 5, "netid": "rm954", "firstName": "Rahul", "middleName": "", "lastName": "Mukherjee"}], "pattern": "M", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4614", "type": "C"}, {"subject": "STS", "catalogNbr": "4616", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course seeks to explore the intersections of corruption and environmental media. We will be analyzing films and other media (including artworks and literary texts) that deal with the environmental effects of governmental and corporate corruption. The course will investigate the epistemological and phenomenological dimensions of mediation and corruption through an eco-critical lens. We shall examine corruption as contagion at both biological (communicable diseases) and informational (glitches, computer viruses) levels.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 368937, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "4617", "titleShort": "Seeing Corruption in Mexico", "titleLong": "Seeing Corruption in Mexico", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16813, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 5, "netid": "lp468", "firstName": "Laura", "middleName": "", "lastName": "Perez-Leon"}], "pattern": "R", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "LATA", "catalogNbr": "4617", "type": "C"}, {"subject": "VISST", "catalogNbr": "4617", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This seminar seeks to examine the relationships among three topics: (i) social vision (a form of collective intentionality), (ii) institutional corruption in Mexico, and (iii) artistic visual representations of institutional corruption in Mexico. Two questions will guide the seminar discussions: Can we see institutional corruption? And, are visual representations of institutional corruption a form of collective intentionality? To tackle them, our case study will be series of photographs, films, and documentaries depicting corruption within three institutional settings in Mexico: the government, the university, and the family.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 368938, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "4618", "titleShort": "Data Corruption's Deep History", "titleLong": "Data Corruption's Deep History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16815, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 1, "netid": "car295", "firstName": "Courtney", "middleName": "Ann", "lastName": "Roby"}], "pattern": "T", "facilityDescr": "A D White House 109", "bldgDescr": "A D White House", "facilityDescrshort": "ADW109", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ARKEO", "catalogNbr": "4618", "type": "C"}, {"subject": "CLASS", "catalogNbr": "4632", "type": "C"}, {"subject": "COML", "catalogNbr": "4615", "type": "C"}, {"subject": "MEDVL", "catalogNbr": "4718", "type": "C"}, {"subject": "STS", "catalogNbr": "4618", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "How can studying the deep past of information storage and transmission help us understand our current engagements with information and contemplate its future? In this course we will we will explore the materiality of information-bearing artifacts over the long history of semantic inscription. From cuneiform tablets to digital media (whose veneer of immateriality disguises the complexities of the material mechanisms of storage and transmission), we will study the shifting materialities of the matrices through which information is stored, transformed, shared, and obliterated: compilations and remixes, piracies and hacks, inscribed objects and their digital \"surrogates.\"", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Intended for advanced undergraduates and graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 366672, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "6308", "titleShort": "Expanded Practice Seminar", "titleLong": "Expanded Practice Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17520, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 5, "netid": "ea369", "firstName": "Esra", "middleName": "", "lastName": "Akcan"}, {"instrAssignSeq": 1, "netid": "mid1", "firstName": "Iftikhar", "middleName": "", "lastName": "Dadi"}], "pattern": "T", "facilityDescr": "Sibley Hall 142", "bldgDescr": "Sibley Hall", "facilityDescrshort": "SBL142", "meetingTopicDescription": null}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "Migration & Discrimination", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ARCH", "catalogNbr": "5819", "type": "B"}, {"subject": "ARCH", "catalogNbr": "6308", "type": "B"}, {"subject": "ARTH", "catalogNbr": "6308", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Expanded Practice Seminars bring students and faculty in the humanities and the design disciplines together around a common and pressing urban issue such as the cultural and material practices induced by national or ethnic divisions; the increasingly leaky taxonomy of the terra firma in areas where land/water boundaries are rapidly changing; and the inadequacy of static zoning models that fail to capture dynamic, urban economics and performance. The intent of the Expanded Practice Seminar is to study complex urban conditions using theoretical and analytic tools derived in equal part from the design disciplines and humanist studies. The Expanded Practice Seminar includes a site visit to experience the conditions under study and meet with local experts, designers, and authorities.\u00a0 Expanded Practice Seminars are offered under the auspices of Cornell University's Andrew W. Mellon Foundation Collaborative Studies in Architecture, Urbanism, and the Humanities grant.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Fellows receive a $1,500 stipend and a funded, week-long travel program during the semester.\u00a0 Participation in the trip is required.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2018-01-07T19:14:21-0500", "catalogDttm": "2018-01-07T19:15:32-0500"}}