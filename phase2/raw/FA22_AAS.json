transnational and trans-Pacific Asia. With the history of anti-Asian racism and lingering Cold War geopolitics increasingly visible due to Covid-19, students will also critically explore the praxis of reparative kinship, in which settler colonialism and anti-Black racism continue to fracture our work on ecological decolonialization and make alliances against white supremacy fragile. For longer description and instructor bio visit the\u00a0Society for the Humanities website.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372829, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "7200", "titleShort": "Directed Individual Study", "titleLong": "Directed Graduate Individual Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 19594, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Permission of instructor required; please contact aasp@cornell.edu."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS",