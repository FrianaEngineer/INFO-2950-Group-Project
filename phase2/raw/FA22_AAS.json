nitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Independent reading course in topics not covered in regularly scheduled courses. Students select a topic in consultation with the faculty member who has agreed to supervise the course work.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-UGR)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "To apply for independent study, please complete the on-line form at data.arts.cornell.edu/as-stus/indep_study_intro.cfm.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 371665, "crseOfferNbr": 3, "subject": "AAS", "catalogNbr": "6457", "titleShort": "Inclusion Exclusion in Am Law", "titleLong": "Inclusion and Exclusion in American Law", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 20398, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "03:55PM", "startDt": "08/22/2022", "endDt": "12/01/2022", "instructors": [{"instrAssignSeq": 1, "netid": "ar643", "firstName": "Aziz", "middleName": "", "lastName": "Rana"}], "pattern": "WR", "facilityDescr": "Myron Taylor Hall 182", "bldgDescr": "Myron Taylor Hall", "facilityDescrshort": "MTH182", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "6456", "type": "C"}, {"subject": "LAW", "catalogNbr": "6457", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Who counts as a full member of the U.S. polity?\u00a0And how has law structured the benefits of such membership as well as the conditions for exclusion?\u00a0Moreover, how have these terms changed and remained consistent throughout American history? This course will use a variety of landmark cases as a jumping off point for assessing the linkages in the U.S. between full inclusion and judgments about race, gender, Indigeneity, class, religion, and immigration. In the process, the course will explore decisive periods of conflict over the meaning of membership\u2014from the founding and the Civil War to the Great Depression, the Civil Rights Movement, and more recent struggles regarding equality and freedom.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 370959, "crseOfferNbr": 4, "subject": "AAS", "catalogNbr": "6611", "titleShort": "Minoritarian Aesthetics", "titleLong": "Minoritarian Aesthetics In-And Performance", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8251, "meetings": [{"classMtgNbr": 1, "timeStart": "11:25AM", "timeEnd": "12:40PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "kj12", "firstName": "Karen", "middleName": "", "lastName": "Jaime"}], "pattern": "TR", "facilityDescr": "Schwartz Ctr-Perform Arts 124", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ124", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "6612", "type": "C"}, {"subject": "LSP", "catalogNbr": "6611", "type": "C"}, {"subject": "PMA", "catalogNbr": "6611", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "What are minoritarian aesthetics? How do these inform the production and reception of performance, broadly defined? How does attending to the aesthetics involved in the production of artistic and cultural productions open up new ways of critically understanding the world around us? In seeking to answer these questions, and others, this seminar will introduce graduate students to theories and critiques that attend to the aesthetic dimensions of visual culture, scripted staged performances, performance art, and contemporary media created by Black, queer, Asian, Caribbean, and Latinx/Latin people. Drawing on the work of theorists Fred Moten, Jos\u00e9 Esteban Mu\u00f1oz, Leticia Alvarado, and Sandra Ruiz amongst others, students will interrogate the dialectical relationship between the artist's subject position and their resultant creative and critical work.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372676, "crseOfferNbr": 6, "subject": "AAS", "catalogNbr": "6673", "titleShort": "The Kinship of Repair", "titleLong": "The Kinship of Repair: Asian and Asian American Artists in Collaboration", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20244, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 5, "netid": "jl3657", "firstName": "Joon", "middleName": "", "lastName": "Lee"}], "pattern": "T", "facilityDescr": "A D White House 201", "bl