 "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Fictions of dictatorship, as termed by scholar Lucy Burns, denote both the narratives and spectacles produced by authoritarian governments and the performances, events, and cultural objects that work against these states of exception. This course will critically examine histories of dictatorships, through both documentary &amp; creative forms (i.e. novels, memoirs, and performance) and with a geographic focus on Asia and Latin America, in order to understand authoritarian returns in our present historical moment.", "catalogBreadth": "(GB)", "catalogDistr": "(GLC-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372677, "crseOfferNbr": 6, "subject": "AAS", "catalogNbr": "4673", "titleShort": "The Kinship of Repair", "titleLong": "The Kinship of Repair: Asian and Asian American Artists in Collaboration", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20243, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 5, "netid": "jl3657", "firstName": "Joon", "middleName": "", "lastName": "Lee"}], "pattern": "T", "facilityDescr": "A D White House 201", "bldgDescr": "A D White House", "facilityDescrshort": "ADW201", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AAS", "catalogNbr": "6673", "type": "B"}, {"subject": "ARTH", "catalogNbr": "4673", "type": "B"}, {"subject": "ARTH", "catalogNbr": "6673", "type": "B"}, {"subject": "ASIAN", "catalogNbr": "4467", "type": "B"}, {"subject": "ASIAN", "catalogNbr": "6667", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4673", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6673", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4673", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6673", "type": "B"}, {"subject": "VISST", "catalogNbr": "4673", "type": "B"}, {"subject": "VISST", "catalogNbr": "6673", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Collaborations among and between Asian and Asian American artists in the twentieth and\u00a0twenty-first centuries have sought to redefine kinship by exploring the politics of belonging,\u00a0generational dis/connections, and the legacy of the Cold War. Through examining collaborative,\u00a0multi-media artworks\u00a0and performances by artists who engage with such questions, this course delves into, and expands on, the discourses of transnational and trans-Pacific Asia. With the history of anti-Asian racism and lingering Cold War geopolitics increasingly visible due to Covid-19, students will also critically explore the praxis of reparative kinship, in which settler colonialism and anti-Black racism continue to fracture our work on ecological decolonialization and make alliances against white supremacy fragile. For longer description and instructor bio visit the Society for the Humanities website.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 351007, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "4950", "titleShort": "Independent Study", "titleLong": "Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "602", "classNbr": 6461, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "vpm1", "firstName": "Viranjini", "middleName": "P.", "lastName": "Munasinghe"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "mate