": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 352722, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "2600", "titleShort": "Intro To Native American Lits", "titleLong": "Introduction to Native American Literature", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16356, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "etc7", "firstName": "Eric", "middleName": "T.", "lastName": "Cheyfitz"}], "pattern": "TR", "facilityDescr": "Kennedy Hall 103", "bldgDescr": "Kennedy Hall", "facilityDescrshort": "KND103", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2600", "type": "C"}, {"subject": "ENGL", "catalogNbr": "2600", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "The production of North American Indigenous literatures began long before European colonization, and persists in a variety of printed, sung, carved, painted, written, spoken, and digital media. From oral traditions transmitted through memory and mnemonics to contemporary genres and media, Native North American authors offer Indigenous perspectives on social, political, and environmental experience, through deft artistry and place-specific aesthetics. Our attention will focus on the contexts from which particular Native American literatures emerge, the ethics to consider when entering Indigenous intellectual territory, and close attention to common themes and techniques that frequently appear in contemporary Native American literature. Readings will feature a range of novels, poetry, short fiction, graphic novel/comics, and film.", "catalogBreadth": "", "catalogDistr": "(CA-AG, D-AG, LA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 370534, "crseOfferNbr": 2, "subject": "AIIS", "catalogNbr": "3324", "titleShort": "Cayuga Language and Culture", "titleLong": "Cayuga Language and Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19224, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "12:05PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "in