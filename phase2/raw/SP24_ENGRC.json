ities. The course will focus students' attention on (i) Production: What are the implications of using a particular platform to create a professional self? (ii) Representation: What tools do they need to analyze their own multimodal presentation of their professional selves? (iii) Circulation: What are the effects of having online representations of themselves as professionals? and (iv) Audience: What are their expectations about who will be viewing/interpreting those professional selves and for what purpose?", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: completed internship, professional experience, or significant undergraduate research; familiarity with HTML, CSS, and/or website development.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: seniors.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373380, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3027", "titleShort": "Cross-cultural Comm & Ethics", "titleLong": "Cross-cultural Communications and Ethics in the Workplace", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18393, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "hw472", "firstName": "Hua", "middleName": "", "lastName": "Wang"}], "pattern": "T", "facilityDescr": "Hollister Hall 206", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS206", "meetingTopicDescription": ""}], "notes": [{"class