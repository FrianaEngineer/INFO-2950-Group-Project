impleCombinations": [{"subject": "AMST", "catalogNbr": "2660", "type": "C"}, {"subject": "HIST", "catalogNbr": "2660", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "One thing many Americans think they know is their Indians: Pocahontas, the First Thanksgiving, fighting cowboys, reservation poverty, and casino riches. Under our very noses, however, Native American history has evolved into one of the most exciting, dynamic, and contentious fields of inquiry into America's past. It is now safer to assume, as Comanche historian Paul Chaat Smith has pointed out, that everything you know about Indians is in fact wrong. Most people have much to \"unlearn\" about Native American history before true learning can take place. This course aims to achieve that end by (re)introducing students to key themes and trends in the history of North America's indigenous nations. Employing an issues-oriented approach, the course stresses the ongoing complexity of Native American societies' engagements with varieties of settler colonialism since 1492 and dedicates itself to a concerted program of myth-busting. As such, the course will provide numerous opportunities for students to develop their critical thinking and reading skills.", "catalogBreadth": null, "catalogDistr": "(D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 371936, "crseOfferNbr": 4, "subject": "AIIS", "catalogNbr": "2720", "titleShort": "Ithaca's Indigenous Peoples", "titleLong": "From the Swampy Land: Indigenous People of the Ithaca Area", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17839, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "kj21", "firstName": "Kurt", "middleName": "Anders", "lastName": "Jordan"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2729", "type": "C"}, {"subject": "ANTHR", "catalogNbr": "2720", "type": "C"}, {"subject": "ARKEO", "catalogNbr": "2720", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Who lived in the Ithaca area before American settlers and Cornell arrived?\u00a0Where do these indigenous peoples reside today? This class explores the history and culture of the Gayogoho:no (Cayuga), which means people from the mucky land. We will read perspectives by indigenous authors, as well as archaeologists and historians, about past and current events, try to understand reasons why that history has been fragmented and distorted by more recent settlers, and delve into primary sources documenting encounters between settlers and the Gayogoho:no. We will also strive to understand the ongoing connections of the Gayogoho:no to this region despite forced dispossession and several centuries of colonialist exclusion from these lands and waters.\u00a0", "catalogBreadth": null, "catalogDistr": "(D-AG, HA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 370808, "crseOfferNbr": 2, "subject": "AIIS", "catalogNbr": "3325", "titleShort": "Cayuga Language and Culture II", "titleLong": "Cayuga Language and Culture II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 2064, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "05:30PM", "startDt": "01/21/2025", "endDt": "02/09/2025", "instructors": [{"instrAssignSeq": 10, "netid": "csh244", "firstName": "Charlene", "middleName": "Sehi:yo", "lastName": "Hemlock"}], "pattern": "M", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "03:00PM", "timeEnd": "05:30PM", "startDt": "02/10/2025", "endDt": "02/10/2025", "instructors": [], "pattern": "M", "meetingTopicDescription": ""}, {"classMtgNbr": 3, "timeStart": "03:00PM", "timeEnd": "05:30PM", "startDt": "02/11/2025", "endDt": "03/23/2025", "instructors": [{"instrAssignSeq": 9, "netid": "csh244", "firstName": "Charlene", "middleName": "Sehi:yo", "lastName": "Hemlock"}], "pattern": "M", "meetingTopicDescription": ""}, {"classMtgNbr": 