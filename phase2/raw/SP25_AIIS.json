601", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course attends to the contemporary issues, contexts and experiences of Indigenous peoples. Students will develop a substantive understanding of colonialism and engage in the parallels and differences of its histories, forms, and effects on Indigenous peoples globally. Contemporary Indigenous theorists, novelists, visual artists and historians have a prominent place in the course, highlighting sociocultural and environmental philosophies, critical responses to and forms of resistance toward neocolonial political and economic agendas and the fundamental concern for Indigenous self-determination, among other topics. We will not only examine the history of victimization of indigenous peoples through colonial oppression, but we will also study their response as agents of change in providing alternative paradigms and insights to humanity in the third millennium.", "catalogBreadth": null, "catalogDistr": "(CA-AG, D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["To gain perspective of contemporary issues in Indigenous Studies with a historical sense that not only conveys the \"pastness of the past\" but its presence and relevance for the future.", "To examine current issues in Indigenous Studies that are important to communities.", "To apply an interdisciplinary lens in understanding indigenous sociocultural and ecological issues.", "To appreciate the complex interconnectivity between the ecological and the sociocultural.", "To comprehend that policy actions informed by cultural systems manifest themselves in social structures that rely on ecological foundations.", "To situate Indigenous Studies within a humanistic framework of knowledge generation.", "To illustrate the relevance and contribution of Indigenous Studies to broader issues of humanity in the 21st Century.", "To discern a methodology of hope based on indigenous experience."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 366760, "crseOfferNbr": 2, "subject": "AIIS", "catalogNbr": "2240", "titleShort": "Native American Languages", "titleLong": "Native American Languages", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18600, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "sem269", "firstName": "Sarah", "middleName": "E.", "lastName": "Murray"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AIIS", "catalogNbr": "6240", "type": "B"}, {"subject": "LING", "catalogNbr": "2248", "type": "B"}, {"subject": "LING", "catalogNbr": "6248", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores the wide variety of languages indigenous to the Americas. There were thousands of languages spoken in the Americas before the arrival of Europeans and hundreds of these languages are still spoken today. We will look at several of these languages in terms of their linguistic structure as well as from social, historical, and political perspectives. No prior linguistic background is required and no previous knowledge of any Native American languages is presumed.", "catalogBreadth": null, "catalogDistr": "(CA-AG, D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 357566, "crseOfferNbr": 3, "subject": "AIIS", "catalogNbr": "2660", "titleShort": "Unlearning Native Amer Hist", "titleLong": "Everything You Know About Indians is Wrong: Unlearning Native American History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9514, "meetings": [{"classMtgNbr": 1, "timeStart": "09:05AM", "timeEnd": "09:55AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "jwp35", "firstName": "Jon", "middleName": "W.", "lastName": "Parmenter"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/