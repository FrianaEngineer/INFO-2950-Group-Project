}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "The purpose of this course is to demonstrate that Leadership Minor students will have met all learning outcomes in the program prior to graduation by documenting relevant in-class and co-curricular activities in their individual ePortfolio. The ePortfolio will be evaluated based on the following elements: a personal profile, leadership philosophy statement, leadership experiences, personal development, examples of how the learning outcomes for the minor have been met through the capstone experience, and reflective writing on the capstone experience. The evaluation and assignment of a grade will be made by the student's advisor using a common rubric. Ideally, students will enroll in this course in their second-to-last semester so any deficiencies can be addressed prior to graduation.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: LEAD minors only.", "catalogCourseSubfield": "", "catalogOutcomes": ["Communicate one's philosophy of leadership.", "Describe one's personal development as a leader.", "Demonstrate competency and mastery of the Leadership Minor's learning outcomes by documenting one's scholarship, training, and experience in leadership through an ePortfolio.", "Build a stronger relationship with one's faculty advisor."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 369498, "crseOfferNbr": 1, "subject": "LEAD", "catalogNbr": "4970", "titleShort": "UG Experience in Leadership", "titleLong": "Undergraduate Experience in Leadership", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 4001, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 2, "netid": "mpp3", "firstName": "Marvin", "middleName": "P.", "lastName": "Pritts"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: LEAD 3100. Enrollment limited to Leadership minors. Students must register using CALS Special Studies form available online at https://dust.cals.cornell.edu/IndStudyPolicy.aspx."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximu