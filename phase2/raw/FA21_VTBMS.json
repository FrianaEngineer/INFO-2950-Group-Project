d Policies; Design and Management of Animal Facilities; Anesthesia, Analgesia, and Euthanasia; Techniques of Experimentation; Control of Biohazards used in animal research; Selected zoonoses/xenozoonoses; Genetic monitoring; Transgenic and knock-out mice; Factors influencing animal research; Animal models in biomedical research; Research in Lab Animal and Comparative Medicine; Lab Animal Behavior.\u00a0 The course will meet for 1 hour weekly and will extend over the course of two years, though each term is independent and can be taken separately.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: basic knowledge of anatomy and pathology in comparative animal species.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 361484, "crseOfferNbr": 1, "subject": "VTBMS", "catalogNbr": "7030", "titleShort": "Bio and Disease of Lab Animals", "titleLong": "The Biology and Diseases of Laboratory Animals", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16189, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "03:00PM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 1, "netid": "bs256", "firstName": "Bhupinder", "middleName": "", "lastName": "Singh"}], "pattern": "W", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Camp