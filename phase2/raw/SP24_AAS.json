": "This course surveys modern U.S. history, from Reconstruction to the contemporary period. It will examine how race has been the terrain on which competing ideas of the American nation have been contested. From struggles over citizenship rights to broader meanings of national belonging, we will explore how practices, ideas, and representations have shaped political, cultural, and social power. A key concern for this course is examining how groups and individuals have pursued racial justice from the late-nineteenth century to the present.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 371649, "crseOfferNbr": 3, "subject": "AAS", "catalogNbr": "3885", "titleShort": "Race and War in History", "titleLong": "Race and War in History: Workers, Soldiers, Prisoners, Activists", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17860, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "tn329", "firstName": "Tejasvi", "middleName": "", "lastName": "Nagaraja"}], "pattern": "TR", "facilityDescr": "Ives Hall 217", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS217", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "0