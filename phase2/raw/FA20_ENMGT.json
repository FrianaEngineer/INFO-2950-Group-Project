.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: CEE 3040\u00a0or ENGRD 2700\u00a0or ILRST 2100\u00a0or BTRY 3010\u00a0or AEM 2100, MATH 1910, MATH 1920, or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: seniors or graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": ["Students' should gain an ability to apply knowledge of mathematics, science and engineering.", "Students' should gain an ability to identify, formulate, and solve engineering problems.", "Students' should gain an understanding of professional and ethical responsibility.", "Students' should gain the broad education necessary to understand the impact of engineering solutions in a global and societal context.", "Students' should gain a knowledge of contemporary issues."], "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 371069, "crseOfferNbr": 1, "subject": "ENMGT", "catalogNbr": "6001", "titleShort": "Residential Intensive I", "titleLong": "Residential Intensive I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18443, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/17/2020", "endDt": "08/20/2020", "instructors": [{"instrAssignSeq": 1, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}, {"instrAssignSeq": 2, "netid": "rtn24", "firstName": "Robert", "middleName": "Todd", "lastName": "Newman"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/17/2020", "endDt": "08/20/2020", "addConsen