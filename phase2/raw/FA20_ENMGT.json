ingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Students will identify the goals for their career and engage in several career development support services, such as networking, interviewing, resume and cover letter writing, and negotiation workshops. In addition, they will engage in a leadership development series to help them further build their engineering management and leadership competencies. Through a variety of tools, one-on-one coaching, workshops, events, and other resources, this course will help students develop and practice critical career management skills, along with build their confidence to find a career opportunity best suited to their interests and needs.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: M.Eng. students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2021-03-03T19:15:03-0500", "catalogDttm": "2021-03-03T19:16:12-0500"}}