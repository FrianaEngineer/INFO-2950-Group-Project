eering (M.Eng.) project to tackle pressing technological and societal challenges surrounding infrastructure, with a specific focus on energy and environmental systems. For example, in 2018/19, projects were focused on Puerto Rico post Hurricane Maria. As part of this course, you will work closely with local stakeholders to hear their perspective on prior challenges and future needs. Each subsequent year will then build upon the prior year's activity to tackle large, complex issues over multiple years. During the course, you will contribute to developing a library of monitoring tools and algorithms which will persist over time and then be applied to solve new challenges with each course iteration.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: M.Eng. students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 371071, "crseOfferNbr": 1, "subject": "ENMGT", "catalogNbr": "5200", "titleShort": "Energy Economics", "titleLong": "Economics of the Energy Transition", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18441, "meetings": [{"classMtgNbr": 1, "timeStart": "09:55AM", "timeEnd": "11:10AM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "jpm452", "firstName": "Jacob", "middleName": "Paul", "lastName": "Mays"}], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "