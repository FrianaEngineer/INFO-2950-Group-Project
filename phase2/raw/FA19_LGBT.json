talogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 370341, "crseOfferNbr": 6, "subject": "LGBT", "catalogNbr": "2770", "titleShort": "Islam and Gender", "titleLong": "Islam and Gender", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18804, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "sg2327", "firstName": "Seema", "middleName": "", "lastName": "Golestaneh"}], "pattern": "TR", "facilityDescr": "White Hall 110", "bldgDescr": "White Hall", "facilityDescrshort": "WHT110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "2470", "type": "C"}, {"subject": "FGSS", "catalogNbr": "2770", "type": "C"}, {"subject": "MEDVL", "catalogNbr": "2770", "type": "C"}, {"subject": "NES", "catalogNbr": "2770", "type": "C"}, {"subject": "RELST", "catalogNbr": "2770", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course explores the role of gender and sexuality in shaping the lives of Muslims past and present. Through a close examination of ethnographies, intellectual histories, and religious treatises, we will analyze the key debates and discourses surrounding the intersection of gender and Islam. We begin by investigating Quranic revelations and hadith concerning gender and sexual ethics, female figures of emulation in early Islam, and feminist exegeses of the Quran. Continuing onward, we focus upon the everyday lives of Muslim women and non-binary individuals in medieval, colonial, and post-colonial contexts, highlighting the ways in which people negotiate and respond to the sexual politics of the times in which they live as we ask what, if anything, is specifically \"Islamic\" about the situations under discussion? Following this, we embark upon a history of sexuality within Islam, tracing the ways in which the categories of \"homosexuality\" and \"heterosexuality\" came to exist in the Muslim world, as well as the history and positionality of trans communities past and present. We then continue with an exploration of Islamic feminism as it exists today, looking to the ways in which Muslim feminists have critically engaged both religious texts as well as Western feminist theory. Finally, the course concludes by analyzing the relationship between the study of Islam, gender, and empire.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 363785, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "2780", "titleShort": "Pleasure and Danger", "titleLong": "Body as Text: Pleasure and Danger", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16367, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:15PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "mr283", "firstName": "Masha", "middleName": "", "lastName": "Raskolnikov"}], "pattern": "MWF", "facilityDescr": "Ives Hall 105", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS105", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "BSOC", "catalogNbr": "2781", "type": "C"}, {"subject": "ENGL", "catalogNbr": "2780", "type": "C"}, {"subject": "FGSS", "catalogNbr": "2780", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "We experience our bodies as so much a part of who we are that we take them for granted. Yet the way we think about the body has a history of its own. This class looks at how the idea of \"the body\" gets constructed over time. How has the body come to have attributes called \"gender,\" \"sexuality,\" and \"race\"? Why have some bodies been seen as monstrous, perverted, and unholy, others as gorgeous, normal, and divine? What makes bodies pleasurable and dangerous? We'll find out by examining a broad range of evidence from the ancient era to the present day, including literature (Ovid, Kafka, Octavia Butler), philosophy (Plato, Descartes, Judith Butler), film, and the history of science.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 370293, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "3310", "titleShort": "Afro-Asia: Futurism & Feminism", "titleLong": "Afro-Asia: Futurism and Feminisms", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18803, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 6, "netid": "tlg92", "firstName": "Tao", "middleName": "Leigh", "lastName": "Goffe"}], "pattern": "MW", "facilityDescr": "Stimson Hall 206", "bldgDescr": "Stimson Hall", "facilityDescrshort": "STM206", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AAS", "catalogNbr": "3312", "type": "C"}, {"subject": "ASRC", "catalogNbr": "3310", "type": "C"}, {"subject": "ASRC", "catalogNbr": "6610", "type": "C"}, {"subject": "COML", "catalogNbr": "3310", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3310", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course explores cultural representations of Afro-Asian intimacies and coalition in novels, songs, films, paintings, and poems. What affinities, loves and thefts, and tensions are present in cultural forms such as anime, jazz, kung fu, and K-pop? Students will consider the intersections and overlap between African and Asian diasporic cultures in global cities such as New York, Chicago, Havana, Lahore, Kingston, and Hong Kong to ask the question: when did Africa and Asia first encounter each other? This will be contextualized through a political and historical lens of the formation of a proto-Global South in the early twentieth, Afro-futurism, women of color feminisms, and Third World solidarity and internationalism. Tackling issues of race, gender, sexuality, and resistance, this seminar also reckons with the intertwined legacies of the institutions of African enslavement and Asian indenture by reading the novels of Patricia Powell and the paintings of Kehinde Wiley, for instance. Students will work in groups to produce Afro-Asia DJ visual soundtracks as part of the final project.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 367227, "crseOfferNbr": 6, "subject": "LGBT", "catalogNbr": "3754", "titleShort": "Spoken Word, Hip-Hop Theater", "titleLong": "Spoken Word, Hip-Hop Theater, and the Politics of the Performance", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16302, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "kj12", "firstName": "Karen", "middleName": "", "lastName": "Jaime"}], "pattern": "TR", "facilityDescr": "Schwartz Ctr-Perform Arts 124", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ124", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3754", "type": "C"}, {"subject": "ENGL", "catalo