: "5360", "titleShort": "PhD Sem: Intr to Asset Pricing", "titleLong": "Doctoral Seminar - Introduction to Asset Pricing Theory", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16028, "meetings": [{"classMtgNbr": 1, "timeStart": "11:55AM", "timeEnd": "01:10PM", "startDt": "08/23/2018", "endDt": "12/02/2018", "instructors": [{"instrAssignSeq": 1, "netid": "raj15", "firstName": "Robert", "middleName": "A.", "lastName": "Jarrow"}], "pattern": "MW", "facilityDescr": "Sage Graduate Hall 135", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGH135", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:55AM", "timeEnd": "01:10PM", "startDt": "12/03/2018", "endDt": "12/03/2018", "instructors": [{"instrAssignSeq": 1, "netid": "raj15", "firstName": "Robert", "middleName": "A.", "lastName": "Jarrow"}], "pattern": "M", "facilityDescr": "Sage Graduate Hall 141", "bldgDescr": "Sage Hall", "facilityDescrshort": "SGH141", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Non-Johnson Students ONLY:  August 14th at 8:00am thru September 10th at 4:00pm.  You may add or drop a full semester class after September 10th with permission of the faculty. A late fee of $100.00 will be charged for each add or drop transaction. If you are dropping after October 23rd you will also receive a \"W\" on your transcript in addition to the late fees."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/23/2018", "sessionEndDt": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course is an introductory Ph.D.-level course on the basic theories of asset pricing. It consists of three parts. The first part covers arbitrage pricing theory, including the Black Scholes Merton, the Heath Jarrow Morton, and reduced form credit risk models. The second part covers portfolio theory, in both complete and incomplete markets. The third part studies equilibrium pricing models, both complete and incomplete markets, including the notion of market efficiency. This course emphasizes continuous time models and it is based on the use of martingales to understand asset pricing theory. Included in the course is the extensions of the standard theories to include asset price bubbles.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-01-31T19:14:21-0500", "catalogDttm": "2019-01-31T19:15:35-0500"}}