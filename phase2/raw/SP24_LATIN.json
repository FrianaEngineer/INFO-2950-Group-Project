ocation": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM", "IND"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LATIN", "catalogNbr": "3203", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Spring 2024 Topic: Latin Poetic Muses: Latin poetic muses were active over many centuries. They remain active today. This seminar provides an overview, through selected excerpts, of some of its moods, modes, and meters, and invites students to bring in some of their own favorite passages for discussion. We will try to convey not only the gist of a poet's \"meaning,\" but also to regenerate any special figured language, including puns, anagrams, and acrostics, which inflect meaning in interesting ways and make Latin poetry different from most English language poetry after Chaucer. We will examine how Latin poetry is put together: how metrics and wordplay shape sense, and why \"dictionary-based\" translation routinely oversimplifies Latin originals. Horace, Ovid, and George Herbert will be our chief sources here. In epic, we'll read excerpts from Ennius, Lucretius, Virgil, Ovid, Lucan, Statius, and Carrara's eighteenth-century Columbus. We'll also look at Ovid's dialogue between his epic and elegiac identities. In lyric, epigram, satire, tragedy, and bucolic, we'll read passages from Terence, Seneca, Virgil, Horace, Persius, and Ausonius.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: one 5220-level Latin course.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 353938, "crseOfferNbr": 2, "subject": "LATIN", "catalogNbr": "7222", "titleShort": "Latin Paleography", "titleLong": "Latin Paleography", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17687, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ajh299", "firstName": "Andrew", "middleName": "J.", "lastName": "Hicks"}], "pattern": "F", "facilityDescr": "Goldwin Smith Hall 181", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH181", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "01:25PM", "timeEnd": "02:15PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ajh299", "firstName": "Andrew", "middleName": "J.", "lastName": "Hicks"}], "pattern": "W", "facilityDescr": "Kroch, Carl A Library 2B49", "bldgDescr": "Kroch,Carl A Library", "facilityDescrshort": "KRC2B49", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "MEDVL", "catalogNbr": "6102", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course is an introduction to and survey of Latin scripts from Roman antiquity through the early Renaissance, with an emphasis on the identification, localization, and reading of scripts. Class meetings will combine practical study of Latin scripts through medieval manuscripts in the Kroch library, facsimiles, and online digital reproductions with instruction in the cultural-historical background to manuscript production, library practices, and bibliographical resources. Students will also be introduced to basic techniques for codicological description and the principles of textual criticism.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Students in doubt about their readiness should consult with the instructor.", "catalogPrereqCoreq": "Prerequisite: a solid understanding of Latin grammar and morphology.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 361494, "crseOfferNbr": 2, "subject": "LATIN", "catalogNbr": "7262", "titleShort": "