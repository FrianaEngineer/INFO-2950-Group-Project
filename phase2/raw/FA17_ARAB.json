lassMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 7, "netid": "ko283", "firstName": "Kadhim", "middleName": "", "lastName": "Owayez"}], "pattern": "MTWRF", "facilityDescr": "White Hall B06", "bldgDescr": "White Hall", "facilityDescrshort": "WHTB06", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "1201", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2017", "sessionEndDt": "12/01/2017", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This two-course sequence assumes no previous knowledge of Arabic and provides a thorough grounding in the four language skills of listening, speaking, reading, and writing. It starts with the alphabet and the number system and builds the four skills gradually and systematically through carefully selected and organized materials focusing on specific, concrete and familiar topics such as self identification, family, travel, food, renting an apartment, study, the weather, etc.). These topics are listed in the textbook's table of contents.\u00a0 The student who successfully completes the two-course sequence will have mastered about 1000 basic words and will be able to: 1) understand and actively participate in conversations on a limited range of practical topics such as self-identification, family, school, work, the weather, travel, etc., 2) read and understand, with the help of a short list of words, passages of up to 180 words written in Arabic script, and 3) discuss orally in class and write a 50-word paragraph in Arabic.\u00a0 The two-course sequence aims to take the student from the Novice to the Intermediate Mid level according to the ACTFL proficiency guidelines.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall, summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2678, "crseId": 353414, "crseOfferNbr": 1, "subject": "ARAB", "catalogNbr": "1203", "titleShort": "Intermediate Arabic I", "titleLong": "Intermediate Arabic I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 6163, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "08/22/2017", "endDt": "12/01/2017", "instructors": [{"instrAssignSeq": 17, "netid": "rb833", "firstName": "Reema", "middleName": "", "lastName": "Barakat"}], "pattern": "MTWR", "facilityDescr": "Lincoln Hall 117", "bldgDescr": "Lincoln Hall", "facilityDescrshort": "LNC117", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2017", "endDt": "12/01/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs":