Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM", "IND"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4283", "type": "C"}, {"subject": "GOVT", "catalogNbr": "4283", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "What are the social, policy, and political needs of the diverse Latino community? This seminar delves into the politics of resistance and solidarity of Latinxs/Hispanics in North America, with a primary focus on the U.S. political system. We commence by examining conceptual categorizations and definitions of the Latina/o/x population, pondering whether Latin@s should be regarded as a racial or ethnic group. Then, we follow with a historical survey of Latino migration to the U.S. and analyze how interlocking systems of oppression shape the material conditions and lived experiences of Latin@/x people. Ultimately, we conclude by analyzing Latino collective action to understand how they organize at the local, national, and transnational levels to confront systems of inequality. The class takes a relational approach, focusing on political and ethnoracial relations and their effects on U.S. political institutions and public policy. Themes we will explore encompass (im)migration, interethnic/racial relations, neoliberalism, mass incarceration and settler colonialism, and social movement's effects on policy outcomes.", "catalogBreadth": "(HB)", "catalogDistr": "(SBA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 360045, "crseOfferNbr": 2, "subject": "LSP", "catalogNbr": "6000", "titleShort": "Issues in Latin/Latino America", "titleLong": "Contemporary Issues in Latin-Latino America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 5686, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 5, "netid": "eb577", "firstName": "Ernesto", "middleName": "E.", "lastName": "Bassi Arevalo"}], "pattern": "T", "facilityDescr": "Uris Hall 302", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH302", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simp