ps": "Forbidden Overlap: due to an overlap in content, students will receive credit for only one course in the following group:\u00a0ECON 3280,\u00a0ECON 4280, ILRLE 3280.", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0 ECON 1110or equivalent,\u00a0PUBPOL 2000, and ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 369372, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3445", "titleShort": "Inequality in US Higher Ed", "titleLong": "Inequality in U.S. Higher Education", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8579, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "er488", "firstName": "Evan", "middleName": "", "lastName": "Riehl"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3770", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Is the U.S. college system a great equalizer or a cause of growing inequality? Improved access to higher education has brought millions of Americans into the middle class, and yet rising selectivity has meant that a disproportionate share of the economic elite come from a few top colleges. This course will explore the three big parts of the college experience --- (1) admissions and the college-going decision; (2) education while in college; and (3) college completion and labor market entry --- and ask how each part contributes to inequality in economic outcomes. Lectures and readings will focus on simple economic theories of higher education as well as the empirical methods used to test these theories.", "catalogBreadth": null, "catalogDistr": "(D-AG, SBA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400, ECON 3030\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374301, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3475", "titleShort": "Visualizing Economics", "titleLong": "Visualizing Economics: Introducing Basic Economic Concepts with Visual Arts", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18200, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "mb2693", "firstName": "Michele", "middleName": "", "lastName": "Belot"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3475", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course proposes a new and innovative approach to learning about economics. If you want to learn in a different manner, if you are attracted to visualizations in general, this course is for you. This course will challenge preconceptions about what economics is. The goal is to use visual arts to illustrate basic economic concepts that are general, and demonstrate how these tools can be used to analyze and understand a variety of human and social phenomena. The idea of using arts to teach a non-arts related topic stems from recent research in neurology suggesting that creative arts aid learning and memorizing. The course focuses on the core concepts and ideas in economics and is meant to be widely accessible.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "No background in arts is needed.", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400\u00a0or ECON 1110\u00a0and ECON 1120.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 360370, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "4430", "titleShort": "Compensation, Incentives&Prod", "titleLong": "Compensation, Incentives, and Productivity", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8504, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 2, "netid": "srt82", "firstName": "Stephanie", "middleName": "R", "lastName": "Thomas"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3430", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Examines topics in labor economics of particular relevance to individual managers and firms. Representative topics include recruitment, screening, and hiring strategies; compensation (including retirement pensions and other benefits); training, turnover, and the theory of human capital; incentive schemes and promotions; layoffs, downsizing, and buyouts; teamwork; and internal labor markets. Focuses on labor-related business problems using the analytic tools of economic theory and should appeal to students with strong quantitative skills who are contemplating careers in general business, consulting, and human resource management as well as in economics.", "catalogBreadth": null, "catalogDistr": "(SBA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 360379, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "5400", "titleShort": "Labor Economics", "titleLong": "Labor Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8541, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 3, "netid": "er488", "firstName": "Evan", "middleName": "", "lastName": "Riehl"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This is a course in labor market economics for prospective managers in the corporate, union, not-for-profit, and public sectors. The course begins with demand and supply in labor markets, presenting the tools of decision analysis for workers and firms. It then goes on to consider various topics in workplace management including deciding on the optimal mix of capital and labor to employ, attracting and retaining talent, pay and productivity, hiring and training investments, and using strategic budget constraints. The final section of the course covers other important labor market issues including analysis of public policies, unemployment, discrimination, poverty and inequality, and pensions and Social Security.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Requirement for MILR\u00a0candidates.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374303, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "7455", "titleShort": "Local Labor Markets", "titleLong": "Local Labor Markets: Disparities and Remedies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18295, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "10:00PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "en322", "firstName": "Elio", "middleName": "", "lastName": "Nimier-David"}], "pattern": "M", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "7455", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Since the 1980s, American cities have exhibited increasingly divergent trends. This \"Great Divergence\" has had profound effects on local employment, income, political preferences, health outcomes, and intergenerational mobility. As more detailed data become available, recent research seeks to uncover the causes of this divergence and evaluate how policy interventions might mitigate its negative effects. Building on this research, this course explores recent advancements at the crossroads of labor and spatial economics. It begins by examining the growing disparities between cities and regions in terms of productivity, labor market opportunities, and amenities, in several countries. It then investigates the rationale behind place-based policies and their potential to stimulate local development. Finally, the course will provide students with essential tools and theories to study the sorting of workers and firms over space and to understand its implications for economic growth and inequality.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 360389, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "7460", "titleShort": "Seminar in Labor Economics II", "titleLong": "Seminar in Labor Economics II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10446, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "jb2722", "firstName": "Justin", "middleName": "", "lastName": "Bloesch"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instruc