", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 362578, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "4260", "titleShort": "Managing Creativity", "titleLong": "Managing for Creativity", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18047, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "bl679", "firstName": "Brian", "middleName": "", "lastName": "Lucas"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Creative ideas are widely touted as a source of competitive advantage available to workers and organizations. At the same time, creativity can be difficult to manage in a systematic way and organizations often fall short of their creative goals. This course is about how to manage creativity \u2013 both yours and in others. We will review theories of creativity, with a focus on (1) how to generate creative ideas and (2) on how to gain support for (i.e., sell) those ideas. We will discuss theoretical frameworks, case studies, and current examples with the goal of distinguishing between effective and ineffective strategies. You will develop skills related to making and selling ideas that you can implement in your organization, use to further your career, or to build value in any endeavor that runs on good ideas. A note to set expectations: This is a course about how to generate creative ideas and build support for those ideas. This course will not teach you how to start a business or secure VC funding.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374277, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "4640", "titleShort": "Business Strategy", "titleLong": "Business Strategy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18048, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "fsb42", "firstName": "Forrest", "middleName": "S", "lastName": "Briscoe"}], "pattern": "MW", "meetingTopicDescription": ""}]