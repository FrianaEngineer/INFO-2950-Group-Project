alism, defined as a multimodal communicative competence honed through the practice of creating, critiquing, and reflecting upon digital artifacts they use to build and present their professional and public identities. The course will focus students\u2019 attention on multiliteracies (functional, critical, and rhetorical) and multimodal communication.\u201d", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: juniors and seniors.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "completed internship, professional experience, or significant undergraduate research; familiarity with HTML, CSS, and/or website development.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025FA, 2025SP, 2024FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 373380, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3027", "titleShort": "Cross-cultural Comm & Ethics", "titleLong": "Cross-cultural Communications and Ethics in the Workplace", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 6228, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "08:20PM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "hw472", "firstName": "Hua", "middleName": "", "lastName": "Wang"}], "pattern": "M", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campu