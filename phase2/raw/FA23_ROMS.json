rd picture of landscape? Reading in the original languages where possible, we will begin with foundational pastoral and bucolic texts from the classical, early modern, and Romantic periods before moving to contemporary science/speculative fictions. we will also read recent critical works on the \"botanic turn,\" terraforming, posthuman ruins, and infrastructure.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 369193, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "6100", "titleShort": "Romance Stds Colloquium", "titleLong": "Romance Studies Colloquium", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5813, "meetings": [{"classMtgNbr": 1, "timeStart": "04:45PM", "timeEnd": "06:45PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 6, "netid": "ld79", "firstName": "Laurent", "middleName": "", "lastName": "Dubreuil"}], "pattern": "T", "facilityDescr": "Klarman Hall K155", "bldgDescr": "Klarman Hall", "facilityDescrshort": "KLRK155", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": ""