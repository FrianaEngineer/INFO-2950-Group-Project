 and resistance, labor migration, community formation, imperialism, and struggles for equality.", "catalogBreadth": "", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 369933, "crseOfferNbr": 1, "subject": "AAS", "catalogNbr": "3020", "titleShort": "Asian Amer & Pop Cult", "titleLong": "Asian Americans & Popular Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18617, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "cbb84", "firstName": "Christine", "middleName": "Bacareza", "lastName": "Balance"}], "pattern": "TR", "facilityDescr": "Morrill Hall 111", "bldgDescr": "Morrill Hall", "facilityDescrshort": "MRL111", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Lett