"instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "From white sand beaches, samba, and carnival, to poverty, violence, and urban chaos, few cities offer so much to the imagination as Rio de Janeiro.\u00a0 From the early nineteenth century to the present Rio has been the backdrop, object, birthplace, and protagonist of countless novels, movies, songs, and sociological studies.\u00a0 In this course we turn to the city as text and explore the multiple possibilities of a hermeneutics of urban space.\u00a0 Shifting the focus of cultural analysis from the national to the urban, this course approaches the multiple images and complex reality of Rio from a broad range of perspectives and fields of inquiry through a wide range of materials including historical documents and narratives, literary works, theoretical pieces, films, and numerous online tools.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 367690, "crseOfferNbr": 3, "subject": "PORT", "catalogNbr": "3480", "titleShort": "Brazilian Music & Culture", "titleLong": "Brazilian Culture through its Music", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16960, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "sfp8", "firstName": "Steven", "middleName": "F.", "lastName": "Pond"}], "pattern": "MWF", "facilityDescr": "Lincoln Hall B21", "bldgDescr": "Lincoln Hall", "facilityDescrshort": "LNCB21", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "3480", "type": "C"}, {"subject": "LATA", "catalogNbr": "3480", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "3480", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Few areas of cultural expression can rise to the importance of music in Brazilian life. This seminar-style course employs discussion, critical reading and listening \u2013 and hands-on music-making \u2013 to investigate Brazilian culture, history, and politics through the lens of its music.\u00a0 Samba will be a significant focus, but we will also discuss a range of additional regional and national styles. Along with two class meetings per week, our \"discussion\" will coincide with rehearsals for Deixa Sambar, Cornell's Brazilian ensemble. The course will be taught in English. Music experience is not necessary, but engagement in music-making is an integral part of the course.", "catalogBreadth": "(GB)", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 359090, "crseOfferNbr": 1, "subject": "PORT", "catalogNbr": "4200", "titleShort": "Topics in Brazilian Lit", "titleLong": "Special Topics in Brazilian Literature", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 16648, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "pre5", "firstName": "Pedro", "middleName": "Rabelo", "lastName": "Erber"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "ma