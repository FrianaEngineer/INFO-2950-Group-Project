eld. Students will give both individual and team talks.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "Satisfies the College of Engineering's engineering communication requirement.", "catalogPrereqCoreq": "Prerequisite: two First-Year Writing Seminars and major affiliation.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: EN and BEE seniors or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": ["Oral Communication/Presentations: Plan, devise, formulate, design, and report information via professional presentations for various technical and stakeholder needs.", "Written Communication: Identify, research, negotiate, and compose various texts to further a technical or engineering effort with consideration to context and audience; use writing and planning skills to support presentation work both for the talk itself and as archival legacy documentation.", "Visual and Multimodal Communication: Visualize, illustrate, and appropriately caption visuals; discriminate between methodologies for creating visuals other multimodal artifacts to support the technical endeavor; create visuals and multimodal artifacts that are accessible."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 373380, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3027", "titleShort": "Cross-cultural Comm & Ethics", "titleLong": "Cross-cultural Communications and Ethics in the Workplace", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11533, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:15PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "hw472", "firstName": "Hua", "middleName": "", "lastName": "Wang"}], "pattern": "T", "facilityDescr": "Hollister Hall 206", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS206", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 11534, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:15PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "hw472", "firstName": "Hua", "middleName": "", "lastName": "Wang"}], "pattern": "R", "facilityDescr": "Hollister Hall 206", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS206", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Engineering industries increasingly demand individual contributors and teams that can communicate and collaborate with professionals across diverse cultures. The purpose of this course is to increase students' cultural awareness and sensitivity and develop intercultural competence while engaging positively in technical work. Course topics will focus on engineering communication and practices of human-centered design, thereby exposing cultural dimensions and ethical consequences of human-engineered artifacts. Through various kinds of genre writing practice and a major teamwork project, students are expected to improve written, oral, visual and interpersonal communication skills as well.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "Satisfies the College of Engineering's engineering communication requirement.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: EN and BEE juniors and\u00a0seniors or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": ["Demonstrate cultural awareness and sensitivity, adapt themselves to audiences from other cultures in both written, visual, and oral communication.", "Demonstrate ethical awareness in technology design/development and create accessible communication artifacts.", "Effectively collaborate with teammates and professionally communicate with clients; increase presentation skills, including creating effective slides and professionally presenting information to clients.", "Effectively compose various kinds of workplace documents to further a technical or engineering effort with consideration to context and audience, especially different cultural contexts and audiences from other cultures.", "Visualize, illustrate, and appropriately caption visuals; create accessible multimodal artifacts to support the technical endeavor.", "Design and conduct engineering and cross-cultural communication research for professional goals; access library databases and use sources accurately."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 355625, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3340", "titleShort": "Indep Study in Engr Comm", "titleLong": "Independent Study in Engineering Communications", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 17584, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 2, "netid": "tmn46", "firstName": "Traci", "middleName": "M.", "lastName": "Nathans-Kelly"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": null}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "Individual Projects", "openStatus": "O",