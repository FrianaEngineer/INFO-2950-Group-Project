rlong": "This course is part of the Shared Course Initiative (SCI). For more information about SCI courses, please see http://sharedcourseinitiative.org/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This advanced course is focused on Dutch literature and films. Students will be reading two novels, which are both considered to be cornerstones of Dutch literature; both deal with crucial historical events. After finishing each novel, students will see the film adaptation of these novels. Students will prepare and read the novels in installments at home, and will get a deep understanding of the historical background of the events described in the novels in class. Relevant Dutch history will be highlighted through background readings and video.", "catalogBreadth": null, "catalogDistr": "(FL-AG)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "This course is part of the Shared Course Initiative (SCI) and will be taught from Columbia University using videoconferencing technology.", "catalogPrereqCoreq": "Prerequisite: DUTCH 3020\u00a0 or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 368002, "crseOfferNbr": 1, "subject": "DUTCH", "catalogNbr": "5010", "titleShort": "17th Century Dutch Texts", "titleLong": "17th Century Dutch Texts", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5125, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "12:45PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 6, "netid": "ak2573", "firstName": "Angelika", "middleName": "", "lastName": "Kraemer"}], "pattern": "W", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This course is part of the Shared Course Initiative (SCI). For more information about SCI courses, please see http://sharedcourseinitiative.org/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The course is specifically meant for PhD candidates, but undergraduates are welcome as well. Each week we read a different text, mainly from the 17th century, based on students' needs: topics of texts typically cover art history, law, history, literature etc.\u00a0 These materials help students greatly with the difficult task of reading challenging printed and handwritten texts from the late 16th and 17th centuries.\u00a0The course starts with an overview of reading strategies that students learn to apply when approaching texts written in the 1600's. As the semester progresses, we read more and more complex texts. The last two weeks of the semester are devoted to handwritten texts and students get an introduction to various hands. The goal of the course is to prepare students for archival research.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SEAP)", "catalogWhenOffered": "Spring.", "catalogComments": "Texts in Dutch, taught in English.\u00a0This course is part of the Shared Course Initiative (SCI) and will be taught from Columbia University using Videoconferencing technology.\u00a0", "catalogPrereqCoreq": "Prerequisite: four semesters of Dutch or German language or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2025-06-08T19:22:06-0400", "catalogDttm": "2025-06-08T19:07:04-0400"}}