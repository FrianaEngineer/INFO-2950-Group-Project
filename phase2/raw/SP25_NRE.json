librium, and various equilibrium refinements. Coverage then turns to basic frameworks that utilize game theory to model a wide range of settings in economics and related fields. These include agency analysis, classic asymmetric information models such as adverse selection and signaling, time inconsistency, and repeated games and reputation.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to read and interpret applied game theory models that appear in the economics literature.", "Students will be able to construct and solve game theory models that frequently appear in applied theory papers and empirical papers.", "Students will be able to explain basic economic concepts such as signaling, adverse selection, time inconsistency, competitive equilibrium, etc."], "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 362022, "crseOfferNbr": 1, "subject": "NRE", "catalogNbr": "5040", "titleShort": "PhD Seminar in Accounting", "titleLong": "PhD Seminar in Accounting", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 12164, "meetings": [{"classMtgNbr": 2, "timeStart": "02:00PM", "timeEnd": "05:00PM", "startDt": "01/21/2025", "endDt": "03/11/2025", "instructors": [{"instrAssignSeq": 16, "netid": "bjw235", "firstName": "Brian", "middleName": "J.", "lastName": "White"}], "pattern": "W", "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: graduate students."}, {"classNotesSeq": 2, "d