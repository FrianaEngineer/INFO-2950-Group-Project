"subject": "PLHRT", "catalogNbr": "4175", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Covers basics of establishing a greenhouse operation, growing crops in optimized environments, and serving niche or mass market. Discusses technology basics including structures and equipment, systems for heating and cooling, lighting, irrigating and fertilizing, material handling, environmental stewardship, integrated pest management, and production management. Also covers world centers of greenhouse crop production; culture of cut, pot, bedding, vegetable, and fruit crops in greenhouses, emphasizing predictive harvesting through environmental, physical, and chemical management of growth and development. Each student grows one or more crops.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Offered in even-numbered years only. Mandatory two-day, one-overnight field trip.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Explain the importance of the major environmental factors that affect plant growth, especially in semi-controlled environments (greenhouses).", "Describe how and why a protected cultivation structure can influence the plant-growing environment.", "Describe environmental manipulations needed to control floral induction, initiation, and development in a variety of plants, and how to apply them to produce commercially acceptable crops.", "Successfully produce a variety of flowering crops within a commercially acceptable time period.", "Develop production costs for a crop or crop sequence.", "Use outside resources to develop and evaluate methods of growing an unknown crop.", "Be conversant in the major greenhouse production and management systems and how they interact to profitably and responsibly produce floral crops."], "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 372972, "crseOfferNbr": 1, "subject": "PLHRT", "catalogNbr": "5350", "titleShort": "Sustainable Orchard Management", "titleLong": "Sustainable Orchard Management", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2497, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "gmp32", "firstName": "Gregory", "middleName": "Michael", "lastName": "Peck"}], "pattern": "TR", "facilityDescr": "Green Grnhouse Bldg G 170-KPL", "bldgDescr": "Green Greenhouse Bldg G", "facilityDescrshort": "GGG170", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "LAB", "ssrComponentLong": "Laboratory", "section": "401", "classNbr": 2514, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "04:25PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "gmp32", "firstName": "Gregory", "middleName": "Michael", "lastName": "Peck"}], "pattern": "R", "facilityDescr": "Green Grnhouse Bldg G 170-KPL", "bldgDescr": "Green Greenhouse Bldg G", "facilityDescrshort": "GGG170", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC", "LAB"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "PLHRT", "catalogNbr": "3350", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The science of tree-fruit production with an emphasis on the agroecology and physiology of regionally important species. Topics include: site selection; orchard design; clonal rootstock and variety selection; nursery production and grafting, tree pruning and training; flowering and pollination; crop load management; water, nutrient, and soil management; fruit ripening, maturity, and storage; marketing and profitability; integrated pest management; orchard mechanization; and sustainable production practices. Students will synthesize and apply knowledge from a broad range of life sciences within the context of perennial crop agroecosystems. Orchard field trips and lab sessions will provide practical, hands-on experience. This course is designed for students interested in commercial tree-fruit production and/or pomology research, hobby fruit growers, and professional IPM consultants.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Offered in even-numbered years only.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Make critical decisions required for profitable orchard management.", "Find and evaluate essential information resources about tree-fruit orchards.", "Integrate key ecological, physiological, environmental, and economic issues in sustainable orchard systems.", "Select the optimal systems for orchard management.", "Successfully plant, prune, and train fruit trees.", "Harvest, store, and market fruit efficiently.", "Synthesize course material into IPM and Commodity Report fact sheets that address sustainable orchard management.", "Produce a 15-20 page term paper based on a review and interpretation of current literature.", "Apply knowledge of fruit physiology to mentor undergraduate colleagues by reviewing and providing a critical assessment of undergraduate term paper drafts."], "acadCareer": "GR", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 354422, "crseOfferNbr": 1, "subject": "PLHRT", "catalogNbr": "5850", "titleShort": "Public Garden Management", "titleLong": "Public Garden Management", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2240, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "sms92", "firstName": "Sonja", "middleName": "M.", "lastName": "Skelly"}], "pattern": "MW", "facilityDescr": "Academic Surge A 109", "bldgDescr": "Academic Surge A", "facilityDescrshort": "ASA109", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "loc