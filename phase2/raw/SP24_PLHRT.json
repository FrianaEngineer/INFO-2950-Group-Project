, "description": "The science of tree-fruit production with an emphasis on the agroecology and physiology of regionally important species. Topics include: site selection; orchard design; clonal rootstock and variety selection; nursery production and grafting, tree pruning and training; flowering and pollination; crop load management; water, nutrient, and soil management; fruit ripening, maturity, and storage; marketing and profitability; integrated pest management; orchard mechanization; and sustainable production practices. Students will synthesize and apply knowledge from a broad range of life sciences within the context of perennial crop agroecosystems. Orchard field trips and lab sessions will provide practical, hands-on experience. This course is designed for students interested in commercial tree-fruit production and/or pomology research, hobby fruit growers, and professional IPM consultants.", "catalogBreadth": "", "catalogDistr": "(OPHLS-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "Offered in even-numbered years only.", "catalogPrereqCoreq": "Prerequisite: two college-level biology courses. Recommended prerequisite: previous horticulture/plant science courses.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Make critical decisions required for profitable orchard management.", "Find and evaluate essential information resources about tree-fruit orchards.", "Integrate key ecological, physiological, environmental, and economic issues in sustainable orchard systems.", "Select the optimal systems for orchard management.", "Successfully plant, prune, and train fruit trees.", "Harvest, store, and market fruit efficiently."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"st