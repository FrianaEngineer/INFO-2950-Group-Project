 of this course, students will have more awareness of the choices writers make as they work at the paragraph, sentence-, and word-level to communicate clearly to readers.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring (weeks 1-7 and 8-15 both semesters).", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 368954, "crseOfferNbr": 1, "subject": "ELSO", "catalogNbr": "6540", "titleShort": "Advanced Academic Writing", "titleLong": "Advanced Academic Writing: Writing with Sources", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14985, "meetings": [{"classMtgNbr": 1, "timeStart": "06:00PM", "timeEnd": "08:25PM", "startDt": "10/21/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 5, "netid": "nwl26", "firstName": "Nathan", "middleName": "W.", "lastName": "Lindberg"}], "pattern": "R", "facilityDescr": "Caldwell Hall 250", "bldgDescr": "Caldwell Hall", "facilityDescrshort": "CLD250", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Only international graduate and professional students who pay tuition to Cornell may enroll. For ELSO course policies, go to knight.as.cornell.edu/elso."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/21/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort":