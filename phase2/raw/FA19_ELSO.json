ng goals, participate in discussions about research writing, and have the option to use the rest of the class meeting time to write, learn about specific aspects of research writing, and/or meet with the instructor for individual consultations \u2014whatever would best help them make progress on their research paper.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 369651, "crseOfferNbr": 1, "subject": "ELSO", "catalogNbr": "6610", "titleShort": "Communicating in the Workplace", "titleLong": "Communicating in the Workplace", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 15017, "meetings": [{"classMtgNbr": 1, "timeStart": "06:00PM", "timeEnd": "08:25PM", "startDt": "10/21/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "mtc225", "firstName": "Michelle", "middleName": "T.", "lastName": "Cox"}], "pattern": "W", "facilityDescr": "Caldwell Hall 250", "bldgDescr": "Caldwell Hall", "facilityDescrshort": "CLD250", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Only international graduate and professional students who pay tuition to Cornell may enroll. For ELSO course policies, go to knight.as.cornell.edu/elso."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/21/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "10/23/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": null}], "description": "This course is designed for international graduate and professional students who will need to communicate in English in professional contexts. Students will learn about differences between academic and workplace writing, explore North American workplace culture, investigate writing practices in particular professions, and gain experience with oral and written professional communication through a team project.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 369649, "crseOfferNbr": 1, "subject": "ELSO", "catalogNbr": "6620", "titleShort": "Prep for Professional Job Srch", "titleLong": "Preparing for the Professional Job Search", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14873, "meetings": [{"classMtgNbr": 1, "timeStart": "06:00PM", "timeEnd": "08:25PM", "startD