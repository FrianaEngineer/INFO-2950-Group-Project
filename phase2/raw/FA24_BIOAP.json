ypical for the meeting pattern due to substantial academic activity outside of instructional hours.", "catalogPrereqCoreq": "Prerequisite or corequisite: BIOAP 3110.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: pre-med/pre-vet juniors, seniors, and graduate students interested in biomedical science.", "catalogCourseSubfield": "", "catalogOutcomes": ["After this course the student will be able to compute physical phenomena, including electrochemical gradients and mechanical forces in the physiology of live systems.", "After this course the student will be able to describe the scientific method including experimental design, formulating, and testing hypotheses.", "After this course the student will be able to work cooperatively in small groups.", "After this course the student will be able to communicate scientific concepts and experimental results in written and oral form.", "After this course the student will be able to use statistics to assess the significance of results.", "After this course the student will be able to research the published scientific findings and interpret them."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 354567, "crseOfferNbr": 2, "subject": "BIOAP", "catalogNbr": "4270", "titleShort": "Fundamentals of Endocrinology", "titleLong": "Fundamentals of Endocrinology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1622, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 7, "netid": "yar9", "firstName": "Yi", "middleName": "Athena", "lastName": "Ren"}], "pattern": "MWF", "facilityDescr": "Morrison Hall B82", "bldgDescr": "Morrison Hall", "facilityDescrshort": "M