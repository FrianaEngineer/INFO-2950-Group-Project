s)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AEM", "catalogNbr": "3547", "type": "C"}, {"subject": "DSOC", "catalogNbr": "3547", "type": "C"}, {"subject": "GOVT", "catalogNbr": "3547", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Do you want to learn the discussion-based case method as taught at the Harvard Business School? Do you want to learn how to write a long research paper? Do you not want to take a final examination? If you answer these questions affirmatively, this course may be for you. We are told often that American primacy is in decline and that other powers are rising. What does this mean when we examine the experience of Government and Business in different countries around the world?\u00a0 Is the international political economy a hydraulic system in which some units rise and others fall? Are the dynamics of the international political economy all pointing in one direction? Or are they marked by cross-currents?\u00a0 This course seeks answers to these questions by teaching the basics of macro-economics, examining a range of powerful states (among others China, India, Russia and Japan) and persisting issues (financial globalization and foreign investment; oil and OPEC; trade and aid) as they play themselves out in different countries (such as Malaysia, Korea; Saudi Arabia, Nigeria; Mexico, Brazil, Uganda, Indonesia).", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 368931, "crseOfferNbr": 4, "subject": "ILRIC", "catalogNbr": "4312", "titleShort": "Migration in the Americas", "titleLong": "Migration in the Americas: Engaged Research Methods and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17861, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 5, "netid": "dac9", "firstName": "Debra", "middleName": "Ann", "lastName": "Castillo"}], "pattern": "TR", "facilityDescr": "Uris Hall 369", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH369", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4575", "type": "B"}, {"subject": "COML", "catalogNbr": "6375", "type": "B"}, {"subject": "DSOC", "catalogNbr": "4312", "type": "B"}, {"subject": "DSOC", "catalogNbr": "6312", "type": "B"}, {"subject": "ILRIC", "catalogNbr": "6312", "type": "B"}, {"subject": "LSP", "catalogNbr": "4312", "type": "B"}, {"subject": "LSP", "catalogNbr": "6312", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course will introduce students to basic concepts and developments related to migrants and migration in Central America, Mexico, and the United States via engaged learning and research. The course will be organized around core themes such as the challenges and ethics of working with vulnerable populations, workplaces and working conditions, oral histories/testimonios, and immigration policy and enforcement practices. Students will learn qualitative methodologies for field research. All students will practice their skills through collaboration with the Cornell Farmworker Program on priority projects identified by immigrant farmworkers.\u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: juniors, seniors, and graduate students.\u00a0Permission of instructor required.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 355581, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4330", "titleShort": "Politics of the Global North", "titleLong": "Politics of the Global North", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16621, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "lrt4", "firstName": "Lowell", "middleName": "", "lastName": "Turner"}], "pattern": "TR", "facilityDescr": "Ives Hall 305", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS305", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "3303", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "From a perspective based on comparative political economy, this course examines pressing contemporary issues such as the politics of growing inequality.\u00a0 We consider conflicts around markets, democracy, economic and social justice, including the efforts of actors such as governments and labor unions aimed at economic recovery, reducing inequality, and the reform of national and global economic policy and institutions.\u00a0 We also look at distinctive types of political and economic organization, especially in Europe and the United States, and the capacities of these societies to meet current economic, political, and social challenges, both domestic and international.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 364423, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4340", "titleShort": "Special Topics in ICL", "titleLong": "Special Topics in International and Comparative Labor", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14861, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/29/2019", "endDt": "10/18/2019", "instructors": [{"instrAssignSeq": 1, "netid": "rb655", "firstName": "Balu", "middleName": "", "lastName": "Balasubramaniam"}], "pattern": "TR", "facilityDescr": "Ives Hall 109", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS109", "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "The predominant and narrow view that development equates to growth in income, expansion of infrastructure and rise in the standard of living is no longer seen as comprehensive or adequate. The World is also coming to terms with the inadequacy of mere economic growth and is struggling to find a development paradigm that is pragmatic to implement while ensuring sustainability at the same time. This course is about exploring an alternate development paradigm that draws lessons and inspiration from success stories across the world.   It is built on the capability approach that many development economists are increasingly subscribing to and will help the student understand how building human and social capital will result in economic consequences."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "10/18/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "An Alternate Paradigm of Sustainable Development", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "7W1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "10/22/2019", "sessionLong": "Seven Week - First", "exploreCriteriaIds": null}], "description": "Devoted to new topics in the field. The specific content and emphasis vary depending upon the interests of the faculty member teaching the course.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 364426, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "4360", "titleShort": "Global Comparative Disability", "titleLong": "Global Comparative Disability Policy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14464, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "10:00PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 2, "netid": "tpg3", "firstName": "Thomas", "middleName": "P.", "lastName": "Golden"}, {"instrAssignSeq": 6, "netid": "mcs378", "firstName": "Matthew", "middleName": "C", "lastName": "Saleh"}], "pattern": "M", "facilityDescr": "Ives Hall 305", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS305", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Globalization is having a significant impact on international disability policy, as well as on the empowerment of grassroots disability movements in countries around the world. This course will provide an overview of international public policies on disability; focusing on the employment and human rights of people with disabilities. Students will be introduced to the United Nations Convention on the Rights of Persons with Disabilities, and provided an in-depth comparative policy analysis of current and emerging disability and employment policy from around the world. The instructor will provide an initial framework for comparative analysis of public policy, which will be used to guide student analyses throughout the course. Class lectures will be supplemented with presentations by experts from each country that will outline the evolution of country-specific disability policies and discuss how these policies have translated to practice.\u00a0 Students will also learn how various countries evaluate the impact of these policies in achieving specific outcomes. Experientially based methods will be used to maximize learning outcomes, including identification and discussion of current events shaping international disability policy; and weighing the merits of specific policies in different parts of the world/countries, designed to directly address disability discrimination and enhance labor market participation of individuals with disabilities.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 368930, "crseOfferNbr": 4, "subject": "ILRIC", "catalogNbr": "6312", "titleShort": "Migration in the Americas", "titleLong": "Migration in the Americas: Engaged Research Methods and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8578, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 5, "netid": "dac9", "firstName": "Debra", "middleName": "Ann", "lastName": "Castillo"}], "pattern": "TR", "facilityDescr": "Uris Hall 369", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH369", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4575", "type": "B"}, {"subject": "COML", "catalogNbr": "6375", "type": "B"}, {"subject": "DSOC", "catalogNbr": "4312", "type": "B"}, {"subject": "DSOC", "catalogNbr": "6312", "type": "B"}, {"subject": "ILRIC", "catalogNbr": "4312", "type": "B"}, {"subject": "LSP", "catalogNbr": "4312", "type": "B"}, {"subject": "LSP", "catalogNbr": "6312", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course will introduce students to basic concepts and developments related to migrants and migration in Central America, Mexico, and the United States via engaged learning and research. The course will be organized around core themes such as the challenges and ethics of working with vulnerable populations, workplaces and working conditions, oral histories/testimonios, and immigration policy and enforcement practices. Students will learn qualitative methodologies for field research. All students will practice their skills through collaboration with the Cornell Farmworker Program on priority projects identified by immigrant farmworkers.\u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: juniors, seniors, and graduate students.\u00a0Permission of instructor required.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 368218, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "9800", "titleShort": "Workshop in ICL", "titleLong": "Workshop in International and Comparative Labor", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 14570, "meetings": [{"classMtgNbr": 1, "timeStart": "12:00PM", "timeEnd": "01:30PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 4, "netid": "al2284", "firstName": "Adam Seth", "middleName": "", "lastName": "Litwin"}], "pattern": "W", "facilityDescr": "Ives Hall 381", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS381", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [{"subject": "ILRLR", "catalogNbr": "9800", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Provides a forum for the presentation of current research being undertaken by faculty members and graduate students in the Department of International and Comparative Labor, and by invited guests. All M.S. and Ph.D. candidates in the department who are at work on their theses are strongly urged to enroll. Students are encouraged to make presentations focusing on the formulation, design, execution, and results of their thesis research.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2020-01-08T19:14:22-0500", "catalogDttm": "2020-01-08T19:15:26-0500"}}