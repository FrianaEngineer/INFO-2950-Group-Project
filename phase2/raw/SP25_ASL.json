erican cultural context, with constructions of Deaf people as a linguistic minority. A major focus of this course is to bring students to an understanding of how differently the world can be viewed through \"Deaf eyes\" and how understanding this worldview can account for views toward the teaching and enculturation of deaf children, Deafhood, biomedical ethics, oppression of signed languages, the provision of accommodations under the Americans with Disabilities Act, and a host of other issues at the interface between hearing and Deaf cultures.", "catalogBreadth": null, "catalogDistr": "(SCD-AS) (D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Can be taken concurrently with ASL 2201. Course conducted entirely in ASL.", "catalogPrereqCoreq": "Prerequisite:\u00a0ASL 1102\u00a0or by permission from lead ASL instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 372988, "crseOfferNbr": 1, "subject": "ASL", "catalogNbr": "3215", "titleShort": "Deaf Art, Film and Theatre", "titleLong": "Deaf Art, Film and Theatre", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5959, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "bs794", "firstName": "Brenda", "middleName": "", "lastName": "Schertz"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", 