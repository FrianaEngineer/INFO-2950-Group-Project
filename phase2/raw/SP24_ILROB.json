{"status": "success", "data": {"classes": [{"strm": 2867, "crseId": 364196, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "2240", "titleShort": "Writing Persuasively", "titleLong": "Writing Persuasively about the Science of Persuasion", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18776, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "vkb28", "firstName": "Vanessa", "middleName": "Kimberly", "lastName": "Bohns"}], "pattern": "MW", "facilityDescr": "Ives Hall 103", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS103", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "ILR Sophomore Writing Requirement is limited to ILR sophomores or others with permission of instructor who have not satisfied their ILR Sophomore Writing Requirement. Not open to first year students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Many things get done and decisions get made in organizations through acts of persuasion and social influence. In lieu of formal power, people must be able to persuade others to come around to their point of view. At the same time, employees frequently influence one another and the broader organizational culture without even trying through social influence processes such as conformity, compliance, and behavioral contagion. In this course, students will learn about established and emerging research on persuasion and social influence by reading academic journal articles and then translating these articles into op-ed style essays that are understandable to the broader public, applicable to current events, and accurately represent the research findings.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Satisfies the ILR sophomore writing requirement.", "catalogPermission": "Enrollment limited to: ILR sophomores or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 371379, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "3240", "titleShort": "Understanding &Improving Decs", "titleLong": "Understanding and Improving Decision Making", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10935, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "sf562", "firstName": "Sean", "middleName": "", "lastName": "Fath"}], "pattern": "MW", "facilityDescr": "Ives Hall 116", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS116", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 10969, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "sf562", "firstName": "Sean", "middleName": "", "lastName": "Fath"}], "pattern": "MW", "facilityDescr": "Ives Hall 116", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS116", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Our lives are built upon countless decisions, some small (What am I going to wear to class?) and some very consequential (Should I accept this job offer?). This course will cover the basics in the science of decision making, exploring the ways in which people tend to make decisions, the ways people ought to make decisions, and common discrepancies between the two. Students will learn about rational models of decision making and the reasons why people's decisions often stray from these models. Students will explore different modes of decision making, such as intuition vs. deliberation, and will discuss various pitfalls (i.e., predictable biases) associated with the use of common decision making strategies or rules of thumb. Many of these topics will bediscussed in terms of their organizational consequences, such as the effects of different decision making strategies and heuristics on the fairness and objectivity of hiring decisions. Most importantly, students will leave the class with a toolkit to avoid errors and biases in their own decisions.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 371056, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "3260", "titleShort": "Building Power from Nothing", "titleLong": "Building Power from Nothing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18286, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bb686", "firstName": "Brittany", "middleName": "M.", "lastName": "Bond"}], "pattern": "MW", "facilityDescr": "Ives Hall 215", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS215", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This is a course about power and influence. We will discuss how to map power and interest patterns in organizations, how to understand various groups' interests and objectives, and how to operate effectively in organizational environments. Organizational actors differ in the power and resources that they bring to bear in order to advance their perspectives. Students will learn how to advance personal interests, even from positions of little structural advantage. This class will develop frameworks as well as a range of practical tools to address these goals. The course will take a macro approach to studying power and influence, focusing on organizational culture, politics, influence, and leadership. Students will learn how to build power from nothing, as well as how to become successful agents of lasting organizational change.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0ILRID 1531.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 368189, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "3760", "titleShort": "Sport Psychology", "titleLong": "Sport Psychology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10927, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 2, "netid": "emz34", "firstName": "Emily", "middleName": "M.", "lastName": "Zitek"}], "pattern": "MW", "facilityDescr": "Ives Hall 115", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS115", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequi