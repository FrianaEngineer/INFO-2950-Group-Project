{"status": "success", "data": {"classes": [{"strm": 2741, "crseId": 370330, "crseOfferNbr": 2, "subject": "RUSSL", "catalogNbr": "2157", "titleShort": "Tolstoy:History&CounterCulture", "titleLong": "Tolstoy: History and Counter-Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17681, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "ol76", "firstName": "Olga", "middleName": "", "lastName": "Litvak"}], "pattern": "TR", "facilityDescr": "McGraw Hall 145", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG145", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "HIST", "catalogNbr": "2157", "type": "C"}, {"subject": "RELST", "catalogNbr": "2157", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Tolstoy is impossible. An aristocrat who renounced his wealth. A man of titanic appetites who repeatedly swore off meat, alcohol and sex. A Christian who didn't believe in God. An anarchist who ruled his own estate like an ancient patriarch. A writer of genius who thought literature was evil and a waste of time and referred to his greatest book as \"garbage.\" An inexhaustible skeptic who wanted nothing but mere faith. In Tolstoy's imaginative universe, we may find the origin of many modern contradictions and anxieties, about money, about sec and about power. But Tolstoy's modern consciousness was not created in Paris or New York. Tolstoy was made in late imperial Russia - notoriously, the least modern country in nineteenth-century Europe. How, then, did Tolstoy happen? How can we account historically for his epic project of self-fashioning? In this seminar, we will see Tolstoy at work in the creation of an heroic counter-cultural persona, writing against the social and political currents of his own time.", "catalogBreadth": "", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 353925, "crseOfferNbr": 1, "subject": "RUSSL", "catalogNbr": "3385", "titleShort": "Reading Nabokov", "titleLong": "Reading Nabokov", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 7186, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "gs33", "firstName": "Gavriel", "middleName": "", "lastName": "Shapiro"}], "pattern": "TR", "facilityDescr": "Goldwin Smith Hall 348", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH348", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "In translation."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "3815", "type": "C"}, {"subject": "ENGL", "catalogNbr": "3790", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/29/2019", "sessionEndDt": "12/10/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course offers an exciting trip to the intricate world of Nabokov's fiction. After establishing himself in Europe as a distinguished Russian writer, Nabokov, at the outbreak of World War II, came to the United States where he reestablished himself, this time as an American writer of world renown. In our analysis of Nabokov's fictional universe, we shall focus on his Russian corpus of works, from Mary (1926) to The Enchanter (writ. 1939), all in English translation, and then shall examine the two widely read novels which he wrote in English in Ithaca while teaching literature at Cornell: Lolita (1955) and Pnin (1957).", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "In translation.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 370364, "crseOfferNbr": 1, "subject": "RUSSL", "catalogNbr": "3386", "titleShort": "Life/Love/Death 20C Russ Prose", "titleLong": "Life, Love, and Death in Twentieth-Century Russian Prose", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16872, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 1, "netid": "gs33", "firstName": "Gavriel", "middleName": "", "lastName": "Shapiro"}], "pattern": "TR", "facilityDescr": "Goldwin Smith Hall 348", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH348", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Updated course description: For over a century now, the Soviet/Russian regime has been one of the foremost adversaries of the American democracy. In order to interact with the country successfully, it is imperative to become familiar with it as a sociopolitical and cultural entity. To this end, this course provides a vital lens through which one may look at Russia\u2019s modern history and comprehend its contemporary mentality. We shall discuss the works by classics of twentieth-century Russian prose, such as Chekhov, Bunin, Bulgakov, Nabokov, Solzhenitsyn, Shalamov, and Voinovich. In translation."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person"