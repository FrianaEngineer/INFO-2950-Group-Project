Code": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "An introductory history of Chinese, Japanese, Asian Indians, Filipinos, and Koreans in the United States from the mid-nineteenth century to the 1990s. Major themes include racism and resistance, labor migration, community formation, imperialism, and struggles for equality.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 367057, "crseOfferNbr": 3, "subject": "AAS", "catalogNbr": "2269", "titleShort": "Korean Popular Culture", "titleLong": "Korean Popular Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11891, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "isy4", "firstName": "Ivanna", "middleName": "Sang Een", "lastName": "Yi"}], "pattern": "MW", "facilityDescr": "Rockefeller Hall 115", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK115", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASIAN", "catalogNbr": "2269", "type": "C"}, {"subject": "PMA", "catalogNbr": "2465", "type": "C"}, {"subject": "SHUM", "catalogNbr": "2269", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course introduces Korean popular culture in global context. Beginning with cultural forms of the late Chos\u014fn period, the course will also examine popular culture during the Japanese colonial period, the post-war period, the democratization period, and contemporary Korea. Through analysis of numerous forms of media, including films, television, music, literature, and music videos, the course will explore the emergence of the \"Korean Wave\" in East Asia and its subsequent global impact. In our examination of North and South Korean cultural products, we will discuss theories of transnationalism, globalization, and cultural politics. The course will consider the increasing global circulation of Korean popular culture through new media and K-Pop's transculturation of forms of American music such as rap. Readings for the course will be in English or in English translation and no prior knowledge of Korean culture is required.", "catalogBreadth": "(GB)", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq"