ough community engagement, public service, and leadership training, guest faculty and students discuss stimulating real-world learning experiences arising from a variety of courses and semesters abroad that include fieldwork in Africa, Asia, and Latin America. Opportunities for academic coursework beyond Cornell and for research and practical internships are also discussed. The course provides an opportunity for students to develop a personalized plan of study that matches their personal and professional aspirations. Such preparation might include combinations of area and language studies; training in community engagement, public service, and/or leadership; international travel workshops, specialized coursework, and/or research methodological development.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-ITL, CU-SBY, CU-UGR)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: freshmen and sophomores majoring or minoring in AGSCI, ESS, or IARD (IDS); others by permission.", "catalogCourseSubfield": "", "catalogOutcomes": ["Better understand how their personal strengths and talents can inform and enhance their professional lives.", "Articulate the characteristics of various approaches to community-engaged service/experiential learning and identify those that support their academic and career goals.", "Use critical reflection to assess the personal outcomes of experiential learning.", "Appreciate the scope of community-engaged international experiences available at Cornell and elsewhere.", "Identify specific community-engaged international experiences that would further personal and professional goals while also meeting curricular requirements for their majors.\u00a0"], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 361069, "crseOfferNbr": 2, "subject": "IARD", "catalogNbr": "4030", "titleShort": "Traditional Agriculture", "titleLong": "Traditional Agriculture in Developing Nations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2872, "meetings": [{"classMtgNbr": 1, "timeStart": "11:25AM", "timeEnd": "12:40PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 8, "netid": "ph14", "firstName": "Peter", "middleName": "", "lastName": "Hobbs"}], "pattern": "W", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [{"subject": "PLSCS", "catalogNbr": "4030", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Half the world's arable land is farmed by traditional farmers who have produced food and fiber for millennia with few outside inputs. Many of these practices are forgotten but some are still used by farmers in developing countries. This course examines the pros and cons of some of these traditional systems through the lens of various Cornell faculty who have experiences with traditional agriculture in developing countries.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-SBY, EC-LASP)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Discuss the pros and cons of traditional agricultural practices found around the world from biophysical and social perspectives.", "Compare and evaluate traditional agriculture farming practices in terms of productivity, sustainability, labor needs and possible relevance to today's agriculture.", "Research other traditional agricultural practices and discuss how components could be useful or not in helping modern day agriculture meet food security needs."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 369782, "crseOfferNbr": 7, "subject": "IARD", "catalogNbr": "4721", "titleShort": "Peace Building Conflict Region", "titleLong": "Peace Building in Conflict Regions: Case Studies Sub-Saharan Africa Israel Palestinian Territories", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 3118, "meetings": [{"classMtgNbr": 1, "timeStart": "09:30AM", "timeEnd": "12:00PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "cal22", "firstName": "Christine", "middleName": "", "lastName": "Leuenberger"}], "pattern": "R", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Tau