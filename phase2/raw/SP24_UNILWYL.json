nt, at caf\u00e9 you'll enjoy great conversation in a relaxed environment with coffee and treats provided! You may join the caf\u00e9 on a drop-in basis or take it as a 1-credit S/U course.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SAP)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 372217, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1416", "titleShort": "Socially Just Leadership Devel", "titleLong": "Socially Just Leadership Development", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8783, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "08:30PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 2, "netid": "pd327", "firstName": "Perdita", "middleName": "", "lastName": "Das-Humphrey"}, {"instrAssignSeq": 1, "netid": "ajh299", "firstName": "Andrew", "middleName": "J.", "lastName": "Hicks"}], "pattern": "W", "facilityDescr": "Hans Bethe House 125", "bldgDescr": "Hans Bethe House", "facilityDescrshort": "BET125", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment preference given to: residents of Bethe House and the West Campus House System. This is a Learning Where You Live course."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "\"Socially Just Leadership Development\" will provide students an opportunity to use an enhanced social justice lens to nurture their leadership development and push past performative allyship. This interactive 12-week class will challenge students to reflect critically on their identities, learn the path from diversity to inclusion and justice, develop tangible skills and tools to interrupt injustice, and further their learning and understanding of social justice. Students will engage in small and large group discussions, guided activities, and will submit a reflection paper at the end of the semester to outline tangible action steps they can take in their time at Cornell and beyond.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373500, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1520", "titleShort": "Food 