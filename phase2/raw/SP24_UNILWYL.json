radingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course will introduce students to the LGBTQAI+ umbrella experience through interactions with community partners and scholars specializing in issues of power, desire, sex, gender, race, and sexuality. These conversations will be supplemented with limited readings that will give a solid framework on LGBTQAI+ advocacy to students and allow them to understand the parameters in which these partners evolve, as well as the history of the LGBTQAI+ communities.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373611, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1170", "titleShort": "Toni Morrison Song of Solomon", "titleLong": "You wanna fly: Toni Morrison's Song of Solomon", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17709, "meetings": [{"classMtgNbr": 1, "timeStart": "07:00PM", "timeEnd": "08:50PM", "startDt": "03/13/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ava2", "firstName": "Anne", "middleName": "V", "lastName": "Adams"}], "pattern": "M", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "25L", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This is a Learning Where You Live course. Priority given to first-year students and Toni Morrison Hall residents."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/13/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/13/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "\"You wanna fly, you got to give up the s\u2014t that weighs you down.\" Cornell alumna (MA '55) and Nobel Laureate (1993) Toni Morrison invented this aphorism in her third novel, Song of Solomon, to articulate the search for what matters in an individual's definition of himself and, by extension, of family and community. We will read and discuss this award-winning novel in the context of Morrison's life and career, her place in African American, US, and world literature, and her exploration of crucial questions regarding identity, race, gender, history, oppression, and autonomy.\u00a0 Reading Morrison's epic novel closely, students will explore the novel's rich amalgam of folklore, racial politics, and vivid characterization, through engaged discussion both in class and online. \u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring."