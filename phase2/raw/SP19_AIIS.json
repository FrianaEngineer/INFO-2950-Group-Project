q": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to define and analyze Indigenous knowledge systems and situate Indigenous epistemologies and ontologies as unique bodies of knowledge.", "Students will gain an understanding of Haudenosaunee peoples as a distinct cultural entity and as an Indigenous people, exercising their sovereign rights within the territory of the present day United States.", "Students will know how to identify the ways in which Haudenosaunee knowledge systems have adapted over time to meet outside challenges as well as the needs of its members.", "Students will be able to recognize the original territory of the Haudenosaunee and trace its shifting boundaries into the post-Revolutionary period.", "Students will gain awareness of Ithaca's and Cornell's connection to the history of Cayuga people and their homelands.", "Students will become familiar with Haudenosaunee gender roles, social organization, and political and economic systems.", "Students will become aware of Haudenosaunee agriculture practices and botanical and ecological knowledge."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 366760, "crseOfferNbr": 2, "subject": "AIIS", "catalogNbr": "2240", "titleShort": "Native American Languages", "titleLong": "Native American Languages", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18006, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "sem269", "firstName": "Sarah", "middleName": "E.", "lastName": "Murray"}], "pattern": "TR", "facilityDescr": "Morrill Hall 106", "bldgDescr": "Morrill Hall", "facilityDescrshort": "MRL106", "meetingT