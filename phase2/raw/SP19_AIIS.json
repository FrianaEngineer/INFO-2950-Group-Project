uctionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}, {"ssrComponent": "DIS", "ssrComponentLong": "Discussion", "section": "204", "classNbr": 16566, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "jwp35", "firstName": "Jon", "middleName": "W.", "lastName": "Parmenter"}], "pattern": "F", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2660", "type": "C"}, {"subject": "HIST", "catalogNbr": "2660", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "One thing many Americans think they know is their Indians: Pocahontas, the First Thanksgiving, fighting cowboys, reservation poverty, and casino riches. Under our very noses, however, Native American history has evolved into one of the most exciting, dynamic, and contentious fields of inquiry into America's past. It is now safer to assume, as Comanche historian Paul Chaat Smith has pointed out, that everything you know about Indians is in fact wrong. Most people have much to \"unlearn\" about Native American history before true learning can take place. This course aims to achieve that end by (re)introducing students to key themes and trends in the history of North America's indigenous nations. Employing an issues-oriented approach, the course stresses the ongoing complexity of Native American societies' engagements with varieties of settler colonialism since 1492 and dedicates itself to a concerted program of myth-busting. As such, the course will provide numerous opportunities for students to develop their critical thinking and reading skills.", "catalogBreadth": "", "catalogDistr": "(D-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 360397, "crseOfferNbr": 1, "subject": "AIIS", "catalogNbr": "4000", "titleShort": "Critical Approaches to AIIS", "titleLong": "Critical Approaches to American Indian and Indigenous Studies: Intellectual History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 3993, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "04:25PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 3, "netid": "tar37", "firstName": "Troy", "middleName": "A.", "lastName": "Richardson"}], "pattern": "W", "facilityDescr": "Caldwell Hall 400", "bldgDescr": "Caldwell Hall", "facilityDescrshort": "CLD400", "meetingTopicDescription": ""}], "n