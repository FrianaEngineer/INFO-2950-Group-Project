talogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["List the major anatomical and physiological systems of the mammary gland and articulate how they support the fully functional gland.", "Describe the developmental and regulatory events leading to the formation of a fully functional mammary gland.", "Name the major components of milk and trace their synthesis to specific precursors and biochemical pathways.", "Explain the events leading to diseases associated with mammary development and lactation.", "Evaluate the scientific literature in one area of high interest to mammary gland biology and articulate deeper knowledge of this area through a poster presentation."], "acadCareer": "GR", "acadGroup": "AG", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2024SP, 2022SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 367868, "crseOfferNbr": 1, "subject": "BIOAP", "catalogNbr": "7100", "titleShort": "By Scientific Design", "titleLong": "By Scientific Design: Skill Building for a Career in the Life Sciences II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 12843, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:25PM", "startDt": "01/20/2026", "endDt": "03/12/2026", "instructors": [{"instrAssignSeq": 1, "netid": "rnc8", "firstName": "Ruth", "middleName": "N.", "lastName": "Collins"}], "pattern": "TR", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "02:55PM", "timeEnd": "04:25PM", "startDt": "03/24/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "rnc8", "firstName": "Ruth", "middleName": "N.", "lastName": "Collins"}], "pattern": "TR", "meetingTopicDescription": ""}, {"classM