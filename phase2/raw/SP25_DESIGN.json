of design. The instructor(s) of the course are drawn from the permanent and visiting faculty who may either broadly or narrowly define the course's scope and content.\u00a0Topics vary each semester.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Primarily for: graduate students, or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374369, "crseOfferNbr": 1, "subject": "DESIGN", "catalogNbr": "6298", "titleShort": "Coding for Design II", "titleLong": "Coding for Design II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19086, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 2, "netid": "ab3276", "firstName": "Adam", "middleName": "", "lastName": "Burke"}], "pattern": "W", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Design Tech students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The course is a continuation of DESIGN 6297. Students continue to explore and develop fundamental concepts and techniques for the integration of coding within design workflows at intermediate levels. The emphasis of the course is on the practical applications and design potential within such techniques while helping students understand the theoretical background and conceptual implications behind them. From a technical point, students will be introduced to XR technologies and material simulations and will handle both discrete and continuous forms. The aim is to develop intermediate skills and knowledge in order to be able to represent, analyze, synthesize and act upon spatial structures at various scales and levels of abstraction. The course is structured as a series of lecture/workshops accompanied by practical tutorials that will help students develop their coding skills.\u00a0", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: DESIGN 6297.\u00a0", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Demonstrate intermediate understanding of computational design, including key techniques, theory, and concepts.", "Develop intermediate skills in coding.", "Demonstrate intermediate to advanced ability in the development of digital tools for design applications.", "Demonstrate introductory understanding of XR technologies & material simulations."], "acadCareer": "GR", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374370, "crseOfferNbr": 1, "subject": "DESIGN", "catalogNbr": "6398", "titleShort": "Design Physical Interaction II", "titleLong": "Design for Physical Interaction II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19133, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 3, "netid": "mc2957", "firstName": "Marcelo", "middleName": "", "lastName": "Coelho"}, {"instrAssignSeq": 2, "netid": "dl2265", "firstName": "Daniel", "middleName": "", "lastName": "Leithinger"}], "pattern": "M", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Design Tech students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "LAB", "ssrComponentLong": "Laboratory", "section": "401", "classNbr": 19134, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "11:00AM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 3, "netid": "mc2957", "firstName": "Marcelo", "middleName": "", "lastName": "Coelho"}, {"instrAssignSeq": 2, "netid": "dl2265", "firstName": "Daniel", "middleName": "", "lastName": "Leithinger"}], "pattern": "T", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "locat