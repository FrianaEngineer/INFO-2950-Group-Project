97, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "01:10PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [], "pattern": "F", "facilityDescr": "Morrill Hall 107", "bldgDescr": "Morrill Hall", "facilityDescrshort": "MRL107", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "1951", "type": "C"}, {"subject": "HIST", "catalogNbr": "1951", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "To what extent does the ideal of the US as a vanguard for democracy and freedom in the world match up with other aspects\u2014military, economic, and humanitarian\u2014of US foreign policy? This same question about the degree to which discourses and practices correspond might be asked of other countries, like the Soviet Union, China, and Britain, but this course examines the ways in which US foreign policy has been deployed over the course of the twentieth century and the ways those policies have been perceived and received by people living in Latin America and Southeast Asia. Particular case studies will be addressed stemming from the faculty's specializations (for example, Vietnam, Cambodia, Guatemala, and Chile) and the emphasis is on the role of the United States in Latin America and Southeast Asia. Prominent themes will include forms of subversion, from military muscle to economic coercion, and how and why they have changed over time; meanings of liberty, democracy, freedom, and sovereignty in different places and times; popular responses to policies and actions of foreign administrations; the relationships between sovereign states and transnational corporations; the uses and abuses of History in the formulation and justification of policy initiatives and in local responses to them; and the complexities involved in discerning internal and external forces in an increasingly transnational world.", "catalogBreadth": "(GB)", "catalogDistr": "(HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 366384, "crseOfferNbr": 3, "subject": "LATA", "catalogNbr": "1970", "titleShort": "Pirates,Slaves,Revolutionaries", "titleLong": "Pirates, Slaves, and Revolutionaries: A History of the Caribbean from Columbus to Louverture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18121, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "eb577", "firstName": "Ernesto", "middleName": "E.", "lastName": "Bassi Arevalo"}], "pattern": "MW", "facilityDescr": "White Hall 106", "bldgDescr": "White Hall", "facilityDescrshort": "WHT106", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 18122, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "1790", "type": "C"}, {"subject": "HIST", "catalogNbr": "1970", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "What is the Caribbean? How did its native inhabitants fared in the aftermath of the arrival of Europeans? How did the region shift from a Spanish Lake to a heavily contested geopolitical site where all European powers vied for political and commercial superiority? What were the main production systems of the region and how did they result in dramatic environmental change? How did the eighteenth-century revolutions transform the Caribbean? In this introductory survey to Caribbean history we will answer these and many other questions through the study of the political, economic, social, cultural, and environmental transformations of the Caribbean from the arrival of Columbus to the era of the Haitian Revolution. We will follow indigenous people, Spanish conquistadors, English, Dutch, and French pirates and privateers, planters, and merchants, imperial officers, slaves, sailors, and revolutionaries as they adapted to the multiple transformations that shaped this region. Through lectures, discussions, and readings of primary and secondary sources we will navigate the Caribbean in a quest to understand the historical processes that gave shape to this tropical paradise.", "catalogBreadth": "", "catalogDistr": "(GLC-AS, HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 359688, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "2050", "titleShort": "Intro. to Latin American Art", "titleLong": "Introduction to Latin American Art", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17518, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/21/2023", "endDt": "12/04/2023