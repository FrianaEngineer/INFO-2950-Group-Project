 1492; the encounter between the Old and the New Worlds; the 'opposition' of high and low in popular culture, and of the secular and the sacred in poetry and prose. Readings may be drawn from medieval short stories and miracle collections; chivalric romances, Columbus, Lazarillo de Tormes, Cervantes, Lope de Vega, Calder\u00f3n, and Sor Juana In\u00e9s de la Cruz, among others.", "catalogBreadth": "(HB)", "catalogDistr": "(ALC-AS, HST-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0SPAN 2095\u00a0, or CASE Q++.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 364093, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "3609", "titleShort": "Deixa Sambar", "titleLong": "Brazilian Ensemble - Deixa Sambar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 6368, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "09:25PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "sfp8", "firstName": "Steven", "middleName": "F.", "lastName": "Pond"}], "pattern": "R", "facilityDescr": "Lincoln Hall B20", "bldgDescr": "Lincoln Hall", "facilityDescrshort": "LNCB20", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": 