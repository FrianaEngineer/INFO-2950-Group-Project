66", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4666", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6666", "type": "B"}, {"subject": "SPAN", "catalogNbr": "4666", "type": "B"}, {"subject": "SPAN", "catalogNbr": "6666", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "In this course, we will take an inter-and multidisciplinary approach that examines works of fiction, film, performance, and photography to explore how specters intervene in and mold the social, political, and cultural landscape of contemporary Latin America.\u00a0 We will discuss how different spectral figures challenge official narratives of memory, ground political authority, complicate transitions and endings, and fuel social movements and revolutions.\u00a0 As we engage with overlapping times, uncanny spaces, and restless bodies, we will also consider how spectrality shapes is shaped by the development of new media, the contemporary resurgence of populist discourse, the global migration crisis, and the urgency of ecological concerns.", "catalogBreadth": "(GB)", "catalogDistr": "(LA-AS, ALC-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 360045, "crseOfferNbr": 1, "subject": "LATA", "catalogNbr": "6000", "titleShort": "Issues in Latin/Latino America", "titleLong": "Contemporary Issues in Latin-Latino America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponen