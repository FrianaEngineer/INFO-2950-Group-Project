nts. Not open to: undergraduates.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 369961, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "6633", "titleShort": "Following", "titleLong": "Following", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16507, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "02:15PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "kam468", "firstName": "Kate", "middleName": "A.", "lastName": "Manne"}], "pattern": "T", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "PHIL", "catalogNbr": "4433", "type": "B"}, {"subject": "PHIL", "catalogNbr": "6433", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4633", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Since Stanley Milgram's famous experiments on obedience to authority conducted in the early 1960s, and arguably long before that, it's been clear that the majority of people are unreliable judges of who to obey, who to follow, and who to treat as moral authority figures. This advanced seminar would begin by considering the nature and bases of a mistaken sense of moral obligation to follow someone's lead, either because one falsely takes oneself to owe them obedience as such, or because one erroneously treats them as a source of superior moral insight. We will then explore questions about the epistemology and metaphysics of genuine or licit moral authority, which is at least partly a matter of issuing, and not contradicting, independently valid moral requirements.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Co-meets with\u00a0PHIL 4433/SHUM 4633.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Not open to: undergraduates.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 369963, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "6634", "titleShort": "Curating the British Empire", "titleLong": "Curating the British Empire", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16516, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:25PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "jrr47", "firstName": "Jessica", "middleName": "R.", "lastName": "Ratcliff"}], "pattern": "T", "facilityDescr": "A D White House 109", "bldgDescr": "A D White House", "facilityDescrshort": "ADW109", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ARTH", "catalogNbr": "4720", "type": "B"}, {"subject": "ARTH", "catalogNbr": "6720", "type": "B"}, {"subject": "BSOC", "catalogNbr": "4634", "type": "B"}, {"subject": "HIST", "catalogNbr": "4634", "type": "B"}, {"subject": "HIST", "catalogNbr": "6634", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4634", "type": "B"}, {"subject": "STS", "catalogNbr": "4634", "type": "B"}, {"subject": "STS", "catalogNbr": "6634", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "During Europe's colonial era, the modern museum emerged as a site of cultural and scientific authority. This course investigates the history of imperial collections and collectors, with a focus on Britain and the East India Company in the nineteenth century. Examples of topics include: the \"supply chain\" for artifacts and knowledge resources; changing conceptions of intellectual property, ownership and access; household versus public versus for-profit collections; museums and the narration of social values and cultural identities; debates over the function or aims of museums and related institutions; the collections and the administration of the empire; the collections and the growth of the sciences; the postcolonial legacies of colonial collections.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Co-meets with\u00a0ARTH 4720/BSOC 4634/HIST 4634/SHUM 4634/STS 4634.\u00a0", "catalogPrereqCoreq": "Recommended prerequisite:\u00a0prior coursework in modern history (post-1600).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Not open to: undergraduates.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 369965, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "6635", "titleShort": "Kafka and Genet", "titleLong": "Authority and Anti-Authority: Kafka and Genet", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16531, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "02:15PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "ams853", "firstName": "Aaron", "middleName": "M", "lastName": "Schuster"}], "pattern": "M", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4622", "type": "B"}, {"subject": "GERST", "catalogNbr": "4635", "type": "B"}, {"subject": "ROMS", "catalogNbr": "4635", "type": "B"}, {"subject": "ROMS", "catalogNbr": "6635", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4635", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "A far-reaching distrust and crisis of authority seems to be coextensive with the European Enlightenment and modernity\u2014but what is authority? Amidst the different attempts at definition and classification, at least one thing is certain: our relation to authority is never simple and straightforward, but is the site of intense fantasmatic activity, mixing guilt, defiance, respect, resentment, terror, justice, and love. The word itself is highly evocative, and part of its power lies in the halo of images and meanings it conjures. Our investigation of the problem of authority will be guided by two great writers of the twentieth century, rarely read together, Franz Kafka and Jean Genet.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Co-meets with\u00a0COML 4622/GERST 4635/ROMS 4635/SHUM 4635.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Not open to: undergraduates.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 369967, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "6637", "titleShort": "Viewing Black Girlhood", "titleLong": "Viewing Black Girlhood", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16536, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "12:05PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "dr557", "firstName": "Dehanza", "middleName": "", "lastName": "Rogers"}], "pattern": "M", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "4637", "type": "B"}, {"subject": "ASRC", "catalogNbr": "6637", "type": "B"}, {"subject": "PMA", "catalogNbr": "4966", "type": "B"}, {"subject": "PMA", "catalogNbr": "6966", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4637", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This seminar explores the narratives of Black girlhood in contemporary media and popular culture. This exploration will also deal with the dearth of existing narratives around Black girlhood and the complexities of their lived experiences in education, sexuality, and interaction with authority.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Co-meets with ASRC 4637/PMA 4966/SHUM 4637.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: 15 students. Not open to: undergraduates.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 366206, "crseOfferNbr": 1, "subject": "SHUM", "catalogNbr": "6819", "titleShort": "Urban Representation", "titleLong": "Urban Representation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18242, "meetings": [{"classMtgNbr": 1, "timeStart": "12:20PM", "timeEnd": "02:15PM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 2, "netid": "pre5", "firstName": "Pedro", "middleName": "Rabelo", "lastName": "Erber"}], "pattern": "T", "facilityDescr": "Uris Hall 254", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH254", "meetingTopicDescription": null}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "Urban Unplanning: The City as Text", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ARCH", "catalogNbr": "6408", "type": "B"}, {"subject": "ROMS", "catalogNbr": "6380", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2019", "sessionEndDt": "05/07/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Urban Representation Labs are intended to bring students and faculty into direct contact with complex urban representations spanning a wide media spectrum and evoking a broad set of humanist discourses. Students will leverage archival materials at Cornell to launch new observations and explore unanticipated approaches to urban culture that derive from previously understudied archival materials. The goal is twofold: to demystify the representational technologies involved in presenting the city, and to unpack the political, cultural, and aesthetic values and priorities embedded in every form of presentation. Urban Representation Labs are offered under the auspices of Cornell University's Andrew W. Mellon Foundation Collaborative Studies in Architecture, Urbanism, and the Humanities grant. For current special topic seminar description and application instructions, visit:\u00a0urbanismeseminars.cornell.edu/courses/.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: fellowship recipients, who receive a $1500 stipend.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-06-02T19:14:21-0400", "catalogDttm": "2019-06-02T19:15:24-0400"}}