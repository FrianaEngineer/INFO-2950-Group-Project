 "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/24/2018", "sessionEndDt": "05/09/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Provides students with a basis for understanding the microscopic, fine-structural, and functional organization of vertebrates (primarily mammals), as well as methods of analytic morphology at the cell and tissue levels. Emphasizes dynamic interrelations of structure, composition, and function in cells and tissues.", "catalogBreadth": "", "catalogDistr": "(PBS-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIOMG 1350. Recommended prerequisite: BIOMG 3300, BIOMG 3310, or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will understand cellular organization and the functions of vertebrate organ and tissues.", "Students will understand the correlation between cellular composition and tissue function."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2692, "crseId": 366718, "crseOfferNbr": 2, "subject": "BIOMS", "catalogNbr": "4140", "titleShort": "Pharmacology", "titleLong": "Principles of Pharmacology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 3554, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "03:20PM", "startDt": "01/24/2018", "endDt": "05/09/2018", "instructors": [{"instrAssignSeq": 2, "netid": "cmf3", "firstName": "Clare", "middleName": "", "lastName": "Fewtrell"}, {"instrAssignSeq": 3, "netid": "mel237", "firstName": "Maurine", "middleName": "E.", "lastName": "Linder"}, {"instrAssignSeq"