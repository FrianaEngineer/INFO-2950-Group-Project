rganelles; and the major signal transduction pathways regulating a variety of physiological cell activities. Among the main subjects covered are absorption and transport processes, mechanism of action of signaling molecules (hormones), the cell cycle and regulation of cell proliferation, cell-cell communication, extracellular matrix, stem cells, apoptosis, and carcinogenesis.", "catalogBreadth": "", "catalogDistr": "(PBS-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIOMG 1350; or previous or concurrent enrollment in BIOMG 3300, BIOMG 3310\u00a0and BIOMG 3320, or BIOMG 3330.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to demonstrate a deep understanding of cellular and molecular physiology, signal transduction and regulation of cellular growth, and principles of cancer biology."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 368751, "crseOfferNbr": 2, "subject": "BIOAP", "catalogNbr": "3300", "titleShort": "Fish Physiology", "titleLong": "Fish Physiology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 4181, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "etw36", "firstName": "Eugene", "middleName": "Thome", "lastName": "Won"}], "pattern": "TR", "facilityDescr": "Morrison Hall 334", "bldgDescr": "Morrison Hall", "facilityDescrshort": "MRS334", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "l