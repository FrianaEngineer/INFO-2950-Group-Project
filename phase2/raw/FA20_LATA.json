catalogNbr": "1802", "type": "C"}, {"subject": "SHUM", "catalogNbr": "1802", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course seeks a fuller recounting of U.S. history by remapping what we understand as \"America.\" We will examine traditional themes in the teaching of U.S. history\u2014territorial expansion and empire, migration and nation building, industrialization and labor, war and revolution, and citizenship and transnationalism\u2014but we will examine this \"American experience\" in a broader hemispheric context and include as actors americanos of Spanish, Mexican, Caribbean, and Central/South American ancestries.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 359848, "crseOfferNbr": 2, "subject": "LATA", "catalogNbr": "2170", "titleShort": "Early Modern Iberian Survey", "titleLong": "Early Modern Iberian Survey", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4859, "meetings": [{"classMtgNbr": 1, "timeStart": "09:55AM", "timeEnd": "11:10AM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 17, "netid": "ag2295", "firstName": "Alvaro", "middleName": "", "lastName": "Garrote Pascual"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: SPAN 2070 or SPAN 2090, or CASE Q+, or permission of instructor."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "MEDVL", "catalogNbr": "2170", "type": "C"}, {"subject": "SPAN", "catalogNbr": "2170", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course explores major texts and themes of the Hispanic tradition from the 11th to the 17th centuries. We will examine general questions on literary analysis and the relationship between literature and history around certain events, such as medieval multicultural Iberia, the creation of the Spanish Inquisition in the 15th century and the expulsion of the Jews in 1492; the encounter between the Old and the New Worlds; the 'opposition' of high and low in popular culture, and of the secular and the sacred in poetry and prose. Readings may be drawn from medieval short stories and miracle collections; chivalric romances, Columbus, Lazarillo de Tormes, Cervantes, Lope de Vega, Calder\u00f3n, and Sor Juana In\u00e9s de la Cruz, among others.", "catalogBreadth": "(HB)", "catalogDistr": "(LA-AS, ALC-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-LASP)", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0SPAN 2095\u00a0, or CASE Q++.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 370926, "crseOfferNbr": 3, "subject": "LATA", "catalogNbr": "2381", "titleShort": "Early America & Caribbean", "titleLong": "Corruption, Collusion, and Commerce in Early America and the Caribbean", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18416, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "12:45PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 6, "netid": "cs2437", "firstName": "Casey", "middleName": "", "lastName": "Schmitt"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2381", "type": "C"}, {"subject": "HIST", "catalogNbr": "2381", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Corruption in politics and economics has become a significant issue in the modern world. This course introduces students to the study of corruption and collusion from the perspective of early America and the Caribbean from 1500 through 1800. By examining the historical evolution of corruption, the course addresses questions such as: What is corruption and, by contrast, what is good governance? Who creates law and when is it enforced? Can societies be corrupt or only institutions? And, does economic corruption help or hurt financial development? Our readings and discussion will examine the intersection of politics, culture, gender, and economics. We will reflect on how early Americans understood corruption and collusion and what that can tell us about similar modern issues. In the end, the course focuses on the concept of corruption as a complex social function through the lens of bribery, piracy, sex crimes, and other forms of social deviancy.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 370930, "crseOfferNbr": 4, "subject": "LATA", "catalogNbr": "2755", "titleShort": "Race & Slavery Early Atlantic", "titleLong": "Race and Slavery in the Early Atlantic World", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrCompon