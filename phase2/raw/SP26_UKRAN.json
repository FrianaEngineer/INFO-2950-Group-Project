entary Ukrainian I and II, students will have control of the basic linguistic structure and common core vocabulary of Ukrainian; converse with native speakers with a degree of confidence and grammatical accuracy; communicate in speech and writing on general subjects; read simple accounts of current events; and function successfully at Ukrainian schools, urban communities, stores, restaurants, theaters, etc.The course is centered around an all-skill textbook used at leading universities in the US and integrates an interactive audio-visual component based on Ukrainian songs, developed at Cornell by Krystyna Golovakova.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 370794, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "2134", "titleShort": "Intermediate Ukrainian II", "titleLong": "Intermediate Ukrainian II", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "EULANG", "descr": "European Studies Lang", "descrformal": "European Studies Language", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0012", "crseAttrValue": "FL-AG", "descr": "AG-Foreign Language", "descrformal": "AG-Foreign Language", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "FLOPI-AS", "desc