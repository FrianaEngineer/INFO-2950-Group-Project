": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2023FA, 2020SP, 2016FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 360379, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "5400", "titleShort": "Labor Economics", "titleLong": "Labor Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9191, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "er488", "firstName": "Evan", "middleName": "", "lastName": "Riehl"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This is a course in labor market economics for prospective managers in the corporate, union, not-for-profit, and public sectors. The course begins with demand and supply in labor markets, presenting the tools of decision analysis for workers and firms. It then goes on to consider various topics in workplace management including deciding on the optimal mix of capital and labor to employ, attracting and retaining talent, pay and productivity, hiring and training investments, and using strategic budget constraints. The final section of the course covers other important labor market issues including analysis of public policies, unemployment, discrimination, poverty and inequality, and pensions and Social Security.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: MILR students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 374303, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "7455", "titleShort": "Local Labor Markets", "titleLong": "Local Labor Markets: Disparities and Remedies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9341, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "en322", "firstName": "Elio", "middleName": "", "lastName": "Nimier-David"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "7455", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Since the 1980s, American cities have exhibited increasingly divergent trends. This Great Divergence has had profound effects on local employment, income, political preferences, health outcomes, and intergenerational mobility. As more detailed data become available, recent research seeks to uncover the causes of this divergence and evaluate how policy interventions might mitigate its negative effects. Building on this research, this course explores recent advancements at the crossroads of labor and spatial economics. It begins by examining the growing disparities between cities and regions in terms of productivity, labor market opportunities, and amenities, in several countries. It then investigates the rationale behind place-based policies and their potential to stimulate local development. Finally, the course will provide students with essential tools and theories to study the sorting of workers and firms over space and to understand its implications for economic growth and inequality.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 360396, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "9400", "titleShort": "Workshop in Labor Economics", "titleLong": "Workshop in Labor Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9192, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "mb2693", "firstName": "Michele", "middleName": "", "lastName": "Belot"}], "pattern": "M", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "7845", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Research workshop featuring guests lecturers. Presentations of completed papers and work in progress by faculty members, advanced graduate students, and speakers from other universities. Focuses on the formulation, design, and execution of dissertations.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025FA, 2025SP, 2024FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 375036, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "9450", "titleShort": "Mdl Bldng for Applied Lbr Econ", "titleLong": "Model Building for Applied (Labor) Economists", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9348, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "pk532", "firstName": "Philipp", "middleName": "", "lastName": "Kircher"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "7450", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The aim of the course \u201cModel Building for Applied (Labor) Economists\u201d is to equip applied researchers with the tools to formalize their theories in terms of mathematical economic models. In contrast to a classical economic theory course that is built mostly around solving models, this course spends more time on the art of building simple models \u2013 ideally in a way that captures the key ideas but remains simple enough to allow relatively easy insights. We will review the basic setup of models including some discussion of ways in which to keep models tractable; and we will read papers that successfully put some of these principles into action. Participants will present some of these papers, and they have to build models and derive insights from them.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: Doctor of Philosophy (PhD) students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalog