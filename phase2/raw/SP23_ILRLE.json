n": "Examines the causes and consequences of sustained economic growth, and the development of economics as a discipline, from pre-industrial mercantilist thought through the economics of John Maynard Keynes. Stresses the relationship between the consequences of 19th-century economic growth and the evolution of economic thought.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ECON 1110, ECON 1120\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 369372, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3445", "titleShort": "Inequality in US Higher Ed", "titleLong": "Inequality in U.S. Higher Education", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18027, "meetings": [{"classMtgNbr": 1, "timeStart": "09:40AM", "timeEnd": "10:55AM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 1, "netid": "er488", "firstName": "Evan", "middleName": "", "lastName": "Riehl"}], "pattern": "MW", "facilityDescr": "Ives Hall 219", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS219", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3770", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Is the U.S. college system a great equalizer or a cause of growing inequality? Improved access to higher education has brought millions of Americans into the middle class, and yet rising selectivity has meant that a disproportionate share of the economic elite come from a few top colleges. This course will explore the three big parts of the college experience --- (1) admissions and the college-going decision; (2) education while in college; and (3) college completion and labor market entry --- and ask how each part contributes to inequality in economic outcomes. Lectures and readings will focus on simple economic theories of higher education as well as the empirical methods used to test these theories.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400, ECON 3030\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 371462, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3460", "titleShort": "New Tech and the Labor Market", "titleLong": "New Technologies and the Labor Market", "cr