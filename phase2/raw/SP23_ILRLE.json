onCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Examines topics in labor economics of particular relevance to individual managers and firms. Representative topics include recruitment, screening, and hiring strategies; compensation (including retirement pensions and other benefits); training, turnover, and the theory of human capital; incentive schemes and promotions; layoffs, downsizing, and buyouts; teamwork; and internal labor markets. Focuses on labor-related business problems using the analytic tools of economic theory and should appeal to students with strong quantitative skills who are contemplating careers in general business, consulting, and human resource management as well as in economics.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ILRLE 2400\u00a0or equivalent.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 360379, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "5400", "titleShort": "Labor Economics", "titleLong": "Labor Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11238, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 3, "netid": "gsf2", "firstName": "Gary", "middleName": "", "lastName": "Fields"}], "pattern": "MW", "facilityDescr": "Ives Hall 217", "