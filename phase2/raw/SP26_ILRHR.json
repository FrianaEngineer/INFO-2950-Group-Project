e students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 350421, "crseOfferNbr": 1, "subject": "ILRHR", "catalogNbr": "5620", "titleShort": "HR Leadership", "titleLong": "HR Leadership", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9138, "meetings": [{"classMtgNbr": 1, "timeStart": "05:00PM", "timeEnd": "07:30PM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "cjc53", "firstName": "Chris", "middleName": "J.", "lastName": "Collins"}], "pattern": "W", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/20/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Hands-on course offering students a unique opportunity to learn and develop key competencies required of HR leaders. The course will focus on developing an understanding of the role and responsibilities of modern HR leaders, and exploration of the key competencies tied to successful performance as an HR leader. The course will be taught in partnership with current or former Chief HR officers and will include the exploration of topics including setting and driving an HR strategy, coaching and influencing line leaders, setting and driving organizational culture, HR's role in mergers and acquisitions, and driving change. Students will apply learnings from lectures and readings to complete an individual project related to how they will make a positive impact as a leader in the organization that they will work for after the semester. The goal of the course is to provide students with a model of HR leadership, learning on key competencies, and a personal development plan to prepare themselves to become HR leaders.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: MILR students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "ILRHR 5600.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId