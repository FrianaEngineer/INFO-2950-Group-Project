 false, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM", "IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3025", "type": "C"}, {"subject": "PMA", "catalogNbr": "3420", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course examines both mainstream representations of and independent media made by, for, and about Asians and Asian Americans throughout U.S. cultural history. In this course, we will analyze popular cultural genres &amp; forms such as: documentary &amp; narrative films, musical theatre &amp; live performance revues, television, zines &amp; blogs, YouTube/online performances, karaoke &amp; cover performances, stand-up comedy, and popular music. Employing theories of cultural studies, media studies, and performance studies, we will discuss the cultural, discursive, and political impact of these various popular cultural forms and representations from the turn of the 20th century to the present.", "catalogBreadth": null, "catalogDistr": "(ALC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SAP, EC-SEAP)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 371649, "crseOfferNbr": 3, "subject": "AAS", "catalogNbr": "3885", "titleShort": "Race and War in History", "titleLong": "Race and War in History: Workers, Soldiers, Prisoners, Activists", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 9722, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "tn329", "firstName": "Tejasvi", "middleName": "", "lastName": "Nagaraja"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3885", "type": "C"}, {"subject": "HIST", "catalogNbr": "3884", "type": "C"}, {"subject": "ILRGL", "catalogNbr": "3885", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Across twentieth-century history, race and war have been dynamic forces in shaping economic organization and everyday livelihoods. This course will approach labor and working-class history, through a focus on global war as well as 'wars at home.' Racial and warfare events often intersect\u2014in the histories of presidents and activists, business leaders and industrial workers, CIA agents and police, soldiers and prisoners, American laborers abroad and non-Americans migrating stateside. In this course, we'll consider how race and war have been linked\u2014from the rise of Jim Crow and U.S. empire in the 1890s, to the WWII 'Greatest Generation' and its diverse workplaces, to Vietnam and the civil rights movement, to the Iraq wars and immigrant workers, to debates about what has been called a 'military-industrial complex' and a 'prison-industrial complex'.", "catalogBreadth": null, "catalogDistr": "(HST-AS) (HA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 373964, "crseOfferNbr": 2, "subject": "AAS", "catalogNbr": "4567", "titleShort": "Speculative East Asias", "titleLong": "Speculative East Asias", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19381, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "adk223", "firstName": "Adhy", "middleName": "", "lastName": "Kim"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 19382, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "adk223", "firstName": "Adhy", "middleName": "", "lastName": "Kim"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM", "IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGL", "catalogNbr": "4567", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "We will examine cultural productions by East and Southeast Asians and their diasporas that imagine speculative, science fictional, magical realist, weird realist, or otherwise non-realist worlds. Paying particular attention to the legacies of militarism and empire, we will consider how imaginaries of East Asia are entangled with the U.S.-led Cold War system, the post-Cold War dominance of finance capitalism, and climate change. Tracking connections between diverse regions and peoples, we will explore how Asians and Asian diasporas dovetail in their visions of historical memory, present-day crisis, and future possibilities. These speculative worlds will prompt us to reflect on the world we live in now and the histories we have inherited.", "catalogBreadth": null, "catalogDistr": "(ALC-AS) (CA-AG, LA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "This course counts toward the Literatures of the Americas and post-1800 requirements for English majors.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374353, "crseOfferNbr": 3, "subject": "AAS", "catalogNbr": "4699", "titleShort": "Mapping the Black Pacific(s)", "titleLong": "Mapping the Black Pacific(s): Afro-Asian Encounters", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20563, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "01:45PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "aja328", "firstName": "Angelica", "middleName": "J.", "lastName": "Allen"}], "pattern": "T", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaxi