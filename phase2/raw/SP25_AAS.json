rades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2043", "type": "C"}, {"subject": "HIST", "catalogNbr": "2043", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This seminar will explore Asian American history through the methodology of oral history.\u00a0Students will read Asian American historical scholarship that has relied on oral history methods, but they will also engage with theoretical and methodological work around the use of oral sources.\u00a0Students will develop, research, and present oral history projects.\u00a0 Themes include power and knowledge production, the role of oral history in documenting the Asian American past, and local and family histories as avenues through which to explore oral history methods.", "catalogBreadth": null, "catalogDistr": "(HST-AS, SCD-AS) (D-AG, HA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 374414, "crseOfferNbr": 2, "subject": "AAS", "catalogNbr": "2295", "titleShort": "Orientalism and East Asia", "titleLong": "Orientalism and East Asia", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 19387, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "hj383", "firstName": "Hyun-ho", "middleName": "", "lastName": "