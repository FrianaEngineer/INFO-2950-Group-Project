eir own topics and design research portfolios that highlight significant analytic research. To do this, students step through the Cornell Library gateway and receive a semester-long guided tour through one of the world's most amazing research libraries--its vast search engines, its abundant print and electronic collections, its precious special collections and archives. This introduction to college research explores using data bases, evaluating information, and engaging both to produce effective academic writing. Students will study techniques of analysis for converting scholarly information into a thesis, synthesizing and acknowledging sources, developing voice and style, and crafting technically and rhetorically sophisticated prose.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 372912, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "1450", "titleShort": "FWS: Communicating Big Ideas", "titleLong": "FWS: Communicating Big Ideas: Climate Change Rhetoric", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20635, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/25/2025", "endDt": "12/08/2025", "ins