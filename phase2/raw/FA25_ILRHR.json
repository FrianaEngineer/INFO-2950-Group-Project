nd ultimately to a \u201ctotal rewards\u201d approach that strategically seeks the right blend of monetary and non-monetary elements that attract, energize and retain workers.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: sophomores, juniors, and seniors.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 350374, "crseOfferNbr": 1, "subject": "ILRHR", "catalogNbr": "4620", "titleShort": "Staffing Organizations", "titleLong": "Staffing Organizations", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "AWI-IL", "descr": "IL-Advanced Writing Intensive", "descrformal": "IL-Advanced Writing Intensive Elective", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "ICE-IL", "descr": "IL-In-College Advanced Electiv", "descrformal": "IL-In-College Advanced Electives", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(AWI-IL, ICE-IL)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 5907, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/25/2025", "endDt": "12/08/2025", "instructors": [{"instrAssignSeq": 2, "netid": "cr589", "fi