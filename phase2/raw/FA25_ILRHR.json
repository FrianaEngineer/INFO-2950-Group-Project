ntemporary organizations. In doing so, you will gain valuable insights into how to manage your own career. We will talk about how organizations recruit and select employees and discuss different approaches to training, developing, and rewarding talent. We will review developments in employing people analytics, using new HR-focused technologies, engaging consultants, and more. In addition to covering the theory and research that guides best practices, we will hear from guest speakers who wrestle with these issues daily through a series of \u201cTalent in Action\u201d conversations and engage alumni to provide insights into exciting (and likely somewhat surprising) career opportunities in human resources.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Open to: undergraduate students.", "catalogLang": null, "catalogForbiddenOverlaps": "HADM 2810, ILRHR 2600", "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 374160, "crseOfferNbr": 1, "subject": "ILRHR", "catalogNbr": "3690", "titleShort": "Managing Total Rewards", "titleLong": "Managing Total Rewards", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "ICE-IL", "descr": "IL-In-College Advanced Electiv", "descrformal": "IL-In-College Advanced Electives", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(ICE