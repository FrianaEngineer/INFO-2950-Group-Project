n the impact of engaging with others whose political perspectives are different from their own, and work collaboratively to foster a \"brave space\" where curiosity and a willingness to understand are promoted.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 373500, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1520", "titleShort": "Food and Climate Change", "titleLong": "Using the Power of Food to Confront Climate Change", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 12998, "meetings": [{"classMtgNbr": 1, "timeStart": "05:00PM", "timeEnd": "06:45PM", "startDt": "08/26/2024", "endDt": "10/28/2024", "instructors": [{"instrAssignSeq": 1, "netid": "mph3", "firstName": "Michael", "middleName": "P.", "lastName": "Hoffmann"}], "pattern": "M", "facilityDescr": "Carl Becker House G32", "bldgDescr": "Carl Becker House", "facilityDescrshort": "BKRG32", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Primarily for: sophomores, juniors, and seniors."}, {"classNotesSeq": 2, "descrlong": "This is a Learning Where You Live course."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "10/28/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "10/24/2024", "sessionLong": "Seven Week - First", "exploreCriteriaIds": []}], "description": "This course will help students use the power of food to help make climate change relevant to others. We all eat, it's all changing and research shows that people want to know more about climate change impacts on their food. The course includes an overview of climate change science, the food system, the many ways our food is changing, how to communicate about climate change and change behaviors, a climate change dining experience, and what needs to be done to keep our favorite foods on the menu. And coincidentally, help keep our planet livable.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 374183, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1540", "titleShort": "Intro to Research Methods", "titleLong": "Introduction to Research Methods", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", 