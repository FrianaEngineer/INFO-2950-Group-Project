entsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "10/16/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "Using a public health approach, \"Sexual Citizenship\" draws on the Sexual Health Initiative to Foster Transformation (SHIFT) study from Columbia University and the work of Jennifer Hirsh and Seamus Kahn, as well as the Sexual Assault and Related Misconduct (SARM) survey data from Cornell University, to explore the social ecosystem that makes sexual assault on college campuses a common experience. Using a framework that introduces the concepts of \"sexual projects,\" \"sexual citizenship,\" and \"sexual geographies,\" we will explore the role of physical spaces, peers, and social and cultural influences that shape students' experiences and interpretations of both sex and sexual assault. A focus for the course will be individuals' agency, culture change and 'bright spots' (what is working, what is positive).", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 372888, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1515", "titleShort": "Dialogue Across Political Diff", "titleLong": "Dialogue Across Political Differences", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "