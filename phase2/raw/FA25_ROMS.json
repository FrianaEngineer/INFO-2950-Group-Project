mic Session", "exploreCriteriaIds": []}], "description": "There's a moment in the movie The Princess Bride when, listening to an adventure story, a kid worries that this might be a \"kissing book.\"  This course takes kissing books as places where \"romance\" and \"fantasy,\" two overcharged words and two overlapping genres, are stages for our enjoyment.  If medieval romances give us a template for narrating desire, and if medieval monastics use kissing, especially in the Song of Songs, to articulate an erotics of reading, the recent explosion of queer romance and fantasy fiction may give us a new way to read (and, who knows, maybe even kiss) with our manifold bodies and desires. Expect Chretien de Troyes, Brnard of Clairvaux, Dante, and lots of queer fiction.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 368458, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "6650", "titleShort": "Revolution:Intellectual Histor", "titleLong": "Revolution: An Intellectual History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 8389, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "08/25/2025", "endDt": "12/08/2025", "instructors": [{"instrAssignSeq": 1, "netid": "vt225", "firstName": "Enzo", "middleName": "", "lastName": "Traverso"}], "pattern": "R", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/25/2025", "endDt": "12/20/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "HIST", "catalogNbr": "4655", "type": "B"}, {"subject": "HIST", "catalogNbr": "6655", "type": "B"}, {"subject": "ROMS", "catalogNbr": "4650", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/25/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "For more than two centuries, revolutions have marked the rhythm of modernity. In 1780, the original meaning of revolution - an astronomical rotation - was transformed in order to apprehend a social and political overthrow. This course will investigate the multiple uses of this crucial concept of political theory, from the revolutionary canon (Blanqui, Marx, Fanon...) to the classics of conservatism (Maistre, Cortes, Schmitt...), which depict contemporary history as a conflict between revolutions and counter-revolutions, socialist and fascist revolutions. We will explore the connections between history and theory, and stress the global dimension of revolutions, forged by a permanent transfer of ideas and people from one continent to another.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", 