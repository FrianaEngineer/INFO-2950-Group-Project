.\u201d Crucial are possible relations between fiction and non-fiction; also among philosophy, theology, psychoanalysis, and political theory. Other authors may include: Althusser, de Beauvoir, Beckett, B\u00fcchner, Camus, Che, Dostoevsky, Fanon, Genet, Gide, Gramsci, O. Gross, Hamsun, Heidegger, Husserl, Jaspers, C.L.R. James, Kafka, Kierkegaard, Lagerkvist, Lacan, Lenin, Marx, Merleau-Ponty, Mishima, G. Novack, Nietzsche, Ortega, Pirandello, W. Reich, Sartre, Shestov, Tillich, Unamuno. There is also cinema. Taught in English.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2022SP, 2020SP, 2017FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 374733, "crseOfferNbr": 2, "subject": "ROMS", "catalogNbr": "4324", "titleShort": "Writing for the Public", "titleLong": "Writing for the Public: Adapting Academic Work for a General Audience", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "ALC-AS", "descr": "AS-Arts, Literat, and Culture", "descrformal": "AS-Arts, Literature, and Culture", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(ALC-AS)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19597, "meetings": [{"classMtgNbr": 1, "timeStart": "0