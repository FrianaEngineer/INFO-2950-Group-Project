dingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LING", "catalogNbr": "4406", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course offers an overview of sign language linguistics, including the core areas of linguistics and how they apply to\u00a0ASL\u00a0and other signed languages. Topics covered will include, but not be limited to: arbitrariness and iconicity, non-manual signals, plurality, derivation of nouns and verbs, acquisition, sociolinguistic variation, emergence of new sign languages, and bilingualism in the Deaf community. The course will be co-taught by a native\u00a0ASL\u00a0signer and an English speaker and will be taught in both\u00a0ASL\u00a0and English.\u00a0ASL/English interpretation will be provided.", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0ASL 1102\u00a0or LING 1101.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-01-15T19:50:41-0500", "catalogDttm": "2024-01-15T19:28:47-0500"}}