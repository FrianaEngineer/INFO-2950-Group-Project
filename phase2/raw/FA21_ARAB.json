riteriaIds": [], "materials": [{"internalId": 45115, "itemId": 28506, "title": "(Pt 2) Arabiyyat Al-Naas : An Intermediate Course In Arabic", "edition": "", "author": "Younes", "publisher": "ROUTLEDGE CHAPMAN HALL", "materialRequirementId": 1, "materialRequirement": "Required", "priceNew": "110.00", "priceUsed": "", "priceDigital": "", "isbn": "9780415509084", "courseCodeId": 291331}]}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "1203", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "In this two-course sequence learners continue to develop the four language skills of listening, speaking, reading, and writing and grammar foundation through the extensive use of graded materials on a wide variety of topics.\u00a0 While more attention is given to developing native-like pronunciation and to grammatical accuracy than in ARAB 1201\u00a0and ARAB 1202, the main focus of the course will be on encouraging fluency and facility in understanding the language and communicating ideas in it.\u00a0 The student who successfully completes this two-course sequence will have mastered over 1500 new words and will be able to: 1) understand and actively participate in conversations related to a wide variety of topics beyond those covered in ARAB 1201\u00a0and ARAB 1202, such as the history and geography of the Arab world, food and health, sports, economic matters, the environment, politics, the Palestine problem, etc. 2) read and understand, with the help of a short list of words, passages of up to 300 words, and 3) discuss orally in class and write a 150-word paragraph in Arabic with fewer grammatical errors than in ARAB 1202.\u00a0 The two-course sequence aims to take the student from the Intermediate Mid to the Advanced Mid level according to the ACTFL proficiency guidelines.", "catalogBreadth": "", "catalogDistr": "(CA-AS, ALC-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: one year of Arabic or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 353535, "crseOfferNbr": 1, "subject": "ARAB", "catalogNbr": "3201", "titleShort": "Advanced Arabic I", "titleLong": "Advanced Arabic I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4434, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:00AM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 12, "netid": "may2", "firstName": "Munther", "middleName": "A.", "lastName": "Younes"}], "pattern": "MTWR", "facilityDescr": "Uris Hall 438", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH438", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": [{"internalId": 45116, "itemId": 28507, "title": "(Pt 3) Arabiyyat Al-Naas : An Advanced Course In Arabic", "edition": "", "author": "Younes", "publisher": "ROUTLEDGE CHAPMAN HALL", "materialRequirementId": 1, "materialRequirement": "Required", "priceNew": "120.00", "priceUsed": "90.00", "priceDigital": "", "isbn": "9780415509015", "courseCodeId": 285025}]}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "3100", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "In this two-semester sequence, learners will be introduced to authentic, unedited Arabic language materials ranging from short stories, and poems, to newspaper articles dealing with social,\u00a0 political,\u00a0 and cultural issues. Emphasis will be on developing fluency in oral expression through discussions of issues presented in the reading and listening selections. There will be more focus on the development of native-like pronunciation and accurate use of grammatical structures than in the previous four courses. A primary objective of the course is the development of the writing skill through free composition exercises in topics of interest to individual students.\u00a0 This course starts where ARAB 2202\u00a0leaves off and continues the development of the four language skills and grammar foundation using 18 themes, some new and some introduced in previous courses but are presented here at a more challenging level.\u00a0 The student who successfully completes this two-course sequence have mastered over 3000 new words and will be able, within context of the 18 new and recycled themes to: 1) understand and actively participate in conversations, 2) read and understand, with the help of a short list of words, authentic, unedited passages of up to 400 words, and 3) discuss orally in class and write a 300-word paragraph in Arabic with fewer grammatical errors than in ARAB 2202.\u00a0 The two-course sequence aims to take the student from the Advanced Mid to the Superior level according to the ACTFL proficiency guidelines.", "catalogBreadth": "(GB)", "catalogDistr": "(CA-AS, ALC-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ARAB 2202\u00a0or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 364470, "crseOfferNbr": 1, "subject": "ARAB", "catalogNbr": "4200", "titleShort": "Modern Arabic Literature", "titleLong": "Modern Arabic Literature", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17755, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 1, "netid": "bma57", "firstName": "Bilal", "middleName": "Mohammad Ibrahim", "lastName": "Al-Omar"}], "pattern": "MW", "facilityDescr": "White Hall B06", "bldgDescr": "White Hall", "facilityDescrshort": "WHTB06", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescrip