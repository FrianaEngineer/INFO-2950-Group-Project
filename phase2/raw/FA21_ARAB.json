ampus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": [{"internalId": 45112, "itemId": 28508, "title": "Arabiyyat Al-Naas Part I: Egyptian Edition", "edition": "", "author": "Younes", "publisher": "TAYLOR & FRANCIS", "materialRequirementId": 1, "materialRequirement": "Required", "priceNew": "99.95", "priceUsed": "75.00", "priceDigital": "", "isbn": "9781138065154", "courseCodeId": 297328}]}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "1201", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This two-course sequence assumes no previous knowledge of Arabic and provides a thorough grounding in the four language skills of listening, speaking, reading, and writing. It starts with the alphabet and the number system and builds the four skills gradually and systematically through carefully selected and organized materials focusing on specific, concrete and familiar topics such as self identification, family, travel, food, renting an apartment, study, the weather, etc.). These topics are listed in the textbook's table of contents.\u00a0 The student who successfully completes the two-course sequence will have mastered about 1000 basic words and will be able to: 1) understand and actively participate in conversations on a limited range of practical topics such as self-identification, family, school, work, the weather, travel, etc., 2) read and understand, with the help of a short list of words, passages of up to 180 words written in Arabic script, and 3) discuss orally in class and write a 50-word paragraph in Arabic.\u00a0 The two-course sequence aims to take the student from the Novice to the Intermediate Mid level according to the ACTFL proficiency guidelines.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will not receive credit for both ARAB 1200\u00a0and ARAB 1201.", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 353414, "crseOfferNbr": 1, "subject": "ARAB", "catalogNbr": "1203", "titleShort": "Intermediate Arabic I", "titleLong": "Intermediate Arabic I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "102", "classNbr": 4432, "meetings": [{"classMtgNbr": 1, "timeStart": "11:20AM", "timeEnd": "12:10PM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 19, "netid": "bma57", "firstName": "Bilal", "middleName": "Mohammad Ibrahim", "lastName": "Al-Omar"}], "pattern": "MTWR", "facilityDescr": "White Hall B04", "bldgDescr": "White Hall", "facilityDescrshort": "WHTB04", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "