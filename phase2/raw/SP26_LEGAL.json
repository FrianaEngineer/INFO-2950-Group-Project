], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/11/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This course will identify and explain some of the key legal issues that arise in cross-border business transactions. The term cross-border business transactions is defined broadly; it can range from simple tax planning through foreign subsidiaries, to joint ventures with foreign partners, to making or receiving foreign direct investment. The course will provide an overview of the relevant legal issues (looking at both public law and private law), offer practical solutions for dealing with these issues, and engage students in discussion of the broader policy implications.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 373206, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "5202", "titleShort": "Business Ethics SP", "titleLong": "Business Ethics SP", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 6816, "meetings": [{"classMtgNbr":