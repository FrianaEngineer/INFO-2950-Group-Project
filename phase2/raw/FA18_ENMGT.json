": "12/04/2018", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Core graduate course in project management for people who will manage technical or engineering projects. Focuses both on the \"technical\" tools of project management (e.g., methods for planning, scheduling, and control) and the \"human\" side (e.g., forming a project team, managing performance, resolving conflicts), with somewhat greater emphasis on the latter.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 358721, "crseOfferNbr": 2, "subject": "ENMGT", "catalogNbr": "5910", "titleShort": "Engineering Management Project", "titleLong": "Engineering Management Project", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17851, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 2, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}, {"instrAssignSeq": 3, "netid": "fmv3", "firstName": "Francis", "middleName": "M.", "lastName": "Vanek"}], "pattern": "", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N