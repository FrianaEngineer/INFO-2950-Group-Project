and utility theory. Applications to all areas of engineering and life. Includes a group project to analyze a real-world decision.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: introduction to probability and statistics course such as CEE 3040, ENGRD 2700, ILRST 2100, BTRY 3010, or AEM 2100.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: seniors and graduate students; or permission of instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2713, "crseId": 369939, "crseOfferNbr": 1, "subject": "ENMGT", "catalogNbr": "6090", "titleShort": "Professional Leadership Sem", "titleLong": "Professional and Leadership Development Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18668, "meetings": [{"classMtgNbr": 1, "timeStart": "04:00PM", "timeEnd": "05:00PM", "startDt": "08/23/2018", "endDt": "12/04/2018", "instructors": [{"instrAssignSeq": 1, "netid": "aki2", "firstName": "Andrea", "middleName": "Katherine", "lastName": "Ippolito"}, {"instrAssignSeq": 2, "netid": "rtn24", "firstName": "Robert", "middleName": "Todd", "lastName": "Newman"}], "pattern": "M", "facilityDescr": "Hollister Hall 401", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS401", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/23/2018", "endDt": "12/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAt