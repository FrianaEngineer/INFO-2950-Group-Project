o ongoing efforts to regulate emerging technologies, in light of significant international, federal, and state regulatory developments.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: MSLS students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 371212, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "6100", "titleShort": "Mastering Negotiations", "titleLong": "Mastering Negotiations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10584, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "10/15/2025", "endDt": "12/14/2025", "instructors": [{"instrAssignSeq": 2, "netid": "amf247", "firstName": "Allan", "middleName": "M.", "lastName": "Filipowicz"}, {"instrAssignSeq": 1, "netid": "tls11", "firstName": "Tony", "middleName": "L.", "lastName": "Simons"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Master of Science Legal Studies (MSLS) program students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/15/2025", "endDt": "12/14/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "10/15/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This course will introduce you to basic negotiation terminology. You will learn about the difference between distributive and integrative negotiation, and how to use each of these approaches to negotiation to create maximum value. You will then learn how to balance these two approaches in order to further your chances of making a deal and create even greater further value. By the end of the course, you will have the tools to not only split the pie but also grow the pie in a way that would benefit you and your negotiating partner. Negotiations don't necessarily have winners and losers. Through collaboration, it is possible to create value in a way that allows both parties to get most of what they want.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslisti