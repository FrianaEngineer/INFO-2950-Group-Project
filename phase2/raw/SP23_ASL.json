nguistic minority. A major focus of this course is to bring students to an understanding of how differently the world can be viewed through \"Deaf eyes\" and how understanding this worldview can account for views toward the teaching and enculturation of deaf children, Deafhood, biomedical ethics, oppression of signed languages, the provision of accommodations under the Americans with Disabilities Act, and a host of other issues at the interface between hearing and Deaf cultures.", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Can be taken concurrently with ASL 2201. Course conducted entirely in ASL.", "catalogPrereqCoreq": "Prerequisite:\u00a0ASL 1102\u00a0or by permission from lead ASL instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 372988, "crseOfferNbr": 1, "subject": "ASL", "catalogNbr": "3215", "titleShort": "Deaf Art, Film and Theatre", "titleLong": "Deaf Art, Film and Theatre", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18337, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 1, "netid": "bs794", "firstName": "Brenda", "middleName": "", "lastName": "Schertz"}], "pattern": "TR", "facilityDescr": "Morrill Hall 110", "bldgDescr": "Morrill Hall", "facilityDescrshort": "MRL110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "PMA", "catalogNbr": "3425", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course will explore approaches to the Deaf experience taken by Deaf artists from the 1900s to the present. Analysis of chosen works of Deaf art, film and theater will illuminate the expression of the Deaf narrative through symbolism, themes, and genres. We will examine the interaction of these works in multiple social, historical, cultural and political contexts and how they have contributed to the construction of Deaf culture and identity. This course will be taught in advanced ASL, with emphasis on the production and comprehension of academic ASL.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0ASL 2202\u00a0and\u00a0ASL 2301.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University