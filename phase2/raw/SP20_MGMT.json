icient operations management. Effective operations management can enable companies to increase market shares, reduce costs, and improve customer service. This course is designed to introduce students to the basic concepts of operations management and the useful methods for solving real-world operations management problems.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 370085, "crseOfferNbr": 1, "subject": "MGMT", "catalogNbr": "5090", "titleShort": "Strategy", "titleLong": "Strategy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14622, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "04:10PM", "startDt": "03/11/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 13, "netid": "mp2222", "firstName": "Marcel", "middleName": "", "lastName": "Preuss"}], "pattern": "W", "facilityDescr": "Breazzano Family Ctr 223", "bldgDescr": "Breazzano Family Ctr for BusEd", "facilityDescrshort": "BRZ223", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Johnson MBA students are not eligible to take this class, as it is duplicative of the MBA core."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/11/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", 