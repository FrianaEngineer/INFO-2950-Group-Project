e highest concentration of non-democratic regimes in the world, the MENA provides a rich context for examining state efforts to control interest representation, and workers' struggles for freedom of association. In addition, the region features diverse political economic systems, making it ideal for examining the interaction between resource endowments and labor market dynamics. Finally, the region is ripe for the study of youth activism and the mobilization of the unemployed given that youth unemployment rates are higher in the MENA than any other world region.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 362677, "crseOfferNbr": 1, "subject": "ILRIC", "catalogNbr": "6350", "titleShort": "Labor Markets, Income Distribu", "titleLong": "Labor Markets and Income Distribution in Developing Economies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11261, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "10:00PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 1, "netid": "gsf2", "firstName": "Gary", "middleName": "", "lastName": "Fields"}], "pattern": "W", "facilityDescr": "Ives Hall 217", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS217", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05