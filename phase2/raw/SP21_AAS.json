cluding the types of research questions and methods that the study of Asians &amp; Pacific Islander peoples in the U.S. as well as politics and historical relations in the Asia/Pacific region have to offer. In this course, we will pay particular attention to the role of culture and its production in documenting histories, formulating critical practices, and galvanizing political efforts. Topics and themes include: war &amp; empire; queer &amp; feminist lives and histories; refugee, adoptees, transnational families, and other forms of kinship &amp; belonging; anti-Asian violence; settler colonialism and postcolonial critique.", "catalogBreadth": "", "catalogDistr": "(CA-AS, ALC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SAP, EC-SEAP)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 369569, "crseOfferNbr": 3, "subject": "AAS", "catalogNbr": "2042", "titleShort": "Jim Crow/Exclusion Era in Amer", "titleLong": "Jim Crow and Exclusion Era in America", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16790, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 1, "netid": "dsc37", "firstName": "Derek", "middleName": "S.", "lastName": "Chang"}], "pattern": "TR", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "02/08/2021", "endDt": "05/25/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2042", "type": "C"}, {"subject": "HIST", "catalogNbr": "2042", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "02/08/2021", "sessionEndDt": "05/25/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This seminar examines America during the overlapping eras of segregation &amp; immigration exclusion.\u00a0 Beginning with contests over the weaning of freedom during reconstruction and running through the institution of Jim Crow legislation and immigration exclusion, the course ends with an evaluation of mid-20th century movements for civil rights and equality.\u00a0 Themes include the links between racial and economic oppression, legal and defacto restriction, everyday resistance, and struggles for equality.", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 350721, "crseOfferNbr": 2, "subject": "AAS", "catalogNb