 New York City; the second segment of the course will be devoted to working with the Cornell Velvet Underground Archive to develop student projects. This course is open to graduate students and fourth-year undergraduates by permission. Undergraduates should contact the instructor before enrolling.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 373253, "crseOfferNbr": 6, "subject": "LGBT", "catalogNbr": "6687", "titleShort": "Trans Theory and Politics", "titleLong": "Trans Theory and Politics Across the Americas", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20053, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 6, "netid": "paz24", "firstName": "Perry", "middleName": "Adyson", "lastName": "Zurn"}], "pattern": "R", "facilityDescr": "A D White House 110", "bldgDescr": "A D White House", "facilityDescrshort": "ADW110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaId