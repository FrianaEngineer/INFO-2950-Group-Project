h projects not covered in regularly scheduled courses. Students select a topic in consultation with an LGBT Studies faculty member who has agreed to supervise independent study.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "To apply for independent study, please complete the on-line form.", "catalogPrereqCoreq": "Prerequisite: LGBT 2290\u00a0and one additional LGBT Studies course at the 3000-level.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 368839, "crseOfferNbr": 2, "subject": "LGBT", "catalogNbr": "4331", "titleShort": "The Velvet Underground Archive", "titleLong": "The Velvet Underground Archive", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17903, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "04:25PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "jap28", "firstName": "Judith", "middleName": "A.", "lastName": "Peraino"}], "pattern": "M", "facilityDescr": "Lincoln Hall 316", "bldgDescr": "Lincoln Hall", "facilityDescrshort": "LNC316", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Permission of instructor required."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4331", "type": "B"}, {"subject": "AMST", "catalogNbr": "6331", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4333", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6333", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6332", "type": "B"}, {"subject": "MUSIC", "catalogNbr": "4331", "type": "B"}, {"subject": "MUSIC", "catalogNbr": "6331", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The Velvet Underground remains one of the most acclaimed and influential rock groups to emerge within the culturally turbulent era of the late 1960s. From their association with Andy Warhol beginning in 1965, to their last recorded performance with Lou Reed in August 1970, the Velvet Underground revitalized rock 'n' roll as streetwise outsider art.\u00a0 Lyrics tell of hard drugs, hustlers, and queer and transgender lives, while the music ranges from noise, drones, feedback, and minimalism to edgy pop tunes. In 2015 Cornell University acquired a substantial archive of Velvet Underground material, including rare photographs, posters, flyers, handwritten lyrics, rare recordings, and ephemera.\u00a0 The first segment of this course will delve into music, lyrics, and the performance art of the Velvet Underground as an archive of underground and dissident art and identities in New York City; the second segment of the course will be devoted to working with the Cornell Velvet Underground Archive to develop student projects. This course is open to graduate students and fourth-year undergraduates by permission. Undergraduates should contact the instructor before enrolling.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 365725, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "4451", "titleShort": "Gender-Sexuality in SEA Cinema", "titleLong": "Gender and Sexuality in Southeast Asian Cinema", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 5576, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "aif32", "firstName": "Arnika", "middleName": "", "lastName": "Fuhrmann"}], "pattern": "MW", "facilityDescr": "Malott Hall 207", "bldgDescr": "Malott Hall", "facilityDescrshort": "MLT207", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/21/2023", "endDt": "12/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASIAN", "catalogNbr": "4451", "type": "B"}, {"subject": "ASIAN", "catalogNbr": "6631", "type": "B"}, {"subject": "COML", "catalogNbr": "4451", "type": "B"}, {"subject": "COML", "catalogNbr": "6651", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4451", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6331", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6331", "type": "B"}, {"subject": "PMA", "catalogNbr": "4451", "type": "B"}, {"subject": "RELST", "catalogNbr": "4451", "type": "B"}, {"subject": "RELST", "catalogNbr": "6631", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4451", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "12/16/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Examines the new cinemas of Southeast Asia and their engagement with contemporary discourses of gender and sexuality. It pays special attention to the ways in which sexuality and gendered embodiment are at present linked to citizenship and other forms of belonging and to how the films draw on Buddhist and Islamic traditions of representation and belief. Focusing on globally circulating Southeast Asian films of the past 15 years, the course draws on current writings in feminism, Buddhist studies, affect theory, queer studies, postcolonial theory, and film studies to ask what new understandings of subjectivity might emerge from these cinemas and their political contexts. Films are drawn from both mainstream and independent cinema and will include the work of directors such as Apichatpong Weerasethakul, Danny and Oxide Pang, Yau Ching, Thunska Pansittivorakul, Garin Nugroho, and Jean-Jacques Annaud.", "catalogBreadth": "(GB)", "catalogDistr": "(ALC-AS, LA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SEAP)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCor