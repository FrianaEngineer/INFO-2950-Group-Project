ription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "4688", "type": "B"}, {"subject": "ASRC", "catalogNbr": "6688", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4688", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6688", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6688", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4688", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6688", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This advanced seminar centers underthought fissures within the field of Trans Studies. These fissures take the form of failed crossings between incommensurable positions. We will examine: the vexed relation between queer theory and Trans Studies, between the field's analytic of\u00a0 \"transing\" and its originary focus on transgender people, between the specific violence faced by Black trans women and the possibility that Blackness itself might be para-ontologically trans; between turns to historical materialism and to new materialism, between understandings of gendered selfhood in the West and in the non-West; and between transmasculine and transfeminine experiences and heuristics. This seminar encourages students to view such failed crossings as generative sites in which future scholarship might take root.", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373585, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "4689", "titleShort": "Sex, Gender, Natural World", "titleLong": "Sex, Gender, and the Natural World in Medieval Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20016, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "01:45PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 4, "netid": "eec78", "firstName": "Emma", "middleName": "Elizabeth", "lastName": "Campbell"}], "pattern": "T", "facilityDescr": "A D White House 201", "bldgDescr": "A D White House", "facilityDescrshort": "ADW201", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGL", "catalogNbr": "4989", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4689", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6689", "type": "B"}, {"subject": "FREN", "catalogNbr": "4689", "type": "B"}, {"subject": "FREN", "catalogNbr": "6689", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6689", "type": "B"}, {"subject": "MEDVL", "catalogNbr": "4689", "type": "B"}, {"subject": "MEDVL", "catalogNbr": "6689", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4689", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6689", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Seemingly timeless concepts of natural sex and gender have a history. In fact, they have many histories, some of which are only just starting to be written. This class examines the relationship between the (human and non-human) natural world and concepts of sex-gender variance in pre- modernity. It asks: How might crossing pre-modern conceptions of sex and gender with those of our contemporary moment lead us to approach cultural objects from the past differently? And what can pre-modern sources reveal about the histories behind the sex-gender diversity of today's natural world? We will pursue these questions through readings of contemporary scholarly literature on the topic and through the analysis of historical examples comprised of visual and textual materials studied in translation.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373584, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "6688", "titleShort": "Trans Studies at a Crossroads", "titleLong": "Trans Studies at a Crossroads", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20007, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ka535", "firstName": "Kadji", "middleName": "", "lastName": "Amin"}], "pattern": "R", "facilityDescr": "A D White House 109", "bldgDescr": "A D White House", "facilityDescrshort": "ADW109", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "4688", "type": "B"}, {"subject": "ASRC", "catalogNbr": "6688", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4688", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6688", "type": "B"}, {"subject": "LGBT", "catalogNbr": "4688", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4688", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6688", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This advanced seminar centers underthought fissures within the field of Trans Studies. These fissures take the form of failed crossings between incommensurable positions. We will examine: the vexed relation between queer theory and Trans Studies, between the field's analytic of\u00a0 \"transing\" and its originary focus on transgender people, between the specific violence faced by Black trans women and the possibility that Blackness itself might be para-ontologically trans; between turns to historical materialism and to new materialism, between understandings of gendered selfhood in the West and in the non-West; and between transmasculine and transfeminine experiences and heuristics. This seminar encourages students to view such failed crossings as generative sites in which future scholarship might take root.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 373587, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "6689", "titleShort": "Sex, Gender, Natural World", "titleLong": "Sex, Gender, and the Natural World in Medieval Culture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 20015, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "01:45PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 4, "netid": "eec78", "firstName": "Emma", "middleName": "Elizabeth", "lastName": "Campbell"}], "pattern": "T", "facilityDescr": "A D White House 201", "bldgDescr": "A D White House", "facilityDescrshort": "ADW201", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGL", "catalogNbr": "4989", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4689", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6689", "type": "B"}, {"subject": "FREN", "catalogNbr": "4689", "type": "B"}, {"subject": "FREN", "catalogNbr": "6689", "type": "B"}, {"subject": "LGBT", "catalogNbr": "4689", "type": "B"}, {"subject": "MEDVL", "catalogNbr": "4689", "type": "B"}, {"subject": "MEDVL", "catalogNbr": "6689", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4689", "type": "B"}, {"subject": "SHUM", "catalogNbr": "6689", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Seemingly timeless concepts of natural sex and gender have a history. In fact, they have many histories, some of which are only just starting to be written. This class examines the relationship between the (human and non-human) natural world and concepts of sex-gender variance in pre- modernity. It asks: How might crossing pre-modern conceptions of sex and gender with those of our contemporary moment lead us to approach cultural objects from the past differently? And what can pre-modern sources reveal about the histories behind the sex-gender diversity of today's natural world? We will pursue these questions through readings of contemporary scholarly literature on the topic and through the analysis of historical examples comprised of visual and textual materials studied in translation.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-05-19T19:32:44-0400", "catalogDttm": "2024-05-19T19:07:08-0400"}}