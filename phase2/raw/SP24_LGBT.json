{"status": "success", "data": {"classes": [{"strm": 2867, "crseId": 363820, "crseOfferNbr": 2, "subject": "LGBT", "catalogNbr": "2290", "titleShort": "Intro to LGBT studies", "titleLong": "Introduction to Lesbian, Gay, Bisexual, and Transgender Studies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 5648, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 4, "netid": "nd326", "firstName": "Naminata", "middleName": "", "lastName": "Diabate"}], "pattern": "TR", "facilityDescr": "Malott Hall 406", "bldgDescr": "Malott Hall", "facilityDescrshort": "MLT406", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}, {"ssrComponent": "DIS", "ssrComponentLong": "Discussion", "section": "201", "classNbr": 18325, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:00AM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "nd326", "firstName": "Naminata", "middleName": "", "lastName": "Diabate"}], "pattern": "W", "facilityDescr": "Rockefeller Hall 102", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK102", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "FGSS", "catalogNbr": "2290", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course offers an introduction to central issues, debates, and theories that characterize the field of Lesbian, Gay, Bisexual, and Transgender (LGBT) Studies. Starting from the assumption that neither \"sex\" nor \"sexuality\" is a private experience or category, we will explore some of the ways that these powerfully public and political terms have circulated in social, legal, economic, and cultural spheres. We will also examine how these categories are situated in relation to other formative categories including race, ethnicity, religion, family, marriage, reproduction, the economy, and the state. Using a comparative and intersectional approach, we will read from various disciplines to assess the tools that LGBT studies offers for understanding power and culture in our contemporary world.", "catalogBreadth": "", "catalogDistr": "(LA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 367858, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "3210", "titleShort": "Gender and the Brain", "titleLong": "Gender and the Brain", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 5463, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "sbd3", "firstName": "Shelby", "middleName": "Barbara", "lastName": "Dietz"}], "pattern": "MW", "facilityDescr": "Corson-Mudd W364", "bldgDescr": "Corson-Mudd", "facilityDescrshort": "CMHW364", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: BIONB 2220, BIOMG 3320, FGSS 2010, LGBT 2290 or permission of instructor. For NBB concentration: this course may be used toward the additional 7 credit requirement, but does not qualify as an advanced course. If a student enrolls in a non-CALS section of a cross-listed course, it will not automatically be counted as CALS credits in their degree progress. However, we can still give them CALS credit for the class, they just need to ask us to code it."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "BIONB", "catalogNbr": "3215", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3210", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Why are boys more likely than girls to be diagnosed with autism, and why are women more likely than men to be diagnosed with depression? Are there different \"gay\" and \"straight\" brains? And how does brain science interact with gender and sexuality in popular debate? Reading and discussing the original scientific papers and related critical texts, we will delve into the neuroscience of gender. In this course, we will delve into the neuroscience of gender difference. Reading the original scientific papers and related critical texts, we will ask whether we can find measurable physical differences in male and female brains, and what these differences might be. Do men and women solve spatial puzzles differently, as measured physiologically? Do nonhuman animals display sex-specific behaviors mediated by brain structure, and can we extrapolate these findings to human behavior? Why are boys three times more likely than girls to be diagnosed as autistic, and is there any connection between the predominantly male phenomenon of autism and other stereotypically male mental traits? Are there physical representations of sexual orientation in the brain, and how are these related to gender identity? And how are scientific studies represented and misrepresented in popular debate?", "catalogBreadth": "", "catalogDistr": "(BIO-AS, PBS-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIONB 2220, BIOMG 3320, FGSS 2010, and LGBT 2290\u00a0or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Demonstrate knowledge of the state of the field in gender and neuroscience.", "Be able to apply concepts from history, philosophy, and critical theory to scientific texts.", "Demonstrate understanding of the interaction of experimental design, stereotypes, and preconceptions in how studies are carried out and communicated.", "Be aware of the range of experimental techniques available in neuroscience, and their advantages and limitations."], "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 352797, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "3550", "titleShort": "Decadence", "titleLong": "Decadence", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 20082, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/22/2024", "endDt": "05/07/2024", "instructors": [{"instrAssignSeq": 1, "netid": "eh36", "firstName": "Ellis", "middleName": "", "lastName": "Hanson"}], "pattern": "TR", "facilityDescr": "White Hall 110", "bldgDescr": "White Hall", "facilityDescrshort": "WHT110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/22/2024", "endDt": "05/18/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "3550", "type": "C"}, {"subject": "ENGL", "catalogNbr": "3550", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3550", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/22/2024", "sessionEndDt": "05/18/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "\"My existence is a scandal,\" Oscar Wilde once wrote, summing up in an epigram the effect of his carefully cultivated style of perversity and paradox. Through their celebration of \"art for art's sake\" and all that was considered artificial, unnatural, or obscene, the Decadent writers of the late-nineteenth century sought to free the pleasures of beauty, spirituality, and sexual desire from their more conventional ethical moorings. We will focus on the literature of the period, including works by Charles Baudelaire, Edgar Allan Poe, A. C. Swinburne, and especially Oscar Wilde, and we will also consider related developments in aesthetic philosophy, painting, music, theater, architecture, and design.", "catalogBreadth": "(HB)", "catalogDistr": "(ALC-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2867, "crseId": 370485, "crseOfferNbr": 1, "subject": "LGBT", "catalogNbr": "3990", "titleShort": "Undergrad Independent Study", "titleLong": "Undergraduate Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 5909, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/22/2024", "endDt": "05/07/2024", "i