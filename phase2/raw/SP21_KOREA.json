o refine their reading and writing skills. Students will acquire concrete knowledge of grammar to use in everyday conversation, and will minimize their spelling errors in writing, through frequent discussion and composition about Korean culture, society and history. They will become confident in reading paragraph-length readings in Korean, be able to write their reflections on the passages that they have read, and speak with ease when participating in the classroom discussions. Various projects will enhance students' overall linguistic and cultural competence.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: grade of B- or higher in KOREA 2209, or online placement test required (collt.lrc.cornell.edu).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 351245, "crseOfferNbr": 1, "subject": "KOREA", "catalogNbr": "3302", "titleShort": "High Intermediate Korean II", "titleLong": "High Intermediate Korean II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4589, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "01:15PM", "startDt": "02/08/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 3, "netid": "hk783", "firstName": "Hankyul", "middleName": "", "lastName": "Kim"}], "pattern": "MWF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: gr