"6458", "type": "B"}, {"subject": "JWST", "catalogNbr": "6458", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "We will engage the political thinking of Jacques Derrida, attempt to disinter and engage attitudes toward history, ancestry, and progress in the radical nineteenth century, and consider the possible relevance of Marx now. We will read Derrida's Specters of Marx, along with key texts Derrida examines there--from Hamlet to the Communist Manifesto to the American triumphalism of Francis Fukuyama. We will also consider a range of critiques of Derrida in response to his own text. Special attention will be devoted to Marx's and Derrida's own \"Jewish specters\" vis-\u00e0-vis the Christian West's non-Christian Others.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 367477, "crseOfferNbr": 1, "subject": "JWST", "catalogNbr": "4533", "titleShort": "Jews and the Immigrant City", "titleLong": "The Lower East Side: Jews and the Immigrant City", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16821, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 4, "netid": "ejs362", "firstName": "Elissa", "middleName": "J.", "lastName": "Sampson"}], "pattern": "R", "facilityDescr": "White Hall 110", "bldgDescr": "White Hall", "facilityDescrshort": "WHT110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4533", "type": "B"}, {"subject": "ANTHR", "catalogNbr": "4733", "type": "B"}, {"subject": "ILRLR", "catalogNbr": "4533", "type": "B"}, {"subject": "ILRLR", "catalogNbr": "7533", "type": "B"}, {"subject": "JWST", "catalogNbr": "7533", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "American Jews have frequently been touted as a \"model minority.\" This course will take a more critical look at the historical interactions between Jewish immigration, United States industrialization, and processes of social and geographical mobility\u2014all through the prism of New York's Lower East Side, first home for over 750,000 Jewish immigrants from Central and Eastern Europe, the Ottoman Empire and elsewhere between the mid-19th century and the 1920s.\u00a0 We will compare the Jewish experience to that of other immigrants/migrants by considering social institutions as well as material and other cultural practices. We will examine interactions with the built environment \u2014most especially the tenement\u2014in Lower East Side culture. Special attention will be paid to immigrant labor movement politics including strikes, splits, and gender in the garment trade. From the perspective of the present, the course will examine how commemoration, heritage tourism and the selling of [immigrant] history intersect with gentrifying real estate in an \"iconic\" New York City neighborhood. Projects using the ILR's archives on the Triangle Fire and other topics are explicitly encouraged. This course counts as an out of college elective for B. Arch and M. Arch students.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 372578, "crseOfferNbr": 2, "subject": "JWST", "catalogNbr": "6458", "titleShort": "Specters Derrida Other Ghosts", "titleLong": "Specters: Derrida, Marx, and Other Ghosts", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17655, "meetings": [{"classMtgNbr": 1, "timeStart": "07:00PM", "timeEnd": "09:30PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 1, "netid": "jab857", "firstName": "Jonathan", "middleName": "Aaron", "lastName": "Boyarin"}], "pattern": "W", "facilityDescr": "McGraw Hall 215", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG215", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "3458", "type": "B"}, {"subject": "ANTHR", "catalogNbr": "6458", "type": "B"}, {"subject": "COML", "catalogNbr": "3458", "type": "B"}, {"subject": "COML", "catalogNbr": "6458", "type": "B"}, {"subject": "JWST", "catalogNbr": "3458", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "We will engage the political thinking of Jacques Derrida, attempt to disinter and engage attitudes toward history, ancestry, and progress in the radical nineteenth century, and consider the possible relevance of Marx now. We will read Derrida's Specters of Marx, along with key texts Derrida examines there--from Hamlet to the Communist Manifesto to the American triumphalism of Francis Fukuyama. We will also consider a range of critiques of Derrida in response to his own text. Special attention will be devoted to Marx's and Derrida's own \"Jewish specters\" vis-\u00e0-vis the Christian West's non-Christian Others.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 367478, "crseOfferNbr": 1, "subject": "JWST", "catalogNbr": "7533", "titleShort": "Jews and the Immigrant City", "titleLong": "The Lower East Side: Jews and the Immigrant City", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16838, "meetings": [{"classMtgNbr": 1, "timeStart": "02:40PM", "timeEnd": "04:35PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 4, "netid": "ejs362", "firstName": "Elissa", "middleName": "J.", "lastName": "Sampson"}], "pattern": "R", "facilityDescr": "White Hall 110", "bldgDescr": "White Hall", "facilityDescrshort": "WHT110", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/22/2022", "endDt": "12/17/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4533", "type": "B"}, {"subject": "ANTHR", "catalogNbr": "4733", "type": "B"}, {"subject": "ILRLR", "catalogNbr": "4533", "type": "B"}, {"subject": "ILRLR", "catalogNbr": "7533", "type": "B"}, {"subject": "JWST", "catalogNbr": "4533", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "descri