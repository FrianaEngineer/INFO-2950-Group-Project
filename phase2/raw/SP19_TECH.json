 M&amp;A, and other corporate activities complement and sometimes compete with larger strategic initiatives. Students will work in teams matched with a real-world opportunity and advisor from a BigCo. Teams will build and pitch a product in three sprints culminating in a final presentation and demo.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment Limited to: Cornell Tech students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "CT", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2727, "crseId": 369809, "crseOfferNbr": 1, "subject": "TECH", "catalogNbr": "5999", "titleShort": "Independent Study", "titleLong": "Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 18351, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/22/2019", "endDt": "05/07/2019", "instructors": [{"instrAssignSeq": 1, "netid": "mn469", "firstName": "Mor", "middleName": "", "lastName": "Naaman"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC.  Enrollment limited to Cornell Tech Students."}], "campus": "NYT", "campusDescr": "New York Tech Campus", "location": "NYCTECH", "locationDescr": "Cornell Tech", "startDt": "01/22/2019", "endDt": "05/07/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "I