": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "7W1", "sessionBeginDt": "01/24/2022", "sessionEndDt": "03/15/2022", "sessionLong": "Seven Week - First", "exploreCriteriaIds": []}], "description": "This course explores social justice in the environmental context and will engage students in the theory and practice of environmental justice with a particular focus on inequality. Students should have a strong interest in learning about the history and challenges of environmentally overburdened communities \u2014 often communities of color and low-income communities\u2014while also exploring strategies for addressing inequalities as they relate to the environment. Students will learn and practice critical reflection as an essential component of this course and we will employ visual, oral, and narrative forms of reflection to appeal to a variety of learning styles.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 372207, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1510", "titleShort": "Learning Across Difference", "titleLong": "Living and Learning Across Difference", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17883, "meetings": [{"classMtgNbr": 1, "timeStart": "04:45PM", "timeEnd": "06:45PM", "startDt": "03/16/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 1, "netid": "skk86", "firstName": "Stephen", "middleName": "", "lastName": "Kim"}], "pattern": "T", "facilityDescr": "Hans Bethe House 240", "bldgDescr": "Hans Bethe House", "facilityDescrshort": "BET240", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This is a Learning Where You Live course."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/16/2022", "endDt": "05/21/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/16/2022", "sessionEndDt": "05/21/2022", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This course seeks to create space for students to have intentional and thoughtful conversations about how their social identities and backgrounds impact their day-to-day life in the Cornell community. Each week, we will focus on a topic of relevance to the student experience that also opens up questions about identity and power. Potential topics include mental health, cancel culture, social media, professionalization, and sustainability. As we move from topic to topic, participants will learn and practice skills for communicating empathetically, maintaining connection across conflict, making sense of personal experience in the contexts of broader structural inequities, and taking everyday action to challenge inequity.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-06-10T07:44:21-0400", "catalogDttm": "2022-06-09T19:14:04-0400"}}