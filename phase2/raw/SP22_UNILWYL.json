here, when, and how to save (invest) money and issues involving managing debt and assets.\u00a0 This includes defining the concept of the time value of money (interest), identifying, and comparing the various options for investing and their associated risks, the pros and cons of credit and debit card use, tax deferred retirement plans, evaluating and comparing house renting or house buying alternatives, types of life or long-term care insurance and when, if at all, to buy it, and the effects of income taxes and inflation.\u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "This is a Learning Where You Live course.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "CU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 371187, "crseOfferNbr": 1, "subject": "UNILWYL", "catalogNbr": "1152", "titleShort": "Cornell and Climate Leadership", "titleLong": "How Cornell is Changing the World Through Climate Leadership", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18089, "meetings": [{"classMtgNbr": 1, "timeStart": "04:00PM", "timeEnd": "06:30PM", "startDt": "03/16/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 1, "netid": "seb382", "firstName": "Sarah", "middleName": "", "lastName": "Brylinsky"}, {"instrAssignSeq": 2, "netid": "ll536", "firstName": "Lori", "middleName": "", "lastName": "Leonard"}], "pattern": "M", "facilityDescr": "Robert Purcell Comm Ctr 220", "bldgDescr": "Robert Purcell Community Ctr", "facilityDescrshort": "RPC220", "meetingTopicDescription": ""}], "notes":