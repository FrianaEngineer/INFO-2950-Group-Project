sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Survey of concepts, theories, and research from the fields of sociology, psychology, and social psychology as these relate to the behavior of individuals, groups, and work organizations. Topics include: job attitudes, motivation, leadership and power, group formation, organizational structure, and interorganizational relations. This course is designed for students in professional programs.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: MILR students only.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 355570, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "5250", "titleShort": "Design,Manage,&Change Orgs", "titleLong": "Designing, Managing, and Changing Organizations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18547, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "09/06/2019", "endDt": "12/19/2019", "instructors": [{"instrAssignSeq": 3, "netid": "bl679", "firstName": "Brian", "middleName": "", "lastName": "Lucas"}, {"instrAssignSeq": 1, "netid": "pst3", "firstName": "Pamela", "middleName": "S.", "lastName": "Tolbert"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. Enrollment limited to students enrolled in the ILR MPS program."}], "campus": "MA