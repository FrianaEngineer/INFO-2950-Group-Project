{"status": "success", "data": {"classes": [{"strm": 2755, "crseId": 363820, "crseOfferNbr": 2, "subject": "LGBT", "catalogNbr": "2290", "titleShort": "Intro to LGBT studies", "titleLong": "Introduction to Lesbian, Gay, Bisexual, and Transgender Studies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8462, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 4, "netid": "mkm23", "firstName": "Kate", "middleName": "", "lastName": "McCullough"}], "pattern": "TR", "facilityDescr": "White Hall 106", "bldgDescr": "White Hall", "facilityDescrshort": "WHT106", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "FGSS", "catalogNbr": "2290", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course offers an introduction to central issues, debates, and theories that characterize the field of Lesbian, Gay, Bisexual, and Transgender (LGBT) Studies. Starting from the assumption that neither \"sex\" nor \"sexuality\" is a private experience or category, we will explore some of the ways that these powerfully public and political terms have circulated in social, legal, economic, and cultural spheres.\u00a0 We will also examine how these categories are situated in relation to other formative categories including race, ethnicity, religion, family, marriage, reproduction, the economy, and the state. Using a comparative and intersectional approach, we will read from various disciplines to assess the tools that LGBT studies offers for understanding power and culture in our contemporary world.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 370721, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "2335", "titleShort": "Making Public Queer History", "titleLong": "Making Public Queer History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17979, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "sv484", "firstName": "Stephen", "middleName": "", "lastName": "Vider"}], "pattern": "TR", "facilityDescr": "Uris Hall 302", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH302", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2335", "type": "B"}, {"subject": "AMST", "catalogNbr": "6335", "type": "B"}, {"subject": "FGSS", "catalogNbr": "2335", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6335", "type": "B"}, {"subject": "HIST", "catalogNbr": "2335", "type": "B"}, {"subject": "HIST", "catalogNbr": "6335", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6335", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "In this course we will examine LGBTQ+ history in the United States with a focus on its recovery and public representation\u2014what are the stakes of researching, preserving, and commemorating the LGBTQ+ past? We will investigate how archival, scholarly, curatorial, and creative practices shape popular conceptions of LGBTQ+ life, politics, and culture, and how those practices and conceptions have changed with evolving understandings of race, gender, sexuality, and oppression. Students will build skills in archival research and historical interpretation and explore possibilities and challenges in building archives and presenting LGBTQ+ history in a variety of public contexts\u2014museums, libraries, monuments, movies and television, and community-based oral history projects. For their final project, students will locate and research a selection of archival materials (periodicals, letters, pamphlets, songs, advertisements, etc.) either online or at Cornell Library's Rare and Manuscript Collections, producing a final research paper and a proposal for a public history project.", "catalogBreadth": "", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 352755, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "2760", "titleShort": "Desire", "titleLong": "Desire", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8808, "meetings": [{"classMtgNbr": 1, "timeStart": "07:30PM", "timeEnd": "08:45PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "eh36", "firstName": "Ellis", "middleName": "", "lastName": "Hanson"}], "pattern": "MW", "facilityDescr": "Goldwin Smith Hall G76-Lewis", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSHG76", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "2760", "type": "C"}, {"subject": "ENGL", "catalogNbr": "2760", "type": "C"}, {"subject": "FGSS", "catalogNbr": "2760", "type": "C"}, {"subject": "PMA", "catalogNbr": "2680", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "\"Language is a skin,\" the critic Roland Barthes once wrote: \"I rub my language against the other. It is as if I had words instead of fingers, or fingers at the tip of my words. My language trembles with desire.\" Sexual desire has a history, even a literary history, which we will examine through an introductory survey of European dramatic literature from the Ancient Greeks to the present, as well as classic readings in sexual theory, including Plato, Freud, Foucault, and contemporary feminist and queer theory.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 369332, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "2841", "titleShort": "Viruses-Humans-Viral Politics", "titleLong": "Viruses- Humans-Viral Politics (Social History and Cultural Politics of HIV & AIDS)", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8566, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "cr566", "firstName": "Christopher", "middleName": "", "lastName": "Roebuck"}], "pattern": "TR", "facilityDescr": "Goldwin Smith Hall G76-Lewis", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSHG76", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "2841", "type": "C"}, {"subject": "ANTHR", "catalogNbr": "2021", "type": "C"}, {"subject": "BSOC", "catalogNbr": "2841", "type": "C"}, {"subject": "FGSS", "catalogNbr": "2841", "type": "C"}, {"subject": "STS", "catalogNbr": "2841", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course explores what has been termed \"the modern plague.\"\u00a0 It investigates the social history, cultural politics, biological processes, and global impacts of the retrovirus, HIV, and the disease syndrome, AIDS. It engages material from multiple fields: life sciences, social sciences, &amp; humanities as well as media reports, government documents, activist art, and community-based documentaries. It explores various meanings and life-experiences of HIV &amp; AIDS; examines conflicting understandings of health, disease, the body; investigates political struggles over scientific research, biomedical &amp; public health interventions, and cultural representations; and queries how HIV vulnerability is shaped by systems of power and inequality. As well, we come to learn about the practices, the politics, and the ethics of life and care that arise in \"the age of epidemic.\"", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 367858, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "3210", "titleShort": "Gender and the Brain", "titleLong": "Gender and the Brain", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8064, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "sbd3", "firstName": "Shelby", "middleName": "Barbara", "lastName": "Dietz"}], "pattern": "MW", "facilityDescr": "Corson-Mudd W364", "bldgDescr": "Corson-Mudd", "facilityDescrshort": "CMHW364", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisite: BIONB 2220, BIOMG 3320, FGSS 2010, LGBT 2290 or permission of instructor. For NBB concentration: this course may be used toward the additional 7 credit requirement, but does not qualify as an advanced course."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "BIONB", "catalogNbr": "3215", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3210", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Why are boys more likely than girls to be diagnosed with autism, and why are women more likely than men to be diagnosed with depression? Are there different \"gay\" and \"straight\" brains? And how does brain science interact with gender and sexuality in popular debate? Reading and discussing the original scientific papers and related critical texts, we will delve into the neuroscience of gender.", "catalogBreadth": "", "catalogDistr": "(PBS-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIONB 2220, BIOMG 3320, FGSS 2010, and LGBT 2290\u00a0or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Demonstrate knowledge of the state of the field in gender and neuroscience.", "Be able to apply concepts from history, philosophy, and critical theory to scientific texts.", "Demonstrate understanding of the interaction of experimental design, stereotypes, and preconceptions in how studies are carried out and communicated.", "Be aware of the range of experimental techniques available in neuroscience, and their advantages and limitations."], "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 357914, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "3250", "titleShort": "Staging Gay & Trans Histories", "titleLong": "Staging Gay and Transgender Histories", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16556, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "slw42", "firstName": "Sara", "middleName": "L.", "lastName": "Warner"}], "pattern": "MW", "facilityDescr": "Schwartz Ctr-Perform Arts 124", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ124", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "FGSS", "catalogNbr": "3250", "type": "B"}, {"subject": "FGSS", "catalogNbr": "6755", "type": "B"}, {"subject": "LGBT", "catalogNbr": "6755", "type": "B"}, {"subject": "PMA", "catalogNbr": "3755", "type": "B"}, {"subject": "PMA", "catalogNbr": "6755", "type": "B"}, {"subject": "VISST", "catalogNbr": "3260", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "How have movements for sexual liberation used performance as a means of self-expression and\u00a0strategies for social justice? How have theatrical stages served as\u00a0sites of queer sociality and\u00a0crucibles of invention, where history is made and remade by social actors?", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 352797, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "3550", "titleShort": "Decadence", "titleLong": "Decadence", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 16594, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "eh36", "firstName": "Ellis", "middleName": "", "lastName": "Hanson"}], "pattern": "MW", "facilityDescr": "White Hall 106", "bldgDescr": "White Hall", "facilityDescrshort": "WHT106", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "3550", "type": "C"}, {"subject": "ENGL", "catalogNbr": "3550", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3550", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "\"My existence is a scandal,\" Oscar Wilde once wrote, summing up in an epigram the effect of his carefully cultivated style of perversity and paradox. Through their celebration of \"art for art's sake\" and all that was considered artificial, unnatural, or obscene, the Decadent writers of the late-nineteenth century sought to free the pleasures of beauty, spirituality, and sexual desire from their more conventional ethical moorings. We will focus on the literature of the period, including works by Charles Baudelaire, Edgar Allan Poe, A. C. Swinburne, and especially Oscar Wilde, and we will also consider related developments in aesthetic philosophy, painting, music, theater, architecture, and design.", "catalogBreadth": "(HB)", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 368288, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "3725", "titleShort": "Femininity as Masquerade", "titleLong": "Femininity as Masquerade", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16601, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "mr283", "firstName": "Masha", "middleName": "", "lastName": "Raskolnikov"}], "pattern": "TR", "facilityDescr": "Rockefeller Hall 102", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK102", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGL", "catalogNbr": "3725", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3725", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "\"One is not born a woman, but rather becomes one\" wrote Simone de Beauvoir. How does such an odd becoming happen? What can literature teach us about it? Does anyone ever achieve \"being a woman\" and how do we (\"we\"??) survive always falling short of the implicit ideal? We will think about the power afforded by receptivity, passivity, bottoming, emotionality and openness, whether or not these are enacted by people born, designated or living as female.\u00a0 What are some of the dimensions of femininity's diversity, even in the United States, today? This course is intimately informed by intersectional queer, women of color and trans* perspectives, which will be at the center of our inquiry. It will cover film, literature, personal essays and gender theory.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 359467, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "3740", "titleShort": "Parody", "titleLong": "Parody", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 16664, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "ngs9", "firstName": "Nick", "middleName": "", "lastName": "Salvato"}], "pattern": "MW", "facilityDescr": "Schwartz Ctr-Perform Arts 220", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ220", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3745", "type": "C"}, {"subject": "FGSS", "catalogNbr": "3740", "type": "C"}, {"subject": "PMA", "catalogNbr": "3740", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "In A Theory of Parody, Linda Hutcheon defines parody broadly as \"repetition with critical difference, which marks difference rather than similarity.\" Taking a cue from Hutcheon, we will consider parody as a form of meaning making that is not necessarily used in the service of ridicule. Rather, we will examine a number of late-twentieth- and early-twenty-first-century imitative works in order to distinguish the rich variety of political agendas and aesthetic rationales for recent parody. An emphasis on postmodern or contemporary performances and media that renovate images, ideas, and icons from modernism and modernity will unite our otherwise diverse efforts. Some of these efforts will also highlight what happens when an artist takes up a work made for one platform (for example, theatre, performance art, installation, cinema, television, the Web) and parodies it in another. Creators and works under consideration may range from Christopher Durang, Split Britches, and Pig Iron Theatre Company to The Simpsons, Cookie's Fortune, and Strindberg and Helium.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 370485, "crseOfferNbr": 1, "subject": "LGBT", "catalogNbr": "3990", "titleShort": "Undergrad Independent Study", "titleLong": "Undergraduate Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 16597, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "nd326", "firstName": "Naminata", "middleName": "", "lastName": "Diabate"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}, {"