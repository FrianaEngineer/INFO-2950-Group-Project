e Ukrainian war who is especially interested in Ukraine's new role on the world stage. Why the yellow-and-blue flags and bumper stickers in our streets and parking lots?", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 371517, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "3134", "titleShort": "Advanced Ukrainian II", "titleLong": "Advanced Ukrainian II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5481, "meetings": [{"classMtgNbr": 1, "timeStart": "01:10PM", "timeEnd": "02:25PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 4, "netid": "ak2573", "firstName": "Angelika", "middleName": "", "lastName": "Kraemer"}], "pattern": "MW", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This course is part of the Shared Course Initiative (SCI). For more information about SCI courses, please see http://sharedcourseinitiative.org/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2025", "endDt": "05/17/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaxi