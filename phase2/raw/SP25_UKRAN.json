", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The course starts with a review and subsequent reinforcement of grammar fundamentals and core vocabulary pertaining to the most common aspects of daily life. Principal emphasis is placed on further development of students' communicative skills (oral and written) on such topics as the self, family, studies and leisure, travel, meals and others.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "This course is part of the Shared Course Initiative and will be taught from Columbia University using videoconferencing technology. Questions may be directed to Ahmed Shamim, as3969@cornell.edu.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 373805, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "2200", "titleShort": "Contemporary Ukraine", "titleLong": "Ukraine's Culture and Language within the Legacy of the USSR, Russian Invasion, and Other Crises", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 10974, "meetings": [{"classMtgNbr": 1, "timeStart": "04:35PM", "timeEnd": "05:25PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 1, "netid": "kg463", "firstName": "Krystyna", "middleName": "", "lastName": "Golovakova"}], "pattern": "M", "meet