rious historical periods since the 18th century, Ukraine had been controlled by the Russian Empire and Soviet Union, gained independence in 1991, and become the target of a military invasion by Russian Federation in 2022. Through assigned readings, videos, and other materials, students will gain a degree of understanding of the historical and social forces that shape Ukrainian everyday life, natural environments, and popular culture, and its current place in Europe and the world.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Students with no previous study of Ukrainian language or culture are welcome, as are those who learned something about Ukraine in their family or community. The credit hour of this course does not count towards the Arts College language requirement.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 370789, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "1122", "titleShort": "Elementary Ukrainian II", "titleLong": "Elementary Ukrainian II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 5309, "meetings": [{"classMtgNbr": 1, "timeStart": "05:35PM", "timeEnd": "06:25PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instructors": [{"instrAssignSeq": 7, "netid": "kg463", "firstName": "Krystyna", "middleName": "", "lastName": "Golovakova"}], "pattern": "M", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "04:35PM", "timeEnd": "05:25PM", "startDt": "01/21/2025", "endDt": "05/06/2025", "instru