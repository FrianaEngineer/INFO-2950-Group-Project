18, "crseOfferNbr": 2, "subject": "BIOMS", "catalogNbr": "4140", "titleShort": "Pharmacology", "titleLong": "Principles of Pharmacology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 3248, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "03:20PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 3, "netid": "mel237", "firstName": "Maurine", "middleName": "E.", "lastName": "Linder"}, {"instrAssignSeq": 1, "netid": "gaw2", "firstName": "Gregory", "middleName": "A.", "lastName": "Weiland"}], "pattern": "MWF", "facilityDescr": "Vet Research Tower T1003-LH3", "bldgDescr": "Vet Research Tower", "facilityDescrshort": "VRTT1003", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisites: Animal Physiology (BIOAP 3110) or Human Anatomy and Physiology (NS 3410)."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "BIOAP", "catalogNbr": "4140", "type": "C"}, {"subject": "BIONB", "catalogNbr": "4140", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Undergraduate course surveying system- and organ-related aspects of pharmacology. Topics include mechanisms of drug action; drug disposition; pharmacokinetics; autonomic pharmacology; pharmacology of inflammation, allergy and platelet function; and endocrine, cardiovascular, respiratory, gastrointestinal, and renal pharmacology. The course is designed for undergraduate life science majors, particularly those interested in medical or veterinary school.", "catalogBreadth": "", "catalogDistr": "(PBS-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: BIOAP 3110\u00a0or NS 3410.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Describe fundamental concepts of drug-receptor interactions.", "Describe the relation between cell membrane or intracellular drug targets and intracellular signaling systems that mediate cellular response", "Describe the impact of drug accessibility to biological compartments on drug action.", "Describe the purpose as well as the detailed mechanisms of the biochemical reactions that render drug and xenobiotic compounds more suitable for elimination from the body.", "Describe the fundamental mechanisms responsible for various types of drug interactions.", "Describe the mechanism of therapeutic action of a selected drug at the molecular, cellular, and organ system level.", "Describe the common adverse effects of a selected drug and their mechanism of production."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 366314, "crseOfferNbr": 1, "subject": "BIOMS", "catalogNbr": "4311", "titleShort": "Paleoparasitology", "titleLong": "Paleoparasitology - Very, Very Cold Cases", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent