br": "1110", "type": "C"}, {"subject": "RELST", "catalogNbr": "1110", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/22/2022", "sessionEndDt": "12/17/2022", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course is designed to introduce students to the language, grammar, and vocabulary of the Hebrew Bible/Old Testament. By the end of the semester students will be able to read and understand a number of biblical narrative passages, drawn from texts such as the stories of: creation in the Garden of Eden, Noah's Ark, Joseph and his brothers, the Israelites' exodus from Egypt, David and Goliath, and others stories students are interested in reading in the original language. Emphasis will be placed on learning vocabulary in context so that students begin to understand the language of the Bible as a window on ancient Israelite religion, culture, and experience.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2825, "crseId": 353532, "crseOfferNbr": 1, "subject": "HEBRW", "catalogNbr": "3101", "titleShort": "Advanced Modern Hebrew I", "titleLong": "Advanced Modern Hebrew I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4360, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "02:20PM", "startDt": "08/22/2022", "endDt": "12/05/2022", "instructors": [{"instrAssignSeq": 5, "netid": "ss66", "firstName": "Shalom", "middleName": "", "last