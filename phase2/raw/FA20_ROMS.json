01", "classNbr": 16770, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "04:15PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "gla23", "firstName": "Gerard", "middleName": "Laurence", "lastName": "Aching"}], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "3010", "type": "C"}, {"subject": "LATA", "catalogNbr": "3015", "type": "C"}, {"subject": "SHUM", "catalogNbr": "3010", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "When sugar \"was king,\" that is, when it was valued in the eighteenth and nineteenth centuries, as we might value petroleum today, European nations went to war in order to possess the sugar producing islands in the Caribbean. Sugar production, slave labor, and the transatlantic trade that they generated were crucial for European empire building and the creation of the enormous wealth that, in comparison with earlier historical periods, rapidly revolutionized agriculture, nutrition, industry, labor, and free trade; racialized Caribbean peoples; and gave rise to transatlantic debates on freedom, abolitionism, and humanitarian philanthropy. Readings include A. Stuart, Sugar in the Blood, S. Mintz, Sweetness and Power, C.L.R. James, Black Jacobins. Films include, Guti\u00e9rrez Alea's The Last Supper and M. Kalatozov's I am Cuba.", "catalogBreadth": "(GHB)", "catalogDistr": "(HA-AS, HST-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 353615, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "3210", "titleShort": "History of Romance Langs I", "titleLong": "History of Romance Languages I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17997, "meetings": [{"classMtgNbr": 1, "timeStart": "12:40PM", "timeEnd": "01:30PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "eha1", "firstName": "Ti", "middleName": "", "lastName": "Alkire"}], "pattern": "MWF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Prerequisites: A 2000-level (or higher) course in any Romance language, and some familiarity with a second one or with Latin."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LING", "catalogNbr": "3321", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "09/02/2020", "sessionEndDt": "12/21/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "The Romance languages are the lasting imprint of all that happened to the Latin language as it moved through time, territories, and people of many ethnicities.\u00a0 While the Latin of antiquity retained its prestige in high culture, the natural untutored usage of ordinary people was always free to go its own way.\u00a0 This course covers the following topics, selected to create a panoramic view:\u00a0 Formation of the general Romance seven-vowel system from Latin.\u00a0 Early and widespread sound changes in popular Latin.\u00a0 Finding and interpreting evidence for trends in popular Latin pronunciation.\u00a0 The comparative method and its limitations.\u00a0 Essential later sound changes, some of which ceate a whole new order of consonants unknown to Latin but conspicuous in Romance.\u00a0 Nouns and adjectives from Latin to Romance.\u00a0 Formation of the present indicative: the competing forces of sound change and analogical adjustment.\u00a0 A brief overview of Portuguese.\u00a0 Variants of the seven-vowel system.\u00a0 Salient features of Romanian.\u00a0 Factors that helped shape the vocabulary of Romance.\u00a0 Medieval diglossia.\u00a0 Emergence of Romance vernaculars newly recognized by their speakers as languages distinct from Latin and from each other.\u00a0 Close analysis of the oldest surviving document written unmistakably in Romance (842 C. E.).", "catalogBreadth": "(HB)", "catalogDistr": "(HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: a 2000-level (or higher) course in any Romance language, and some familiarity with a second one or with Latin.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2769, "crseId": 371035, "crseOfferNbr": 1, "subject": "ROMS", "catalogNbr": "4360", "titleShort": "Literature and Film", "titleLong": "Literature and Film After Climate Change", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17999, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "04:55PM", "startDt": "09/02/2020", "endDt": "12/16/2020", "instructors": [{"instrAssignSeq": 3, "netid": "kep44", "firstName": "Karen", "middleName": "Elyse", "lastName": "Pinkus"}], "pattern": "R", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "09/02/2020", "endDt": "12/21/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": 