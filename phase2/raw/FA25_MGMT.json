: null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 369837, "crseOfferNbr": 1, "subject": "MGMT", "catalogNbr": "6220", "titleShort": "Marketing Strategy", "titleLong": "Marketing Strategy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10738, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "04:30PM", "startDt": "10/15/2025", "endDt": "12/05/2025", "instructors": [{"instrAssignSeq": 13, "netid": "jl2545", "firstName": "Jura", "middleName": "", "lastName": "Liaukonyte"}], "pattern": "T", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Johnson Master of Professional Studies (MPS) in Management students."}, {"classNotesSeq": 2, "descrlong": "Add/Drop Dates: 9:00 am, August 18, 2025 - 11:59 pm, September 8, 2025 with an additional add/drop period 8:00 am, October 15, 2025 - 11:59 pm, October 22, 2025. Students will be required to obtain faculty permission to add/drop after October 22, 2025. If you drop after November 12, 2025, a \"W\" will be posted on your transcript."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "10/15/2025", "endDt": "12/20/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "10/15/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This course will help you build and defend a great business. A strong business leader has to make smart, strategic marketing decisions, create and present a plan to get people on board, and then execute. You will learn about all of these steps in the course, as we review a range of topics including marketing fundamentals, new business strategy, established business strategy, brand portfolio strategy, and more. In doing so, we will build on the core marketing course and other marketing classes, in addition to introducing new concepts. The material for this course will help you analyze and understand businesses, develop and gain support for your marketing strategies and ultimately deliver strong results. Upon successful completion of this course, students will have the knowledge and skills to apply working knowledge of marketing concepts to make marketing decisions to solve case-based and simulated problems, assess business situations and diagnose the effectiveness of marketing decisions (made by you, classmates and business leaders) using analytical frameworks, understand the problems that are encountered/managed by the marketing function. Make recommendations as to how the situations could be managed more effectively, and communicate marketing insights and engage in group decision making.", "catalogBreadth": null, "catalogDistr": n