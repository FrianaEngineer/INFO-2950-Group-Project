. Globalization-related issues such as international financial markets and global crises will be given special attention.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2024FA, 2023FA, 2022FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2909, "crseId": 369838, "crseOfferNbr": 1, "subject": "MGMT", "catalogNbr": "5245", "titleShort": "Managerial Economics", "titleLong": "Managerial Economics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10267, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "08/25/2025", "endDt": "10/10/2025", "instructors": [{"instrAssignSeq": 1, "netid": "mw46", "firstName": "Michael", "middleName": "", "lastName": "Waldman"}], "pattern": "TR", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Johnson Master of Professional Studies (MPS) in Management students."}, {"classNotesSeq": 2, "descrlong": "Add/Drop Dates: 9:00am, August 18, 2025 \u2013 11:59pm September 2, 2025. Students are required to obtain faculty permission to add/drop after September 2, 2025. If you drop after September 22, 2025, a \u201cW\u201d will be posted on your transcript."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "loc