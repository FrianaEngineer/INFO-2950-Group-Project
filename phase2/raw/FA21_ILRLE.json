alId": 42660, "itemId": 143055, "title": "White Trash : The 400-Year Untold History of Class in America", "edition": "", "author": "Isenberg", "publisher": "Penguin Publishing Group", "materialRequirementId": 1, "materialRequirement": "Required", "priceNew": "18.00", "priceUsed": "13.50", "priceDigital": "", "isbn": "9780143129677", "courseCodeId": 293848}]}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3480", "type": "C"}, {"subject": "HIST", "catalogNbr": "3480", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This class investigates race and class in the American labor market from Colonial America to the present day. We investigate the circumstances and labor institutions that brought labor to the U.S. and how laborers of various classes were received. A primary goal of the class is to understand the degree to which social mobility was historically possible in different time periods in American history. Social mobility is intimately tied to labor market institutions and the ability for workers to get ahead within those institutions. Some of the institutions we study are Indentured Servitude, Slavery, tenant farming, the Great Migration and labor organization in the industrial north. Ultimately we hope to build an understanding of the historical roots of the role of race and class today.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ECON 3030\u00a0or ILRLE 2400.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 371462, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3460", "titleShort": "New Tech and the Labor Market", "titleLong": "New Technologies and the Labor Market", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 17844, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "08/26/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 1, "netid": "mb2693", "firstName": "Michele", "middleName": "", "lastName": "Belot"}], "pattern": "TR", "facilityDescr": "Ives Hall 115", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS115", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2021", "endDt": "12/18/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ECON", "catalogNbr": "3485", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "12/18/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course examines economic approaches to how new technologies impact the labour market. We will study how robots and digital technolo