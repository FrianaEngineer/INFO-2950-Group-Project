l, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: pre-med/pre-vet juniors, seniors, and graduate students interested in biomedical science.", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will understand the role of physical phenomena, including electrochemical gradients and mechanical forces, in the physiology of live systems.", "Students will understand the scientific method including experimental design and formulating and testing hypotheses.", "Students will know how to work cooperatively in small groups.", "Students will know how to communicate scientific concepts and experimental results in written and oral form.", "Students will understand how to use statistics to assess the significance of results.", "Students will know how to research published scientific findings and interpret them."], "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2741, "crseId": 360920, "crseOfferNbr": 1, "subject": "BIOMS", "catalogNbr": "4090", "titleShort": "Principles of Virology", "titleLong": "Principles of Virology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1237, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/29/2019", "endDt": "12/10/2019", "instructors": [{"instrAssignSeq": 7, "netid": "jsp7", "firstName": "John", "middleName": "Stuart Leslie", "lastName": "Parker"}], "pattern": "TR", "facilityDescr": "Vet Research Tower T1003-LH3", "bldgDescr": "Vet Research Tower", "facilityDescrshort": "VRTT1003", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/29/2019", "endDt": "12/10/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs