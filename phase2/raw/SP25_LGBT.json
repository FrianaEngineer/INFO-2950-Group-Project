"4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "6701", "type": "B"}, {"subject": "PMA", "catalogNbr": "4701", "type": "B"}, {"subject": "PMA", "catalogNbr": "6701", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4701", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores nightlife as a temporality that fosters countercultural performances of the self and that serves as a site for the emergence of alternative kinship networks. Focusing on queer communities of color, course participants will be asked to interrogate the ways in which nightlife demonstrates the queer world-making potential that exists beyond the normative 9-5 capitalist model of production. Performances of the everyday,\u00a0alongside films, texts, and performance art, will be analyzed through a performance studies methodological lens. Through close readings and sustained cultural analysis, students will acquire a critical understanding of the potentiality of spaces, places, and geographies codified as \"after hours\" in the development of subcultures, alternative sexualities, and emerging performance practices.", "catalogBreadth": null, "catalogDistr": "(ALC-AS, SCD-AS) (CA-AG, D-AG, LA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 365151, "crseOfferNbr": 3, "subject": "LGBT", "catalogNbr": "6290", "titleShort": "Sexual Politics of Religion", "titleLong": "The Sexual Politics of Religion", "crseAttrs": [], "crseAt