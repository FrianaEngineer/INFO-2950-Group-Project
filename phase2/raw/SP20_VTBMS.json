: "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 361478, "crseOfferNbr": 1, "subject": "VTBMS", "catalogNbr": "7020", "titleShort": "Practice Lab Anim Med", "titleLong": "The Practice of Laboratory Animal Medicine", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14377, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "03:00PM", "startDt": "01/21/2020", "endDt": "05/05/2020", "instructors": [{"instrAssignSeq": 1, "netid": "bs256", "firstName": "Bhupinder", "middleName": "", "lastName": "Singh"}], "pattern": "W", "facilityDescr": "Moore Laboratory S1102", "bldgDescr": "Moore Laboratory", "facilityDescrshort": "MRBS1102", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/21/2020", "endDt": "05/12/2020", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid - Online & In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "01/21/2020", "sessionEndDt": "05/12/2020", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "A laboratory animal veterinarian must be trained in the regulatory aspects of research and teaching utilizing animals; in addition they must understand the principles of facility management and design.\u00a0 Also, to work with researchers, a lab animal veterinarian must have knowledge of basic research methodologies and animal welfare issues.\u00a0 This course may also be of interest to other veterinarians, veterinary students, and researchers who wish to understand the workings of the specialized field that oversees and enables the use of animals in research and teaching.\u00a0 The topics covered include:\u00a0 Laboratory Animal Medicine: Laws, Regulations, and Policies; Design and Management of Animal Facilities; Anesthesia, Analgesia, and Euthanasia; Techniques of Experimentation; Control of Biohazards used in animal research; Selected zoonoses/xenozoonoses; Genetic monitoring; Transgenic and knock-out mice; Factors influencing animal research; Animal models in biomedical research; Research in Lab Animal and Comparative Medicine; Lab Animal Behavior.\u00a0 The course will meet for 1 hour weekly and will extend over the course of two years, though each term is independent and can be taken separately.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: basic knowledge of anatomy and pathology in comparative animal species.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: upper-level undergraduate or graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2755, "crseId": 361484, "crseOfferNbr": 1, "subject"