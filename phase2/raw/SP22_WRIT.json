"isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "FWS", "sessionBeginDt": "01/24/2022", "sessionEndDt": "05/21/2022", "sessionLong": "FWS Session", "exploreCriteriaIds": []}], "description": "The purpose of this course is to develop our skills as writers in order to competently navigate the communication and expression of thought for academic success. We will practice reading, writing, and discussing ideas with purpose. The framework of thought to help us study our writing will examine the relationships between mind and bodies, and what that means for having a sense of self. In short, we examine being-in-the-world. Many questions in this course pertain to relationships: How does the mind relate to the body; how does the body relate to the environment; how do I feel connected to myself and others? This course takes an interdisciplinary approach and incorporates materials from biology, philosophy, psychology, and sociology.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 371791, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "1968", "titleShort": "FWS: Public Writing", "titleLong": "FWS: Public Writing: Navigating the News", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19582, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "01/24/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 1, "netid": "kk775", "firstName": "Kelly", "middleName": "", "lastName": "King-O'Brien"}], "pattern": "TR", "facilityDescr": "Rockefeller Hall 189", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK189", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "For more information about First-Year Writing Seminars, see the Knight Institute website at http://knight.as.cornell.edu/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2022", "endDt": "05/21/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "FWS", "sessionBeginDt": "01/24/2022", "sessionEndDt": "05/21/2022", "sessionLong": "FWS Session", "exploreCriteriaIds": []}], "description": "We now live in a 24-hour news cycle that bombards college students with \"news\" every day--in multiple forms such as news apps, social media, and online news sources. Who has time to read all these articles and which news can we trust? How do we ever find news that isn't \"biased?\" This first-year seminar offers students an opportunity to read the news on topics they wish to read about and learn more about how to find reputable articles and discern when they aren't. As we analyze how journalists write to big, broad audiences, students will write to different members of the public about contemporary controversies in the news-in the form of investigative essays, blog posts, and short news digests.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 371480, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "2101", "titleShort": "Rspnding to Wtg:Theory&Pedagog", "titleLong": "Responding to Writing: Theory and Pedagogy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 13009, "meetings": [{"classMtgNbr": 1, "timeStart": "04:30PM", "timeEnd": "06:00PM", "startDt": "03/16/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 1, "netid": "ken43", "firstName": "Kate", "middleName": "", "lastName": "Navickas"}], "pattern": "W", "facilityDescr": "Rockefeller Hall 127", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK127", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Students interested in this course should apply to be a Cornell Writing Centers tutor at the beginning of the spring semester. All successful tutor applicants will be enrolled automatically. To apply, go here: https://knight.as.cornell.edu/become-wc-tutor To enroll without becoming a tutor, please contact Dr. Kate Navickas, ken43@cornell.edu. Special consideration may be granted based on space, interest, and major. Day/time for this class may change depending on availability of hired tutors."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/16/2022", "endDt": "05/21/2022", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/16/2022", "sessionEndDt": "05/21/2022", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "This course introduces students to scholarship on writing pedagogy, requiring them to think critically about collaborative learning strategies, multilingual writing challenges, ethical considerations in peer tutoring, and the ways in which race and other facets of identity inform teaching and learning. The learning objectives include: develop an understanding of different theories of writing and the history of writing centers; practice reading and responding to a variety of different writing genres and student situations in ways that connect theory to practice; learn to question assumptions in specific pieces of writing, frameworks for writing, and in pedagogical interactions; self-reflect on individual writing processes, writing, and previous educational experiences; analyze the ways in which writer and tutor identities affect pedagogical interactions and learn strategies for equitable and ethical tutoring; develop confidence in suggesting interventions for other writers at various stages of their writing processes; and, gain flexibility in utilizing a variety of strategies for fostering writer agency and growth.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 353948, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "7101", "titleShort": "Writing In The Majors Seminar", "titleLong": "Writing in the Majors Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 12520, "meetings": [{"classMtgNbr": 1, "timeStart": "07:00PM", "timeEnd": "09:15PM", "startDt": "01/24/2022", "endDt": "03/15/2022", "instructors": [{"instrAssignSeq": 1, "netid": "ehs9", "firstName": "Elliot", "middleName": "Hart", "lastName": "Shapiro"}], "pattern": "W", "facilityDescr": "White Hall 114", "bldgDescr": "White Hall", "facilityDescrshort": "WHT114", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/24/2022", "endDt": "03/15/2022", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "