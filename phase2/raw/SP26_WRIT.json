 the teacher, peer workshopping, discussion, and learning to talk about how different types of writing work. Students will deeply engage diverse course materials (journalism, scholarly articles, podcasts, films, etc.) on topics like art, literature, and relevant social issues to explore ideas about a text, write for specific audiences, and develop creativity, style, and voice.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 353946, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "1390", "titleShort": "Special Topics in Writing", "titleLong": "Special Topics in Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1698, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "kk775", "firstName": "Kelly", "middleName": "", "lastName": "King-O'Brien"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "05/16/2026", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isC