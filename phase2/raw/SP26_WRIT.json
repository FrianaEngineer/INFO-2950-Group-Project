ead all these articles and which news can we trust? How do we ever find news that isn't biased? This first-year seminar offers students an opportunity to read the news on topics they wish to read about and learn more about how to find reputable articles and discern when they aren't. As we analyze how journalists write to big, broad audiences, students will write to different members of the public about contemporary controversies in the news-in the form of investigative essays, blog posts, and short news digests.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025FA, 2022SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 371480, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "2101", "titleShort": "Rspnding to Wtg:Theory&Pedagog", "titleLong": "Responding to Writing: Theory and Pedagogy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1710, "meetings": [{"classMtgNbr": 1, "timeStart": "04:30PM", "timeEnd": "06:00PM", "startDt": "03/11/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "ken43", "firstName": "Kate", "middleName": "", "lastName": "Navickas"}], "pattern": "T", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Application required. See https://knight.as.cornell.edu/become-wc-tutor to apply. \nTo request enrollment without becoming a tutor, please contact the instructor."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "03/11/2026", "endDt": "05/16/2026", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W2", "sessionBeginDt": "03/11/2026", "sessionEndDt": "05/16/2026", "sessionLong": "Seven Week - Second", "exploreCriteriaIds": []}], "description": "Although many of us have experiences being taught to write, helping someone else improve their writing in ways that respect their agency and cultivate learning is often not intuitive. In order to learn about ethical and educational methods of tutoring, this course introduces scholarship on tutoring, writing centers, and writing pedagogy. We will be critically thinking about your own writing process and experiences, responding to another\u2019s writing, and reading about collaborative learning strategies, multilingual writing challenges, ethical considerations in peer tutoring, and the ways in which race and other facets of identity affect tutoring and learning. With an emphasis on the connection between theory and practice, you will get tutored, observe and reflect on tutoring sessions, practice reading and responding to sample student writing, and develop your own tutoring pedagogy\u2014a theory of tutoring that considers the relationship between tutoring practices and the values those practices imply. The aim of the course is to cultivate knowledge and flexibility in the use of tutoring strategies for supporting agency and growth in diverse writers working on a variety of genres from across the disciplines.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: newly hired Cornell Writing Center Tutors.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025SP, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 353948, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "7101", "titleShort": "Writing in the Majors Seminar", "titleLong": "Writing in the Majors Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1699, "meetings": [{"classMtgNbr": 1, "timeStart": "06:30PM", "timeEnd": "08:45PM", "startDt": "01/20/2026", "endDt": "03/10/2026", "instructors": [{"instrAssignSeq": 1, "netid": "ehs9", "firstName": "Elliot", "middleName": "Hart", "lastName": "Shapiro"}], "pattern": "R", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/20/2026", "endDt": "03/18/2026", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDesc