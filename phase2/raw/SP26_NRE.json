ds": []}], "description": "This is a doctoral level seminar in finance designed to acquaint students with the research in the area of market microstructure. The course evaluates the main theoretical models and their applications. Increasingly issues in microstructure are empirical in nature, and we will spend time on the empirical approaches used in such research. We will discuss a variety of current market microstructure topics including high-frequency trading and OTC markets. Because information and liquidity issues are fundamental to many of the issues covered in microstructure, this course should be of interest to students in a wide range of disciplines.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2024SP, 2022FA, 2022SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 364307, "crseOfferNbr": 1, "subject": "NRE", "catalogNbr": "5030", "titleShort": "App Microecon II: Game Theory", "titleLong": "Applied Microeconomics II: Game Theory", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 15232, "meetings": [{"classMtgNbr": 1, "timeStart": "08:40AM", "timeEnd": "09:55AM", "startDt": "01/20/2026", "endDt": "05/05/2026", "instructors": [{"instrAssignSeq": 1, "netid": "mw46", "firstName": "Michael", "middleName": "", 