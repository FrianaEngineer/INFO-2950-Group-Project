"6225", "type": "C"}, {"subject": "HIST", "catalogNbr": "6225", "type": "C"}, {"subject": "ROMS", "catalogNbr": "6225", "type": "C"}, {"subject": "SPAN", "catalogNbr": "6225", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/21/2025", "sessionEndDt": "05/17/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course calls into question the public use of history. The past is permanently mobilized according to the culture and the problems of the present. Over the last decades, \"memory\" - a general concept used as a synonym for remembering, history, imagination, or representations of the past - arose at the heart of the public sphere, becoming an object of struggles.\u00a0 In some historical circumstances, the past is suddenly \"reactivated\" and irrupts in the present by claiming its \"rights,\" the end of oblivion, and rescue of the vanquished.\u00a0 Considering some well-known controversies about slavery, colonialism, fascism, communism, civil wars, the Holocaust, etc., the course aims at exploring how collective memories are interwoven with cultural industry, public policies (museums, commemorations, laws, etc.), and history writing.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2895, "crseId": 353304, "crseOfferNbr": 1, "subject": "ITAL", "catalogNbr": "6400", "titleShort": "Special Topics", "titleLong": "Special Topics in Italian Literature", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrCompon