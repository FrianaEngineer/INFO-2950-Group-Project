us)", "startDt": "08/25/2025", "endDt": "12/20/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "D-AG", "descr": "AG-Human Diversity", "descrformal": "AG-Human Diversity", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "GLC-AS", "descr": "AS-Global Citizenship", "descrformal": "AS-Global Citizenship", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "SCD-AS", "descr": "AS-Social Difference", "descrformal": "AS-Social Difference", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0013", "crseAttrValue": "CU-ITL", "descr": "International Study", "descrformal": "International Study", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "2470", "type": "C"}, {"subject": "FGSS", "catalogNbr": "2770", "type": "C"}, {"subject": "MEDVL", "catalogNbr": "2770", "type": "C"}, {"subject": "NES", "catalogNbr": "2770", "type": "C"}, {"subject": "RELST", "catalogNbr": "2770", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "08/25/2025", "sessionEndDt": "12/20/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores the role of gender and sexuality in shaping the lives of Muslims past and present. Through a close examination of ethnographies, intellectual histories, and religious treatises, we will analyze the key debates and discourses surrounding the intersection of gender and Islam. We begin by investigating Quranic revelations and hadith concerning gender and sexual ethics, female figures of emulation in early Islam, and feminist exegeses of the Quran. Continuing onward, we focus upon the everyday lives of Muslim women and non-binary individuals in medieval, colonial, and post-colonial contexts, highlighting the ways in which people negotiate and respond to the sexual politics of the times in which they live as we ask what, if anything, is specifically Islamic about the situations under discussion? Following this, we embark upon a history of sexuality within Islam, tracing the ways in which the categories of homosexuality and heterosexuality came to exist in the Muslim world, as well as the history and positionality of trans communities past and present. We then continue with an exploration of Islamic feminism as it exists today, looking to the ways in which Muslim feminists have critically engaged both religious texts as well as Western feminist theory. Finally, the course concludes by analyzing the relationship between the study of Islam, gender, and empire.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2023SP, 2019FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCross