istening skills. All listening exercises will aim at preparing students to speak. Be ready to actively participate in conversations, to express yourself orally, and write stories/compositions. Literature and Cultural materials are incorporated into the course, along with audio, video, and web-based materials.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "SWAHL 1100.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SP, 2025FA, 2024SP, 2023SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2923, "crseId": 351028, "crseOfferNbr": 1, "subject": "SWAHL", "catalogNbr": "2101", "titleShort": "Intermediate Swahili I", "titleLong": "Intermediate Swahili I", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "AFLANG", "descr": "Africana Studies Lang", "descrformal": "Africana Studies Language", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0012", "crseAttrValue": "FL-AG", "descr": "AG-Foreign Language", "descrformal": "AG-Foreign Language", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "FLOPI-AS", "descr": "AS-Foreign Language Option One", "descrformal": "AS-Foreign Language Option One", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "OCL-IL", "descr": "IL-Out of College Language", "descrformal": "IL-Approved Out of College Language Electives",