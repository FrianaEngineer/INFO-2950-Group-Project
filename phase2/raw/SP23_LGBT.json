rly scheduled courses. Students select a topic in consultation with an LGBT Studies faculty member who has agreed to supervise independent study.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "To apply for independent study, please complete the on-line form.", "catalogPrereqCoreq": "Prerequisite: LGBT 2290\u00a0and one additional LGBT Studies course at the 3000-level.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 368795, "crseOfferNbr": 4, "subject": "LGBT", "catalogNbr": "4701", "titleShort": "Nightlife", "titleLong": "Nightlife", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 6068, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 1, "netid": "kj12", "firstName": "Karen", "middleName": "", "lastName": "Jaime"}], "pattern": "TR", "facilityDescr": "Schwartz Ctr-Perform Arts 124", "bldgDescr": "Schwartz Ctr-Performing Arts", "facilityDescrshort": "SWZ124", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "4705", "type": "B"}, {"subject": "FGSS", "catalogNbr": "4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "4701", "type": "B"}, {"subject": "LSP", "catalogNbr": "6701", "type": "B"}, {"subject": "PMA", "catalogNbr": "4701", "type": "B"}, {"subject": "PMA", "catalogNbr": "6701", "type": "B"}, {"subject": "SHUM", "catalogNbr": "4701", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course explores nightlife as a temporality that fosters countercultural performances of the self and that serves as a site for the emergence of alternative kinship networks. Focusing on queer communities of color, course participants will be asked to interrogate the ways in which nightlife demonstrates the queer world-making potential that exists beyond the normative 9-5 capitalist model of production. Performances of the everyday,\u00a0alongside films, texts, and performance art, will be analyzed through a performance studies methodological lens. Through close readings and sustained cultural analysis, students will acquire a critical understanding of the potentiality of spaces, places, and geographies codified as \"after hours\" in the development of subcultures, alternative sexualities, and emerging performance practices.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2839, "crseId": 353025, "crseOfferNbr": 5, "subject": "LGBT", "catalogNbr": "6600", "titleShort": "Erotics of Visuality", "titleLong": "Erotics of Visuality", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17057, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "02:20PM", "startDt": "01/23/2023", "endDt": "05/09/2023", "instructors": [{"instrAssignSeq": 1, "netid": "eh36", "firstName": "Ellis", "middleName": "", "lastName": "Hanson"}], "pattern": "M", "facilityDescr": "Rockefeller Hall 187", "bldgDescr": "Rockefeller Hall", "facilityDescrshort": "RCK187", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/23/2023", "endDt": "05/20/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COML", "catalogNbr": "6601", "type": "C"}, {"subject": "ENGL", "catalogNbr": "6600", "type": "C"}, {"subject": "FGSS", "catalogNbr": "6610", "type": "C"}, {"subject": "PMA", "catalogNbr": "6670", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "01/23/2023", "sessionEndDt": "05/20/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "\"You didn't see anything,\" a woman in a movie says to her dubious lover. \"No one sees anything. Ever. They watch, but they don't understand.\"\u00a0\u00a0What is desire in a movie, and how do we know it when we see it or feel it? How do the images, sounds, and narratives of a cinematic event engage us erotically? How might we want to revise classic psychoanalytic, feminist, and queer theories of desire and cinema in light of the changing art of the moving image in the 21st century? We will focus especially on metacinematic work by Pedro Almod\u00f3var, Olivier Assayas, Todd Haynes, David Lynch, Michael Haneke, Steve McQueen, and John Cameron Mitchell, among others.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2023-06-07T20:54:13-0400", "catalogDttm": "2023-06-07T19:14:05-0400"}}