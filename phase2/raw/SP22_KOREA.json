y introducing a wide range of linguistic resources. Students will command daily conversation in different cultural contexts and develop an ability to summarize and reflect on literary texts and films both in oral and written modes. Students will be able to create a discourse regarding topics such as birthday, campus life, family, shopping and hobbies. Also, students will write and revise their own work regularly to improve linguistic accuracy and reduce error production.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will not receive credit for both KOREA 1102\u00a0and KOREA 1110.", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "For Korean heritage students who have limited Korean Language background and need formal training.", "catalogPrereqCoreq": "Prerequisite: grade of B- or higher in KOREA 1109\u00a0or online placement test (collt.lrc.cornell.edu/).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 351233, "crseOfferNbr": 1, "subject": "KOREA", "catalogNbr": "2202", "titleShort": "Intermediate Korean II", "titleLong": "Intermediate Korean II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 4223, "meetings": [{"classMtgNbr": 1, "timeStart": "01:30PM", "timeEnd": "02:20PM", "startDt": "01/24/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 3, "netid": "hk783", "firstName": "Hankyul", "middleName": "", "lastName": "Kim"}], "pattern": "MTWRF", "facilityDescr": "Rockefeller Hall 185", "bldgDescr": "Rockefeller Hall", "facilityDescrshort