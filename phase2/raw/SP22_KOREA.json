ntinuation of KOREA 2209. Designed for Korean heritage students who can understand and speak Korean, but especially need to refine their reading and writing skills. Students will acquire concrete knowledge of grammar to use in everyday conversation, and will minimize their spelling errors in writing, through frequent discussion and composition about Korean culture, society and history. They will become confident in reading paragraph-length readings in Korean, be able to write their reflections on the passages that they have read, and speak with ease when participating in the classroom discussions. Various projects will enhance students' overall linguistic and intercultural competence.", "catalogBreadth": "(GB)", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: grade of B- or higher in KOREA 2209, or online placement test (collt.lrc.cornell.edu).", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2811, "crseId": 351245, "crseOfferNbr": 1, "subject": "KOREA", "catalogNbr": "3302", "titleShort": "High Intermediate Korean II", "titleLong": "High Intermediate Korean II", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 4234, "meetings": [{"classMtgNbr": 1, "timeStart": "12:25PM", "timeEnd": "01:15PM", "startDt": "01/24/2022", "endDt": "05/10/2022", "instructors": [{"instrAssignSeq": 3, "netid": "hk783", "firstName": "Hankyul", "middleName": "", "lastName": "Kim"}], "pattern": "MWF", "facilityDescr": "Rockefeller Hall 388", "bldgDescr": "Rockefeller Ha