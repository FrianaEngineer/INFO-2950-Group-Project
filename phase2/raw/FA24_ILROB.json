alogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Recommended prerequisite: coursework in\u00a0statistics.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 355591, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "7220", "titleShort": "Macro Organizational Behavior", "titleLong": "Macro Organizational Behavior Seminar", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 18603, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bb686", "firstName": "Brittany", "middleName": "M.", "lastName": "Bond"}], "pattern": "M", "facilityDescr": "Ives Hall Faculty Wing 381", "bldgDescr": "Ives Hall Faculty Wing", "facilityDescrshort": "IVF381", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This doctoral seminar is designed to provide you with an overview of major theoretical traditions in the field of macro-Organizational Behavior. We will examine the historical development of sociological theories of organizations and contemporary issues in macro organizational research. The readings are organized in a semi-chronological fashion \u2013 we start with older, established classics and move into more contemporary lines of work.\u00a0 This course heavily emphasizes reading and analysis of primary source material. Students will be expected to lead a discussion class as well as submit a final written research proposal due at the end of the semester. The goal will be to convert our consumption of scholarship into production of robust research.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate students pursuing a\u00a0MS or PhD degree. All others by permission of the instructor.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 355616, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "9200", "titleShort": "Organizl Behavr Workshop", "titleLong": "Organizational Behavior Workshop", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18604, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bb686", "firstName": "Brittany",