]}], "description": "Survey of concepts, theories, and research from the fields of sociology, psychology, and social psychology as these relate to the behavior of individuals, groups, and work organizations. Topics include: job attitudes, motivation, leadership and power, group formation, organizational structure, and interorganizational relations. This course is designed for students in professional programs.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: MILR students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 373221, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "5290", "titleShort": "Social Capital and Orgs", "titleLong": "Social Capital and Organizations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10918, "meetings": [{"classMtgNbr": 1, "timeStart": "01:25PM", "timeEnd": "02:40PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bar93", "firstName": "Ben", "middleName": "A", "lastName": "Rissing"}], "pattern": "TR", "facilityDescr": "Ives Hall 219", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS219", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "in