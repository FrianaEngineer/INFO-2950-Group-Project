e where students will generate, develop, and pitch an idea related to a societal or business challenge.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Identify real problems (a.k.a., pain points).", "Effectively ideate creative solutions, including thinking through the idea's feasability, viability, and novelty.", "Recognize how technologies and solutions from one industry can be adapted to solve teh pain points of another industry."], "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 367804, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "3270", "titleShort": "Social Capital & Organizations", "titleLong": "Social Capital and Organizations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 10917, "meetings": [{"classMtgNbr": 1, "timeStart": "11:40AM", "timeEnd": "12:55PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bar93", "firstName": "Ben", "middleName": "A", "lastName": "Rissing"}], "pattern": "TR", "facilityDescr": "Ives Hall 115", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS115", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In 