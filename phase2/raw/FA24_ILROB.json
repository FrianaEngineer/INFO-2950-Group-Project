lls necessary to conduct scientific research in the field of organizational behavior. Topics covered will include generating research ideas, ethical considerations, common experimental and non-experimental designs, creating surveys and other measures, interpreting results, and writing research papers. Students will be asked to conduct their own research projects as part of the class. This course focuses on methods from psychology and related disciplines and is recommended for students considering doing honors thesis research.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "Recommended prerequisite: coursework in\u00a0statistics.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 355565, "crseOfferNbr": 1, "subject": "ILROB", "catalogNbr": "5200", "titleShort": "Organizational Behavior", "titleLong": "Organizational Behavior", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 8247, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "08/26/2024", "endDt": "12/09/2024", "instructors": [{"instrAssignSeq": 1, "netid": "bl679", "firstName": "Brian", "middleName": "", "lastName": "Lucas"}], "pattern": "TR", "facilityDescr": "Ives Hall 219", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS219", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/26/2024", "endDt": "12/21/2024", "addConsent": 