ode": "1", "sessionBeginDt": "08/26/2024", "sessionEndDt": "12/21/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This constitutes the first course in our third year of the Modern Hebrew language sequence.\u00a0\u00a0Development of speech proficiency will be emphasized. Over the course of the semester, students will develop reading comprehension through reading a variety of fiction and nonfiction texts, listening comprehension through screening of filmic works and episodes drawn from popular television series, writing through communication about what is read and screened, as well as more personal topics, and speech through in class discussion and oral presentations.\u00a0\u00a0Readings will include authentic and\u00a0partially adapted\u00a0contemporary short stories, poems and newspaper articles.\u00a0\u00a0", "catalogBreadth": null, "catalogDistr": "(ALC-AS) (CA-AG, LA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: HEBRW 2100\u00a0with a grade equivalent to C- or above or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2881, "crseId": 371088, "crseOfferNbr": 1, "subject": "HEBRW", "catalogNbr": "3103", "titleShort": "Advanced Hebrew Through Media", "titleLong": "Advanced Hebrew Through Media", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 19500, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "12:05PM", "startDt": "08/26/2024", "endDt": "12/09/2024", "inst