p behavior in an organizational context. We will read both classic and current articles in the field, and students will be responsible for helping to shape the reading list and guide the class discussions. Due to the nature of the class it is critical that all students read the assigned materials before class and\u00a0be prepared to contribute to a lively intellectual discussion about the work.\u00a0\u00a0Upon completion of this course, students should be able to: \u00a01) Discuss \u00a0and critique theory and research in major topic areas of Organizational Behavior, 2) integrate material within and across topics, and 3) propose new research questions that will extend management scholarship.\u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2783, "crseId": 364858, "crseOfferNbr": 1, "subject": "NRE", "catalogNbr": "5220", "titleShort": "Doc Seminar Quant Models", "titleLong": "Doctoral Seminar in Quantitative Models", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 14058, "meetings": [{"classMtgNbr": 1, "timeStart": "10:05AM", "timeEnd": "11:20AM", "startDt": "03/29/2021", "endDt": "05/14/2021", "instructors": [{"instrAssignSeq": 19, "netid": "ncy6", "firstName": "Nathan", "middleName": "Chi-Chung", "lastName": "Yang"}], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descr