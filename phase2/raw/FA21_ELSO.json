ng": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "7W1", "sessionBeginDt": "08/26/2021", "sessionEndDt": "10/19/2021", "sessionLong": "Seven Week - First", "exploreCriteriaIds": []}], "description": "In academia, students participate in discussions to share and create new knowledge, challenge ideas, and negotiate their identities. Thus participating in discussions is essential for students to become part of their academic community and have a voice in their fields. This course gives students strategies and practice working in range of discussion contexts, from one-on-one to planning and leading class discussions. By the end of this course, students will have learned strategies for preparing for, entering in, responding to, and being the leader of different types of discussions. Students will leave this course with more confidence to assert their voices.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2797, "crseId": 368952, "crseOfferNbr": 1, "subject": "ELSO", "catalogNbr": "6230", "titleShort": "Design/Deliver Presentations", "titleLong": "Designing and Delivering Effective Presentations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 13581, "meetings": [{"classMtgNbr": 1, "timeStart": "02:45PM", "timeEnd": "04:00PM", "startDt": "10/20/2021", "endDt": "12/07/2021", "instructors": [{"instrAssignSeq": 5, "netid": "nwl26", "firstName": "Nathan", "middleName"