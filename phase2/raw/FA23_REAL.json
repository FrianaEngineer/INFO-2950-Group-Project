hort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "CRP", "catalogNbr": "5560", "type": "C"}], "sessionCode": "7W1", "sessionBeginDt": "08/21/2023", "sessionEndDt": "10/19/2023", "sessionLong": "Seven Week - First", "exploreCriteriaIds": []}], "description": "Real estate professionals and city and regional planners play a vital role in creating the built environment. Understanding the physical form of real estate, and the rules that govern that form, is critically important if one is to meaningfully engage in the practice of real estate development. In this course, we examine in detail the physical form of the built environment, and students gain an understanding of the principles and organizing strategies that underlie it. We examine the following building types in depth: residential, retail, hotel and mixed use. Students exit this course with a deeper understanding of why the built environment takes the shape it does and the opportunities for innovations.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 369112, "crseOfferNbr": 1, "subject": "REAL", "catalogNbr": "5561", "titleShort": "Innov. Strat. in Com RE Develo", "titleLong": "Innovation and Strategy in Commercial Real Estate Development", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 12624, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:25AM", "startDt": "10/11/202