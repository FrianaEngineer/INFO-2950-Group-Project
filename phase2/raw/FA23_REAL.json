teriaIds": []}], "description": "This introduction to real estate finance and investment emphasizes developing valuation and decision-making skills. It introduces students to the business of real estate, both residential and commercial real estate, including roles, activities and players, terminology, and how the tools, concepts, and models in real estate are used in decision making. The objectives of this course are twofold: (1) to help students develop an understanding of real estate fundamentals; and (2) to introduce students to the quantitative aspects of real estate-investment decision making, valuation under uncertainty, and mortgage financing.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: an undergraduate or graduate level course in finance.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2853, "crseId": 366125, "crseOfferNbr": 1, "subject": "REAL", "catalogNbr": "6205", "titleShort": "Real Estate Financial Modeling", "titleLong": "Real Estate Financial Modeling", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 11550, "meetings": [{"classMtgNbr": 1, "timeStart": "02:55PM", "timeEnd": "04:10PM", "startDt": "08/21/2023", "endDt": "12/04/2023", "instructors": [{"instrAssignSeq": 1, "netid": "dl255", "firstName": "Daniel", "middleName": "", "lastName": "Lebret"}], "pattern": "MW", "facilityDescr": "Statler Hall 365", "bldgDescr": "Statler Hall", "facilityDescrshort": "STL365", "meetingTopicDescription": ""}], "notes": [{"clas